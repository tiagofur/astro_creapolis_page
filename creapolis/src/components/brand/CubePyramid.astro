---
interface Props {
  size?: number;
  class?: string;
  variant?: 'mono' | 'cmyk';
}

const { size = 28, class: className = '', variant = 'cmyk' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={`cube-pyramid ${className}`}
  aria-hidden="true"
>
  {variant === 'cmyk' ? (
    <g class="pyramid-group">
      {/* Top Peak Cube (Cyan) */}
      <g class="cube-top">
        <polygon points="24,6 32,10.6 24,15.2 16,10.6" fill="#00AEEF" />
        <polygon points="16,10.6 24,15.2 24,24.4 16,19.8" fill="#008BC4" />
        <polygon points="24,15.2 32,10.6 32,19.8 24,24.4" fill="#006C99" />
      </g>
      {/* Bottom Left Cube (Magenta) */}
      <g class="cube-left">
        <polygon points="16,20 24,24.6 16,29.2 8,24.6" fill="#EC008C" />
        <polygon points="8,24.6 16,29.2 16,38.4 8,33.8" fill="#B8006E" />
        <polygon points="16,29.2 24,24.6 24,33.8 16,38.4" fill="#8A0052" />
      </g>
      {/* Bottom Right Cube (Yellow) */}
      <g class="cube-right">
        <polygon points="32,20 40,24.6 32,29.2 24,24.6" fill="#FFC400" />
        <polygon points="24,24.6 32,29.2 32,38.4 24,33.8" fill="#D9A600" />
        <polygon points="32,29.2 40,24.6 40,33.8 32,38.4" fill="#B38900" />
      </g>
      {/* Center Key Anchor / Core (Black/Ink) */}
      <polygon points="24,24.6 32,20 24,15.4 16,20" fill="#111111" opacity="0.9" />
    </g>
  ) : (
    <g class="pyramid-group mono">
      <g class="cube-top">
        <polygon points="24,6 32,10.6 24,15.2 16,10.6" fill="currentColor" opacity="0.9" />
        <polygon points="16,10.6 24,15.2 24,24.4 16,19.8" fill="currentColor" opacity="0.65" />
        <polygon points="24,15.2 32,10.6 32,19.8 24,24.4" fill="currentColor" opacity="0.4" />
      </g>
      <g class="cube-left">
        <polygon points="16,20 24,24.6 16,29.2 8,24.6" fill="currentColor" opacity="0.85" />
        <polygon points="8,24.6 16,29.2 16,38.4 8,33.8" fill="currentColor" opacity="0.6" />
        <polygon points="16,29.2 24,24.6 24,33.8 16,38.4" fill="currentColor" opacity="0.35" />
      </g>
      <g class="cube-right">
        <polygon points="32,20 40,24.6 32,29.2 24,24.6" fill="currentColor" opacity="0.85" />
        <polygon points="24,24.6 32,29.2 32,38.4 24,33.8" fill="currentColor" opacity="0.6" />
        <polygon points="32,29.2 40,24.6 40,33.8 32,38.4" fill="currentColor" opacity="0.35" />
      </g>
      <polygon points="24,24.6 32,20 24,15.4 16,20" fill="currentColor" opacity="0.2" />
    </g>
  )}
</svg>

<style>
  .cube-pyramid {
    display: inline-block;
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cube-pyramid:hover {
    transform: scale(1.06) translateY(-1px);
  }
</style>
