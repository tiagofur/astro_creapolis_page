---
import { getAboutData } from '../../i18n/data/about';
import type { Lang } from '../../i18n/ui';
import { getLocalizedPath, useTranslations } from '../../i18n/utils';
import CmyDots from '../brand/CmyDots.astro';
import Footer from '../Footer.astro';
import Nav from '../Nav.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const { timeline, values, stack, heroChips, ops } = getAboutData(lang);

const ACCENTS = ['var(--c-cyan)', 'var(--c-magenta)', 'var(--c-yellow)', 'var(--key)'] as const;

const links = {
  linkedin: null as string | null,
  github: null as string | null,
  twitter: null as string | null,
};

const opsIcons: Record<string, string> = {
  repo: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>',
  ci: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>',
  docs: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  backup:
    '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 6v6l4 2"/></svg>',
  handover:
    '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>',
  support:
    '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
};
---

<Nav lang={lang} />

<header class="s-hero">
  <div class="wrap reveal">
    <div class="hero-eyebrow">
      <CmyDots size={4} />
      <span>{t('about.eyebrow')}</span>
    </div>
    <div class="chips-row">
      <span class="chip live"><span class="chip-dot"></span>{heroChips.dev}</span>
      <span class="chip">{heroChips.location}</span>
    </div>
    <h1>{t('about.hero.title.p1')} <span class="tone">{t('about.hero.title.p2')}</span> {t('about.hero.title.p3')}</h1>
    <p class="lead">{t('about.hero.lead')}</p>
  </div>
</header>

<section class="section portrait-section">
  <div class="wrap">
    <div class="portrait-grid">
      <div class="portrait-visual reveal">
        <div class="portrait-frame">
          <div class="portrait-placeholder" aria-label={t('about.portrait.alt')}>
            <div class="portrait-avatar">
              <span class="initial">T</span>
            </div>
            <CmyDots size={6} class="portrait-dots" />
          </div>
        </div>
        <div class="portrait-links">
          {links.linkedin && (
            <a href={links.linkedin} target="_blank" rel="noopener" class="plink">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.34 17.5V9.75H5.67v7.75h2.67zM7 8.58a1.54 1.54 0 1 0 0-3.08 1.54 1.54 0 0 0 0 3.08zM18.34 17.5v-4.24c0-2.29-1.23-3.35-2.87-3.35-1.32 0-1.91.73-2.24 1.24V9.75h-2.67v7.75h2.67v-4.33c0-1.16.22-2.29 1.66-2.29 1.42 0 1.44 1.33 1.44 2.37v4.25h2.01z"/></svg>
              LinkedIn
            </a>
          )}
          {links.github && (
            <a href={links.github} target="_blank" rel="noopener" class="plink">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.1-1.47-1.1-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.1-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.1.39-1.99 1.03-2.69-.1-.26-.45-1.28.1-2.66 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.66.64.7 1.03 1.59 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .26.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
              GitHub
            </a>
          )}
          {links.twitter && (
            <a href={links.twitter} target="_blank" rel="noopener" class="plink">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2h3.2l-7 8 8.2 12h-6.4l-5-6.6L6.2 22H3l7.5-8.6L2.6 2h6.6l4.5 6 4.2-6zm-1.1 18h1.8L7.3 4H5.4l12.4 16z"/></svg>
              X
            </a>
          )}
        </div>
      </div>

      <div class="portrait-copy reveal reveal-delay-1">
        <h2>{t('about.intro')} <span class="tone">{t('about.intro.serif')}.</span></h2>
        <p class="intro">{t('about.intro.p1')}</p>
        <p>{t('about.intro.p2')}</p>
        <p>{t('about.intro.p3')}</p>
      </div>
    </div>
  </div>
</section>

<section class="section timeline-section section-alt">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow" style="--accent-color: var(--c-cyan);"><span>{t('about.timeline.eyebrow')}</span></p>
      <h2>{t('about.timeline.title.p1')} <span class="tone">{t('about.timeline.title.serif')}.</span></h2>
      <p>{t('about.timeline.desc')}</p>
    </div>

    <div class="timeline">
      {timeline.map((item, i) => (
        <div class={`tl-item reveal${i % 2 === 1 ? ' reveal-delay-1' : ''}`} style={`--tl-accent: ${ACCENTS[i % 3]}`}>
          <div class="tl-year">{item.year}</div>
          <div class="tl-body">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow" style="--accent-color: var(--c-magenta);"><span>{t('about.values.eyebrow')}</span></p>
      <h2>{t('about.values.title.p1')} <span class="tone">{t('about.values.title.serif')}.</span></h2>
      <p>{t('about.values.desc')}</p>
    </div>

    <div class="values-grid">
      {values.map((v, i) => (
        <div class={`value-card reveal${i === 1 ? ' reveal-delay-1' : ''}${i === 2 ? ' reveal-delay-2' : ''}`} style={`--accent-color: ${ACCENTS[i % 3]}`}>
          <div class="v-letter">
            <span class="v-dot" aria-hidden="true"></span>
            {v.letter}
          </div>
          <h3>{v.title}</h3>
          <p>{v.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section ops-section section-alt">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow" style="--accent-color: var(--c-yellow);"><span>{t('about.ops.eyebrow')}</span></p>
      <h2>{t('about.ops.title.p1')} <span class="tone">{t('about.ops.title.serif')}.</span></h2>
      <p>{t('about.ops.desc')}</p>
    </div>

    <div class="ops-grid">
      {ops.map((op, i) => (
        <div class={`ops-card reveal${i % 2 === 1 ? ' reveal-delay-1' : ''}`} style={`--accent-color: ${ACCENTS[i % 3]}`}>
          <div class="ops-icon" set:html={opsIcons[op.icon] || ''} />
          <h3>{op.title}</h3>
          <p>{op.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section stack-section">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow" style="--accent-color: var(--c-cyan);"><span>{t('about.stack.eyebrow')}</span></p>
      <h2>{t('about.stack.title.p1')} <span class="tone">{t('about.stack.title.serif')}.</span></h2>
      <p>{t('about.stack.desc')}</p>
    </div>

    <div class="stack-grid">
      {stack.map((group, i) => (
        <div class={`stack-group reveal${i === 1 ? ' reveal-delay-1' : ''}${i === 2 ? ' reveal-delay-2' : ''}`} style={`--accent-color: ${ACCENTS[i % 3]}`}>
          <div class="sg-label">{group.group}</div>
          <div class="sg-chips">
            {group.items.map((item) => <span class="sg-chip">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="contact-cta">
  <div class="wrap">
    <div class="cta-card reveal">
      <div class="cta-glow cta-glow-magenta" aria-hidden="true"></div>
      <div class="cta-glow cta-glow-cyan" aria-hidden="true"></div>
      <h2>{t('about.cta.title.p1')} <span class="tone">{t('about.cta.title.serif')}{t('about.cta.title.p2')}</span></h2>
      <p class="lead">{t('about.cta.lead')}</p>
      <div class="cta-row">
        <a href={getLocalizedPath(lang, '/contacto')} class="cta-btn-primary">{t('about.cta.btn')}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </a>
        <a href="mailto:hola@creapolis.dev" class="cta-btn-email">hola@creapolis.dev</a>
      </div>
    </div>
  </div>
</section>

<Footer lang={lang} />

<style>
  .tone { color: var(--ink-4); }

  /* ─── Hero ─────────────────────────────────────────────────────────── */
  .s-hero {
    padding: 168px var(--gutter) 72px;
    background: var(--paper);
  }
  .s-hero .wrap {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: var(--ls-mono);
    color: var(--ink-3);
  }
  .chips-row {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .s-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4.4rem);
    line-height: 1.05;
    letter-spacing: var(--ls-display);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .s-hero p.lead {
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.6;
    color: var(--ink-3);
    max-width: 58ch;
    margin: 0;
    text-wrap: pretty;
  }

  /* ─── Sections ─────────────────────────────────────────────────────── */
  .section {
    padding: clamp(72px, 9vw, 120px) 0;
  }
  .section-alt {
    background: var(--chalk);
  }
  .section .wrap { max-width: var(--max); margin: 0 auto; }

  .section-head {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 48px;
  }
  .section-head h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: var(--fw-semibold);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .section-head p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-3);
    max-width: 56ch;
  }

  /* ─── Portrait ─────────────────────────────────────────────────────── */
  .portrait-grid {
    display: grid;
    gap: 48px;
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 880px) {
    .portrait-grid { grid-template-columns: 320px 1fr; gap: 64px; }
  }
  .portrait-frame {
    aspect-ratio: 1;
    border-radius: var(--r-xl);
    border: 1px solid var(--line);
    background: #ffffff;
    overflow: hidden;
  }
  .portrait-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    background: var(--chalk);
  }
  .portrait-avatar {
    display: grid;
    place-items: center;
    width: 120px;
    height: 120px;
    border-radius: var(--r-lg);
    background: #09090b;
  }
  .portrait-avatar .initial {
    font-size: 3.4rem;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.03em;
    line-height: 1;
    color: #ffffff;
  }
  .portrait-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .plink {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px;
    font-size: 0.85rem;
    font-weight: var(--fw-medium);
    color: var(--ink-2);
    background: #ffffff;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .plink:hover {
    color: var(--ink);
    border-color: #d4d4d8;
    background: var(--chalk);
  }
  .portrait-copy h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: var(--fw-semibold);
    color: var(--ink);
    margin: 0 0 24px;
    text-wrap: balance;
  }
  .portrait-copy p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-3);
    margin: 0 0 16px;
    max-width: 58ch;
  }
  .portrait-copy p.intro {
    font-size: 1.08rem;
    color: var(--ink-2);
  }

  /* ─── Timeline — zai left rule + accent dots ───────────────────────── */
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 760px;
    padding-left: 24px;
    border-left: 1px solid rgba(0, 0, 0, 0.08);
  }
  .tl-item {
    position: relative;
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 24px;
  }
  .tl-item::before {
    content: '';
    position: absolute;
    left: -28px;
    top: 6px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tl-accent);
    border: 2px solid var(--paper);
    box-shadow: 0 0 0 1px var(--line);
  }
  .tl-year {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: var(--fw-medium);
    color: var(--ink-4);
    line-height: 1.4;
    padding-top: 2px;
  }
  .tl-body h3 {
    font-size: 1.08rem;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.01em;
    margin: 0 0 6px;
    color: var(--ink);
  }
  .tl-body p {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--ink-3);
    margin: 0;
  }

  /* ─── Values ───────────────────────────────────────────────────────── */
  .values-grid {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    overflow: hidden;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .values-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .value-card {
    padding: 28px;
    background: #ffffff;
    border-top: var(--accent-bar) solid var(--accent-color);
  }
  .v-letter {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 1.9rem;
    font-weight: var(--fw-medium);
    color: var(--ink);
    line-height: 1;
    margin-bottom: 14px;
  }
  .v-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-color);
  }
  .value-card h3 {
    font-size: 1.12rem;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.015em;
    margin: 0 0 8px;
    color: var(--ink);
  }
  .value-card p {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--ink-3);
    margin: 0;
  }

  /* ─── Ops — tinted icon tiles cycling CMYK ─────────────────────────── */
  .ops-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .ops-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .ops-grid { grid-template-columns: repeat(3, 1fr); } }

  .ops-card {
    padding: 26px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .ops-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-hover);
  }
  .ops-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--accent-color) 8%, transparent);
    border-radius: var(--r-lg);
    color: var(--ink);
    margin-bottom: 16px;
  }
  .ops-card h3 {
    font-size: 1.02rem;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.01em;
    margin: 0 0 8px;
    color: var(--ink);
  }
  .ops-card p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-3);
    margin: 0;
  }

  /* ─── Stack — light mono chips ─────────────────────────────────────── */
  .stack-grid {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .stack-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .stack-grid { grid-template-columns: repeat(4, 1fr); } }
  .stack-group {
    border-top: var(--accent-bar) solid var(--accent-color);
    padding-top: 18px;
  }
  .sg-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: var(--ls-mono);
    color: var(--ink-4);
    margin-bottom: 14px;
  }
  .sg-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sg-chip {
    padding: 5px 12px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-2);
    background: #ffffff;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
  }

  /* ─── Final CTA — the one dark card ────────────────────────────────── */
  .contact-cta {
    padding: 24px var(--gutter) 96px;
  }
  .contact-cta .wrap {
    max-width: var(--max);
    margin: 0 auto;
  }
  .cta-card {
    position: relative;
    background: #09090b;
    color: #ffffff;
    border-radius: var(--r-mega);
    padding: clamp(48px, 7vw, 80px) clamp(24px, 5vw, 64px);
    text-align: center;
    overflow: hidden;
  }
  .cta-glow {
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.25;
    pointer-events: none;
  }
  .cta-glow-magenta {
    background: radial-gradient(circle, #ec008c, transparent 65%);
    top: -160px;
    left: -80px;
  }
  .cta-glow-cyan {
    background: radial-gradient(circle, #00aeef, transparent 65%);
    bottom: -160px;
    right: -80px;
  }
