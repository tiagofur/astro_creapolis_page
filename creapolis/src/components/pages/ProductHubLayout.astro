---
import '../../styles/tokens.css';
import '../../styles/global.css';
import { getProduct } from '../../i18n/data/products';
import type { Lang } from '../../i18n/ui';
import { getLocalizedPath, getAlternateLink, useTranslations } from '../../i18n/utils';
import CookieConsent from '../CookieConsent.astro';
import Footer from '../Footer.astro';
import Nav from '../Nav.astro';

type Accent = 'iris' | 'lime' | 'sky' | 'coral';

interface Props {
  lang: Lang;
  slug: string;
  currentPage:
    | 'overview'
    | 'guide'
    | 'tips'
    | 'support'
    | 'changelog'
    | 'privacy';
  accent?: Accent;
  title?: string;
  description?: string;
  ogImage?: string;
}

const { lang, slug, currentPage, accent, title, description, ogImage } = Astro.props;
const t = useTranslations(lang);
const product = getProduct(slug);

if (!product) {
  return Astro.redirect(getLocalizedPath(lang, '/proyectos'));
}

// ─── V3 CMYK accents ────────────────────────────────────────────────
// One accent per product: solennix=cyan, pepinillo=yellow,
// peliculas=magenta, subscription-guardian=key(ink).
// `deep` is the text-safe shade for small text/glyphs on white.
const productAccent: Record<string, { css: string; soft: string; deep: string }> = {
  solennix: { css: 'var(--sol-accent)', soft: 'var(--sol-soft)', deep: 'var(--c-cyan-3)' },
  pepinillo: { css: 'var(--pep-accent)', soft: 'var(--pep-soft)', deep: 'var(--c-yellow-3)' },
  peliculas: { css: 'var(--pel-accent)', soft: 'var(--pel-soft)', deep: 'var(--c-magenta-3)' },
  'subscription-guardian': { css: 'var(--sg-accent)', soft: 'var(--sg-soft)', deep: 'var(--ink-2)' },
};

// Legacy accent prop names → same V3 product accents
const legacyAccent: Record<Accent, { css: string; soft: string; deep: string }> = {
  iris: productAccent.solennix,
  lime: productAccent.pepinillo,
  sky: productAccent['subscription-guardian'],
  coral: productAccent.peliculas,
};

const resolvedAccent = (accent && legacyAccent[accent]) || productAccent[slug] || legacyAccent.iris;

// SEO
const pageLabel = currentPage === 'overview' ? '' : t(`hub.nav.${currentPage}`);
const fullTitle = title
  || (pageLabel ? `${pageLabel} — ${product.name}` : `${product.name} — Creapolis`);
const fullDescription = description || product.seo.description;
const fullOgImage = ogImage || product.seo.ogImage;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const htmlLang = lang === 'en' ? 'en' : lang === 'pt' ? 'pt' : 'es';
const ogLocale = lang === 'en' ? 'en_US' : lang === 'pt' ? 'pt_BR' : 'es_MX';

// Build sidebar items from product resources + overview
const sidebarItems: {
  type: string;
  label: string;
  href: string;
  icon: string;
  available: boolean;
}[] = [
  {
    type: 'overview',
    label: t('hub.nav.overview'),
    href: getLocalizedPath(lang, `/proyectos/${slug}`),
    icon: '🏠',
    available: true,
  },
  ...product.resources.map((r) => ({
    type: r.type,
    label: t(`hub.nav.${r.type}`),
    href: getLocalizedPath(lang, `/proyectos/${slug}/${r.type}`),
    icon: r.icon,
    available: r.available,
  })),
];

// Only show available pages
const visibleItems = sidebarItems.filter((item) => item.available);
---

<!DOCTYPE html>
<html lang={htmlLang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={fullDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    {getAlternateLink(Astro.url).map(({ lang: l, href }) => {
      const hreflang = l === 'es' ? 'es-MX' : l === 'pt' ? 'pt-BR' : 'en-US';
      return <link rel="alternate" hreflang={hreflang} href={new URL(href, Astro.site).href} />;
    })}
    <link rel="alternate" hreflang="x-default" href={new URL('/es/', Astro.site).href} />

    <meta property="og:title" content={fullTitle.includes('Creapolis') ? fullTitle : `${fullTitle} — Creapolis`} />
    <meta property="og:description" content={fullDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Creapolis" />
    <meta property="og:image" content={new URL(fullOgImage, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={fullDescription} />
    <meta name="twitter:image" content={new URL(fullOgImage, Astro.site).href} />

    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Creapolis Blog RSS" href="/rss.xml" />

    <title>{fullTitle.includes('Creapolis') ? fullTitle : `${fullTitle} — Creapolis`}</title>
  </head>
  <body>
    <a href="#hub-content" class="skip-link">{lang === 'en' ? 'Skip to content' : lang === 'pt' ? 'Pular para o conteúdo' : 'Saltar al contenido'}</a>

    <Nav lang={lang} />

    <div class="hub-shell" style={`--hub-accent: ${resolvedAccent.css}; --hub-accent-soft: ${resolvedAccent.soft}; --hub-accent-3: ${resolvedAccent.deep};`}>
      <!-- Sidebar -->
      <aside class="hub-sidebar" aria-label="Product navigation">
        <div class="hub-sidebar-inner">
          <a href={getLocalizedPath(lang, `/proyectos/${slug}`)} class="hub-product-link">
            <span class="hub-product-icon">
              {product.name.charAt(0)}
            </span>
            <span class="hub-product-name">{product.name}</span>
          </a>

          <nav class="hub-nav" aria-label="Sections">
            {visibleItems.map((item) => (
              <a
                href={item.href}
                class={`hub-nav-item ${item.type === currentPage ? 'active' : ''}`}
                aria-current={item.type === currentPage ? 'page' : undefined}
              >
                <span class="hub-nav-icon">{item.icon}</span>
                <span class="hub-nav-label">{item.label}</span>
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <!-- Main content -->
      <div class="hub-main">
        <!-- Breadcrumbs -->
        <nav class="hub-breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li>
              <a href={getLocalizedPath(lang, '/proyectos')}>{t('hub.breadcrumb.projects')}</a>
            </li>
            <li>
              <a href={getLocalizedPath(lang, `/proyectos/${slug}`)}>{product.name}</a>
            </li>
            {currentPage !== 'overview' && (
              <li aria-current="page">
                {t(`hub.nav.${currentPage}`)}
              </li>
            )}
            {currentPage === 'overview' && (
              <li aria-current="page">
                {t('hub.nav.overview')}
              </li>
            )}
          </ol>
        </nav>

        <div class="hub-content" id="hub-content">
          <slot />
        </div>
      </div>
    </div>

    <Footer lang={lang} />
    <CookieConsent />
  </body>
</html>

<style is:global>
  .hub-shell {
    display: grid;
    grid-template-columns: 248px 1fr;
    min-height: 100vh;
    padding-top: 72px; /* nav height */
    background: var(--paper);
  }

  /* ─── Sidebar — sticky left nav, mono uppercase labels ─── */
  .hub-sidebar {
    position: sticky;
    top: 72px;
    height: calc(100vh - 72px);
    overflow-y: auto;
    border-right: 1px solid var(--line);
    background: var(--paper);
    z-index: 10;
  }

  .hub-sidebar-inner {
    padding: 28px 20px;
  }

  .hub-product-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  /* Tinted icon tile — accent-soft bg + text-safe glyph shade */
  .hub-product-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--r-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: var(--fw-medium);
    font-size: 0.9rem;
    color: var(--hub-accent-3, var(--ink));
    background: var(--hub-accent-soft, var(--chalk));
    border: 1px solid var(--line);
    flex-shrink: 0;
  }

  .hub-product-name {
    font-weight: var(--fw-semibold);
    font-size: 0.9rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .hub-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hub-nav-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px 9px 14px;
    border-radius: var(--r-sm);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-3);
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }

  /* 3px accent left bar */
  .hub-nav-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 14px;
    border-radius: 2px;
    background: transparent;
    transition: background 0.2s var(--ease);
  }

  .hub-nav-item:hover {
    background: var(--chalk);
    color: var(--ink);
  }

  .hub-nav-item.active {
    background: var(--chalk);
    color: var(--ink);
  }

  .hub-nav-item.active::before {
    background: var(--hub-accent, var(--ink));
  }

  .hub-nav-icon {
    font-size: 12px;
    width: 18px;
    text-align: center;
    flex-shrink: 0;
    opacity: 0.85;
  }

  /* ─── Main — white content column ─────────────────── */
  .hub-main {
    min-height: 100vh;
    background: var(--paper);
  }

  .hub-content {
    max-width: 760px;
    margin: 0 auto;
    padding: 40px var(--gutter) 100px;
  }

  /* ─── Breadcrumbs — mono 11px ─────────────────────── */
  .hub-breadcrumbs {
    padding: 20px var(--gutter) 0;
    max-width: 760px;
    margin: 0 auto;
    border-bottom: 1px solid var(--line);
  }

  .hub-breadcrumbs ol {
    display: flex;
    align-items: center;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-4);
  }

  .hub-breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .hub-breadcrumbs li:not(:last-child)::after {
    content: '/';
    color: var(--ink-4);
  }

  .hub-breadcrumbs a {
    color: var(--ink-4);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .hub-breadcrumbs a:hover {
    color: var(--ink);
  }

  .hub-breadcrumbs [aria-current='page'] {
    color: var(--ink-3);
  }

  /* ─── Mobile — horizontal scrollable chip row ─────── */
  @media (max-width: 768px) {
    .hub-shell {
      grid-template-columns: 1fr;
    }

    .hub-sidebar {
      position: static;
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--line);
    }

    .hub-sidebar-inner {
      padding: 14px 16px;
    }

    .hub-product-link {
      margin-bottom: 14px;
      padding-bottom: 14px;
    }

    .hub-nav {
      flex-direction: row;
      overflow-x: auto;
      gap: 6px;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 2px;
    }

    .hub-nav-item {
      white-space: nowrap;
      padding: 7px 12px;
      border: 1px solid var(--line-2);
      border-radius: var(--r-pill);
      background: #ffffff;
    }

    .hub-nav-item::before {
      /* no room for the bar inside chips — accent dot instead */
      width: 6px;
      height: 6px;
      border-radius: 50%;
      top: 50%;
      transform: translateY(-50%);
    }

    .hub-nav-item.active {
      background: var(--ink);
      border-color: var(--ink);
      color: #ffffff;
    }

    .hub-nav-item.active::before {
      background: var(--hub-accent, #ffffff);
    }

    .hub-nav-icon {
      display: none;
    }

    .hub-breadcrumbs ol {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .hub-breadcrumbs ol::-webkit-scrollbar {
      display: none;
    }

    .hub-content {
      padding: 28px var(--gutter) 80px;
    }
  }
</style>
