---
import { getSolennixSupportData } from '../../i18n/data/solennix-support';
import type { Lang } from '../../i18n/ui';
import { getLocalizedPath } from '../../i18n/utils';
import SupportLayout from './SupportLayout.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getSolennixSupportData(lang);

const base = '/proyectos/solennix';
const nav = [
  { label: d.nav.features, href: getLocalizedPath(lang, base) + '#features' },
  { label: d.nav.guide, href: getLocalizedPath(lang, base + '/guide') },
  { label: d.nav.tips, href: getLocalizedPath(lang, base + '/tips') },
  { label: d.nav.support, href: getLocalizedPath(lang, base + '/feedback') },
];
const cta = { text: d.cta, href: getLocalizedPath(lang, base) };
---

<SupportLayout lang={lang} nav={nav} cta={cta} accent="iris"><slot /></SupportLayout>
