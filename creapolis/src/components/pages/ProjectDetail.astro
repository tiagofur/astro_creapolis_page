---
import { getProjectData } from '../../i18n/data/projects';
import type { Lang } from '../../i18n/ui';
import { getLocalizedPath, useTranslations } from '../../i18n/utils';
import Footer from '../Footer.astro';
import Nav from '../Nav.astro';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const t = useTranslations(lang);
const project = getProjectData(lang, slug);

if (!project) {
  return Astro.redirect(getLocalizedPath(lang, '/proyectos'));
}

const gradientId = `prib-${slug}`;
---

<Nav lang={lang} />

<header class="p-hero" style={`--p-color: ${project.color}; --p-soft: ${project.colorSoft}`}>
  <div class="ribbon" aria-hidden="true">
    <svg viewBox="0 0 1400 800" preserveAspectRatio="none">
      <defs>
        <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
          {project.ribbonStops.map((s) => (
            <stop offset={s.offset} stop-color={s.color} stop-opacity={s.opacity} />
          ))}
        </linearGradient>
      </defs>
      <path d="M -100,500 C 300,300 500,650 800,400 C 1100,150 1300,550 1500,300" fill="none" stroke={`url(#${gradientId})`} stroke-width="100" stroke-linecap="round"/>
    </svg>
  </div>

  <div class="wrap">
    <a href={getLocalizedPath(lang, '/proyectos')} class="back-link reveal">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M10 12L6 8M6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      {t('project.back')}
    </a>

    <div class="hero-grid">
      <div class="hero-copy reveal reveal-delay-1">
        <div class="chips-row">
          <span class="chip live"><span class="chip-dot"></span>{t('project.chip.live')}</span>
          <span class="chip proj-chip">{t('project.chip.by')}</span>
        </div>
        <h1>
          <span class="serif">{project.name}.</span><br/>
          {project.headline}<br/>
          <span class="accent">{project.headlineAccent}</span>
        </h1>
        <p class="tag">{project.lead}</p>

        <div class="stores">
          {project.storeLinks.apple && (
            <a class="store" href={project.storeLinks.apple} target="_blank" rel="noopener">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.05 12.04a4.4 4.4 0 0 1 2.1-3.7 4.5 4.5 0 0 0-3.55-1.92c-1.5-.15-2.94.88-3.7.88-.78 0-1.95-.86-3.22-.84a4.72 4.72 0 0 0-3.98 2.42c-1.7 2.95-.43 7.3 1.22 9.7.8 1.17 1.76 2.48 3.02 2.44 1.22-.05 1.68-.78 3.15-.78 1.46 0 1.88.78 3.17.75 1.31-.02 2.14-1.18 2.94-2.36a10.5 10.5 0 0 0 1.34-2.73 4.25 4.25 0 0 1-2.49-3.86zM14.5 5.25a4.3 4.3 0 0 0 1-3.25 4.47 4.47 0 0 0-2.9 1.5 4.16 4.16 0 0 0-1.02 3.15 3.67 3.67 0 0 0 2.92-1.4z"/></svg>
              <span><span class="small">{t('project.download.store.small')}</span><span class="big">App Store</span></span>
            </a>
          )}
          {project.storeLinks.google && (
            <a class="store" href={project.storeLinks.google} target="_blank" rel="noopener">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 1.9C3.2 2.1 3 2.5 3 3v18c0 .5.2.9.6 1.1l10.5-10.2L3.6 1.9zm12 10.6l2.7 2.6-3.8 2.2-2-1.9 3.1-2.9zm0-1.9l-3-2.9 2.4-1.4 3.4 2-2.8 2.3zM4.7 2.4l10.2 10-10.2 10v-20z"/></svg>
              <span><span class="small">{t('project.download.store.small')}</span><span class="big">Google Play</span></span>
            </a>
          )}
        </div>
      </div>

      <div class="phone-wrap reveal reveal-delay-2">
        <div class="phone">
          <div class="phone-screen">
            <div class="ps-head">
              <div>
                <h4>{project.mockup.headTitle}</h4>
                <div class="sub">{project.mockup.headSub}</div>
              </div>
              <div class="ps-avatar" style={`background: ${project.color}`}></div>
            </div>
            <div class="ps-stats">
              {project.mockup.stats.map((s) => (
                <div class="ps-stat"><div class="v">{s.v}</div><div class="l">{s.l}</div></div>
              ))}
            </div>
            <div class="ps-label">{project.mockup.listLabel}</div>
            <div class="ps-list">
              {project.mockup.listItems.map((it) => (
                <div class="ps-item"><span class="dot" style={`background: ${it.color}`}></span><span class="name">{it.name}</span><span class="date">{it.tag}</span></div>
              ))}
            </div>
          </div>
        </div>
        <div class="phone-glow" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</header>

<section class="info-strip">
  <div class="row wrap">
    <div class="info-cell"><div class="v">{project.platform}</div><div class="l">{t('project.info.platform')}</div></div>
    <div class="info-cell"><div class="v">{project.category}</div><div class="l">{t('project.info.category')}</div></div>
    <div class="info-cell"><div class="v">{project.languages}</div><div class="l">{t('project.info.languages')}</div></div>
    <div class="info-cell"><div class="v">{project.price ?? t('project.info.free')}</div><div class="l">{t('project.info.price')}</div></div>
  </div>
</section>

<section id="features" class="section">
  <div class="wrap">
    <div class="products-header">
      <div class="reveal">
        <div class="eyebrow" style="margin-bottom:18px"><span>{project.featureLabel}</span></div>
        <h2>{t('project.features.title.p1')} <span class="serif">{t('project.features.title.serif')}</span>{t('project.features.title.p2')}</h2>
      </div>
      <p class="reveal reveal-delay-1">{t('project.features.lead')}</p>
    </div>

    <div class="features">
      {project.features.map((feature, i) => (
        <div class={`feature reveal${i === 1 ? ' reveal-delay-1' : ''}${i === 2 ? ' reveal-delay-2' : ''}`}>
          <div class="icon" style={`--accent-color: ${project.color}`}>{feature.letter}</div>
          <h3>{feature.title}</h3>
          <p>{feature.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section case-study" style="background: var(--chalk)">
  <div class="wrap">
    <div class="case-head reveal">
      <div class="eyebrow" style="margin-bottom:16px"><span>{t('project.case.eyebrow')}</span></div>
      <h2>{t('project.case.title.p1')} <span class="serif">{t('project.case.title.serif')}</span>.</h2>
    </div>

    <div class="case-grid">
      {project.story.map((chapter, i) => (
        <div class={`case-block reveal${i === 1 ? ' reveal-delay-1' : ''}${i === 2 ? ' reveal-delay-2' : ''}`}>
          <div class="case-num" style={`color: ${project.color}`}>{String(i + 1).padStart(2, '0')}</div>
          <h3>{chapter.title}</h3>
          <p>{chapter.text}</p>
        </div>
      ))}
    </div>

    <div class="tech-block reveal">
      <div class="eyebrow" style="margin-bottom:14px"><span>{t('project.case.stack')}</span></div>
      <div class="tech-chips">
        {project.tech.map((tech) => (
          <span class="tech-chip" style={`--accent-color: ${project.color}`}>{tech}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="download">
  <div class="wrap reveal">
    <div class="eyebrow" style="margin-bottom:16px; color: var(--ink-3)"><span>{t('project.download.eyebrow')}</span></div>
    <h2>{t('project.download.title.p1')} <span class="serif">{t('project.download.title.serif')}</span>.</h2>
    <p>{t('project.download.desc')}</p>
    <div class="download-btns">
      {project.storeLinks.apple && (
        <a class="store" href={project.storeLinks.apple} target="_blank" rel="noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 12.04a4.4 4.4 0 0 1 2.1-3.7 4.5 4.5 0 0 0-3.55-1.92c-1.5-.15-2.94.88-3.7.88-.78 0-1.95-.86-3.22-.84a4.72 4.72 0 0 0-3.98 2.42c-1.7 2.95-.43 7.3 1.22 9.7.8 1.17 1.76 2.48 3.02 2.44 1.22-.05 1.68-.78 3.15-.78 1.46 0 1.88.78 3.17.75 1.31-.02 2.14-1.18 2.94-2.36a10.5 10.5 0 0 0 1.34-2.73 4.25 4.25 0 0 1-2.49-3.86zM14.5 5.25a4.3 4.3 0 0 0 1-3.25 4.47 4.47 0 0 0-2.9 1.5 4.16 4.16 0 0 0-1.02 3.15 3.67 3.67 0 0 0 2.92-1.4z"/></svg>
          <span><span class="small">{t('project.download.store.small')}</span><span class="big">App Store</span></span>
        </a>
      )}
      {project.storeLinks.google && (
        <a class="store" href={project.storeLinks.google} target="_blank" rel="noopener">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M3.6 1.9C3.2 2.1 3 2.5 3 3v18c0 .5.2.9.6 1.1l10.5-10.2L3.6 1.9z"/></svg>
          <span><span class="small">{t('project.download.store.small')}</span><span class="big">Google Play</span></span>
        </a>
      )}
    </div>
  </div>
</section>

{project.resources && (
  <section class="section resources-section">
    <div class="wrap">
      <div class="reveal" style="margin-bottom:48px">
        <div class="eyebrow" style="margin-bottom:16px"><span>{t('project.resources.eyebrow')}</span></div>
        <h2>{t('project.resources.title.p1')} <span class="serif">{project.name}</span>.</h2>
      </div>
      <div class="resources-grid">
        {project.resources.map((r) => (
          <a href={getLocalizedPath(lang, r.href)} class="resource-card reveal">
            <div class="res-icon">{r.icon}</div>
            <div>
              <h3>{r.title}</h3>
              <p>{r.desc}</p>
              <span class="res-link">{t('project.resources.read')}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<section id="contacto" class="contact-cta">
  <div class="wrap">
    <div class="contact-card reveal">
      <div class="eyebrow" style="margin-bottom:16px"><span>{t('project.cta.eyebrow')}</span></div>
      <h2>{t('project.cta.title.p1')} <span class="serif">{t('project.cta.title.serif')}</span>{t('project.cta.title.p2')}</h2>
      <p class="lead">{t('project.cta.lead')}</p>
      <div class="cta-row">
        <a href={getLocalizedPath(lang, '/contacto')} class="btn btn-primary btn-lg">{t('project.cta.primary')}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </a>
        <a href={getLocalizedPath(lang, '/proyectos')} class="btn btn-ghost btn-lg">{t('project.cta.secondary')}</a>
      </div>
    </div>
  </div>
</section>

<Footer lang={lang} />

<style>
  .p-hero {
    position: relative;
    overflow: clip;
    padding: 120px var(--gutter) clamp(60px, 8vw, 100px);
    background: radial-gradient(60% 50% at 50% 0%, var(--p-soft) 0%, transparent 60%), var(--paper);
  }
  .p-hero .ribbon { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .p-hero .ribbon svg { width: 100%; height: 100%; }
  .p-hero .wrap { position: relative; z-index: 1; max-width: var(--max); margin: 0 auto; }

  .back-link {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: 0.78rem;
    font-weight: 500; color: var(--ink-3);
    text-transform: uppercase; letter-spacing: 0.06em;
    margin-bottom: 32px;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--p-color); }

  .hero-grid { display: grid; gap: 48px; grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 960px) { .hero-grid { grid-template-columns: 1.15fr 1fr; gap: 64px; } }

  .chips-row { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 24px; }
  .proj-chip { color: var(--p-color); background: var(--p-soft); border-color: color-mix(in oklch, var(--p-color) 25%, var(--line)); }

  .hero-copy h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); line-height: 1; letter-spacing: -0.025em; color: var(--ink); margin: 0 0 20px; text-wrap: balance; }
  .hero-copy h1 .serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--p-color); }
  .hero-copy h1 .accent { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--ink-2); }
  .hero-copy .tag { font-size: 1.1rem; line-height: 1.55; color: var(--ink-2); max-width: 48ch; margin: 0 0 32px; }

  .stores { display: flex; flex-wrap: wrap; gap: 12px; }
  .store {
    display: inline-flex; align-items: center; gap: 12px;
    padding: 10px 18px;
    background: var(--ink); color: var(--paper);
    border-radius: var(--r-md);
    text-decoration: none;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .store:hover { transform: translateY(-2px); box-shadow: var(--sh-3); }
  .store .small { display: block; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.75; }
  .store .big { display: block; font-size: 1.02rem; font-weight: 500; }

  .phone-wrap { position: relative; display: flex; justify-content: center; }
  .phone-glow { position: absolute; inset: -20%; background: radial-gradient(circle, var(--p-color) 0%, transparent 60%); opacity: 0.18; z-index: 0; pointer-events: none; }
  .phone {
    position: relative; z-index: 1;
    width: 100%; max-width: 320px;
    aspect-ratio: 9 / 18;
    background: var(--ink);
    border-radius: 40px;
    padding: 14px;
    box-shadow: var(--sh-3);
  }
  .phone-screen {
    width: 100%; height: 100%;
    background: var(--paper);
    border-radius: 28px;
    padding: 22px 18px;
    display: flex; flex-direction: column; gap: 16px;
    overflow: hidden;
  }
  .ps-head { display: flex; justify-content: space-between; align-items: center; }
  .ps-head h4 { font-family: var(--font-serif); font-style: italic; font-size: 1.5rem; margin: 0; color: var(--ink); }
  .ps-head .sub { font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 2px; }
  .ps-avatar { width: 34px; height: 34px; border-radius: 999px; opacity: 0.9; }
  .ps-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .ps-stat { background: var(--chalk); border-radius: var(--r-sm); padding: 10px 8px; text-align: center; }
  .ps-stat .v { font-family: var(--font-serif); font-style: italic; font-size: 1.2rem; color: var(--ink); line-height: 1; }
  .ps-stat .l { font-family: var(--font-mono); font-size: 0.6rem; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 4px; }
  .ps-label { font-family: var(--font-mono); font-size: 0.66rem; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.08em; }
  .ps-list { display: flex; flex-direction: column; gap: 8px; }
  .ps-item { display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: var(--chalk); border-radius: var(--r-sm); }
  .ps-item .dot { width: 8px; height: 8px; border-radius: 999px; flex-shrink: 0; }
  .ps-item .name { flex: 1; font-size: 0.82rem; color: var(--ink); }
  .ps-item .date { font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-3); }

  .info-strip { background: var(--ink); color: var(--paper); padding: 28px var(--gutter); }
  .info-strip .row { max-width: var(--max); margin: 0 auto; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px 32px; }
  @media (min-width: 720px) { .info-strip .row { grid-template-columns: repeat(4, 1fr); } }
  .info-cell .v { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.2rem, 2vw, 1.5rem); line-height: 1; color: var(--paper); }
  .info-cell .l { font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: oklch(0.72 0.01 265); margin-top: 6px; }

  .section { padding: clamp(64px, 9vw, 120px) var(--gutter); position: relative; }
  .section .wrap { max-width: var(--max); margin: 0 auto; }

  .products-header { display: grid; gap: 24px; align-items: end; grid-template-columns: 1fr; margin-bottom: 56px; }
  @media (min-width: 760px) { .products-header { grid-template-columns: 1.4fr 1fr; gap: 48px; } }
  .products-header h2 { font-size: clamp(2rem, 3.8vw, 3.2rem); line-height: 1.05; letter-spacing: -0.02em; color: var(--ink); margin: 0; text-wrap: balance; }
  .products-header h2 .serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--p-color); }
  .products-header p { color: var(--ink-2); font-size: 1rem; line-height: 1.55; max-width: 40ch; margin: 0; }

  .features { display: grid; gap: 20px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .features { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .features { grid-template-columns: repeat(3, 1fr); } }

  .feature { padding: 28px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-lg); transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease); }
  .feature:hover { transform: translateY(-3px); box-shadow: var(--sh-2); border-color: var(--p-color); }
  .feature .icon {
    --accent-color: var(--p-color);
    width: 48px; height: 48px;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-serif); font-style: italic; font-size: 1.6rem;
    color: var(--accent-color);
    background: color-mix(in oklch, var(--accent-color) 14%, var(--paper));
    border-radius: var(--r-md);
    margin-bottom: 16px;
  }
  .feature h3 { font-size: 1.1rem; line-height: 1.3; margin: 0 0 8px; color: var(--ink); }
  .feature p { font-size: 0.92rem; line-height: 1.55; color: var(--ink-2); margin: 0; }

  .case-head { max-width: 640px; margin-bottom: 56px; }
  .case-head h2 { font-size: clamp(2rem, 3.8vw, 3rem); line-height: 1.05; letter-spacing: -0.02em; color: var(--ink); margin: 0; text-wrap: balance; }
  .case-head h2 .serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--p-color); }

  .case-grid { display: grid; gap: 32px; grid-template-columns: 1fr; margin-bottom: 64px; }
  @media (min-width: 800px) { .case-grid { grid-template-columns: repeat(3, 1fr); } }

  .case-block { padding: 28px; border-top: 2px solid var(--line); }
  .case-num { font-family: var(--font-serif); font-style: italic; font-size: 3rem; line-height: 1; margin-bottom: 16px; }
  .case-block h3 { font-size: 1.15rem; margin: 0 0 10px; color: var(--ink); }
  .case-block p { font-size: 0.95rem; line-height: 1.6; color: var(--ink-2); margin: 0; }

  .tech-block { padding-top: 24px; border-top: 1px solid var(--line); }
  .tech-chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .tech-chip {
    --accent-color: var(--p-color);
    display: inline-flex; align-items: center;
    padding: 8px 16px;
    font-family: var(--font-mono); font-size: 0.78rem;
    color: var(--accent-color);
    background: color-mix(in oklch, var(--accent-color) 10%, var(--paper));
    border: 1px solid color-mix(in oklch, var(--accent-color) 25%, var(--line));
    border-radius: 999px;
  }

  .download { padding: clamp(72px, 10vw, 120px) var(--gutter); background: var(--ink); color: var(--paper); text-align: center; }
  .download .wrap { max-width: 640px; margin: 0 auto; }
  .download h2 { font-size: clamp(2.2rem, 4vw, 3.2rem); line-height: 1.05; letter-spacing: -0.02em; color: var(--paper); margin: 0 0 16px; }
  .download h2 .serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--p-color); }
  .download p { color: oklch(0.82 0.01 265); font-size: 1.05rem; margin: 0 0 32px; }
  .download .eyebrow span { color: oklch(0.72 0.01 265); }
  .download-btns { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .download .store { background: var(--paper); color: var(--ink); }

  .resources-section { background: var(--chalk); }
  .resources-section h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); line-height: 1.1; letter-spacing: -0.02em; color: var(--ink); margin: 0; }
  .resources-section h2 .serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--p-color); }
  .resources-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .resource-card {
    display: flex; gap: 20px; padding: 28px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s var(--ease), border-color 0.2s var(--ease);
    align-items: flex-start;
  }
  .resource-card:hover { box-shadow: var(--sh-2); border-color: var(--p-color); }
  .res-icon { font-size: 1.4rem; flex-shrink: 0; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: var(--p-soft); border-radius: var(--r-sm); }
