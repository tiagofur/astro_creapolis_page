---
import { getProjectData } from '../../i18n/data/projects';
import type { Lang } from '../../i18n/ui';
import { getLocalizedPath, useTranslations } from '../../i18n/utils';
import Footer from '../Footer.astro';
import Nav from '../Nav.astro';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const t = useTranslations(lang);
const project = getProjectData(lang, slug);

if (!project) {
  return Astro.redirect(getLocalizedPath(lang, '/proyectos'));
}
---

<Nav lang={lang} />

<header class="p-hero" style={`--p-color: ${project.color}`}>
  <div class="wrap">
    <a href={getLocalizedPath(lang, '/proyectos')} class="back-link reveal">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M10 12L6 8M6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      {t('project.back')}
    </a>

    <div class="hero-grid">
      <div class="hero-copy reveal reveal-delay-1">
        <div class="chips-row">
          <span class={`chip ${project.status === 'live' ? 'live' : 'dev'}`}><span class="chip-dot"></span>{t(`project.chip.${project.status === 'live' ? 'live' : 'dev'}`)}</span>
          <span class="chip proj-chip">{t('project.chip.by')}</span>
        </div>
        <h1>
          {project.name}.<br/>
          {project.headline}<br/>
          <span class="tone">{project.headlineAccent}</span>
        </h1>
        <p class="tag">{project.lead}</p>

        <div class="stores">
          {project.storeLinks.apple && (
            <a class="store" href={project.storeLinks.apple} target="_blank" rel="noopener" data-track-event="store_click" data-track-label="apple">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.05 12.04a4.4 4.4 0 0 1 2.1-3.7 4.5 4.5 0 0 0-3.55-1.92c-1.5-.15-2.94.88-3.7.88-.78 0-1.95-.86-3.22-.84a4.72 4.72 0 0 0-3.98 2.42c-1.7 2.95-.43 7.3 1.22 9.7.8 1.17 1.76 2.48 3.02 2.44 1.22-.05 1.68-.78 3.15-.78 1.46 0 1.88.78 3.17.75 1.31-.02 2.14-1.18 2.94-2.36a10.5 10.5 0 0 0 1.34-2.73 4.25 4.25 0 0 1-2.49-3.86zM14.5 5.25a4.3 4.3 0 0 0 1-3.25 4.47 4.47 0 0 0-2.9 1.5 4.16 4.16 0 0 0-1.02 3.15 3.67 3.67 0 0 0 2.92-1.4z"/></svg>
              <span><span class="small">{t('project.download.store.small')}</span><span class="big">App Store</span></span>
            </a>
          )}
          {project.storeLinks.google && (
            <a class="store" href={project.storeLinks.google} target="_blank" rel="noopener" data-track-event="store_click" data-track-label="google">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 1.9C3.2 2.1 3 2.5 3 3v18c0 .5.2.9.6 1.1l10.5-10.2L3.6 1.9zm12 10.6l2.7 2.6-3.8 2.2-2-1.9 3.1-2.9zm0-1.9l-3-2.9 2.4-1.4 3.4 2-2.8 2.3zM4.7 2.4l10.2 10-10.2 10v-20z"/></svg>
              <span><span class="small">{t('project.download.store.small')}</span><span class="big">Google Play</span></span>
            </a>
          )}
        </div>
      </div>

      <div class="phone-wrap reveal reveal-delay-2">
        <div class="phone">
          <div class="phone-screen">
            <div class="ps-head">
              <div>
                <h4>{project.mockup.headTitle}</h4>
                <div class="sub">{project.mockup.headSub}</div>
              </div>
              <div class="ps-avatar" style={`background: ${project.color}`}></div>
            </div>
            <div class="ps-stats">
              {project.mockup.stats.map((s) => (
                <div class="ps-stat"><div class="v">{s.v}</div><div class="l">{s.l}</div></div>
              ))}
            </div>
            <div class="ps-label">{project.mockup.listLabel}</div>
            <div class="ps-list">
              {project.mockup.listItems.map((it) => (
                <div class="ps-item"><span class="dot" style={`background: ${it.color}`}></span><span class="name">{it.name}</span><span class="date">{it.tag}</span></div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<section class="info-strip">
  <div class="row wrap">
    <div class="info-cell"><div class="v">{project.platform}</div><div class="l">{t('project.info.platform')}</div></div>
    <div class="info-cell"><div class="v">{project.category}</div><div class="l">{t('project.info.category')}</div></div>
    <div class="info-cell"><div class="v">{project.languages}</div><div class="l">{t('project.info.languages')}</div></div>
    <div class="info-cell"><div class="v">{project.price ?? t('project.info.free')}</div><div class="l">{t('project.info.price')}</div></div>
  </div>
</section>

{project.features.length > 0 && (
<section id="features" class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow" style={`--accent-color: ${project.color}; margin:0`}><span>{project.featureLabel}</span></p>
      <h2>{t('project.features.title.p1')} <span class="tone">{t('project.features.title.serif')}{t('project.features.title.p2')}</span></h2>
      <p>{t('project.features.lead')}</p>
    </div>

    <div class="features">
      {project.features.map((feature, i) => (
        <div class={`feature reveal${i === 1 ? ' reveal-delay-1' : ''}${i === 2 ? ' reveal-delay-2' : ''}`}>
          <div class="icon">{feature.letter}</div>
          <h3>{feature.title}</h3>
          <p>{feature.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
)}

{project.story.length > 0 && (
<section class="section case-study section-alt">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow" style={`--accent-color: ${project.color}; margin:0`}><span>{t('project.case.eyebrow')}</span></p>
      <h2>{t('project.case.title.p1')} <span class="tone">{t('project.case.title.serif')}.</span></h2>
    </div>

    <div class="case-grid">
      {project.story.map((chapter, i) => (
        <div class={`case-block reveal${i === 1 ? ' reveal-delay-1' : ''}${i === 2 ? ' reveal-delay-2' : ''}`}>
          <div class="case-num">
            <span class="case-dot" aria-hidden="true"></span>
            {String(i + 1).padStart(2, '0')}
          </div>
          <h3>{chapter.title}</h3>
          <p>{chapter.text}</p>
        </div>
      ))}
    </div>

    {project.tech.length > 0 && (
    <div class="tech-block reveal">
      <p class="eyebrow" style={`--accent-color: ${project.color}; margin:0 0 14px`}><span>{t('project.case.stack')}</span></p>
      <div class="tech-chips">
        {project.tech.map((tech) => (
          <span class="tech-chip">{tech}</span>
        ))}
      </div>
    </div>
    )}
  </div>
</section>
)}

<section class="download-wrap">
  <div class="wrap reveal">
    <div class="download-card">
      <div class="cta-glow cta-glow-cyan" aria-hidden="true"></div>
      <p class="dl-eyebrow">{t(`project.download.${project.status === 'live' ? 'eyebrow' : 'eyebrow.dev'}`)}</p>
      <h2>{t(`project.download.${project.status === 'live' ? 'title.p1' : 'title.p1.dev'}`)} <span class="tone">{t(`project.download.${project.status === 'live' ? 'title.serif' : 'title.serif.dev'}`)}</span>.</h2>
      <p class="dl-desc">{t(`project.download.${project.status === 'live' ? 'desc' : 'desc.dev'}`)}</p>
      <div class="download-btns">
        {(project.availablePlatforms?.includes('ios') ?? true) && (
          project.storeLinks.apple ? (
            <a class="store" href={project.storeLinks.apple} target="_blank" rel="noopener" data-track-event="store_click" data-track-label="apple">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 12.04a4.4 4.4 0 0 1 2.1-3.7 4.5 4.5 0 0 0-3.55-1.92c-1.5-.15-2.94.88-3.7.88-.78 0-1.95-.86-3.22-.84a4.72 4.72 0 0 0-3.98 2.42c-1.7 2.95-.43 7.3 1.22 9.7.8 1.17 1.76 2.48 3.02 2.44 1.22-.05 1.68-.78 3.15-.78 1.46 0 1.88.78 3.17.75 1.31-.02 2.14-1.18 2.94-2.36a10.5 10.5 0 0 0 1.34-2.73 4.25 4.25 0 0 1-2.49-3.86zM14.5 5.25a4.3 4.3 0 0 0 1-3.25 4.47 4.47 0 0 0-2.9 1.5 4.16 4.16 0 0 0-1.02 3.15 3.67 3.67 0 0 0 2.92-1.4z"/></svg>
            <span><span class="small">{t('project.download.store.small')}</span><span class="big">App Store</span></span>
          </a>
        ) : (
          <span class="store store-soon">
            <span><span class="small">{t('project.download.store.soon')}</span><span class="big">App Store</span></span>
          </span>
        )
        )}
        {(project.availablePlatforms?.includes('android') ?? true) && (
          project.storeLinks.google ? (
            <a class="store" href={project.storeLinks.google} target="_blank" rel="noopener" data-track-event="store_click" data-track-label="google">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3.6 1.9C3.2 2.1 3 2.5 3 3v18c0 .5.2.9.6 1.1l10.5-10.2L3.6 1.9zm12 10.6l2.7 2.6-3.8 2.2-2-1.9 3.1-2.9zm0-1.9l-3-2.9 2.4-1.4 3.4 2-2.8 2.3zM4.7 2.4l10.2 10-10.2 10v-20z"/></svg>
            <span><span class="small">{t('project.download.store.small')}</span><span class="big">Google Play</span></span>
          </a>
        ) : (
          <span class="store store-soon">
            <span><span class="small">{t('project.download.store.soon')}</span><span class="big">Google Play</span></span>
          </span>
        )
        )}
      </div>
    </div>
  </div>
</section>

{project.resources && (
  <section class="section resources-section">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow" style={`--accent-color: ${project.color}; margin:0`}><span>{t('project.resources.eyebrow')}</span></p>
        <h2>{t('project.resources.title.p1')} <span class="tone">{project.name}</span>.</h2>
      </div>
      <div class="resources-grid">
        {project.resources.map((r) => (
          <a href={getLocalizedPath(lang, r.href)} class="resource-card reveal">
            <div class="res-icon">{r.icon}</div>
            <div>
              <h3>{r.title}</h3>
              <p>{r.desc}</p>
              <span class="res-link">{t('project.resources.read')}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<section id="contacto" class="contact-cta">
  <div class="wrap reveal">
    <p class="eyebrow" style={`--accent-color: ${project.color}; margin:0 auto 14px; justify-content:center`}><span>{t('project.cta.eyebrow')}</span></p>
    <h2>{t('project.cta.title.p1')} <span class="tone">{t('project.cta.title.serif')}{t('project.cta.title.p2')}</span></h2>
    <p class="lead">{t('project.cta.lead')}</p>
    <div class="cta-row">
      <a href={getLocalizedPath(lang, '/contacto')} class="btn btn-primary">{t('project.cta.primary')}
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </a>
      <a href={getLocalizedPath(lang, '/proyectos')} class="btn btn-secondary">{t('project.cta.secondary')}</a>
    </div>
  </div>
</section>

<Footer lang={lang} />

<style>
  .tone { color: var(--ink-4); }

  .p-hero {
    padding: 128px var(--gutter) clamp(48px, 6vw, 80px);
    background: var(--paper);
  }
  .p-hero .wrap { max-width: var(--max); margin: 0 auto; }

  .back-link {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: 11px;
    font-weight: var(--fw-medium); color: var(--ink-3);
    text-transform: uppercase; letter-spacing: 0.08em;
    margin-bottom: 32px;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--ink); }

  .hero-grid { display: grid; gap: 48px; grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 960px) { .hero-grid { grid-template-columns: 1.15fr 1fr; gap: 64px; } }

  .chips-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 22px; }
  .proj-chip { color: var(--ink-2); }

  .hero-copy h1 {
    font-size: clamp(2.3rem, 5.4vw, 4rem);
    line-height: 1.05;
    letter-spacing: var(--ls-display);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    margin: 0 0 20px;
    text-wrap: balance;
  }
  .hero-copy .tag { font-size: 1.05rem; line-height: 1.6; color: var(--ink-3); max-width: 48ch; margin: 0 0 28px; text-wrap: pretty; }

  .stores { display: flex; flex-wrap: wrap; gap: 10px; }
  .store {
    display: inline-flex; align-items: center; gap: 12px;
    padding: 10px 18px;
    background: var(--ink); color: #ffffff;
    border-radius: var(--r-pill);
    text-decoration: none;
    transition: box-shadow 0.2s var(--ease), transform 0.15s;
  }
  .store:hover { box-shadow: 0 12px 32px rgba(9, 9, 11, 0.15); }
  .store:active { transform: scale(0.98); }
  .store .small { display: block; font-family: var(--font-mono); font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.08em; opacity: 0.7; }
  .store .big { display: block; font-size: 0.98rem; font-weight: var(--fw-medium); }
  .store-soon { background: var(--chalk); color: var(--ink-4); cursor: default; border: 1px dashed var(--line-2); }
  .store-soon:hover { box-shadow: none; }

  .phone-wrap { display: flex; justify-content: center; }
  .phone {
    width: 100%; max-width: 300px;
    aspect-ratio: 9 / 18;
    background: #09090b;
    border-radius: 36px;
    padding: 12px;
    box-shadow: var(--sh-3);
  }
  .phone-screen {
    width: 100%; height: 100%;
    background: #ffffff;
    border-radius: 26px;
    padding: 20px 16px;
    display: flex; flex-direction: column; gap: 14px;
    overflow: hidden;
  }
  .ps-head { display: flex; justify-content: space-between; align-items: center; }
  .ps-head h4 { font-size: 1.2rem; font-weight: var(--fw-semibold); letter-spacing: -0.02em; margin: 0; color: var(--ink); }
  .ps-head .sub { font-family: var(--font-mono); font-size: 0.62rem; color: var(--ink-4); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 3px; }
  .ps-avatar { width: 32px; height: 32px; border-radius: 999px; opacity: 0.9; }
  .ps-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .ps-stat { background: var(--chalk); border-radius: var(--r-sm); padding: 9px 6px; text-align: center; }
  .ps-stat .v { font-size: 1.05rem; font-weight: var(--fw-semibold); letter-spacing: -0.02em; color: var(--ink); line-height: 1; }
  .ps-stat .l { font-family: var(--font-mono); font-size: 0.56rem; color: var(--ink-4); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 4px; }
  .ps-label { font-family: var(--font-mono); font-size: 0.62rem; color: var(--ink-4); text-transform: uppercase; letter-spacing: 0.08em; }
  .ps-list { display: flex; flex-direction: column; gap: 6px; }
  .ps-item { display: flex; align-items: center; gap: 10px; padding: 9px 11px; background: var(--chalk); border-radius: var(--r-sm); }
  .ps-item .dot { width: 7px; height: 7px; border-radius: 999px; flex-shrink: 0; }
  .ps-item .name { flex: 1; font-size: 0.78rem; color: var(--ink); }
  .ps-item .date { font-family: var(--font-mono); font-size: 0.64rem; color: var(--ink-4); }

  /* Info strip — hairline grid */
  .info-strip { padding: 0 var(--gutter); }
  .info-strip .row {
    max-width: var(--max); margin: 0 auto;
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 1px; background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    overflow: hidden;
  }
  @media (min-width: 720px) { .info-strip .row { grid-template-columns: repeat(4, 1fr); } }
  .info-cell { background: #ffffff; padding: 20px 22px; }
  .info-cell .v { font-size: clamp(1.05rem, 1.8vw, 1.3rem); font-weight: var(--fw-semibold); letter-spacing: -0.02em; line-height: 1.15; color: var(--ink); }
  .info-cell .l { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-4); margin-top: 6px; }

  .section { padding: clamp(64px, 9vw, 120px) var(--gutter); }
  .section .wrap { max-width: var(--max); margin: 0 auto; }
  .section-alt { background: var(--chalk); }

  .section-head { max-width: 640px; display: flex; flex-direction: column; gap: 14px; margin-bottom: 44px; }
  .section-head h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
    line-height: 1.08; letter-spacing: -0.03em;
    font-weight: var(--fw-semibold);
    color: var(--ink); margin: 0; text-wrap: balance;
  }
  .section-head p { color: var(--ink-3); font-size: 1rem; line-height: 1.6; max-width: 56ch; }

  /* Features — hairline cards with tinted icon tiles */
  .features { display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .features { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .features { grid-template-columns: repeat(3, 1fr); } }

  .feature {
    padding: 26px 24px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .feature:hover { transform: translateY(-4px); box-shadow: var(--sh-hover); }
  .feature .icon {
    width: 44px; height: 44px;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 1.15rem; font-weight: var(--fw-medium);
    color: var(--ink);
    background: color-mix(in srgb, var(--p-color) 8%, transparent);
    border-radius: var(--r-lg);
    margin-bottom: 16px;
  }
  .feature h3 { font-size: 1.05rem; font-weight: var(--fw-semibold); letter-spacing: -0.01em; line-height: 1.3; margin: 0 0 8px; color: var(--ink); }
  .feature p { font-size: 0.9rem; line-height: 1.55; color: var(--ink-3); margin: 0; }

  /* Case study */
  .case-grid { display: grid; gap: 24px; grid-template-columns: 1fr; margin-bottom: 56px; }
  @media (min-width: 800px) { .case-grid { grid-template-columns: repeat(3, 1fr); } }

  .case-block {
    padding: 22px 24px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    border-top: var(--accent-bar) solid var(--p-color);
  }
  .case-num {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: 11px; font-weight: var(--fw-medium);
    color: var(--ink-4);
    margin-bottom: 12px;
  }
  .case-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--p-color); }
  .case-block h3 { font-size: 1.08rem; font-weight: var(--fw-semibold); letter-spacing: -0.01em; margin: 0 0 8px; color: var(--ink); }
  .case-block p { font-size: 0.92rem; line-height: 1.6; color: var(--ink-3); margin: 0; }

  .tech-block { padding-top: 24px; border-top: 1px solid var(--line); }
  .tech-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .tech-chip {
    display: inline-flex; align-items: center;
    padding: 5px 12px;
    font-family: var(--font-mono); font-size: 0.76rem;
    color: var(--ink-2);
    background: #ffffff;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
  }

  /* Download — the page's one dark mega-card */
  .download-wrap { padding: 24px var(--gutter) clamp(56px, 7vw, 96px); }
  .download-wrap .wrap { max-width: var(--max); margin: 0 auto; }
  .download-card {
    position: relative;
    background: #09090b;
    color: #ffffff;
    border-radius: var(--r-mega);
    padding: clamp(48px, 7vw, 80px) clamp(24px, 5vw, 64px);
    text-align: center;
    overflow: hidden;
  }
  .cta-glow {
    position: absolute;
    width: 420px; height: 420px;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.22;
    pointer-events: none;
  }
  .cta-glow-cyan { background: radial-gradient(circle, #00aeef, transparent 65%); bottom: -160px; right: -80px; }
  .dl-eyebrow {
    position: relative;
    font-family: var(--font-mono); font-size: 11px; font-weight: var(--fw-medium);
    text-transform: uppercase; letter-spacing: var(--ls-mono);
    color: #71717a;
    margin: 0 0 14px;
  }
  .download-card h2 {
    position: relative;
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    line-height: 1.08; letter-spacing: -0.03em;
    font-weight: var(--fw-semibold);
    color: #ffffff; margin: 0 0 14px;
    text-wrap: balance;
  }
  .download-card h2 .tone { color: #71717a; }
  .dl-desc { position: relative; color: #a1a1aa; font-size: 1rem; line-height: 1.6; margin: 0 0 32px; }
  .download-btns { position: relative; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .download-card .store { background: #ffffff; color: #09090b; }
