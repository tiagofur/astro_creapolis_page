---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import Footer from '../Footer.astro';
import Nav from '../Nav.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const WEB3FORMS_KEY =
  import.meta.env.WEB3FORMS_KEY || 'YOUR_WEB3FORMS_ACCESS_KEY';
---

<Nav lang={lang} />

<header class="c-hero">
  <div class="wrap reveal">
    <p class="eyebrow" style="justify-content:center; margin:0 auto;"><span>{t('contact.page.eyebrow')}</span></p>
    <h1>{t('contact.page.title.p1')}<br/>{t('contact.page.title.p2')} <span class="tone">{t('contact.page.title.serif')}</span>.</h1>
    <p>{t('contact.page.subtitle')}</p>
  </div>
</header>

<section id="form" class="form-section">
  <div class="form-grid">
    <aside class="side">
      <div class="side-card promise reveal">
        <p class="eyebrow accent" style="--accent-color: var(--c-cyan); margin-bottom:8px"><span>{t('contact.promise.title')}</span></p>
        <h2>{t('contact.promise.subtitle')}</h2>
        <p>{t('contact.promise.desc')}</p>
        <div class="metric">
          <span class="big">&lt; 24h</span>
          <span class="lbl">{t('contact.promise.metric')}</span>
        </div>
      </div>

      <div class="side-card reveal reveal-delay-1">
        <h2>{t('contact.write.title')}</h2>
        <p>{t('contact.write.desc')}</p>
        <a href="mailto:hola@creapolis.dev">hola@creapolis.dev →</a>
        <div class="row" style="margin-top:18px">
          <div class="kv"><span class="k">{t('contact.write.office.label')}</span><span class="v">{t('contact.write.office.value')}</span></div>
          <div class="kv"><span class="k">{t('contact.write.hours.label')}</span><span class="v">{t('contact.write.hours.value')}</span></div>
          <div class="kv"><span class="k">{t('contact.write.lang.label')}</span><span class="v">{t('contact.write.lang.value')}</span></div>
        </div>
      </div>

      <div class="side-card reveal reveal-delay-2">
        <h2>{t('contact.after.title')}</h2>
        <div class="row" style="margin-top:8px">
          <div class="step">
            <span class="chip step-num">1</span>
            <div><div class="step-title">{t('contact.after.step1')}</div><div class="step-sub">{t('contact.after.step1.sub')}</div></div>
          </div>
          <div class="step">
            <span class="chip step-num">2</span>
            <div><div class="step-title">{t('contact.after.step2')}</div><div class="step-sub">{t('contact.after.step2.sub')}</div></div>
          </div>
          <div class="step">
            <span class="chip step-num">3</span>
            <div><div class="step-title">{t('contact.after.step3')}</div><div class="step-sub">{t('contact.after.step3.sub')}</div></div>
          </div>
        </div>
      </div>
    </aside>

    <div class="form-card reveal reveal-delay-1"
      data-msg-wait={t('contact.cta.form.error.wait')}
      data-msg-conn={t('contact.cta.form.error.conn')}
      data-msg-hp={t('contact.form.ok')}
      data-msg-ok={t('contact.cta.form.success.hp')}
      data-calendar-url="https://calendly.com/creapolis/30min"
    >
      {/* --- FORM STATE --- */}
      <div id="form-view">
        <h2>{t('contact.form.title')} <span class="tone">{t('contact.form.title.serif')}</span>.</h2>
        <p class="intro">{t('contact.form.intro')}</p>

        <form id="contact-form" class="big" autocomplete="on" data-track-form="contact_form_started">
          <div class="hp-field" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" id="timestamp" name="timestamp" value="" />
          <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
          <input type="hidden" name="subject" value="Nuevo contacto desde creapolis.dev" />
          <input type="hidden" name="from_name" value="Creapolis · Formulario web" />

          <div class="two">
            <label>{t('contact.form.name')}
              <input type="text" id="name" name="name" required placeholder="María González" />
            </label>
            <label>{t('contact.form.email')}
              <input type="email" id="email" name="email" required placeholder="maria@empresa.com" />
            </label>
          </div>

          <label>{t('contact.form.type')}
            <select name="type" id="type-select">
              <option value="">{t('contact.form.type.placeholder')}</option>
              <option value="mobile">{t('contact.form.type.mobile')}</option>
              <option value="web">{t('contact.form.type.web')}</option>
              <option value="desktop">{t('contact.form.type.desktop')}</option>
              <option value="ai">{t('contact.form.type.ai')}</option>
              <option value="consult">{t('contact.cta.form.type.consult')}</option>
            </select>
          </label>

          <label>{t('contact.form.message')}
            <textarea id="message" name="message" required placeholder={t('contact.cta.form.message.placeholder')}></textarea>
          </label>

          <div class="submit-row">
            <button type="submit" class="btn btn-primary btn-lg submit-btn">
              <span class="btn-text">{t('contact.form.submit')}
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
              <span class="btn-loading" aria-hidden="true">
                <svg class="spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="32"><animate attributeName="stroke-dashoffset" values="32;0" dur="0.8s" repeatCount="indefinite"/></circle></svg>
                {t('contact.form.sending')}
              </span>
            </button>
            <span class="fine">{t('contact.form.response')}</span>
          </div>

          <div id="form-message" class="form-message" role="status" aria-live="polite" hidden></div>
        </form>
      </div>

      {/* --- SUCCESS STATE --- */}
      <div id="success-view" class="success-view" hidden>
        <div class="success-icon">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="22" stroke="var(--c-cyan)" stroke-width="2"/><path d="M14 24l7 7 13-13" stroke="var(--c-cyan)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h2>{t('contact.success.title')} <span class="tone">{t('contact.success.title.serif')}</span>.</h2>
        <p class="intro">{t('contact.success.desc')}</p>
        <div class="success-actions">
          <div class="calendar-embed">
            <div class="calendar-label">{t('contact.success.calendar')}</div>
            <div class="calendar-placeholder">
              <div class="calendar-card">
                <div class="cal-header">
                  <span class="cal-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
                  <span>{t('contact.success.cal.title')}</span>
                </div>
                <p>{t('contact.success.cal.desc')}</p>
                <a href="https://calendly.com/creapolis/30min" target="_blank" rel="noopener" class="btn btn-primary">
                  {t('contact.success.cal.cta')}
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </a>
              </div>
            </div>
          </div>
          <a href={`mailto:hola@creapolis.dev?subject=${encodeURIComponent('Re: contacto creapolis.dev')}`} class="btn btn-ghost">
            {t('contact.success.email')}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="faq" class="faq">
  <p class="eyebrow" style="justify-content:center;margin:0 auto 14px"><span>{t('faq.title')}</span></p>
  <h2>{t('faq.title')} <span class="tone">{t('faq.title.serif')}</span>.</h2>

  <details>
    <summary>{t('faq.q1')}<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 4V14M4 9H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></summary>
    <div class="ans">{t('faq.a1')}</div>
  </details>
  <details>
    <summary>{t('faq.q2')}<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 4V14M4 9H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></summary>
    <div class="ans">{t('faq.a2')}</div>
  </details>
  <details>
    <summary>{t('faq.q3')}<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 4V14M4 9H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></summary>
    <div class="ans">{t('faq.a3')}</div>
  </details>
  <details>
    <summary>{t('faq.q4')}<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 4V14M4 9H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></summary>
    <div class="ans">{t('faq.a4')}</div>
  </details>
  <details>
    <summary>{t('faq.q5')}<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 4V14M4 9H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></summary>
    <div class="ans">{t('faq.a5')}</div>
  </details>
</section>

<Footer lang={lang} />

<script>
  import { trackEvent } from '../../lib/analytics';
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const formView = document.getElementById('form-view')!;
  const successView = document.getElementById('success-view')!;
  const messageEl = document.getElementById('form-message') as HTMLElement;
  const submitBtn = form?.querySelector('.submit-btn') as HTMLButtonElement | null;
  const btnText = submitBtn?.querySelector('.btn-text') as HTMLElement;
  const btnLoading = submitBtn?.querySelector('.btn-loading') as HTMLElement;
  const honeypot = document.getElementById('website') as HTMLInputElement;
  const timestampInput = document.getElementById('timestamp') as HTMLInputElement;
  const formCard = document.querySelector('.form-card') as HTMLElement;

  if (timestampInput) timestampInput.value = Date.now().toString();

  let submitting = false;
  const MAX_RETRIES = 2;
  const TIMEOUT_MS = 10000;

  function setLoading(on: boolean) {
    if (on) {
      if (btnText) btnText.style.display = 'none';
      if (btnLoading) btnLoading.style.display = 'inline-flex';
      if (submitBtn) submitBtn.disabled = true;
      if (form) form.setAttribute('aria-busy', 'true');
    } else {
      if (btnText) btnText.style.display = 'inline';
      if (btnLoading) btnLoading.style.display = 'none';
      if (submitBtn) submitBtn.disabled = false;
      if (form) form.removeAttribute('aria-busy');
    }
  }

  function showError(msg: string, retryable = false) {
    if (!messageEl) return;
    messageEl.hidden = false;
    messageEl.className = 'form-message form-error';
    messageEl.textContent = msg;
    if (retryable) {
      const retryBtn = document.createElement('button');
      retryBtn.type = 'button';
      retryBtn.className = 'btn btn-ghost retry-btn';
      retryBtn.textContent = 'Reintentar';
      retryBtn.setAttribute('aria-label', 'Reintentar envío del formulario');
      retryBtn.style.marginTop = '12px';
      retryBtn.addEventListener('click', () => form?.requestSubmit());
      messageEl.appendChild(retryBtn);
    }
  }

  function showSuccess() {
    formView.hidden = true;
    successView.hidden = false;
    formCard?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    // Track completion
    trackEvent?.('contact_form_completed');
  }

  function buildPayload(): Record<string, unknown> {
    const fd = new FormData(form);
    return {
      access_key: fd.get('access_key'),
      subject: fd.get('subject'),
      from_name: fd.get('from_name'),
      name: fd.get('name'),
      email: fd.get('email'),
      type: fd.get('type'),
      message: fd.get('message'),
      botcheck: fd.get('website'),
      timestamp: fd.get('timestamp'),
    };
  }

  async function submitWithTimeout(payload: Record<string, unknown>): Promise<{success: boolean}> {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
        signal: controller.signal,
      });
      return await res.json();
    } finally {
      clearTimeout(timer);
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitting) return;

    const msgHp = formCard?.dataset.msgHp || '';
    const msgWait = formCard?.dataset.msgWait || '';
    const msgConn = formCard?.dataset.msgConn || '';

    // Honeypot check
    if (honeypot?.value) {
      showSuccess();
      return;
    }

    // Timing check (prevent bot submissions)
    const submittedAt = Date.now();
    const loadedAt = parseInt(timestampInput.value) || 0;
    if (submittedAt - loadedAt < 2000) {
      showError(msgWait);
      return;
    }

    submitting = true;
    setLoading(true);
    messageEl.hidden = true;
    messageEl.textContent = '';

    const payload = buildPayload();
    let lastError = '';

    for (let attempt = 0; attempt <= MAX_RETRIES; attempt++) {
      try {
        const result = await submitWithTimeout(payload);
        if (result.success) {
          showSuccess();
          submitting = false;
          return;
        }
        lastError = msgConn;
      } catch (err: unknown) {
        lastError = err instanceof DOMException && err.name === 'AbortError'
          ? 'Tiempo de espera agotado. Verifica tu conexión.'
          : msgConn;
      }
      // Brief pause before retry (exponential backoff)
      if (attempt < MAX_RETRIES) {
        await new Promise(r => setTimeout(r, 1000 * (attempt + 1)));
      }
    }

    showError(lastError, true);
    submitting = false;
    setLoading(false);
  });
</script>

<style>
  .tone { color: var(--ink-4); }

  /* ─── Hero ─────────────────────────────────────────────────────────── */
  .c-hero {
    padding: 168px var(--gutter) 56px;
    background: var(--paper);
  }
  .c-hero .wrap {
    max-width: 860px;
    text-align: center;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .c-hero h1 {
    font-size: clamp(2.6rem, 6.4vw, 4.8rem);
    line-height: 1.03;
    letter-spacing: var(--ls-display);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .c-hero p {
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.6;
    color: var(--ink-3);
    max-width: 54ch;
    margin: 0;
    text-wrap: pretty;
  }

  /* ─── Form layout ──────────────────────────────────────────────────── */
  .form-section { padding: 24px var(--gutter) clamp(72px, 9vw, 120px); }
  .form-grid { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 980px) { .form-grid { grid-template-columns: 1fr 1.4fr; gap: 32px; } }

  .side { display: flex; flex-direction: column; gap: 16px; }
  .side-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: 26px;
  }
  .side-card h2 { font-size: 1.08rem; font-weight: var(--fw-semibold); letter-spacing: -0.015em; margin-bottom: 10px; }
  .side-card p, .side-card a { font-size: 0.9rem; color: var(--ink-3); }
  .side-card a { color: var(--ink); font-weight: var(--fw-medium); display: inline-flex; align-items: center; gap: 6px; margin-top: 6px; }
  .side-card a:hover { text-decoration: underline; }
  .side-card .row { display: flex; flex-direction: column; gap: 12px; }
  .side-card .kv {
    display: grid; grid-template-columns: auto 1fr;
    gap: 14px; align-items: baseline;
    padding: 9px 0; border-bottom: 1px solid var(--line);
    font-size: 0.88rem;
  }
  .side-card .kv:last-child { border-bottom: 0; }
  .side-card .kv .k { font-family: var(--font-mono); font-size: 11px; color: var(--ink-4); text-transform: uppercase; letter-spacing: 0.08em; }
  .side-card .kv .v { color: var(--ink); font-weight: var(--fw-medium); }

  /* Promise — the page's single dark card */
  .side-card.promise {
    background: #09090b;
    color: #ffffff;
    border-color: #09090b;
  }
  .side-card.promise h2 { color: #ffffff; }
  .side-card.promise p { color: #a1a1aa; }
  .promise .metric {
    display: flex; align-items: baseline; gap: 10px;
    margin-top: 16px; padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .promise .metric .big {
    font-size: 2.4rem; font-weight: var(--fw-semibold);
    letter-spacing: -0.03em; line-height: 1; color: var(--c-cyan);
  }
  .promise .metric .lbl {
    font-family: var(--font-mono); font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.08em; color: #71717a;
  }

  .step { display: flex; gap: 14px; align-items: flex-start; }
  .step-num {
    flex-shrink: 0;
    font-family: var(--font-mono); font-size: 0.78rem; font-weight: var(--fw-medium);
    width: 26px; height: 26px; display: grid; place-items: center;
    border: 1px solid var(--line-2); border-radius: var(--r-pill);
    color: var(--ink-2);
    padding: 0;
  }
  .step-title { font-weight: var(--fw-medium); font-size: 0.92rem; color: var(--ink); }
  .step-sub { font-size: 0.82rem; color: var(--ink-3); }

  /* ─── Form card ────────────────────────────────────────────────────── */
  .form-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: clamp(28px, 4vw, 48px);
    position: relative;
  }
  .form-card h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: var(--fw-semibold); letter-spacing: -0.025em; margin-bottom: 8px; }
  .form-card .intro { font-size: 0.98rem; color: var(--ink-3); margin-bottom: 28px; }

  form.big { display: grid; gap: 16px; }
  form.big .two { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 640px) { form.big .two { grid-template-columns: 1fr 1fr; } }
  form.big label {
    display: flex; flex-direction: column; gap: 7px;
    font-size: 11px; color: var(--ink-3);
    font-family: var(--font-mono);
    font-weight: var(--fw-medium);
    text-transform: uppercase; letter-spacing: var(--ls-mono);
  }
  form.big input, form.big textarea, form.big select {
    padding: 13px 15px;
    border-radius: var(--r-sm);
    border: 1px solid var(--line-2);
    background: #ffffff;
    font-size: 1rem;
    font-family: var(--font-sans);
    color: var(--ink);
    transition: border-color 0.2s, box-shadow 0.2s;
    text-transform: none; letter-spacing: normal;
  }
  form.big input:focus, form.big textarea:focus, form.big select:focus {
    outline: 2px solid var(--ink);
    outline-offset: 0;
    border-color: var(--ink);
    box-shadow: 0 0 0 4px rgba(24, 24, 27, 0.1);
  }
  form.big input:invalid:not(:placeholder-shown), form.big textarea:invalid:not(:placeholder-shown) {
    border-color: rgba(236, 0, 140, 0.6);
  }
  form.big textarea { resize: vertical; min-height: 140px; }

  .hp-field {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    overflow: hidden;
  }

  .submit-row { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-top: 10px; }
  .submit-row .fine { font-size: 0.78rem; color: var(--ink-4); font-family: var(--font-mono); }
  .submit-btn:disabled { opacity: 0.7; cursor: not-allowed; }
  .btn-loading { display: none; align-items: center; gap: 8px; }
  .spinner { animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .form-message { padding: 16px; border-radius: var(--r-md); font-size: 0.94rem; }
  .form-success { background: var(--c-cyan-soft); color: var(--c-cyan-3); border: 1px solid rgba(0, 174, 239, 0.25); }
  .form-error { background: var(--c-magenta-soft); color: #C40075; border: 1px solid rgba(236, 0, 140, 0.25); }

  /* Success view */
  .success-view {
    text-align: center;
    padding: 20px 0;
  }
  .success-icon {
    margin-bottom: 24px;
    animation: popIn 0.4s var(--ease);
  }
  @keyframes popIn {
    0% { transform: scale(0.5); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
  .success-view h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: var(--fw-semibold); letter-spacing: -0.025em;
    margin-bottom: 12px;
  }
  .success-view .intro {
    font-size: 1rem;
    color: var(--ink-3);
    max-width: 44ch;
    margin: 0 auto 32px;
  }
  .success-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
  }

  .calendar-embed { width: 100%; max-width: 400px; }
  .calendar-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: var(--ls-mono);
    color: var(--ink-4);
    margin-bottom: 12px;
  }
  .calendar-placeholder { width: 100%; }
  .calendar-card {
    background: var(--chalk);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: 28px;
    text-align: center;
  }
  .cal-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-weight: var(--fw-medium);
    font-size: 1.02rem;
    margin-bottom: 12px;
    color: var(--ink);
  }
  .cal-icon { color: var(--c-cyan-3); }
  .calendar-card p {
    font-size: 0.9rem;
    color: var(--ink-3);
    margin: 0 auto 20px;
