---
import {
  type Product,
  type ProductStatus,
  products,
} from '../../i18n/data/products';
import type { Lang } from '../../i18n/ui';
import { getLocalizedPath, useTranslations } from '../../i18n/utils';
import Footer from '../Footer.astro';
import Nav from '../Nav.astro';
import CubePyramid from '../brand/CubePyramid.astro';
import CmyDots from '../brand/CmyDots.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Filter products: live and pre_production
const workProducts = products.filter(
  (p) => p.status === 'live' || p.status === 'pre_production',
);

const statusLabels: Record<ProductStatus, string> = {
  live: t('apps.live'),
  pre_production: t('apps.pre'),
  coming_soon: t('apps.dev'),
  archived: t('apps.dev'),
};

function getPlatformLabel(platforms: Product['platforms']): string {
  return platforms
    .filter((p) => p.available)
    .map((p) => p.id.toUpperCase())
    .join(' · ');
}

const contactPath = getLocalizedPath(lang, '/contacto');
---

<Nav lang={lang} />

<!-- ─── HERO ─── -->
<header class="page-hero">
  <div class="wrap">
    <div class="page-copy reveal">
      <p class="hero-eyebrow">
        <CmyDots size={4} />
        <span>{lang === 'es' ? 'Productos & Software Propio' : lang === 'en' ? 'Proprietary Software & Apps' : 'Produtos & Software Próprio'}</span>
      </p>
      <h1>
        {lang === 'es' ? (
          <>Software que diseñamos, publicamos <span class="tone">y operamos</span>.</>
        ) : lang === 'en' ? (
          <>Software we design, publish <span class="tone">and operate</span>.</>
        ) : (
          <>Software que projetamos, publicamos <span class="tone">e operamos</span>.</>
        )}
      </h1>
      <p class="lead">
        {lang === 'es'
          ? 'Creapolis no es solo una consultora: es un laboratorio de ingeniería. Cada producto aquí publicado cuenta con documentación de arquitectura, guías de usuario y soporte oficial en App Store y Google Play.'
          : lang === 'en'
            ? 'Creapolis is an active software laboratory. Each published application features architecture case studies, complete user guides, and official support for App Store and Google Play.'
            : 'A Creapolis não é só uma consultoria: é um laboratório de engenharia. Cada produto publicado aqui conta com documentação de arquitetura, guias de usuário e suporte oficial na App Store e Google Play.'}
      </p>
    </div>
  </div>
</header>

<!-- ─── PRODUCTS GRID ─── -->
<section class="section">
  <div class="wrap">
    <div class="products-grid">
      {workProducts.map((product, i) => (
        <a href={getLocalizedPath(lang, `/proyectos/${product.slug}`)} class={`product-card reveal${i > 0 && i < 4 ? ` reveal-delay-${i}` : ''}`} style={`--card-accent: ${product.color}`}>
          <span class="card-bar" aria-hidden="true"></span>
          <div class="product-card-top">
            <div class="product-badge-group">
              <span class="product-num">0{i + 1}</span>
              <span class={`status-pill ${product.status}`}>
                <span class="pulse-dot"></span>
                {statusLabels[product.status]}
              </span>
            </div>
            <span class="platform-tags">{getPlatformLabel(product.platforms)}</span>
          </div>

          <div class="product-preview-box">
            <img src={`/og/${product.slug}.svg`} alt={product.name} class="product-preview-img" loading="lazy" decoding="async" />
          </div>

          <div class="product-card-body">
            <h3>{product.name}</h3>
            <span class="product-category-title">{product.category}</span>
            <p>{product.seo.description}</p>
          </div>

          <div class="product-card-footer">
            <div class="quick-links">
              <span>{lang === 'es' ? 'Guía' : lang === 'en' ? 'Guide' : 'Guia'}</span> · <span>Tips</span> · <span>{lang === 'es' ? 'Soporte' : lang === 'en' ? 'Support' : 'Suporte'}</span>
            </div>
            <span class="enter-link">
              {lang === 'es' ? 'Abrir Hub del Producto' : lang === 'en' ? 'Open Product Hub' : 'Abrir Hub do Produto'} →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ─── B2B CALL TO ACTION — the page's one dark card ─── -->
<section class="section b2b-bridge-section">
  <div class="wrap">
    <div class="bridge-card reveal">
      <div class="cta-glow cta-glow-magenta" aria-hidden="true"></div>
      <div class="cta-glow cta-glow-cyan" aria-hidden="true"></div>
      <div class="bridge-content">
        <CubePyramid size={30} variant="cmyk" />
        <h2>{lang === 'es' ? '¿Quieres que construyamos un sistema con este nivel para tu empresa?' : lang === 'en' ? 'Want us to engineer a custom system for your business?' : 'Quer que a gente construa um sistema desse nível para sua empresa?'}</h2>
        <p>
          {lang === 'es'
            ? 'Desde un agente de agendamiento automático hasta un CRM o una app móvil de punta a punta. Aplicamos el mismo rigor que ves en nuestros propios productos.'
            : lang === 'en'
              ? 'From automated appointment agents to full-stack CRMs and mobile apps. We bring the exact same engineering craft to your company.'
              : 'De um agente de agendamento automático a um CRM ou app mobile completo. Aplicamos o mesmo rigor que você vê nos nossos próprios produtos.'}
        </p>
        <div class="bridge-actions">
          <a href={contactPath} class="bridge-btn-primary">
            {lang === 'es' ? 'Agendar llamada de diagnóstico' : lang === 'en' ? 'Book a discovery session' : 'Agendar chamada de diagnóstico'}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </a>
          <a href={getLocalizedPath(lang, '/servicios')} class="bridge-btn-email">
            {lang === 'es' ? 'Ver servicios y metodología' : lang === 'en' ? 'View services & methodology' : 'Ver serviços e metodologia'}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<Footer lang={lang} hideCta={true} />

<style>
  .tone { color: var(--ink-4); }

  .page-hero {
    padding: 160px var(--gutter) 56px;
    background: var(--paper);
  }
  .page-copy {
    max-width: 760px;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: var(--ls-mono);
    color: var(--ink-3);
  }
  .page-copy h1 {
    font-size: clamp(2.3rem, 4.6vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: var(--ls-display);
    font-weight: var(--fw-semibold);
    margin: 18px 0 18px;
    text-wrap: balance;
  }
  .page-copy .lead {
    font-size: 1.04rem;
    line-height: 1.6;
    color: var(--ink-3);
    text-wrap: pretty;
  }

  .section {
    padding: clamp(56px, 7vw, 96px) var(--gutter);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 24px;
  }

  .product-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    position: relative;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-hover);
  }

  .product-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 24px 14px;
  }
  .product-badge-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .product-num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    color: var(--ink-4);
  }
  .status-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: var(--r-pill);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--c-cyan-soft);
    color: var(--c-cyan-3);
    border: 1px solid rgba(0, 174, 239, 0.3);
  }
  .status-pill.pre_production {
    background: var(--c-yellow-soft);
    color: var(--c-yellow-3);
    border-color: rgba(255, 196, 0, 0.35);
  }
  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .platform-tags {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    background: #ffffff;
    border: 1px solid var(--line-2);
    padding: 4px 9px;
    border-radius: var(--r-pill);
  }

  .product-preview-box {
    padding: 0 24px;
  }
  .product-preview-img {
    width: 100%;
    border-radius: var(--r-md);
    border: 1px solid var(--line);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--chalk);
  }

  .product-card-body {
    padding: 20px 24px;
    flex: 1;
  }
  .product-card-body h3 {
    font-size: 1.3rem;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
    margin: 0 0 4px 0;
  }
  .product-category-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-4);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: 12px;
  }
  .product-card-body p {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink-3);
    margin: 0;
  }

  .product-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    background: var(--chalk);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .quick-links {
    color: var(--ink-4);
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .enter-link {
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-2);
    transition: color 0.2s;
  }
  .product-card:hover .enter-link {
    color: var(--ink);
  }

  /* B2B Bridge — dark mega-card */
  .b2b-bridge-section {
    padding: 16px var(--gutter) 96px;
  }
  .bridge-card {
    position: relative;
    background: #09090b;
    color: #ffffff;
    border-radius: var(--r-mega);
    padding: clamp(40px, 6vw, 72px);
    text-align: center;
    overflow: hidden;
  }
  .cta-glow {
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.25;
    pointer-events: none;
  }
  .cta-glow-magenta {
    background: radial-gradient(circle, #ec008c, transparent 65%);
    top: -160px;
    left: -80px;
  }
  .cta-glow-cyan {
    background: radial-gradient(circle, #00aeef, transparent 65%);
    bottom: -160px;
    right: -80px;
  }
  .bridge-content {
    position: relative;
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .bridge-content h2 {
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.03em;
    line-height: 1.14;
    margin: 20px 0 14px;
    text-wrap: balance;
  }
  .bridge-content p {
    font-size: 0.98rem;
    line-height: 1.6;
    color: #a1a1aa;
    margin: 0 0 28px;
  }
  .bridge-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .bridge-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    padding: 0 28px;
    border-radius: var(--r-pill);
    background: #ffffff;
    color: #09090b;
    font-size: 15px;
    font-weight: var(--fw-medium);
    text-decoration: none;
    transition: box-shadow 0.2s var(--ease), transform 0.15s;
  }
  .bridge-btn-primary:hover {
    box-shadow: 0 12px 32px rgba(255, 255, 255, 0.18);
  }
  .bridge-btn-primary:active { transform: scale(0.98); }
  .bridge-btn-email {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 24px;
    border-radius: var(--r-pill);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #d4d4d8;
    font-size: 0.9rem;
    font-weight: var(--fw-medium);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }
  .bridge-btn-email:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.35);
  }
</style>
