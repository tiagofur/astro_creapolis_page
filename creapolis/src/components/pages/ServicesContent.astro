---
import { getServicesData } from '../../i18n/data/services';
import type { Lang } from '../../i18n/ui';
import { getLocalizedPath, useTranslations } from '../../i18n/utils';
import Footer from '../Footer.astro';
import Nav from '../Nav.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Web3Forms access key (pública, client-side, no es secreta).
// Generala gratis en https://web3forms.com y ponela en la env WEB3FORMS_KEY.
const WEB3FORMS_KEY =
  import.meta.env.WEB3FORMS_KEY || 'YOUR_WEB3FORMS_ACCESS_KEY';
const { services, process } = getServicesData(lang);
---

<Nav lang={lang} />

<header class="page-hero">
  <div class="wrap">
    <div class="page-hero-copy reveal">
      <div class="eyebrow" style="margin-bottom:18px"><span>{t('services.page.eyebrow')}</span></div>
      <h1>{t('services.page.title.p1')}<br/><span class="serif">{t('services.page.title.serif')}</span>.</h1>
      <p class="lead">{t('services.page.lead')}</p>
    </div>
  </div>
</header>

<section class="section" style="background:var(--chalk)">
  <div class="wrap">
    <div class="svc-grid">
      {services.map((s, i) => (
        <article id={s.id} class={`svc-card reveal${i > 0 ? ` reveal-delay-${i}` : ''}`}>
          <div class="svc-head">
            <span class="svc-num">{String(i + 1).padStart(2, '0')}</span>
            <h2>{s.title}</h2>
            <span class="svc-tagline">{s.tagline}</span>
          </div>

          <div class="svc-body">
            <div class="svc-field">
              <span class="svc-label">{t('services.page.audience')}</span>
              <p>{s.audience}</p>
            </div>

            <div class="svc-field svc-outcome">
              <span class="svc-label">{t('services.page.outcome')}</span>
              <p>{s.outcome}</p>
            </div>

            <div class="svc-field">
              <span class="svc-label">{t('services.page.deliverables')}</span>
              <div class="svc-deliverables">
                {s.deliverables.map((d) => (
                  <div class="svc-del">
                    <strong>{d.title}</strong>
                    <span>{d.desc}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="svc-field svc-method">
              <span class="svc-label">{t('services.page.method')}</span>
              <div class="svc-chips">
                {s.tech.map((tech) => (
                  <span class="chip">{tech}</span>
                ))}
              </div>
            </div>

            <div class="svc-proof">
              <div class="svc-proof-label">{s.proof.label}</div>
              <p>{s.proof.text}</p>
              <a href={s.proof.link.startsWith('/#') ? `${getLocalizedPath(lang, '/')}${s.proof.link.slice(1)}` : getLocalizedPath(lang, s.proof.link)} class="svc-proof-link">{s.proof.linkLabel}
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </a>
            </div>

            <a href={getLocalizedPath(lang, s.ctaLink)} class="btn btn-primary svc-cta" data-track-event="service_click" data-track-label={s.ctaLabel}>
              {s.ctaLabel}
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="proceso" class="section">
  <div class="wrap">
    <div class="proc-header">
      <div class="reveal">
        <div class="eyebrow" style="margin-bottom:18px"><span>{t('services.page.how.eyebrow')}</span></div>
        <h2>{t('services.page.how.title.p1')}<br/><span class="serif">{t('services.page.how.title.serif')}</span>.</h2>
      </div>
      <p class="reveal reveal-delay-1">{t('services.page.how.lead')}</p>
    </div>

    <div class="proc">
      {process.map((step, i) => (
        <div class={`step reveal${i > 0 ? ` reveal-delay-${i}` : ''}`}>
          <span class="bignum">{step.n}</span>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
          <ul class="step-details">
            {step.details.map((d) => (
              <li>{d}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="contacto" class="contact-cta">
  <div class="contact-card reveal">
    <div class="eyebrow" style="margin-bottom:16px"><span>{t('contact.cta.eyebrow')}</span></div>
    <h2>{t('contact.cta.title.p1')}<br/>{t('contact.cta.title.p2')} <span class="serif">{t('contact.cta.title.serif')}</span>.</h2>
    <p class="lead">{t('contact.cta.lead')}</p>
    <form class="c-form" id="svc-contact-form"
      data-track-form="contact_form_started"
      data-msg-hp={t('contact.cta.form.success.hp')}
      data-msg-wait={t('contact.cta.form.error.wait')}
      data-msg-conn={t('contact.cta.form.error.conn')}
      data-msg-ok={t('contact.cta.form.success.hp')}
    >
      <div class="hp-field" aria-hidden="true">
        <label for="svc-website">Website</label>
        <input type="text" id="svc-website" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" id="svc-timestamp" name="timestamp" value="" />
      <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
      <input type="hidden" name="subject" value="Nuevo contacto (Servicios) desde creapolis.dev" />
      <input type="hidden" name="from_name" value="Creapolis · Formulario web" />

      <div class="two">
        <label>{t('contact.form.name')}
          <input type="text" name="name" required placeholder="María González" />
        </label>
        <label>{t('contact.form.email')}
          <input type="email" name="email" required placeholder="maria@empresa.com" />
        </label>
      </div>
      <label>{t('contact.form.type')}
        <select name="service">
          <option>{t('contact.form.type.mobile')}</option>
          <option>{t('contact.form.type.web')}</option>
          <option>{t('contact.form.type.desktop')}</option>
          <option>{t('contact.form.type.ai')}</option>
          <option>{t('contact.cta.form.type.consult')}</option>
        </select>
      </label>
      <label>{t('contact.form.message')}
        <textarea name="message" placeholder={t('contact.cta.form.message.placeholder')}></textarea>
      </label>
      <div class="row-cta">
        <button type="submit" class="btn btn-primary btn-lg">{t('contact.form.submit')}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <span class="hint">{t('contact.cta.email.hint')} <a href="mailto:hola@creapolis.dev">hola@creapolis.dev</a></span>
        <span class="ok chip live" hidden style="margin-left:auto"><span class="chip-dot"></span>{t('contact.cta.sent')}</span>
      </div>
      <div id="svc-form-msg" class="form-msg" role="status" aria-live="polite" hidden></div>
    </form>
  </div>
</section>

<Footer lang={lang} />

<style>
  .page-hero {
    padding: 160px var(--gutter) 80px;
    position: relative;
    overflow: clip;
    background:
      radial-gradient(50% 45% at 10% 80%, var(--coral-soft) 0%, transparent 70%),
      radial-gradient(60% 50% at 90% 10%, var(--iris-soft) 0%, transparent 60%),
      var(--paper);
  }
  .page-hero-copy { max-width: 720px; }
  .page-hero h1 { margin-bottom: 24px; }
  .page-hero h1 .serif { color: var(--iris); font-size: 1.02em; }
  .page-hero .lead { max-width: 52ch; }

  .svc-grid { display: grid; gap: 20px; }
  .svc-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: clamp(28px, 4vw, 48px);
    position: relative;
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
    scroll-margin-top: 100px;
  }
  .svc-card:hover { border-color: var(--svc-color); box-shadow: var(--sh-2); }
  .svc-card:nth-child(1) { --svc-color: var(--iris); --svc-soft: var(--iris-soft); }
  .svc-card:nth-child(2) { --svc-color: var(--lime); --svc-soft: var(--lime-soft); }
  .svc-card:nth-child(3) { --svc-color: var(--coral); --svc-soft: var(--coral-soft); }
  .svc-card:nth-child(4) { --svc-color: var(--sky); --svc-soft: var(--sky-soft); }
  .svc-card:nth-child(5) { --svc-color: var(--amber); --svc-soft: var(--amber-soft); }

  .svc-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }
  .svc-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--svc-color);
    margin-bottom: 4px;
  }
  .svc-card h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); }
  .svc-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--svc-color);
    font-size: 1.05rem;
  }

  .svc-body { display: grid; gap: 24px; }
  .svc-field { }
  .svc-label {
    display: block;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 8px;
  }
  .svc-field p { font-size: 1rem; color: var(--ink-2); max-width: 60ch; }
  .svc-outcome p { font-size: 1.05rem; font-weight: 500; color: var(--ink); }

  .svc-deliverables { display: grid; grid-template-columns: 1fr; gap: 10px; }
  @media (min-width: 640px) { .svc-deliverables { grid-template-columns: repeat(2, 1fr); } }
  .svc-del {
    padding: 16px;
    background: var(--chalk);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    display: flex; flex-direction: column; gap: 4px;
  }
  .svc-del strong { font-size: 0.92rem; font-weight: 500; color: var(--ink); }
  .svc-del span { font-size: 0.82rem; color: var(--ink-3); }

  .svc-method { margin-top: 4px; }
  .svc-chips { display: flex; flex-wrap: wrap; gap: 8px; }

  .svc-proof {
    margin-top: 4px;
    padding: 20px 24px;
    border-left: 3px solid var(--svc-color);
    background: color-mix(in oklch, var(--svc-soft) 50%, var(--paper));
    border-radius: 0 var(--r-md) var(--r-md) 0;
  }
  .svc-proof-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--svc-color);
    margin-bottom: 8px;
  }
  .svc-proof p { font-size: 0.95rem; line-height: 1.6; color: var(--ink-2); margin: 0 0 12px; }
  .svc-proof-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--svc-color);
    text-decoration: none;
    transition: gap 0.2s var(--ease);
  }
  .svc-proof-link:hover { gap: 10px; }

  .svc-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    margin-top: 4px;
  }

  .proc-header {
    display: grid;
    gap: 28px;
    grid-template-columns: 1fr;
    margin-bottom: 56px;
    align-items: end;
  }
  @media (min-width: 720px) { .proc-header { grid-template-columns: 1.1fr 1fr; gap: 48px; } }
  .proc-header h2 { max-width: 14ch; }
  .proc-header h2 .serif { color: var(--coral); }
  .proc-header p { font-size: 1.05rem; max-width: 48ch; color: var(--ink-2); }

  .proc { display: grid; grid-template-columns: 1fr; gap: 12px; }
  @media (min-width: 720px) { .proc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .proc { grid-template-columns: repeat(4, 1fr); } }

  .step {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 28px 24px;
    position: relative;
    overflow: hidden;
  }
  .step .bignum {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 5rem;
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--step-color, var(--iris));
  }
  .step h4 { font-size: 1.1rem; margin: 14px 0 6px; }
  .step p { font-size: 0.88rem; color: var(--ink-2); margin-bottom: 16px; }
  .step:nth-child(1) { --step-color: var(--iris); }
  .step:nth-child(2) { --step-color: var(--coral); }
  .step:nth-child(3) { --step-color: var(--lime); }
  .step:nth-child(4) { --step-color: var(--amber); }

  .step-details {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex; flex-direction: column; gap: 4px;
  }
  .step-details li {
    font-size: 0.8rem;
    color: var(--ink-3);
    padding-left: 16px;
    position: relative;
  }
  .step-details li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--step-color, var(--iris));
    font-weight: 700;
  }

  .contact-cta {
    padding: clamp(64px, 9vw, 120px) var(--gutter);
    background: var(--paper);
    position: relative;
  }
  .contact-card {
    max-width: 960px;
    margin: 0 auto;
    background: linear-gradient(180deg, var(--paper), var(--chalk));
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: clamp(40px, 6vw, 72px);
    position: relative;
    overflow: clip;
    box-shadow: var(--sh-3);
  }
  .contact-card::before {
    content: "";
    position: absolute;
    inset: -40% -20% auto auto;
    width: 70%; height: 180%;
    background: radial-gradient(circle, var(--iris-soft) 0%, transparent 60%);
    z-index: 0;
  }
  .contact-card > * { position: relative; z-index: 1; }
  .contact-card h2 { max-width: 22ch; margin-bottom: 14px; }
  .contact-card h2 .serif { color: var(--iris); }
  .contact-card p.lead {
    font-size: 1.1rem;
    max-width: 50ch;
    margin-bottom: 32px;
    color: var(--ink-2);
  }

  .c-form {
    display: grid;
    gap: 14px;
    grid-template-columns: 1fr;
    max-width: 640px;
  }
  @media (min-width: 640px) {
    .c-form .two { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  }
  .c-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .c-form input, .c-form textarea, .c-form select {
    padding: 14px 16px;
    border-radius: var(--r-md);
    border: 1px solid var(--line-2);
    background: var(--paper);
    font-size: 1rem;
    font-family: var(--font-sans);
    color: var(--ink);
    transition: border-color 0.2s, box-shadow 0.2s;
    text-transform: none;
    letter-spacing: normal;
  }
  .c-form input:focus, .c-form textarea:focus, .c-form select:focus {
    outline: none;
    border-color: var(--iris);
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--iris) 20%, transparent);
  }
  .c-form textarea { resize: vertical; min-height: 120px; }
  .c-form .row-cta {
    display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-top: 6px;
  }
  .c-form .hint { font-size: 0.82rem; color: var(--ink-3); font-family: var(--font-mono); }
  .c-form .hint a { color: var(--iris); font-weight: 500; }

  .hp-field {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    overflow: hidden;
  }

  .form-msg {
    padding: 14px 18px;
    border-radius: var(--r-md);
    font-size: 0.92rem;
    margin-top: 4px;
  }
  .form-msg.success {
    background: var(--lime-soft);
    color: oklch(0.45 0.12 128);
    border: 1px solid color-mix(in oklch, var(--lime) 30%, var(--line));
  }
  .form-msg.error {
    background: var(--coral-soft);
    color: oklch(0.45 0.12 25);
    border: 1px solid color-mix(in oklch, var(--coral) 30%, var(--line));
  }
</style>

<script>
  import { trackEvent } from '../../lib/analytics';
  const form = document.getElementById('svc-contact-form') as HTMLFormElement;
  const msgEl = document.getElementById('svc-form-msg');
  const honeypot = document.getElementById('svc-website') as HTMLInputElement;
  const tsInput = document.getElementById('svc-timestamp') as HTMLInputElement;

  if (tsInput) tsInput.value = Date.now().toString();

  let submitting = false;
  const MAX_RETRIES = 2;
  const TIMEOUT_MS = 10000;

  function setMsg(type: 'success' | 'error', text: string, retryable = false) {
    if (!msgEl) return;
    msgEl.hidden = false;
    msgEl.className = `form-msg ${type}`;
    msgEl.textContent = text;
    if (retryable) {
      const retryBtn = document.createElement('button');
      retryBtn.type = 'button';
      retryBtn.className = 'btn btn-ghost retry-btn';
      retryBtn.textContent = 'Reintentar';
      retryBtn.setAttribute('aria-label', 'Reintentar envío del formulario');
      retryBtn.style.marginTop = '12px';
      retryBtn.addEventListener('click', () => form?.requestSubmit());
      msgEl.appendChild(retryBtn);
    }
  }

  function buildPayload(): Record<string, unknown> {
    const fd = new FormData(form);
    return {
      access_key: fd.get('access_key'),
      subject: fd.get('subject'),
      from_name: fd.get('from_name'),
      name: fd.get('name'),
      email: fd.get('email'),
      service: fd.get('service'),
      message: fd.get('message'),
      botcheck: fd.get('website'),
      timestamp: fd.get('timestamp'),
    };
  }

  async function submitWithTimeout(payload: Record<string, unknown>): Promise<{success: boolean}> {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
        signal: controller.signal,
      });
      return await res.json();
    } finally {
      clearTimeout(timer);
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitting) return;

    const msgHp = form.dataset.msgHp || '';
    const msgWait = form.dataset.msgWait || '';
    const msgConn = form.dataset.msgConn || '';
    const msgOk = form.dataset.msgOk || '';

    if (honeypot?.value) {
      setMsg('success', msgHp);
      form.reset();
      return;
    }

    const submittedAt = Date.now();
    const loadedAt = parseInt(tsInput?.value || '0');
    if (submittedAt - loadedAt < 2000) {
      setMsg('error', msgWait);
      return;
    }

    submitting = true;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const okChip = form.querySelector('.ok') as HTMLElement;
    if (btn) btn.disabled = true;
    form.setAttribute('aria-busy', 'true');
    if (msgEl) msgEl.hidden = true;

    const payload = buildPayload();
    let lastError = '';

    for (let attempt = 0; attempt <= MAX_RETRIES; attempt++) {
      try {
        const result = await submitWithTimeout(payload);
        if (result.success) {
          setMsg('success', msgOk);
          form.reset();
          trackEvent?.('contact_form_completed');
          if (okChip) okChip.hidden = false;
          setTimeout(() => { if (okChip) okChip.hidden = true; }, 4000);
          submitting = false;
          if (btn) btn.disabled = false;
          form.removeAttribute('aria-busy');
          return;
        }
        lastError = msgConn;
      } catch (err: unknown) {
        lastError = err instanceof DOMException && err.name === 'AbortError'
          ? 'Tiempo de espera agotado. Verifica tu conexión.'
          : msgConn;
      }
      if (attempt < MAX_RETRIES) {
        await new Promise(r => setTimeout(r, 1000 * (attempt + 1)));
      }
    }

    setMsg('error', lastError, true);
    submitting = false;
    if (btn) btn.disabled = false;
    form.removeAttribute('aria-busy');
  });
</script>
