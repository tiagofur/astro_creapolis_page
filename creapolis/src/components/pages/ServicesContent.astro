---
import { getServicesData } from '../../i18n/data/services';
import type { Lang } from '../../i18n/ui';
import { getLocalizedPath, useTranslations } from '../../i18n/utils';
import Footer from '../Footer.astro';
import Nav from '../Nav.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Web3Forms access key (pública, client-side, no es secreta).
// Generala gratis en https://web3forms.com y ponela en la env WEB3FORMS_KEY.
const WEB3FORMS_KEY =
  import.meta.env.WEB3FORMS_KEY || 'YOUR_WEB3FORMS_ACCESS_KEY';
const { services, process } = getServicesData(lang);

/* ─── CMYK accent cycle: cyan → magenta → yellow ─── */
const ACCENTS = ['var(--c-cyan)', 'var(--c-magenta)', 'var(--c-yellow)'] as const;
---

<Nav lang={lang} />

<header class="page-hero">
  <div class="wrap">
    <div class="page-hero-copy reveal">
      <p class="eyebrow" style="margin-bottom:18px; --accent-color: var(--c-cyan);"><span>{t('services.page.eyebrow')}</span></p>
      <h1>{t('services.page.title.p1')}<br/><span class="tone">{t('services.page.title.serif')}.</span></h1>
      <p class="lead">{t('services.page.lead')}</p>
    </div>
  </div>
</header>

<section class="section section-alt">
  <div class="wrap">
    <div class="svc-grid">
      {services.map((s, i) => (
        <article
          id={s.id}
          class={`svc-card reveal${i > 0 ? ` reveal-delay-${Math.min(i, 4)}` : ''}`}
          style={`--accent-color: ${ACCENTS[i % 3]};`}
        >
          <span class="card-bar" aria-hidden="true"></span>

          <div class="svc-head">
            <div class="svc-head-top">
              <span class="svc-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="svc-badges">
                {s.timeline && <span class="svc-timeline">{s.timeline}</span>}
                {s.price && <span class="svc-price">{s.price}</span>}
              </div>
            </div>
            <h2>{s.title}</h2>
            <p class="svc-tagline">{s.tagline}</p>
          </div>

          <div class="svc-body">
            {s.desc && <p class="svc-desc-text">{s.desc}</p>}

            <div class="svc-field">
              <span class="svc-label">{t('services.page.audience')}</span>
              <p>{s.audience}</p>
            </div>

            <div class="svc-field svc-outcome">
              <span class="svc-label">{t('services.page.outcome')}</span>
              <p>{s.outcome}</p>
            </div>

            <div class="svc-field">
              <span class="svc-label">{t('services.page.deliverables')}</span>
              <ul class="svc-deliverables">
                {s.deliverables.map((d) => (
                  <li class="svc-del">
                    <strong>{d.title}</strong>
                    <span>{d.desc}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="svc-field svc-method">
              <span class="svc-label">{t('services.page.method')}</span>
              <div class="svc-chips">
                {s.tech.map((tech) => (
                  <span class="chip">{tech}</span>
                ))}
              </div>
            </div>

            <div class="svc-proof">
              <span class="svc-proof-label">{s.proof.label}</span>
              <p>{s.proof.text}</p>
              <a href={s.proof.link.startsWith('/#') ? `${getLocalizedPath(lang, '/')}${s.proof.link.slice(1)}` : getLocalizedPath(lang, s.proof.link)} class="svc-proof-link">{s.proof.linkLabel}
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </a>
            </div>

            <a href={getLocalizedPath(lang, s.ctaLink)} class="btn btn-primary svc-cta" data-track-event="service_click" data-track-label={s.ctaLabel}>
              {s.ctaLabel}
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="proceso" class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow" style="--accent-color: var(--c-magenta);"><span>{t('services.page.how.eyebrow')}</span></p>
      <h2 class="section-title">{t('services.page.how.title.p1')} <span class="tone">{t('services.page.how.title.serif')}.</span></h2>
    </div>
    <p class="section-lead reveal reveal-delay-1">{t('services.page.how.lead')}</p>

    <div class="hairline-grid proc-grid reveal">
      {process.map((step, i) => (
        <div class={`hairline-cell step${i > 0 ? ` reveal reveal-delay-${Math.min(i, 4)}` : ' reveal'}`}>
          <span class="step-number">{step.n}</span>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
          <ul class="step-details">
            {step.details.map((d) => (
              <li>{d}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="contacto" class="section contact-cta">
  <div class="wrap">
    <div class="contact-card reveal">
      <p class="eyebrow" style="margin-bottom:16px; --accent-color: var(--c-yellow);"><span>{t('contact.cta.eyebrow')}</span></p>
      <h2>{t('contact.cta.title.p1')}<br/>{t('contact.cta.title.p2')} <span class="tone">{t('contact.cta.title.serif')}.</span></h2>
      <p class="lead">{t('contact.cta.lead')}</p>
      <form class="c-form" id="svc-contact-form"
        data-track-form="contact_form_started"
        data-msg-hp={t('contact.cta.form.success.hp')}
        data-msg-wait={t('contact.cta.form.error.wait')}
        data-msg-conn={t('contact.cta.form.error.conn')}
        data-msg-ok={t('contact.cta.form.success.hp')}
      >
        <div class="hp-field" aria-hidden="true">
          <label for="svc-website">Website</label>
          <input type="text" id="svc-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" id="svc-timestamp" name="timestamp" value="" />
        <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
        <input type="hidden" name="subject" value="Nuevo contacto (Servicios) desde creapolis.dev" />
        <input type="hidden" name="from_name" value="Creapolis · Formulario web" />

        <div class="two">
          <label>{t('contact.form.name')}
            <input type="text" name="name" required placeholder="María González" />
          </label>
          <label>{t('contact.form.email')}
            <input type="email" name="email" required placeholder="maria@empresa.com" />
          </label>
        </div>
        <label>{t('contact.form.type')}
          <select name="service">
            <option>{t('contact.form.type.mobile')}</option>
            <option>{t('contact.form.type.web')}</option>
            <option>{t('contact.form.type.desktop')}</option>
            <option>{t('contact.form.type.ai')}</option>
            <option>{t('contact.cta.form.type.consult')}</option>
          </select>
        </label>
        <label>{t('contact.form.message')}
          <textarea name="message" placeholder={t('contact.cta.form.message.placeholder')}></textarea>
        </label>
        <div class="row-cta">
          <button type="submit" class="btn btn-primary btn-lg">{t('contact.form.submit')}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <span class="hint">{t('contact.cta.email.hint')} <a href="mailto:hola@creapolis.dev">hola@creapolis.dev</a></span>
          <span class="ok chip live" hidden style="margin-left:auto"><span class="chip-dot"></span>{t('contact.cta.sent')}</span>
        </div>
        <div id="svc-form-msg" class="form-msg" role="status" aria-live="polite" hidden></div>
      </form>
    </div>
  </div>
</section>

<Footer lang={lang} hideCta={true} />

<style>
  .tone {
    color: var(--ink-4);
  }

  /* ═══════════════════════════════════════════════════════════════
     HERO — white canvas, two-tone headline
     ═══════════════════════════════════════════════════════════════ */
  .page-hero {
    padding: 168px var(--gutter) 72px;
    background: var(--paper);
  }
  .page-hero-copy {
    max-width: 720px;
  }
  .page-hero h1 {
    margin-bottom: 24px;
  }
  .page-hero .lead {
    max-width: 52ch;
  }

  .section {
    padding: clamp(72px, 9vw, 120px) 0;
  }
  .section-alt {
    background: var(--chalk);
  }

  .section-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 40px;
    max-width: 640px;
  }
  .section-head .eyebrow {
    margin: 0;
  }
  .section-title {
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
    line-height: 1.08;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .section-lead {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-3);
    max-width: 60ch;
    margin: -20px 0 40px;
  }

  /* ═══════════════════════════════════════════════════════════════
     SERVICE CARDS — zai color-card: white, hairline, 3px accent bar
     ═══════════════════════════════════════════════════════════════ */
  .svc-grid {
    display: grid;
    gap: 20px;
  }

  .svc-card {
    position: relative;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: clamp(28px, 4vw, 48px);
    overflow: hidden;
    scroll-margin-top: 100px;
    transition:
      box-shadow 0.25s var(--ease),
      transform 0.25s var(--ease);
  }
  .svc-card:hover {
    box-shadow: var(--sh-hover);
    transform: translateY(-4px);
  }

  .svc-head {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }
  .svc-head-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }
  .svc-num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    color: var(--ink-4);
  }
  .svc-badges {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .svc-timeline {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-4);
  }
  .svc-price {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: var(--fw-medium);
    color: var(--ink-2);
    background: var(--chalk-2);
    padding: 4px 10px;
    border-radius: var(--r-pill);
  }
  .svc-card h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
  }
  .svc-tagline {
    font-size: 1.02rem;
    line-height: 1.5;
    color: var(--ink-3);
    max-width: 60ch;
  }

  .svc-body {
    display: grid;
    gap: 24px;
  }
  .svc-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    color: var(--ink-4);
    margin-bottom: 10px;
  }
  .svc-desc-text {
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 68ch;
  }
  .svc-field p {
    font-size: 1rem;
    color: var(--ink-2);
    max-width: 60ch;
  }
  .svc-outcome p {
    font-size: 1.05rem;
    font-weight: var(--fw-medium);
    color: var(--ink);
  }

  /* Deliverables — clean hairline list */
  .svc-deliverables {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .svc-deliverables {
      grid-template-columns: repeat(2, 1fr);
    }
    .svc-deliverables li:nth-last-child(1):nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  .svc-del {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 16px 16px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .svc-del {
      padding-right: 24px;
    }
    .svc-del:nth-child(odd) {
      padding-right: 24px;
    }
    .svc-del:nth-child(even) {
      padding-left: 24px;
    }
  }
  .svc-del strong {
    font-size: 0.92rem;
    font-weight: var(--fw-semibold);
    color: var(--ink);
  }
  .svc-del span {
    font-size: 0.82rem;
    color: var(--ink-3);
    line-height: 1.5;
  }

  .svc-method {
    margin-top: 4px;
  }
  .svc-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Case proof — hairline note with 3px accent edge */
  .svc-proof {
    margin-top: 4px;
    padding: 20px 24px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent-color, var(--c-cyan));
    border-radius: 0 var(--r-md) var(--r-md) 0;
    background: var(--chalk);
  }
  .svc-proof-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: var(--ls-mono);
    color: var(--ink-4);
    margin-bottom: 8px;
  }
  .svc-proof p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0 0 12px;
  }
  .svc-proof-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line-2);
    padding-bottom: 2px;
    transition: border-color 0.2s, gap 0.2s var(--ease);
  }
  .svc-proof-link:hover {
    border-color: var(--ink);
    gap: 10px;
  }

  .svc-cta {
    width: fit-content;
    margin-top: 4px;
  }

  /* ═══════════════════════════════════════════════════════════════
     PROCESS — hairline grid
     ═══════════════════════════════════════════════════════════════ */
  .hairline-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    overflow: hidden;
  }
  .hairline-cell {
    background: #ffffff;
    padding: 26px 24px;
  }
  .step-number {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    color: var(--ink-4);
    margin-bottom: 10px;
  }
  .hairline-cell h3 {
    font-size: 1.05rem;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.015em;
    margin: 0 0 6px 0;
  }
  .hairline-cell p {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--ink-3);
    margin: 0 0 14px 0;
  }
  .step-details {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .step-details li {
    font-size: 0.8rem;
    color: var(--ink-3);
    padding-left: 14px;
    position: relative;
    line-height: 1.45;
  }
  .step-details li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--ink-4);
  }

  /* ═══════════════════════════════════════════════════════════════
     CONTACT — white card, flat hairline, black-focus inputs
     ═══════════════════════════════════════════════════════════════ */
  .contact-card {
    max-width: 960px;
    margin: 0 auto;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: clamp(40px, 6vw, 72px);
  }
  .contact-card h2 {
    max-width: 22ch;
    margin-bottom: 14px;
  }
  .contact-card p.lead {
    font-size: 1.1rem;
    max-width: 50ch;
    margin-bottom: 32px;
    color: var(--ink-3);
  }

  .c-form {
    display: grid;
    gap: 14px;
    grid-template-columns: 1fr;
    max-width: 640px;
  }
  @media (min-width: 640px) {
    .c-form .two {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
  }
  .c-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .c-form input,
  .c-form textarea,
  .c-form select {
    padding: 14px 16px;
    border-radius: var(--r-sm);
    border: 1px solid var(--line-2);
    background: #ffffff;
    font-size: 1rem;
    font-family: var(--font-sans);
    color: var(--ink);
    text-transform: none;
    letter-spacing: normal;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .c-form input:focus,
  .c-form textarea:focus,
  .c-form select:focus {
    outline: 2px solid var(--ink);
    outline-offset: 0;
    border-color: var(--ink);
    box-shadow: 0 0 0 4px rgba(24, 24, 27, 0.1);
  }
  .c-form textarea {
    resize: vertical;
    min-height: 120px;
  }
  .c-form .row-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    margin-top: 6px;
  }
  .c-form .hint {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-4);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .c-form .hint a {
    color: var(--ink-2);
    font-weight: var(--fw-medium);
    border-bottom: 1px solid var(--line-2);
    transition: color 0.2s, border-color 0.2s;
  }
  .c-form .hint a:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    overflow: hidden;
  }

  .form-msg {
    padding: 14px 18px;
    border-radius: var(--r-sm);
    font-size: 0.92rem;
    margin-top: 4px;
  }
  .form-msg.success {
    background: var(--c-cyan-soft);
    color: var(--c-cyan-3);
    border: 1px solid rgba(0, 174, 239, 0.3);
  }
  .form-msg.error {
    background: var(--c-magenta-soft);
    color: #c40075;
    border: 1px solid rgba(236, 0, 140, 0.3);
  }
</style>

<script>
  import { trackEvent } from '../../lib/analytics';
  const form = document.getElementById('svc-contact-form') as HTMLFormElement;
  const msgEl = document.getElementById('svc-form-msg');
  const honeypot = document.getElementById('svc-website') as HTMLInputElement;
  const tsInput = document.getElementById('svc-timestamp') as HTMLInputElement;

  if (tsInput) tsInput.value = Date.now().toString();

  let submitting = false;
  const MAX_RETRIES = 2;
  const TIMEOUT_MS = 10000;

  function setMsg(type: 'success' | 'error', text: string, retryable = false) {
    if (!msgEl) return;
    msgEl.hidden = false;
    msgEl.className = `form-msg ${type}`;
    msgEl.textContent = text;
    if (retryable) {
      const retryBtn = document.createElement('button');
      retryBtn.type = 'button';
      retryBtn.className = 'btn btn-ghost retry-btn';
      retryBtn.textContent = 'Reintentar';
      retryBtn.setAttribute('aria-label', 'Reintentar envío del formulario');
      retryBtn.style.marginTop = '12px';
      retryBtn.addEventListener('click', () => form?.requestSubmit());
      msgEl.appendChild(retryBtn);
    }
  }

  function buildPayload(): Record<string, unknown> {
    const fd = new FormData(form);
    return {
      access_key: fd.get('access_key'),
      subject: fd.get('subject'),
      from_name: fd.get('from_name'),
      name: fd.get('name'),
      email: fd.get('email'),
      service: fd.get('service'),
      message: fd.get('message'),
      botcheck: fd.get('website'),
      timestamp: fd.get('timestamp'),
    };
  }

  async function submitWithTimeout(payload: Record<string, unknown>): Promise<{success: boolean}> {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
        signal: controller.signal,
      });
      return await res.json();
    } finally {
      clearTimeout(timer);
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitting) return;

    const msgHp = form.dataset.msgHp || '';
    const msgWait = form.dataset.msgWait || '';
    const msgConn = form.dataset.msgConn || '';
    const msgOk = form.dataset.msgOk || '';

    if (honeypot?.value) {
      setMsg('success', msgHp);
      form.reset();
      return;
    }

    const submittedAt = Date.now();
    const loadedAt = parseInt(tsInput?.value || '0');
    if (submittedAt - loadedAt < 2000) {
      setMsg('error', msgWait);
      return;
    }

    submitting = true;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const okChip = form.querySelector('.ok') as HTMLElement;
    if (btn) btn.disabled = true;
    form.setAttribute('aria-busy', 'true');
    if (msgEl) msgEl.hidden = true;

    const payload = buildPayload();
    let lastError = '';

    for (let attempt = 0; attempt <= MAX_RETRIES; attempt++) {
      try {
        const result = await submitWithTimeout(payload);
        if (result.success) {
          setMsg('success', msgOk);
          form.reset();
          trackEvent?.('contact_form_completed');
          if (okChip) okChip.hidden = false;
          setTimeout(() => { if (okChip) okChip.hidden = true; }, 4000);
          submitting = false;
          if (btn) btn.disabled = false;
          form.removeAttribute('aria-busy');
          return;
        }
        lastError = msgConn;
      } catch (err: unknown) {
        lastError = err instanceof DOMException && err.name === 'AbortError'
          ? 'Tiempo de espera agotado. Verifica tu conexión.'
          : msgConn;
      }
      if (attempt < MAX_RETRIES) {
        await new Promise(r => setTimeout(r, 1000 * (attempt + 1)));
      }
    }

    setMsg('error', lastError, true);
    submitting = false;
    if (btn) btn.disabled = false;
    form.removeAttribute('aria-busy');
  });
</script>
