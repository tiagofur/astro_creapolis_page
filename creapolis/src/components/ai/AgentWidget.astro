---
import type { Lang } from '../../i18n/ui';
import CubePyramid from '../brand/CubePyramid.astro';
import CmyDots from '../brand/CmyDots.astro';

interface Props {
  lang: Lang;
  variant?: 'inline' | 'floating';
}

const { lang, variant = 'floating' } = Astro.props;

const labels = {
  es: {
    agentTitle: 'Creapolis AI Concierge',
    agentSubtitle: 'Agente autónomo · Citas & Calificación',
    statusOnline: 'En línea',
    placeholder: 'Escribe tu duda o pide agendar una cita...',
    btnSend: 'Enviar',
    quickChips: [
      '🤖 Agente WhatsApp + Citas + CRM',
      '⚡ Automatizar operaciones y soporte',
      '📱 Desarrollar una app o MVP a medida',
      '📅 Agendar llamada en el calendario',
    ],
    initialMsg: '¡Hola! Soy el agente de Creapolis. Puedo cotizar tu proyecto, mostrarte cómo automatizamos flujos de atención y agendar una llamada directa con Tiago en su calendario. ¿En qué te puedo ayudar hoy?',
    bookDirect: 'Abrir calendario completo →',
    typingSoon: 'Revisando tu consulta…',
    typingLong: 'Casi listo…',
  },
  en: {
    agentTitle: 'Creapolis AI Concierge',
    agentSubtitle: 'Autonomous Agent · Scheduling & Scoping',
    statusOnline: 'Online',
    placeholder: 'Ask a question or request a calendar slot...',
    btnSend: 'Send',
    quickChips: [
      '🤖 WhatsApp Agent + Booking + CRM',
      '⚡ Automate internal operations',
      '📱 Custom App or MVP Build',
      '📅 Book a 30-min discovery call',
    ],
    initialMsg: 'Hi! I am the Creapolis AI concierge. I can scope your workflow, demonstrate how our automated appointment agents work, and book a direct call on Tiago’s calendar. How can I help you today?',
    bookDirect: 'Open full calendar →',
    typingSoon: 'Looking into that…',
    typingLong: 'Almost there…',
  },
  pt: {
    agentTitle: 'Creapolis AI Concierge',
    agentSubtitle: 'Agente autônomo · Agendamento & Escopo',
    statusOnline: 'Online',
    placeholder: 'Digite sua dúvida ou peça um horário na agenda...',
    btnSend: 'Enviar',
    quickChips: [
      '🤖 Agente WhatsApp + Agendamento + CRM',
      '⚡ Automatizar operações internas',
      '📱 Desenvolver app ou MVP sob medida',
      '📅 Agendar reunião no calendário',
    ],
    initialMsg: 'Olá! Sou o agente virtual da Creapolis. Posso analisar seu projeto, mostrar como funcionam nossos fluxos automáticos de agendamento e marcar uma reunião na agenda do Tiago. Como posso te ajudar hoje?',
    bookDirect: 'Abrir calendário completo →',
    typingSoon: 'Verificando sua consulta…',
    typingLong: 'Quase lá…',
  },
}[lang];
---

<div class={`creapolis-agent-wrapper ${variant}`} data-agent-widget data-lang={lang} data-typing-soon={labels.typingSoon} data-typing-long={labels.typingLong}>
  {variant === 'floating' && (
    <button
      type="button"
      class="agent-launcher-btn"
      data-agent-toggle
      aria-label="Abrir asistente de IA"
      aria-expanded="false"
    >
      <div class="launcher-avatar">
        <CubePyramid size={20} variant="cmyk" />
      </div>
      <div class="launcher-text">
        <span class="launcher-title">{labels.agentTitle}</span>
        <span class="launcher-sub"><span class="pulse-dot"></span> {labels.statusOnline}</span>
      </div>
      <svg class="launcher-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <svg class="launcher-icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  )}

  <div class={`agent-panel ${variant === 'inline' ? 'agent-panel--inline' : 'agent-panel--floating'}`} data-agent-panel>
    <div class="agent-panel-header">
      <div class="agent-panel-header-info">
        <CubePyramid size={22} variant="cmyk" />
        <div>
          <h4>{labels.agentTitle}</h4>
          <p><span class="pulse-dot"></span> {labels.agentSubtitle}</p>
        </div>
      </div>
      <div class="agent-panel-header-actions">
        <CmyDots size={4} />
        {variant === 'floating' && (
          <button type="button" class="agent-close-btn" data-agent-close aria-label="Cerrar asistente">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        )}
      </div>
    </div>

    <div class="agent-messages" data-agent-messages tabindex="0" role="log" aria-live="polite">
      <div class="agent-msg assistant">
        <div class="msg-bubble">
          <p>{labels.initialMsg}</p>
        </div>
      </div>
    </div>

    <!-- Quick action chips -->
    <div class="agent-chips" data-agent-chips>
      {labels.quickChips.map((chip) => (
        <button type="button" class="chip-btn" data-chip-text={chip}>
          {chip}
        </button>
      ))}
    </div>

    <form class="agent-input-bar" data-agent-form>
      <input
        type="text"
        class="agent-input"
        data-agent-input
        placeholder={labels.placeholder}
        aria-label="Mensaje para el agente"
        required
      />
      <button type="submit" class="agent-send-btn" aria-label={labels.btnSend}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
  </div>
</div>

<style>
  .creapolis-agent-wrapper.floating {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999;
  }
  /* ─── Launcher — black pill with cyan status dot ─── */
  .agent-launcher-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--key);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--r-pill);
    padding: 8px 16px 8px 10px;
    box-shadow: var(--sh-3);
    cursor: pointer;
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .agent-launcher-btn:hover {
    transform: translateY(-2px);
  }
  .agent-launcher-btn:active {
    transform: scale(0.98);
  }
  .launcher-avatar {
    width: 32px;
    height: 32px;
    background: var(--ink);
    border-radius: var(--r-pill);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .launcher-text {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .launcher-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.25;
  }
  .launcher-sub {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: #a1a1aa;
    display: flex;
    align-items: center;
    gap: 5px;
    line-height: 1.3;
  }
  /* Cyan status dot + ping */
  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-cyan);
    display: inline-block;
    position: relative;
    flex-shrink: 0;
  }
  .pulse-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--c-cyan);
    opacity: 0.4;
    animation: agent-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes agent-ping {
    75%, 100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  /* ─── Panel — white, hairline, r-xl, floating shadow ─── */
  .agent-panel {
    background: #ffffff;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .agent-panel--floating {
    position: absolute;
    bottom: 56px;
    right: 0;
    width: 380px;
    max-width: calc(100vw - 32px);
    height: 520px;
    max-height: calc(100vh - 120px);
    box-shadow: var(--sh-3);
    display: none;
  }
  .creapolis-agent-wrapper.active .agent-panel--floating {
    display: flex;
    animation: agentPopup 0.25s var(--ease);
  }
  @keyframes agentPopup {
    from { opacity: 0; transform: translateY(12px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .agent-panel--inline {
    width: 100%;
    height: 480px;
    box-shadow: var(--sh-1);
  }

  /* ─── Header — mark + mono title + close ─── */
  .agent-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: #ffffff;
    border-bottom: 1px solid var(--line);
  }
  .agent-panel-header-info {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .agent-panel-header-info h4 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink);
  }
  .agent-panel-header-info p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--ink-4);
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .agent-panel-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .agent-close-btn {
    background: transparent;
    border: 1px solid var(--line-2);
    cursor: pointer;
    color: var(--ink-3);
    padding: 5px;
    border-radius: var(--r-pill);
    display: flex;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .agent-close-btn:hover {
    background: var(--chalk-2);
    border-color: #d4d4d8;
    color: var(--ink);
  }

  /* ─── Messages — bubbles ─── */
  .agent-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #ffffff;
  }
  /* ─── Messages — bubbles (chat rows are JS-injected, so these stay global too) ─── */
  :global(.agent-msg) {
    display: flex;
    flex-direction: column;
    max-width: 85%;
  }
  :global(.agent-msg.assistant) {
    align-self: flex-start;
  }
  :global(.agent-msg.user) {
    align-self: flex-end;
  }
  :global(.agent-msg .msg-bubble) {
    padding: 10px 14px;
    border-radius: var(--r-md);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  :global(.agent-msg.assistant .msg-bubble) {
    background: var(--chalk);
    color: var(--ink);
    border-bottom-left-radius: 4px;
  }
  :global(.msg-bubble p) {
    margin: 0;
    /* Beat the site-wide `p { color: ... }` rule; bubbles own their text color. */
    color: inherit;
  }
  /* User bubbles cycle the CMYK brand inks: cyan → magenta → yellow. */
  :global(.agent-msg.user .msg-bubble) {
    background: var(--c-cyan-soft);
    color: var(--ink);
    border: 1px solid rgba(0, 174, 239, 0.35);
    border-bottom-right-radius: 4px;
  }
  :global(.agent-msg.user.cmy-1 .msg-bubble) {
    background: var(--c-magenta-soft);
    border-color: rgba(236, 0, 140, 0.3);
  }
  :global(.agent-msg.user.cmy-2 .msg-bubble) {
    background: var(--c-yellow-soft);
    border-color: rgba(255, 196, 0, 0.5);
  }
  :global(.msg-bubble strong) {
    font-weight: var(--fw-semibold, 600);
  }

  /* ─── JS-injected nodes never get Astro's scope attribute, so these must stay global ─── */
  :global(.agent-action-card) {
    margin-top: 8px;
    background: #ffffff;
    border: 1px solid var(--line-2);
    border-radius: var(--r-md);
    padding: 12px;
  }
  :global(.agent-slots-grid) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 8px;
  }
  :global(.slot-btn) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--chalk-2);
    border: 1px solid transparent;
    padding: 8px 12px;
    border-radius: var(--r-sm);
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    color: var(--ink);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  :global(.slot-btn:hover) {
    background: var(--c-cyan);
    color: #ffffff;
    border-color: var(--c-cyan);
  }
  :global(.action-calendar-link) {
    display: inline-block;
    margin-top: 8px;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    color: var(--c-cyan-3);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(.action-calendar-link:hover) {
    text-decoration-thickness: 2px;
  }

  /* ─── Typing indicator — CMY dots in an assistant bubble (JS-injected) ─── */
  :global(.agent-msg.typing .msg-bubble) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 13px 14px;
  }
  :global(.typing-dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    animation: typingBounce 1.2s ease-in-out infinite;
  }
  :global(.typing-dot:nth-child(1)) { background: var(--c-cyan); }
  :global(.typing-dot:nth-child(2)) { background: var(--c-magenta); animation-delay: 0.15s; }
  :global(.typing-dot:nth-child(3)) { background: var(--c-yellow); animation-delay: 0.3s; }
  /* Staged status text that fades in on slower turns (populated by the client). */
  :global(.typing-label) {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--ink-4);
    margin-left: 3px;
    animation: typingLabelIn 0.3s ease-out;
  }
  @keyframes typingLabelIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes typingBounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.35; }
    30% { transform: translateY(-4px); opacity: 1; }
  }
  :global(.agent-chips.is-busy .chip-btn),
  :global(.agent-send-btn.is-busy) {
    opacity: 0.45;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse-dot::after,
    :global(.typing-dot) {
      animation: none;
    }
    :global(.typing-dot) {
      opacity: 0.6;
    }
  }

  /* ─── Scenario chips — mono zinc pills ─── */
  .agent-chips {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding: 8px 12px;
    background: #ffffff;
    border-top: 1px solid var(--line);
    scrollbar-width: none;
  }
  .agent-chips::-webkit-scrollbar {
    display: none;
  }
  .chip-btn {
    white-space: nowrap;
    background: #ffffff;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
    padding: 5px 11px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: var(--fw-medium);
    color: var(--ink-3);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .chip-btn:hover {
    background: var(--chalk);
    border-color: #d4d4d8;
    color: var(--ink);
  }

  /* ─── Input row — white input, zinc border, black send pill ─── */
  .agent-input-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    background: #ffffff;
    border-top: 1px solid var(--line);
  }
  .agent-input {
    flex: 1;
    border: 1px solid var(--line-2);
    background: #ffffff;
    border-radius: var(--r-sm);
    padding: 8px 12px;
    font-size: 0.8125rem;
    color: var(--ink);
    outline: none;
    min-width: 0;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .agent-input:focus {
    border-color: var(--ink);
    box-shadow: 0 0 0 4px rgba(24, 24, 27, 0.1);
  }
  .agent-send-btn {
    background: var(--ink);
    color: #ffffff;
    border: none;
    border-radius: var(--r-pill);
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    cursor: pointer;
    transition: background 0.15s, transform 0.15s;
  }
  .agent-send-btn:hover {
    background: var(--ink-2);
  }
  .agent-send-btn:active {
    transform: scale(0.96);
  }

  @media (max-width: 420px) {
    .creapolis-agent-wrapper.floating {
      right: 12px;
      bottom: 12px;
    }
    .agent-launcher-btn {
      padding: 8px 12px 8px 8px;
      gap: 8px;
    }
    .agent-panel--floating {
      max-width: calc(100vw - 24px);
    }
  }
</style>

<script>
  // Lazy bootstrap: the ~6KB agent client loads on first interaction only.
  // Keeps every page's eager JS tiny; the panel opens on the first click.
  let booted = false;
  function boot(origin: HTMLElement | null) {
    if (booted) return;
    booted = true;
    import('./agent-widget-client').then(() => {
      // Replay the first toggle click: listeners attach after import resolves.
      const widget = origin?.closest('[data-agent-widget]');
      const toggle = widget?.querySelector<HTMLElement>('[data-agent-toggle]');
      if (toggle && origin && (origin === toggle || toggle.contains(origin))) {
        toggle.click();
      }
    });
  }
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest?.('[data-agent-widget]')) boot(target);
  });
</script>
