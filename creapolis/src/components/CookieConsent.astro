---
/**
 * Privacy-aware cookie consent banner.
 * Shows on first visit, stores choice in localStorage.
 * Localized for ES, EN, PT.
 */
import type { Lang } from '../i18n/ui';
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);

const labels = {
  es: {
    text: '🍪 Usamos analíticas anónimas para entender cómo se usa el sitio. No recopilamos datos personales ni usamos rastreadores invasivos.',
    more: 'Política de privacidad',
    accept: 'Aceptar',
    deny: 'Rechazar',
    privacyHref: getLocalizedPath('es', '/privacidad'),
  },
  en: {
    text: '🍪 We use anonymous analytics to understand how this site is used. No personal data or invasive trackers are used.',
    more: 'Privacy policy',
    accept: 'Accept',
    deny: 'Decline',
    privacyHref: getLocalizedPath('en', '/privacy-policy'),
  },
  pt: {
    text: '🍪 Usamos análises anônimas para entender o uso do site. Nenhum dado pessoal ou rastreador invasivo é coletado.',
    more: 'Política de privacidade',
    accept: 'Aceitar',
    deny: 'Recusar',
    privacyHref: getLocalizedPath('pt', '/privacidade'),
  },
}[lang];
---

<div id="cookie-consent" class="cookie-consent" role="dialog" aria-label="Consentimiento de privacidad" aria-live="polite" hidden>
  <div class="cookie-inner">
    <p class="cookie-text">
      {labels.text}
      <a href={labels.privacyHref} class="cookie-link">{labels.more}</a>
    </p>
    <div class="cookie-actions">
      <button id="cookie-accept" class="cookie-btn cookie-btn--accept" type="button">
        {labels.accept}
      </button>
      <button id="cookie-deny" class="cookie-btn cookie-btn--deny" type="button">
        {labels.deny}
      </button>
    </div>
  </div>
</div>

<style>
  .cookie-consent {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: #ffffff;
    color: var(--ink);
    border-top: 1px solid var(--line);
    padding: 16px 24px;
    animation: slide-up 0.3s ease-out;
    box-shadow: 0 -12px 40px rgba(9, 9, 11, 0.08);
  }
  .cookie-inner {
    max-width: 1152px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .cookie-text {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-3);
    margin: 0;
    flex: 1;
    min-width: 280px;
  }
  .cookie-link {
    color: var(--ink);
    text-decoration: underline;
    font-weight: var(--fw-medium);
  }
  .cookie-link:hover {
    color: var(--ink);
  }
  .cookie-actions {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }
  .cookie-btn {
    font-size: 0.84rem;
    font-weight: var(--fw-medium);
    height: 40px;
    padding: 0 20px;
    border-radius: var(--r-pill);
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
  }
  .cookie-btn:active {
    transform: scale(0.97);
  }
  .cookie-btn--accept {
    background: var(--ink);
    color: #ffffff;
    border: none;
  }
  .cookie-btn--accept:hover {
    background: #3f3f46;
  }
  .cookie-btn--deny {
    background: transparent;
    color: var(--ink-2);
    border: 1px solid var(--line-2);
  }
  .cookie-btn--deny:hover {
    border-color: #d4d4d8;
    background: var(--chalk);
  }

  @keyframes slide-up {
    from {
      transform: translateY(100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-consent {
      animation: none;
    }
  }
</style>

<script>
  import { getConsentStatus, setConsent, initAnalytics } from '../lib/analytics';

  function init() {
    const status = getConsentStatus();

    if (status === 'pending') {
      const banner = document.getElementById('cookie-consent');
      if (banner) {
        banner.hidden = false;

        document.getElementById('cookie-accept')?.addEventListener('click', () => {
          setConsent('granted');
          banner.hidden = true;
          initAnalytics();
        });

        document.getElementById('cookie-deny')?.addEventListener('click', () => {
          setConsent('denied');
          banner.hidden = true;
        });
      }
    } else {
      // Consent already given/denied — just init
      initAnalytics();
    }
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
