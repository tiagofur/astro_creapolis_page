---
/**
 * RelatedArticles — shows 3 related posts by shared tags/categories.
 * Deduplicates against the current article.
 */
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { getPostDescription } from '../utils/post';

interface Props {
  lang: Lang;
  currentSlug: string;
  currentTags: string[];
  currentCategories?: string[];
}

const { lang, currentSlug, currentTags, currentCategories = [] } = Astro.props;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// Score each post by tag/category overlap with current article
const scored = allPosts
  .filter((p) => p.slug !== currentSlug)
  .map((post) => {
    let score = 0;
    // Category match = 3 points each
    for (const cat of currentCategories) {
      const postCats = (post.data as any).categories as string[] | undefined;
      if (postCats?.includes(cat)) score += 3;
    }
    // Tag match = 1 point each
    for (const tag of currentTags) {
      if (post.data.tags.includes(tag)) score += 1;
    }
    return { post, score };
  })
  .filter((item) => item.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat(
    lang === 'es' ? 'es-MX' : lang === 'pt' ? 'pt-BR' : 'en-US',
    {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    },
  ).format(date);
}

const catColorMap: Record<string, string> = {
  Engineering: 'cyan',
  Mobile: 'magenta',
  'AI/ML': 'yellow',
  Product: 'cyan',
  'Building Creapolis': 'magenta',
};
---

{scored.length > 0 && (
  <section class="related-section reveal">
    <p class="eyebrow" style="margin:0 0 14px"><span>Artículos relacionados</span></p>
    <div class="related-grid">
      {scored.map(({ post }) => {
        const cats = (post.data as any).categories as string[] | undefined;
        const primaryCat = cats?.[0] || 'Engineering';
        const colorVar = catColorMap[primaryCat] || 'default';
        return (
          <a href={`/${lang}/blog/${post.slug}`} class="related-card">
            <div class={`related-accent related-accent--${colorVar}`}></div>
            <div class="related-body">
              <span class={`related-badge related-badge--${colorVar}`}>{primaryCat}</span>
              <h4>{post.data.title}</h4>
              <p>{getPostDescription(post)}</p>
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}

<style>
  .related-section {
    max-width: 720px;
    margin: 48px auto 0;
  }
  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  @media (min-width: 720px) {
    .related-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .related-card {
    display: flex;
    flex-direction: row;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .related-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-hover);
  }

  .related-accent {
    width: 3px;
    flex-shrink: 0;
  }
  .related-accent--cyan { background: var(--c-cyan); }
  .related-accent--magenta { background: var(--c-magenta); }
  .related-accent--yellow { background: var(--c-yellow); }
  .related-accent--default { background: var(--ink-4); }

  .related-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    min-width: 0;
  }
  .related-badge {
    display: inline-flex;
    align-self: flex-start;
    padding: 2px 9px;
    border-radius: var(--r-pill);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .related-badge--cyan { background: var(--c-cyan-soft); color: var(--c-cyan-3); }
  .related-badge--magenta { background: var(--c-magenta-soft); color: var(--c-magenta-3); }
  .related-badge--yellow { background: var(--c-yellow-soft); color: var(--c-yellow-3); }
  .related-badge--default { background: var(--chalk); color: var(--ink-3); }

  .related-body h4 {
    font-size: 0.92rem;
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .related-body p {
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--ink-3);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-body time {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-4);
  }
</style>
