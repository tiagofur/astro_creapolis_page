---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  currentPath: string;
}
const { lang, currentPath } = Astro.props;
const t = useTranslations(lang);

if (lang === 'es') return null;

const esHref = currentPath.replace(/^\/(en|pt)\//, '/es/');
---

<div class="blog-es-notice" role="note">
  <div class="wrap">
    <span class="label" aria-hidden="true">ES</span>
    <div class="body">
      <strong>{t('blog.enOnly.title')}</strong>
      <span>{t('blog.enOnly.desc')}</span>
    </div>
    <a href={esHref} class="cta">{t('blog.enOnly.cta')} →</a>
  </div>
</div>

<style>
  .blog-es-notice {
    background: var(--c-yellow-soft);
    border-bottom: 1px solid rgba(255, 196, 0, 0.3);
    padding: 14px var(--gutter);
    margin-top: 64px;
  }
  .blog-es-notice .wrap {
    max-width: var(--max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .blog-es-notice .label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-yellow-3);
    border: 1px solid rgba(255, 196, 0, 0.5);
    border-radius: var(--r-pill);
    padding: 3px 10px;
    flex-shrink: 0;
  }
  .blog-es-notice .body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 240px;
  }
  .blog-es-notice .body strong {
    font-size: 0.9rem;
    color: var(--ink);
    font-weight: var(--fw-semibold);
  }
  .blog-es-notice .body span {
    font-size: 0.82rem;
    color: var(--ink-3);
    line-height: 1.45;
  }
  .blog-es-notice .cta {
    font-size: 0.85rem;
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-decoration: none;
    padding: 8px 16px;
    border: 1px solid var(--line-2);
    background: #ffffff;
    border-radius: var(--r-pill);
    white-space: nowrap;
    transition: background 0.2s, border-color 0.2s;
  }
  .blog-es-notice .cta:hover {
    background: var(--ink);
    color: #ffffff;
    border-color: var(--ink);
  }
</style>
