---
import type { Lang } from '../i18n/ui';
import { getAlternateLink } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const alternates = getAlternateLink(Astro.url);
const other = alternates.find((a) => a.lang !== lang);
if (!other) return null;

const langLabels: Record<string, string> = {
  en: 'English',
  es: 'Español',
  pt: 'Português',
};
const langFlags: Record<string, string> = { en: '🇬🇧', es: '🇪🇸', pt: '🇧🇷' };
const langMessages: Record<
  string,
  { msg: string; cta: string; dismiss: string }
> = {
  en: {
    msg: 'This page is also available in English',
    cta: 'Switch',
    dismiss: 'Dismiss',
  },
  es: {
    msg: 'Esta página también está disponible en español',
    cta: 'Cambiar',
    dismiss: 'Cerrar',
  },
  pt: {
    msg: 'Esta página também está disponível em português',
    cta: 'Mudar',
    dismiss: 'Fechar',
  },
};

const otherLabel = langLabels[other.lang] || other.lang;
const otherFlag = langFlags[other.lang] || '🌐';
const { msg, cta, dismiss } = langMessages[other.lang] || langMessages.en;
---

<div class="lang-banner" id="language-banner" hidden
  data-current-lang={lang}
  data-other-lang={other.lang}
>
  <div class="lb-wrap">
    <span class="lb-flag" aria-hidden="true">{otherFlag}</span>
    <span class="lb-msg">{msg}</span>
    <a href={other.href} class="lb-cta" data-lb-switch>{cta} → {otherLabel}</a>
    <button type="button" class="lb-dismiss" aria-label={dismiss} data-lb-dismiss>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 3L11 11M11 3L3 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</div>

<script>
  (function () {
    const banner = document.getElementById('language-banner') as HTMLElement | null;
    if (!banner) return;

    const currentLang = banner.dataset.currentLang || 'es';
    const otherLang = banner.dataset.otherLang || 'en';
    const STORAGE_KEY = 'creapolis-lang';
    const DISMISS_KEY = 'creapolis-lang-banner-dismissed';

    let stored: string | null = null;
    let dismissed: string | null = null;
    try { stored = localStorage.getItem(STORAGE_KEY); } catch (e) {}
    try { dismissed = localStorage.getItem(DISMISS_KEY); } catch (e) {}

    // User explicitly picked a lang (via switch): respect it.
    if (stored === currentLang) return;

    // User dismissed banner for this (current, other) pair.
    if (dismissed === `${currentLang}->${otherLang}`) return;

    // Only show if the browser prefers otherLang.
    const nav = (navigator.language || 'en').toLowerCase();
    const browserPrefersOther =
      (otherLang === 'en' && (nav.startsWith('en'))) ||
      (otherLang === 'es' && (nav.startsWith('es') || nav.startsWith('pt'))) ||
      (otherLang === 'pt' && (nav.startsWith('pt')));

    if (!browserPrefersOther) return;

    banner.hidden = false;

    // Switch: remember choice and navigate.
    const switchLink = banner.querySelector('[data-lb-switch]') as HTMLAnchorElement | null;
    if (switchLink) {
      switchLink.addEventListener('click', () => {
        try { localStorage.setItem(STORAGE_KEY, otherLang); } catch (e) {}
      });
    }

    // Dismiss: hide and remember dismissal.
    const dismissBtn = banner.querySelector('[data-lb-dismiss]') as HTMLButtonElement | null;
    if (dismissBtn) {
      dismissBtn.addEventListener('click', () => {
        banner.hidden = true;
        try { localStorage.setItem(DISMISS_KEY, `${currentLang}->${otherLang}`); } catch (e) {}
      });
    }
  })();
</script>

<style>
  .lang-banner {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    max-width: calc(100% - 32px);
  }
  .lb-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    background: #ffffff;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    box-shadow: var(--sh-3);
    font-size: 0.88rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .lb-flag { font-size: 1.1rem; line-height: 1; flex-shrink: 0; }
  .lb-msg {
    color: var(--ink-3);
    flex: 1;
    min-width: 200px;
  }
  .lb-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: var(--ink);
    color: #ffffff;
    border-radius: var(--r-pill);
    font-weight: var(--fw-medium);
    font-size: 0.84rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .lb-cta:hover { background: #3f3f46; }
  .lb-dismiss {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: transparent;
    border: none;
    color: var(--ink-4);
    cursor: pointer;
    border-radius: 50%;
    transition: background 0.2s, color 0.2s;
  }
  .lb-dismiss:hover {
    background: var(--chalk-2);
    color: var(--ink);
  }

  @media (max-width: 600px) {
    .lang-banner { bottom: 12px; }
    .lb-wrap { padding: 10px 14px; font-size: 0.82rem; }
    .lb-msg { min-width: auto; flex-basis: 100%; text-align: center; }
  }
</style>
