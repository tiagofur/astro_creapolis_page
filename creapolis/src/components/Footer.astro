---
import { getLegalLinks, getSocialLinks } from '../i18n/data/navigation';
import { products } from '../i18n/data/products';
import type { Lang } from '../i18n/ui';
import {
  getLangFromUrl,
  getLocalizedPath,
  useTranslations,
} from '../i18n/utils';
import CubePyramid from './brand/CubePyramid.astro';
import CmyDots from './brand/CmyDots.astro';

interface Props {
  lang?: Lang;
  /** v3: footer CTA banner removed — one dark CTA card per page instead. */
  hideCta?: boolean;
}

const year = new Date().getFullYear();
const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const socialLinks = getSocialLinks();
const legalLinks = getLegalLinks(lang);

// Derive product links from canonical product data
const footerProducts = products
  .filter((p) => p.status === 'live' || p.status === 'pre_production')
  .map((p) => ({
    name: p.name,
    href: getLocalizedPath(lang, `/proyectos/${p.slug}`),
  }));
---

<footer class="footer">
  <div class="footer-stripe" aria-hidden="true"></div>
  <div class="footer-inner">
    <!-- Brand column -->
    <div class="footer-brand">
      <a href={getLocalizedPath(lang, '/')} class="footer-brand-link" aria-label="Creapolis home">
        <CubePyramid size={26} variant="cmyk" />
        <span class="footer-brand-name">Creapolis</span>
        <CmyDots size={4} />
      </a>
      <p class="footer-tagline">{t('footer.tagline')}</p>
      <div class="footer-social">
        {socialLinks.map((s) =>
          s.url ? (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.label} class="fsoc"
              data-track-event={s.icon === 'linkedin' ? 'linkedin_click' : s.icon === 'github' ? 'github_click' : undefined}>
              {s.icon === 'linkedin' && (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.34 17.5V9.75H5.67v7.75h2.67zM7 8.58a1.54 1.54 0 1 0 0-3.08 1.54 1.54 0 0 0 0 3.08zM18.34 17.5v-4.24c0-2.29-1.23-3.35-2.87-3.35-1.32 0-1.91.73-2.24 1.24V9.75h-2.67v7.75h2.67v-4.33c0-1.16.22-2.29 1.66-2.29 1.42 0 1.44 1.33 1.44 2.37v4.25h2.01z"/></svg>
              )}
              {s.icon === 'github' && (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.1-1.47-1.1-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.1-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.1.39-1.99 1.03-2.69-.1-.26-.45-1.28.1-2.66 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.66.64.7 1.03 1.59 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .26.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
              )}
              {s.icon === 'twitter' && (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2h3.2l-7 8 8.2 12h-6.4l-5-6.6L6.2 22H3l7.5-8.6L2.6 2h6.6l4.5 6 4.2-6zm-1.1 18h1.8L7.3 4H5.4l12.4 16z"/></svg>
              )}
            </a>
          ) : null,
        )}
      </div>
      <span class="footer-location">Monterrey · MX</span>
    </div>

    <!-- Navigation columns -->
    <nav class="footer-col" aria-label={t('footer.site')}>
      <h5>{t('footer.site')}</h5>
      <a href={getLocalizedPath(lang, '/')}>{t('footer.home')}</a>
      <a href={getLocalizedPath(lang, '/#apps')}>{t('footer.apps')}</a>
      <a href={getLocalizedPath(lang, '/servicios')}>{t('footer.services')}</a>
      <a href={getLocalizedPath(lang, '/sobre')}>{t('footer.about')}</a>
      <a href={getLocalizedPath(lang, '/blog')}>{t('footer.blog')}</a>
    </nav>

    <nav class="footer-col" aria-label={t('footer.projects')}>
      <h5>{t('footer.projects')}</h5>
      <a href={getLocalizedPath(lang, '/proyectos')}>{t('footer.all')}</a>
      {footerProducts.map((p) => (
        <a href={p.href}>{p.name}</a>
      ))}
    </nav>

    <nav class="footer-col" aria-label={t('footer.contact')}>
      <h5>{t('footer.contact')}</h5>
      <a href={getLocalizedPath(lang, '/contacto')}>{t('footer.form')}</a>
      <a href="mailto:hola@creapolis.dev" class="footer-email">
        hola@creapolis.dev
        <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </a>
      <span class="footer-meta">
        <span class="dot" aria-hidden="true"></span>
        {t('footer.location')}
      </span>
      <span class="footer-meta">{t('footer.response')}</span>
    </nav>
  </div>

  <!-- Legal bottom strip -->
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <p class="footer-copyright">
        &copy; {year} Creapolis · Tiago David Furtado. {t('footer.copyright')}
      </p>
      <div class="footer-legal-links">
        {legalLinks.map((link, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true">·</span>}
            <a href={link.href}>{link.label}</a>
          </>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  /* ═══════════════════════════════════════════════════════════════
     FOOTER — v3 ink (CMYK "Key") with CMYK gradient stripe
     ═══════════════════════════════════════════════════════════════ */
  .footer {
    background: #09090b;
    color: #ffffff;
  }

  /* The one splash of color: cyan → magenta → yellow hairline */
  .footer-stripe {
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--c-cyan) 0%,
      var(--c-magenta) 50%,
      var(--c-yellow) 100%
    );
  }

  .footer-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(32px, 4vw, 48px) var(--gutter) 28px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  @media (min-width: 880px) {
    .footer-inner {
      grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
      gap: 24px;
    }
  }

  /* Brand column */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }

  .footer-brand-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #ffffff;
  }

  .footer-brand-name {
    font-weight: var(--fw-semibold);
    font-size: 0.95rem;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .footer-tagline {
    font-size: 0.84rem;
    line-height: 1.5;
    color: #a1a1aa;
    max-width: 36ch;
    margin: 0;
  }

  .footer-social {
    display: flex;
    gap: 8px;
  }

  .fsoc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--r-pill);
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: transparent;
    color: #d4d4d8;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .fsoc:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.06);
  }

  .footer-location {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--ls-mono);
    color: #71717a;
  }

  /* Columns */
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .footer-col h5 {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: var(--ls-mono);
    color: #71717a;
    margin: 0 0 4px;
  }

  .footer-col a {
    font-size: 0.85rem;
    color: #a1a1aa;
    text-decoration: none;
    width: fit-content;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: #ffffff;
  }

  .footer-email {
    display: inline-flex !important;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: #ffffff !important;
  }

  .footer-email:hover {
    color: var(--c-cyan) !important;
  }

  .footer-meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: #71717a;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-cyan);
  }

  /* Bottom strip */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-bottom-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 14px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .footer-copyright {
    font-size: 0.76rem;
    color: #71717a;
    margin: 0;
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.76rem;
  }

  .footer-legal-links a {
    color: #a1a1aa;
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-legal-links a:hover {
    color: #ffffff;
  }

  .footer-legal-links .sep {
    color: #52525b;
  }
</style>
