---
/**
 * Nav.astro — Main navigation with:
 * - Semantic <header> + <nav> wrapper
 * - Scroll hide/show (hide on scroll down, show on scroll up)
 * - Language selector with keyboard navigation
 * - Mobile menu with Escape to close + focus trap
 * - Uses navigation.ts as single source of truth
 * - Integrates with new Button.astro for CTA
 */

import { getNavCTA, getNavLinks } from '../i18n/data/navigation';
import type { Lang } from '../i18n/ui';
import {
  getAlternateLink,
  getLangFromUrl,
  getLocalizedPath,
  useTranslations,
} from '../i18n/utils';
import CubePyramid from './brand/CubePyramid.astro';
import CmyDots from './brand/CmyDots.astro';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = getNavLinks(lang);
const cta = getNavCTA(lang);

const currentPath = Astro.url.pathname;
function isActive(href: string): boolean {
  if (href.startsWith('/#'))
    return currentPath === `/${lang}/` || currentPath === `/${lang}`;
  if (href === `/${lang}/` || href === `/${lang}`)
    return currentPath === `/${lang}/` || currentPath === `/${lang}`;
  return currentPath.startsWith(href) || currentPath === href;
}

const homeHref = getLocalizedPath(lang, '/');
const alternates = getAlternateLink(Astro.url);
const otherLangs = alternates.filter((a) => a.lang !== lang);

const langLabels: Record<Lang, string> = { es: 'ES', en: 'EN', pt: 'PT' };
const langNames: Record<Lang, string> = {
  es: 'Español',
  en: 'English',
  pt: 'Português',
};
---

<header class="site-header">
  <nav class="nav" aria-label={lang === 'en' ? 'Main' : 'Principal'}>
    <div class="nav-inner">
      {/* Logo */}
      <a href={homeHref} class="nav-logo" aria-label="Creapolis home">
        <CubePyramid size={26} class="nav-cube" />
        <span class="nav-brand-name">Creapolis</span>
        <CmyDots size={4} class="nav-dots" />
      </a>

      {/* Desktop links */}
      <div class="nav-links">
        {links.map((l) => (
          <a
            href={l.href}
            class:list={['nav-link', isActive(l.href) && 'active']}
          >
            {l.label}
          </a>
        ))}

        {/* Language Selector */}
        <div class="lang-selector" data-lang-selector>
          <button
            class="lang-current"
            aria-expanded="false"
            aria-haspopup="listbox"
            aria-label={t('nav.lang')}
            type="button"
          >
            <svg class="lang-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5" />
              <ellipse cx="8" cy="8" rx="3" ry="6.5" stroke="currentColor" stroke-width="1.5" />
              <path d="M2 8h12" stroke="currentColor" stroke-width="1.5" />
            </svg>
            <span class="lang-label">{langLabels[lang]}</span>
            <svg class="lang-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </button>
          <div class="lang-dropdown" role="listbox" aria-label={t('nav.lang')}>
            {otherLangs.map(({ lang: l, href }) => (
              <a href={href} role="option" aria-label={langNames[l]} tabindex="-1" data-track-event="language_changed" data-track-label={l}>
                <span class="lang-option-label">{langLabels[l]}</span>
                <span class="lang-option-name">{langNames[l]}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      {/* CTA */}
      <a href={cta.href} class="nav-cta" data-track-event="start_project_click">
        {cta.label}
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </a>

      {/* Mobile toggle */}
      <button class="nav-mobile-toggle" aria-label={t('nav.menu')} aria-expanded="false" type="button">
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile Menu -->
<div class="mobile-menu" aria-hidden="true">
  <div class="mobile-menu-inner">
    {links.map((l) => (
      <a href={l.href} class:list={['mobile-link', isActive(l.href) && 'active']}>
        {l.label}
      </a>
    ))}
    <div class="mobile-lang-group">
      <span class="mobile-lang-label">{t('nav.lang')}</span>
      <div class="mobile-lang-options">
        {alternates.map(({ lang: l, href }) => (
          <a href={href} class:list={[l === lang && 'active']}>{langNames[l]}</a>
        ))}
      </div>
    </div>
    <a href={cta.href} class="mobile-cta">{cta.label}</a>
  </div>
</div>

<script>
  // ─── Scroll Hide/Show ──────────────────────────────────────────────
  const header = document.querySelector('.site-header') as HTMLElement | null;
  if (header) {
    let lastScrollY = 0;
    let ticking = false;

    function onScroll() {
      const scrollY = window.scrollY;
      const delta = scrollY - lastScrollY;

      if (scrollY > 80) {
        header!.classList.add('scrolled');
      } else {
        header!.classList.remove('scrolled');
      }

      // Hide on scroll down, show on scroll up (only after 80px)
      if (scrollY > 80) {
        if (delta > 10) {
          header!.classList.add('nav-hidden');
        } else if (delta < -10) {
          header!.classList.remove('nav-hidden');
        }
      } else {
        header!.classList.remove('nav-hidden');
      }

      lastScrollY = scrollY;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });
  }

  // ─── Language Selector ─────────────────────────────────────────────
  const langSelector = document.querySelector('[data-lang-selector]') as HTMLElement | null;
  const langCurrent = langSelector?.querySelector('.lang-current') as HTMLButtonElement | null;
  const langDropdown = langSelector?.querySelector('.lang-dropdown') as HTMLElement | null;
  const langOptions = langDropdown?.querySelectorAll('a') as NodeListOf<HTMLAnchorElement> | null;

  function closeLangDropdown() {
    langSelector?.classList.remove('open');
    langCurrent?.setAttribute('aria-expanded', 'false');
  }

  function openLangDropdown() {
    langSelector?.classList.add('open');
    langCurrent?.setAttribute('aria-expanded', 'true');
    // Focus first option
    langOptions?.[0]?.focus();
  }

  langCurrent?.addEventListener('click', (e) => {
    e.preventDefault();
    const isOpen = langSelector?.classList.contains('open');
    if (isOpen) {
      closeLangDropdown();
    } else {
      openLangDropdown();
    }
  });

  // Keyboard navigation in dropdown
  langSelector?.addEventListener('keydown', (e) => {
    const key = e.key;
    const isOpen = langSelector?.classList.contains('open');

    if (!isOpen) {
      if (key === 'ArrowDown' || key === 'Enter' || key === ' ') {
        e.preventDefault();
        openLangDropdown();
      }
      return;
    }

    const options = Array.from(langOptions ?? []);
    const currentIndex = options.indexOf(document.activeElement as HTMLAnchorElement);

    if (key === 'Escape') {
      e.preventDefault();
      closeLangDropdown();
      langCurrent?.focus();
    } else if (key === 'ArrowDown') {
      e.preventDefault();
      const next = currentIndex < options.length - 1 ? currentIndex + 1 : 0;
      options[next]?.focus();
    } else if (key === 'ArrowUp') {
      e.preventDefault();
      const prev = currentIndex > 0 ? currentIndex - 1 : options.length - 1;
      options[prev]?.focus();
    } else if (key === 'Tab') {
      closeLangDropdown();
    }
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!langSelector?.contains(e.target as Node)) {
      closeLangDropdown();
    }
  });

  // ─── Mobile Menu ───────────────────────────────────────────────────
  const mobileToggle = document.querySelector('.nav-mobile-toggle') as HTMLButtonElement | null;
  const mobileMenu = document.querySelector('.mobile-menu') as HTMLElement | null;
  const mobileLinks = mobileMenu?.querySelectorAll('a') as NodeListOf<HTMLAnchorElement> | null;
  const body = document.body;

  function openMobileMenu() {
    mobileMenu?.classList.add('open');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    mobileToggle?.setAttribute('aria-expanded', 'true');
    mobileToggle?.classList.add('active');
    body.classList.add('menu-open');
    // Focus first link
    mobileLinks?.[0]?.focus();
  }

  function closeMobileMenu() {
    mobileMenu?.classList.remove('open');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    mobileToggle?.setAttribute('aria-expanded', 'false');
    mobileToggle?.classList.remove('active');
    body.classList.remove('menu-open');
  }

  mobileToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('open');
    if (isOpen) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  });

  // Close on link click
  mobileLinks?.forEach((link) => {
    link.addEventListener('click', closeMobileMenu);
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (mobileMenu?.classList.contains('open')) {
        closeMobileMenu();
        mobileToggle?.focus();
      }
    }
  });

</script>

<style>
  /* ─── Header wrapper — v3 zai bar ──────────────────────────────────── */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: transparent;
    transition:
      transform 0.3s var(--ease),
      background 0.25s var(--ease),
      border-color 0.25s var(--ease),
      backdrop-filter 0.25s var(--ease);
    border-bottom: 1px solid transparent;
  }

  .site-header.scrolled {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom-color: var(--line);
  }

  .site-header.nav-hidden {
    transform: translateY(-100%);
  }

  /* ─── Nav base ──────────────────────────────────────────────────────── */
  .nav {
    height: 64px;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    max-width: var(--max);
  }

  /* ─── Logo ──────────────────────────────────────────────────────────── */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
  }

  .nav-logo span {
    font-weight: var(--fw-semibold);
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  /* ─── Desktop links ─────────────────────────────────────────────────── */
  .nav-links {
    display: none;
    gap: 2px;
    align-items: center;
  }

  @media (min-width: 880px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-link {
    padding: 8px 13px;
    border-radius: var(--r-pill);
    font-size: 0.875rem;
    color: var(--ink-3);
    font-weight: var(--fw-medium);
    text-decoration: none;
    transition:
      color 0.2s,
      background 0.2s;
  }

  .nav-link:hover {
    color: var(--ink);
    background: var(--chalk-2);
  }

  .nav-link.active {
    color: var(--ink);
    font-weight: var(--fw-semibold);
  }

  /* ─── CTA button — black pill ───────────────────────────────────────── */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 18px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: var(--fw-medium);
    text-decoration: none;
    transition:
      background 0.2s,
      box-shadow 0.2s,
      transform 0.15s;
  }

  .nav-cta:hover {
    background: #3f3f46;
    box-shadow: 0 12px 32px rgba(9, 9, 11, 0.15);
  }

  .nav-cta:active {
    transform: scale(0.98);
  }

  .nav-cta svg {
    transition: transform 0.2s var(--ease);
  }

  .nav-cta:hover svg {
    transform: translate(1px, -1px);
  }

  /* ─── Mobile toggle ─────────────────────────────────────────────────── */
  .nav-mobile-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: 10px;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 880px) {
    .nav-mobile-toggle {
      display: none;
    }
  }

  .nav-mobile-toggle span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--ink);
    transition: transform 0.3s, opacity 0.3s;
  }

  .nav-mobile-toggle.active span:first-child {
    transform: rotate(45deg) translate(2px, 2px);
  }

  .nav-mobile-toggle.active span:last-child {
    transform: rotate(-45deg) translate(2px, -2px);
  }

  /* ─── Language Selector ─────────────────────────────────────────────── */
  .lang-selector {
    position: relative;
    margin-left: 8px;
  }

  .lang-current {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 12px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-2);
    background: transparent;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .lang-current:hover {
    color: var(--ink);
    border-color: #d4d4d8;
    background: var(--chalk);
  }

  .lang-current:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px rgba(24, 24, 27, 0.1);
  }

  .lang-icon {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .lang-chevron {
    transition: transform 0.2s;
    opacity: 0.6;
  }

  .lang-selector.open .lang-chevron {
    transform: rotate(180deg);
  }

  .lang-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 160px;
    padding: 6px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: var(--sh-3);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
    z-index: 100;
  }

  .lang-selector.open .lang-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .lang-dropdown a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    min-height: 44px;
    border-radius: var(--r-sm);
    text-decoration: none;
    color: var(--ink-2);
    transition: background 0.15s, color 0.15s;
  }

  .lang-dropdown a:hover,
  .lang-dropdown a:focus-visible {
    background: var(--chalk);
    color: var(--ink);
    outline: none;
  }

  .lang-option-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.08em;
    color: var(--ink-4);
  }

  .lang-option-name {
    font-size: 0.875rem;
  }

  /* ─── Mobile Menu ───────────────────────────────────────────────────── */
  .mobile-menu {
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    bottom: 0;
    background: #ffffff;
    padding: 24px var(--gutter);
    display: flex;
    flex-direction: column;
    z-index: 99;
    border-top: 1px solid var(--line);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
    overflow-y: auto;
  }

  .mobile-menu.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-link {
    padding: 14px 16px;
    border-radius: var(--r-md);
    font-size: 1rem;
    font-weight: var(--fw-medium);
    color: var(--ink-2);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .mobile-link:hover,
  .mobile-link:focus-visible {
    background: var(--chalk);
    color: var(--ink);
  }

  .mobile-link.active {
    color: var(--ink);
    background: var(--chalk);
  }

  .mobile-lang-group {
    padding: 16px 0;
    border-top: 1px solid var(--line);
    margin-top: 8px;
  }

  .mobile-lang-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: var(--ls-mono);
    color: var(--ink-4);
    margin-bottom: 12px;
  }

  .mobile-lang-options {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-lang-options a {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-3);
    text-decoration: none;
    padding: 8px 0;
    border-radius: var(--r-md);
    transition: color 0.2s;
  }

  .mobile-lang-options a.active {
    color: var(--c-cyan-3);
    font-weight: var(--fw-medium);
  }

  .mobile-lang-options a:hover {
    color: var(--ink);
  }

  .mobile-cta {
    display: block;
    padding: 14px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: #ffffff;
    text-align: center;
    margin-top: 12px;
    font-weight: var(--fw-medium);
    text-decoration: none;
    transition: background 0.2s;
  }

  .mobile-cta:hover {
    background: #3f3f46;
  }

  /* ─── Body lock when menu open ──────────────────────────────────────── */
  :global(body.menu-open) {
    overflow: hidden;
  }

  /* ─── Reduced Motion ────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .nav-inner,
    .nav-link,
    .nav-cta,
    .mobile-link,
    .mobile-cta,
    .lang-current,
    .lang-dropdown {
      transition: none;
    }
  }
</style>
