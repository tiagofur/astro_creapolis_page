---
/**
 * Ribbon — Creapolis signature SVG decorative motif
 *
 * A flowing ribbon path with multi-hue oklch gradient.
 * Used as a decorative background element in hero sections.
 *
 * Props:
 *   class — pass extra CSS classes (e.g. for positioning)
 *
 * Usage:
 *   <Ribbon />                     <!-- default ribbon -->
 *   <Ribbon class="hero-ribbon" /> <!-- with custom class -->
 */
---

<div class="ribbon" aria-hidden="true">
  <svg viewBox="0 0 1400 800" preserveAspectRatio="none">
    <defs>
      <linearGradient id="rib1" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="oklch(0.72 0.18 32)" stop-opacity="0.45" />
        <stop offset="50%" stop-color="oklch(0.62 0.2 285)" stop-opacity="0.4" />
        <stop offset="100%" stop-color="oklch(0.84 0.18 128)" stop-opacity="0.35" />
      </linearGradient>
    </defs>
    <path
      d="M -100,500 C 200,300 400,700 700,450 C 1000,200 1200,600 1500,380"
      fill="none"
      stroke="url(#rib1)"
      stroke-width="120"
      stroke-linecap="round"
      opacity="0.7"
    />
  </svg>
</div>

<style>
  .ribbon {
    position: absolute;
    pointer-events: none;
    user-select: none;
    inset: 0;
    overflow: visible;
    z-index: 0;
  }
  .ribbon svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ribbon path {
    mix-blend-mode: multiply;
  }
</style>
