---
/**
 * TextLink primitive — styled <a> for inline text navigation.
 *
 * Variants:
 *   default — underlined ink, hover darkens
 *   subtle — muted color, underline on hover
 *   accent — text-safe cyan, underline always
 *   underline — always underlined
 *
 * Usage:
 *   <TextLink href="/about">About us</TextLink>
 *   <TextLink href="/blog" variant="subtle">Read more</TextLink>
 *   <TextLink href="https://example.com" external>External</TextLink>
 */

interface Props {
  href: string;
  variant?: 'default' | 'subtle' | 'accent' | 'underline';
  external?: boolean;
  class?: string;
  ['aria-label']?: string;
}

const {
  href,
  variant = 'default',
  external = false,
  class: className = '',
  ['aria-label']: ariaLabel,
  ...rest
} = Astro.props;

const classes = ['ui-link', `ui-link--${variant}`, className]
  .filter(Boolean)
  .join(' ');

const externalProps = external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<a
  class={classes}
  href={href}
  aria-label={ariaLabel}
  {...externalProps}
  {...rest}
><slot /></a>

<style>
  /* ─── TextLink Base — v3 underlined ink links ──────────────────────── */
  .ui-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color var(--duration-fast) var(--ease), text-decoration-thickness var(--duration-fast) var(--ease);
  }

  .ui-link:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .ui-link:focus:not(:focus-visible) {
    outline: none;
  }

  /* ─── Variants ─────────────────────────────────────────────────────── */
  /* Default: underlined ink, hover darkens */
  .ui-link--default:hover {
    color: var(--key);
    text-decoration-thickness: 2px;
  }

  /* Subtle: muted color, underline on hover */
  .ui-link--subtle {
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .ui-link--subtle:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  /* Accent: text-safe cyan shade, always underlined */
  .ui-link--accent {
    color: var(--c-cyan-3);
    text-decoration: underline;
    text-decoration-color: rgba(0, 145, 198, 0.35);
  }
  .ui-link--accent:hover {
    color: var(--c-cyan-2);
    text-decoration-color: var(--c-cyan-2);
  }

  /* Underline: always underlined */
  .ui-link--underline {
    text-decoration-color: currentColor;
    text-underline-offset: 3px;
  }
  .ui-link--underline:hover {
    color: var(--key);
    text-decoration-thickness: 2px;
  }

  /* ─── Reduced Motion ───────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .ui-link {
      transition: none;
    }
  }
</style>
