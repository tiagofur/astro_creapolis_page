---
/**
 * Button primitive — renders <a> or <button> depending on href.
 *
 * Variants: primary (default), secondary, ghost, accent, danger
 * Sizes: md (default), lg, sm
 * States: disabled, loading (shows spinner)
 *
 * Usage:
 *   <Button href="/contacto">Contact</Button>
 *   <Button variant="ghost" size="lg">Learn more</Button>
 *   <Button disabled>Unavailable</Button>
 *   <Button loading>Sending…</Button>
 */

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'accent' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  disabled?: boolean;
  loading?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  ['aria-label']?: string;
  target?: string;
  rel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  disabled = false,
  loading = false,
  type = 'button',
  class: className = '',
  ['aria-label']: ariaLabel,
  target,
  rel,
  ...rest
} = Astro.props;

const classes = [
  'ui-btn',
  `ui-btn--${variant}`,
  `ui-btn--${size}`,
  disabled ? 'is-disabled' : '',
  loading ? 'is-loading' : '',
  className,
]
  .filter(Boolean)
  .join(' ');

const Tag = href ? 'a' : 'button';
const hrefProps = href ? { href, target, rel } : {};
const buttonProps = !href ? { type, disabled } : {};
---

<Tag
  class={classes}
  aria-label={ariaLabel}
  aria-disabled={disabled || loading ? 'true' : undefined}
  {...hrefProps}
  {...buttonProps}
  {...rest}
>
  {loading && <span class="ui-btn__spinner" aria-hidden="true" />}
  <span class:list={['ui-btn__label', { 'sr-only': loading }]}>
    <slot />
  </span>
</Tag>

<style>
  /* ─── Button Base — v3 black pill (zai) ────────────────────────────── */
  .ui-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    padding: 0 28px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: var(--fw-medium);
    line-height: 1.2;
    border-radius: var(--r-pill);
    border: 1px solid transparent;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition:
      transform var(--duration-fast) var(--ease),
      box-shadow var(--duration-fast) var(--ease),
      background var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease),
      opacity var(--duration-fast) var(--ease);
  }

  /* ─── Press feedback ───────────────────────────────────────────────── */
  .ui-btn:active {
    transform: scale(0.98);
  }

  /* ─── Focus ring (keyboard only, ink) ──────────────────────────────── */
  .ui-btn:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px rgba(24, 24, 27, 0.1);
  }

  .ui-btn:focus:not(:focus-visible) {
    outline: none;
    box-shadow: none;
  }

  /* ─── Variants ─────────────────────────────────────────────────────── */
  /* Primary: ink pill, white text */
  .ui-btn--primary {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .ui-btn--primary:not(.is-disabled):not(.is-loading):hover {
    background: var(--ink-2);
    border-color: var(--ink-2);
    box-shadow: 0 12px 32px rgba(9, 9, 11, 0.15);
  }

  /* Secondary: white bg, zinc-200 border pill */
  .ui-btn--secondary {
    background: #ffffff;
    color: var(--ink-2);
    border-color: var(--line-2);
  }
  .ui-btn--secondary:not(.is-disabled):not(.is-loading):hover {
    border-color: #d4d4d8;
    background: var(--chalk);
    color: var(--ink);
  }

  /* Ghost: quiet text link button */
  .ui-btn--ghost {
    background: transparent;
    color: var(--ink-2);
    border-color: transparent;
    padding-left: 12px;
    padding-right: 12px;
  }
  .ui-btn--ghost:not(.is-disabled):not(.is-loading):hover {
    background: var(--chalk);
    color: var(--ink);
  }

  /* Accent: CMYK accent via --accent-color, defaults to ink */
  .ui-btn--accent {
    background: var(--accent-color, var(--ink));
    color: #ffffff;
    border-color: var(--accent-color, var(--ink));
  }
  .ui-btn--accent:not(.is-disabled):not(.is-loading):hover {
    background: color-mix(in srgb, var(--accent-color, var(--ink)) 85%, #000000);
    border-color: color-mix(in srgb, var(--accent-color, var(--ink)) 85%, #000000);
    box-shadow: var(--sh-hover);
  }

  /* Danger: CMYK magenta shade */
  .ui-btn--danger {
    background: var(--c-magenta-2);
    color: #ffffff;
    border-color: var(--c-magenta-2);
  }
  .ui-btn--danger:not(.is-disabled):not(.is-loading):hover {
    background: var(--c-magenta-3);
    border-color: var(--c-magenta-3);
    box-shadow: var(--sh-hover);
  }

  /* ─── Sizes: 40 / 48 / 56 ──────────────────────────────────────────── */
  .ui-btn--sm {
    height: 40px;
    padding: 0 18px;
    font-size: 0.8125rem;
  }

  .ui-btn--md {
    height: 48px;
    padding: 0 28px;
    font-size: 0.9375rem;
  }

  .ui-btn--lg {
    height: 56px;
    padding: 0 34px;
    font-size: 1rem;
  }

  /* ─── States ───────────────────────────────────────────────────────── */
  .ui-btn.is-disabled {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  .ui-btn.is-loading {
    cursor: wait;
    pointer-events: none;
  }

  /* ─── Spinner ──────────────────────────────────────────────────────── */
  .ui-btn__spinner {
    width: 16px;
    height: 16px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: ui-btn-spin 0.6s linear infinite;
    flex-shrink: 0;
  }

  @keyframes ui-btn-spin {
    to { transform: rotate(360deg); }
  }

  /* ─── Reduced Motion ───────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .ui-btn {
      transition: none;
    }
    .ui-btn__spinner {
      animation-duration: 1.2s;
    }
    .ui-btn:active {
      transform: none;
    }
  }
</style>
