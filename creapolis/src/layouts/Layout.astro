---
import '../styles/tokens.css';
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import LanguageBanner from '../components/LanguageBanner.astro';
import AgentWidget from '../components/ai/AgentWidget.astro';
import { defaultLang, type Lang } from '../i18n/ui';
import { getAlternateLink, getLangFromUrl } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: Lang;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
  };
  extraJsonLd?: Record<string, unknown>;
}

const {
  title = 'Creapolis — Software que transforma ideas en productos',
  description = 'Estudio de desarrollo en Monterrey. Diseño y construcción de apps móviles, web y de escritorio, con consultoría de IA práctica.',
  ogImage = '/og-default.webp',
  lang = getLangFromUrl(Astro.url),
  article,
  extraJsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title.includes('Creapolis') ? title : `${title} — Creapolis`;
const htmlLang = lang === 'en' ? 'en' : lang === 'pt' ? 'pt' : 'es';
const ogLocale = lang === 'en' ? 'en_US' : lang === 'pt' ? 'pt_BR' : 'es_MX';
const inLanguage = lang === 'en' ? 'en-US' : lang === 'pt' ? 'pt-BR' : 'es-MX';

// Person + Organization shared schema (single dev studio)
// TODO: reemplazar los sameAs con URLs reales cuando estén
const founder = {
  '@type': 'Person',
  name: 'Tiago David Furtado',
  jobTitle: 'Desarrollador de software independiente',
  url: 'https://creapolis.dev/es/sobre',
  sameAs: [
    // 'https://www.linkedin.com/in/TU_HANDLE',
    // 'https://github.com/TU_HANDLE',
    // 'https://x.com/TU_HANDLE',
  ],
};

const organization = {
  '@type': 'Organization',
  name: 'Creapolis',
  url: 'https://creapolis.dev',
  logo: {
    '@type': 'ImageObject',
    url: 'https://creapolis.dev/favicon.svg',
  },
  founder,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Monterrey',
    addressRegion: 'Nuevo León',
    addressCountry: 'MX',
  },
};

// JSON-LD structured data
const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonicalURL.href,
      datePublished: article.publishedTime,
      dateModified: article.modifiedTime || article.publishedTime,
      author: article.author
        ? { '@type': 'Person', name: article.author }
        : founder,
      publisher: organization,
      keywords: article.tags?.join(', '),
      inLanguage,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Creapolis',
      url: 'https://creapolis.dev',
      description,
      inLanguage,
      publisher: organization,
      potentialAction: {
        '@type': 'SearchAction',
        target: 'https://creapolis.dev/blog?q={search_term_string}',
        'query-input': 'required name=search_term_string',
      },
    };
---

<!DOCTYPE html>
<html lang={htmlLang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Alternate language links (slug-aware: uses getAlternateLink to translate slugs) -->
    {getAlternateLink(Astro.url).map(({ lang: l, href }) => {
      const hreflang = l === 'es' ? 'es-MX' : l === 'pt' ? 'pt-BR' : 'en-US';
      return <link rel="alternate" hreflang={hreflang} href={new URL(href, Astro.site).href} />;
    })}
    <link rel="alternate" hreflang="x-default" href={new URL('/es/', Astro.site).href} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocale} />
    {getAlternateLink(Astro.url).filter(a => a.lang !== lang).map(({ lang: l }) => {
      const altLocale = l === 'en' ? 'en_US' : l === 'pt' ? 'pt_BR' : 'es_MX';
      return <meta property="og:locale:alternate" content={altLocale} />;
    })}
    <meta property="og:site_name" content="Creapolis" />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Article-specific OG -->
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
        {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <!-- Theme -->
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />

    <!-- Google Fonts — Geist + Geist Mono only (v3: no serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking font loading: media=print + onload switches to all -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      />
    </noscript>
    <!-- Font metrics fallback — reduces CLS while web fonts load -->
    <style is:inline>
      @font-face {
        font-family: "Geist Fallback";
        src: local("system-ui"), local("-apple-system"), local("Segoe UI"), local("sans-serif");
        size-adjust: 105%;
        ascent-override: 90%;
        descent-override: 22%;
        line-gap-override: 0%;
      }
      @font-face {
        font-family: "Geist Mono Fallback";
        src: local("ui-monospace"), local("SFMono-Regular"), local("Consolas"), local("monospace");
        size-adjust: 108%;
        ascent-override: 88%;
        descent-override: 22%;
        line-gap-override: 0%;
      }
    </style>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Creapolis Blog RSS" href="/rss.xml" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- BreadcrumbList structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `https://creapolis.dev/${lang}/` },
        ...Astro.url.pathname
          .replace(/^\/\w+\//, '')
          .split('/')
          .filter(Boolean)
          .map((segment, i, arr) => ({
            '@type': 'ListItem' as const,
            position: i + 2,
            name: segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
            item: `https://creapolis.dev/${lang}/${arr.slice(0, i + 1).join('/')}/`,
          })),
      ],
    })} />

    <!-- Extra page-specific JSON-LD -->
    {extraJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        ...extraJsonLd,
      })} />
    )}

    <title>{fullTitle}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{lang === 'en' ? 'Skip to content' : lang === 'pt' ? 'Pular para o conteúdo' : 'Saltar al contenido'}</a>
    <main id="main-content">
      <slot />
    </main>
    <LanguageBanner lang={lang} />
    <CookieConsent lang={lang} />
    <AgentWidget lang={lang} variant="floating" />
  </body>
</html>

<script>
  // ─── Analytics event tracking ───
  import '../lib/track-events.ts';
</script>

<script>
  // ─── Scroll Reveal ───
  // Supports .visible (legacy) and .in (v2) class names
  // Auto-staggers children of .reveal-stagger containers
  // threshold 0 + rootMargin negativo = dispara cuando cualquier pixel
  // cruza 40px arriba del fondo del viewport. Threshold 0.1 rompía con
  // elementos muy altos (ej: artículos del blog enteros dentro de .reveal)
  // porque un elemento más grande que 10× el viewport nunca llega al 10%.
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          entry.target.classList.add('in');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));

  // Auto-stagger: elements inside .reveal-stagger get incremental delays
  document.querySelectorAll('.reveal-stagger').forEach((container) => {
    const children = container.children;
    Array.from(children).forEach((child, i) => {
      (child as HTMLElement).style.transitionDelay = `${i * 0.08}s`;
    });
  });

  // ─── Smooth scroll for anchor links ───
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const href = (anchor as HTMLAnchorElement).getAttribute('href');
      if (!href || href === '#') return;
      const target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>
