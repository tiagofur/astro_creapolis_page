  /* ═══════════════════════════════════════════════════════════════
     CONTACT CTA — reuses homepage pattern
     ═══════════════════════════════════════════════════════════════ */
  .contact-cta {
    padding: clamp(64px, 9vw, 120px) var(--gutter);
