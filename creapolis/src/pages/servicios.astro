---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    id: 'moviles',
    title: 'Apps móviles',
    tagline: 'Apps que la gente abre todos los días',
    desc: 'Mobile es mi terreno. Diseño, codeo y publico apps nativas y cross-platform — eligiendo la tecnología según el problema, no según la moda.',
    fullDesc: 'Flutter para MVP rápido o cuando querés cubrir iOS + Android con una sola codebase. Swift o Kotlin nativo cuando el rendimiento, la integración con hardware, o los patterns de cada plataforma lo exigen. No existe un "stack universal" — existe el stack que sirve a tu caso.',
    color: '#5856D6',
    features: [
      { title: 'Flutter · MVP rápido', desc: 'Una codebase, dos tiendas. Ideal para validar una idea o cubrir ambas plataformas con presupuesto ajustado.' },
      { title: 'iOS nativo', desc: 'Swift + SwiftUI cuando necesitás integración profunda con el sistema, 60fps garantizados, o tu mercado es Apple-first.' },
      { title: 'Android nativo', desc: 'Kotlin + Jetpack Compose para Android-first (LATAM, retail, workforce), Material You, o features del SDK que Flutter no cubre.' },
      { title: 'Stores + soporte', desc: 'Publico en App Store y Google Play, respondo reviews, publico updates. No te entrego el APK y desaparezco.' },
    ],
    tech: ['Flutter', 'Swift', 'SwiftUI', 'Kotlin', 'Jetpack Compose', 'Firebase', 'Room'],
    deliverable: 'App publicada en App Store y Google Play, lista para recibir usuarios',
    proof: {
      label: 'Dónde lo apliqué',
      text: 'Pepinillo (Android, Jetpack Compose) y Películas (Android, Kotlin) en Google Play. Solennix en iOS, Android y web — gestión real de eventos con CRM e inventario.',
      link: '/proyectos',
      linkLabel: 'Ver proyectos reales',
    },
  },
  {
    id: 'web',
    title: 'Apps web',
    tagline: 'Sitios que cargan rápido y convierten',
    desc: 'Web es marketing, producto y ventas en un solo artefacto. Construyo experiencias que cargan en menos de un segundo, posicionan en Google, y convierten a visitantes en clientes.',
    fullDesc: 'Astro para sitios de contenido o marketing. Next.js cuando hay SSR o estado complejo. React puro cuando es una SPA de verdad. Nada de WordPress — ese barco ya se hundió y llevarte ahí es condenarte a plugins rotos y velocidad de 2012.',
    color: '#34C759',
    features: [
      { title: 'Sitios marketing', desc: 'Astro + Tailwind. 95+ Lighthouse en mobile, SEO técnico, cargás en menos de 1s en conexión promedio.' },
      { title: 'Apps con estado', desc: 'Next.js + tRPC + Postgres. Auth, dashboards, portales internos, e-commerce con checkout propio.' },
      { title: 'Headless CMS', desc: 'Sanity/Contentful/Decap + front en Astro o Next. Editorial feliz, developer feliz, build time aceptable.' },
      { title: 'Migración desde WP', desc: 'WordPress → stack moderno sin perder SEO. Redirects 301, sitemap, schema markup, monitoreo post-migración.' },
    ],
    tech: ['Astro', 'Next.js', 'React', 'TypeScript', 'Tailwind CSS', 'tRPC', 'PostgreSQL', 'Vercel'],
    deliverable: 'Sitio desplegado, monitoreado y con guía de edición para vos',
    proof: {
      label: 'Dónde lo apliqué',
      text: 'Este mismo sitio. Astro + oklch + Google Fonts + backend en Go para el formulario. Tokens de diseño custom, animaciones con Intersection Observer, performance-first.',
      link: '/',
      linkLabel: 'Ver el sitio (sos vos ahora)',
    },
  },
  {
    id: 'escritorio',
    title: 'Software de escritorio',
    tagline: 'Cuando una web no alcanza',
    desc: 'Escritorio es nicho, pero brutal cuando aplica. Punto de venta offline, herramientas internas, apps que manejan archivos grandes, workflows que no aguantan la latencia de una web.',
    fullDesc: 'Tauri + Rust es mi default para desktop nuevo — apps de 5 a 15MB con rendimiento nativo, contra los 120MB de Electron que arrancan medio minuto. Nativo (Swift, Kotlin) cuando necesitás integración profunda con el sistema. Electron sólo si hay que compartir código con una web existente.',
    color: '#FF9500',
    features: [
      { title: 'Tauri + Rust', desc: 'Mi default 2025. Bundles de ~10MB, cold start en ms, memoria mínima. Web stack adentro, binario nativo afuera.' },
      { title: 'macOS nativo', desc: 'SwiftUI para apps que se sienten como Apple las haría. Integración con Spotlight, Shortcuts, Continuity.' },
      { title: 'Herramientas internas', desc: 'Punto de venta, gestión de inventario, tools para tu operación. A veces la mejor app no es una web.' },
      { title: 'Distribución', desc: 'Code signing, auto-updater, instaladores firmados para Windows, macOS y Linux. Sin warnings de "developer desconocido".' },
    ],
    tech: ['Tauri', 'Rust', 'Swift', 'SwiftUI', '.NET', 'Electron'],
    deliverable: 'Instaladores firmados para Windows, macOS y Linux — listos para distribuir',
    proof: {
      label: 'Dónde lo apliqué',
      text: 'Pepinillo Desktop (en desarrollo, Tauri + Rust) — versión de escritorio con sincronización y widgets de enfoque. Herramientas internas para flujos de eventos.',
      link: '/#shelf',
      linkLabel: 'Ver qué está en construcción',
    },
  },
  {
    id: 'ia',
    title: 'Consultoría de IA',
    tagline: 'IA práctica, sin humo',
    desc: 'La IA está en todos lados y la mitad es marketing. Te ayudo a separar lo que sirve de lo que es hype, y a integrar lo que vale la pena en tu flujo real.',
    fullDesc: 'No vengo a venderte "transformación digital con IA". Vengo a ver dónde podés ahorrar horas semanales con un LLM bien integrado, o dónde un chatbot honesto puede manejar el 80% de consultas recurrentes. Lo demás es fricción disfrazada de innovación.',
    color: '#0071E3',
    features: [
      { title: 'Auditoría de procesos', desc: 'Miro tus flujos, te digo qué tiene sentido automatizar con IA y qué no. Dos días de trabajo. Sin compromiso posterior.' },
      { title: 'Chatbots honestos', desc: 'LLM + tus datos con RAG. Contestan sobre lo que saben, derivan lo que no. Sin alucinaciones sueltas al cliente.' },
      { title: 'Automatización', desc: 'Clasificación de correo, resúmenes de reuniones, extracción de datos de PDFs. Tareas donde el LLM es mejor que una persona por 30 veces.' },
      { title: 'IA en tu producto', desc: 'Feature de IA integrada en tu app existente. Desde search semántico hasta generación de contenido asistida.' },
    ],
    tech: ['OpenAI', 'Anthropic', 'LangChain', 'Python', 'Vector DBs', 'RAG'],
    deliverable: 'IA integrada en tu stack, con límites claros y monitoreo de costo',
    proof: {
      label: 'Dónde lo apliqué',
      text: 'Aether (alpha interna) — chatbot para PyMEs que conecta WhatsApp, correo y CRM en un solo hilo. Lo estoy construyendo con lo que aprendo en producción.',
      link: '/#shelf',
      linkLabel: 'Ver Aether en desarrollo',
    },
  },
];

const process = [
  {
    n: '01',
    title: 'Descubrir',
    desc: 'Escucho tu idea, leo tu mercado y armo un roadmap con fechas realistas.',
    details: ['Llamada de 45 min', 'Análisis de competencia', 'Definición de KPIs', 'Propuesta técnica y presupuesto'],
  },
  {
    n: '02',
    title: 'Diseñar',
    desc: 'Wireframes primero, prototipo navegable después, sistema de diseño documentado al final.',
    details: ['Wireframes en papel digital', 'Prototipo en Figma', 'Diseño UI/UX', 'Design tokens y guía'],
  },
  {
    n: '03',
    title: 'Construir',
    desc: 'Sprints de 2 semanas con demo cada viernes. Código en tu repo desde el día uno — sin black box.',
    details: ['Demo semanal en vivo', 'Código en tu repositorio', 'Tests en lo crítico', 'CI/CD configurado'],
  },
  {
    n: '04',
    title: 'Lanzar',
    desc: 'QA, publicación en tiendas, métricas conectadas. 30 días de soporte incluido post-lanzamiento.',
    details: ['QA cruzado por dispositivo', 'Publicación en stores', 'Analytics y monitoring', 'Soporte 30 días incluido'],
  },
];
---

<Layout
  title="Servicios — Creapolis"
  description="Desarrollo apps móviles, web y de escritorio. Consultoría de IA práctica para empresas en México y LATAM."
>
  <Nav />

  <!-- ═══════════════════════════════════════════════════════════════
       PAGE HEADER
       ═══════════════════════════════════════════════════════════════ -->
  <header class="page-hero" id="main-content">
    <div class="wrap">
      <div class="page-hero-copy reveal">
        <div class="eyebrow" style="margin-bottom:18px"><span>Servicios</span></div>
      <h1>Producto de cabo a rabo,<br/><span class="serif">sin intermediarios</span>.</h1>
      <p class="lead">Apps móviles, web y de escritorio. Consultoría de IA práctica. Un solo responsable que descubre, diseña, construye y lanza.</p>
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════════════════════
       SERVICE DETAIL CARDS
       ═══════════════════════════════════════════════════════════════ -->
  <section class="section" style="background:var(--chalk)">
    <div class="wrap">
      <div class="svc-detail-grid">
        {services.map((s, i) => (
          <article id={s.id} class={`svc-detail reveal${i > 0 ? ` reveal-delay-${i}` : ''}`}>
            <div class="svc-detail-head">
              <div class="svc-num-block">
                <span class="svc-bignum">{String(i + 1).padStart(2, '0')}</span>
                <span class="svc-mark">{s.title.charAt(0)}</span>
              </div>
              <div class="svc-detail-title">
                <h3>{s.title}</h3>
                <span class="svc-tagline">{s.tagline}</span>
              </div>
            </div>

            <div class="svc-detail-body">
              <p class="svc-desc">{s.desc}</p>
              <p class="svc-full">{s.fullDesc}</p>

              <div class="svc-features">
                <h4>Qué incluyo</h4>
                <div class="svc-feat-grid">
                  {s.features.map((f) => (
                    <div class="svc-feat">
                      <strong>{f.title}</strong>
                      <span>{f.desc}</span>
                    </div>
                  ))}
                </div>
              </div>

              <div class="svc-tech">
                <h4>Stack</h4>
                <div class="svc-chips">
                  {s.tech.map((t) => (
                    <span class="chip">{t}</span>
                  ))}
                </div>
              </div>

              <div class="svc-deliverable">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <path d="M9 1a8 8 0 100 16A8 8 0 009 1zm0 14.5a6.5 6.5 0 110-13 6.5 6.5 0 010 13zm-1-9.75l3.5 2L8 9.75V5.75z" fill="currentColor"/>
                </svg>
                <span>{s.deliverable}</span>
              </div>

              <div class="svc-proof">
                <div class="svc-proof-label">{s.proof.label}</div>
                <p>{s.proof.text}</p>
                <a href={s.proof.link} class="svc-proof-link">{s.proof.linkLabel}
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       PROCESS — how we work
       ═══════════════════════════════════════════════════════════════ -->
  <section id="proceso" class="section">
    <div class="wrap">
      <div class="proc-header">
        <div class="reveal">
          <div class="eyebrow" style="margin-bottom:18px"><span>Cómo trabajo</span></div>
          <h2>Un proceso con<br/><span class="serif">pocas sorpresas</span>.</h2>
        </div>
        <p class="reveal reveal-delay-1">Entregas visibles cada dos semanas. Canal directo con quien escribe el código. Sin intermediarios que pierdan contexto — ni sorpresas al final.</p>
      </div>

      <div class="proc">
        {process.map((step, i) => (
          <div class={`step reveal${i > 0 ? ` reveal-delay-${i}` : ''}`}>
            <span class="bignum">{step.n}</span>
            <h4>{step.title}</h4>
            <p>{step.desc}</p>
            <ul class="step-details">
              {step.details.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       TECH STACK OVERVIEW
       ═══════════════════════════════════════════════════════════════ -->
  <section class="section" style="background:var(--chalk)">
    <div class="wrap">
      <div class="reveal" style="text-align:center; margin-bottom:40px">
        <div class="eyebrow" style="margin-bottom:18px; justify-content:center"><span>Stack completo</span></div>
        <h2>Tecnologías que <span class="serif">uso a diario</span>.</h2>
      </div>
      <div class="tech-cloud reveal reveal-delay-1">
        {['Swift', 'SwiftUI', 'Kotlin', 'Jetpack Compose', 'Flutter', 'React Native', 'Next.js', 'React', 'Astro', 'TypeScript', 'Tailwind CSS', 'PostgreSQL', 'Tauri', 'Rust', 'Electron', 'OpenAI', 'LangChain', 'Python', 'TensorFlow', 'Firebase', 'Vercel', 'Node.js'].map((t) => (
          <span class="chip">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       CONTACT CTA — form
       ═══════════════════════════════════════════════════════════════ -->
  <section id="contacto" class="contact-cta">
    <div class="contact-card reveal">
      <div class="eyebrow" style="margin-bottom:16px"><span>Hablemos</span></div>
      <h2>Contame tu idea.<br/>Te contesto <span class="serif">el mismo día</span>.</h2>
      <p class="lead">Sin formularios de 20 campos ni telenovelas. Escribime en 2 minutos, te respondo en menos de 24 horas con próximos pasos concretos.</p>
      <form class="c-form" id="svc-contact-form">
        <div class="hp-field" aria-hidden="true">
          <label for="svc-website">Website</label>
          <input type="text" id="svc-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" id="svc-timestamp" name="timestamp" value="" />

        <div class="two">
          <label>Nombre
            <input type="text" name="name" required placeholder="María González" />
          </label>
          <label>Email
            <input type="email" name="email" required placeholder="maria@empresa.com" />
          </label>
        </div>
        <label>¿Qué quieres construir?
          <select name="service">
            <option>App móvil</option>
            <option>Aplicación web</option>
            <option>Software de escritorio</option>
            <option>Integración de IA</option>
            <option>Todavía no lo sé · necesito asesoría</option>
          </select>
        </label>
        <label>Cuéntanos un poco más
          <textarea name="message" placeholder="Una o dos líneas bastan. El contexto que tengas."></textarea>
        </label>
        <div class="row-cta">
          <button type="submit" class="btn btn-primary btn-lg">Enviar mensaje
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <span class="hint">o escribe a <a href="mailto:hola@creapolis.dev">hola@creapolis.dev</a></span>
          <span class="ok chip live" hidden style="margin-left:auto"><span class="chip-dot"></span>Enviado — te escribimos pronto</span>
        </div>
        <div id="svc-form-msg" class="form-msg" hidden></div>
      </form>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════════
     PAGE HERO
     ═══════════════════════════════════════════════════════════════ */
  .page-hero {
    padding: 160px var(--gutter) 80px;
    position: relative;
    overflow: clip;
    background:
      radial-gradient(50% 45% at 10% 80%, var(--coral-soft) 0%, transparent 70%),
      radial-gradient(60% 50% at 90% 10%, var(--iris-soft) 0%, transparent 60%),
      var(--paper);
  }
  .page-hero-copy {
    max-width: 720px;
  }
  .page-hero h1 {
    margin-bottom: 24px;
  }
  .page-hero h1 .serif {
    color: var(--iris);
    font-size: 1.02em;
  }
  .page-hero .lead {
    max-width: 52ch;
  }

  /* ═══════════════════════════════════════════════════════════════
     SERVICE DETAIL CARDS
     ═══════════════════════════════════════════════════════════════ */
  .svc-detail-grid {
    display: grid;
    gap: 20px;
  }

  .svc-detail {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: clamp(28px, 4vw, 48px);
    position: relative;
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
    scroll-margin-top: 100px;
  }
  .svc-detail:hover {
    border-color: var(--svc-color);
    box-shadow: var(--sh-2);
  }

  .svc-detail:nth-child(1) { --svc-color: var(--iris); --svc-soft: var(--iris-soft); }
  .svc-detail:nth-child(2) { --svc-color: var(--lime); --svc-soft: var(--lime-soft); }
  .svc-detail:nth-child(3) { --svc-color: var(--coral); --svc-soft: var(--coral-soft); }
  .svc-detail:nth-child(4) { --svc-color: var(--sky); --svc-soft: var(--sky-soft); }

  .svc-detail-head {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }

  .svc-num-block {
    position: relative;
    flex-shrink: 0;
  }
  .svc-bignum {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--svc-color);
  }
  .svc-mark {
    position: absolute;
    top: -6px;
    right: -10px;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--svc-soft);
    color: var(--svc-color);
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
  }

  .svc-detail-title h3 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: 4px;
  }
  .svc-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--svc-color);
    font-size: 1.05rem;
  }

  .svc-detail-body {
    display: grid;
    gap: 24px;
  }

  .svc-desc {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--ink);
    max-width: 60ch;
  }
  .svc-full {
    font-size: 1rem;
    color: var(--ink-2);
    max-width: 60ch;
  }

  .svc-features h4,
  .svc-tech h4 {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 14px;
  }

  .svc-feat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .svc-feat-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .svc-feat {
    padding: 18px;
    background: var(--chalk);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .svc-feat strong {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
  }
  .svc-feat span {
    font-size: 0.85rem;
    color: var(--ink-3);
  }

  .svc-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .svc-deliverable {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 22px;
    background: var(--svc-soft);
    border: 1px solid color-mix(in oklch, var(--svc-color) 25%, var(--line));
    border-radius: var(--r-lg);
    color: var(--svc-color);
    font-weight: 500;
    font-size: 0.95rem;
    width: fit-content;
  }

  /* Case-study proof block inside each service card */
  .svc-proof {
    margin-top: 8px;
    padding: 20px 24px;
    border-left: 3px solid var(--svc-color);
    background: color-mix(in oklch, var(--svc-soft) 50%, var(--paper));
    border-radius: 0 var(--r-md) var(--r-md) 0;
  }
  .svc-proof-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--svc-color);
    margin-bottom: 8px;
  }
  .svc-proof p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0 0 12px;
  }
  .svc-proof-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--svc-color);
    text-decoration: none;
    transition: gap 0.2s var(--ease);
  }
  .svc-proof-link:hover { gap: 10px; }

  /* ═══════════════════════════════════════════════════════════════
     PROCESS — reuse homepage step pattern
     ═══════════════════════════════════════════════════════════════ */
  .proc-header {
    display: grid;
    gap: 28px;
    grid-template-columns: 1fr;
    margin-bottom: 56px;
    align-items: end;
  }
  @media (min-width: 720px) {
    .proc-header { grid-template-columns: 1.1fr 1fr; gap: 48px; }
  }
  .proc-header h2 { max-width: 14ch; }
  .proc-header h2 .serif { color: var(--coral); }
  .proc-header p { font-size: 1.05rem; max-width: 48ch; color: var(--ink-2); }

  .proc {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 720px) { .proc { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .proc { grid-template-columns: repeat(4, 1fr); } }

  .step {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 28px 24px;
    position: relative;
    overflow: hidden;
  }
  .step .bignum {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 5rem;
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--step-color, var(--iris));
  }
  .step h4 {
