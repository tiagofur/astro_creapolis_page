    font-weight: 500;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    overflow: hidden;
  }

  .form-msg {
    padding: 14px 18px;
    border-radius: var(--r-md);
    font-size: 0.92rem;
    margin-top: 4px;
  }
  .form-msg.success {
    background: var(--lime-soft);
    color: oklch(0.45 0.12 128);
    border: 1px solid color-mix(in oklch, var(--lime) 30%, var(--line));
  }
  .form-msg.error {
    background: var(--coral-soft);
    color: oklch(0.45 0.12 25);
    border: 1px solid color-mix(in oklch, var(--coral) 30%, var(--line));
  }
</style>

<script>
  const form = document.getElementById('svc-contact-form') as HTMLFormElement;
  const msgEl = document.getElementById('svc-form-msg');
  const honeypot = document.getElementById('svc-website') as HTMLInputElement;
  const tsInput = document.getElementById('svc-timestamp') as HTMLInputElement;

  if (tsInput) tsInput.value = Date.now().toString();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (honeypot?.value) {
      if (msgEl) {
        msgEl.hidden = false;
        msgEl.className = 'form-msg success';
        msgEl.textContent = 'Mensaje enviado. Te respondemos pronto.';
      }
      form.reset();
      return;
    }

    const submittedAt = Date.now();
    const loadedAt = parseInt(tsInput?.value || '0');
    if (submittedAt - loadedAt < 2000) {
      if (msgEl) {
        msgEl.hidden = false;
        msgEl.className = 'form-msg error';
        msgEl.textContent = 'Espera un momento antes de enviar.';
      }
      return;
    }

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const okChip = form.querySelector('.ok') as HTMLElement;
    if (btn) btn.disabled = true;

    const formData = new FormData(form);
    const data = {
      name: formData.get('name'),
      email: formData.get('email'),
      service: formData.get('service'),
      message: formData.get('message'),
      website: formData.get('website'),
      timestamp: formData.get('timestamp'),
    };

    try {
      const apiUrl = import.meta.env.API_URL || '/api/contact';
      const res = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await res.json();

      if (msgEl) {
        msgEl.hidden = false;
        if (result.success) {
          msgEl.className = 'form-msg success';
          msgEl.textContent = result.message;
          form.reset();
          if (okChip) okChip.hidden = false;
          setTimeout(() => { if (okChip) okChip.hidden = true; }, 4000);
        } else {
          msgEl.className = 'form-msg error';
          msgEl.textContent = result.message;
        }
      }
    } catch {
      if (msgEl) {
        msgEl.hidden = false;
        msgEl.className = 'form-msg error';
        msgEl.textContent = 'Error de conexión. Escribimos a hola@creapolis.dev';
      }
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
