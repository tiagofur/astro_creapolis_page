  /* ═══════════════════════════════════════════════════════════════
     TECH CLOUD
     ═══════════════════════════════════════════════════════════════ */
  .tech-cloud {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 800px;
