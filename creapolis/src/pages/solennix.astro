---
import Layout from '../layouts/Layout.astro';

const solennix = {
  name: 'Solennix',
  tagline: 'La app todo-en-uno para organizadores de eventos',
  subtitle: 'Gestión de eventos profesionales en Latinoamérica',
  desc: 'Solennix es la app todo-en-uno para organizadores de eventos profesionales en Latinoamérica: bodas, quinceañeras, cumpleaños, eventos corporativos y sociales.',
  fullDesc: 'Solennix te devuelve el control de tu operación para que dediques tu energía a lo que importa: crear eventos memorables. Gestión completa desde el primer contacto hasta el reporte final.',
  color: '#5856D6',
  platform: 'iOS & Android',
  size: '24.6 MB',
  developer: 'Tiago David Furtado',
  version: 'iOS 17.0+',
  features: [
    {
      icon: '📅',
      title: 'Gestión de Eventos',
      desc: 'Calendario con todos tus eventos, detalles completos, checklist de tareas y estados claros'
    },
    {
      icon: '👥',
      title: 'CRM de Clientes',
      desc: 'Base de datos completa con historial, notas, contactos y eventos asociados'
    },
    {
      icon: '💰',
      title: 'Cotizaciones y Contratos',
      desc: 'Genera cotizaciones profesionales en segundos y conviértelas en contratos'
    },
    {
      icon: '📦',
      title: 'Inventario',
      desc: 'Control de equipos reutilizables e insumos con tracking de stock en tiempo real'
    },
    {
      icon: '📊',
      title: 'Dashboard',
      desc: 'KPIs clave: ingresos, eventos del mes, clientes activos y visión clara del negocio'
    },
    {
      icon: '🎨',
      title: 'Diseño Premium',
      desc: 'Interfaz cálida y profesional. Light y Dark mode incluido'
    }
  ],
  pricing: [
    {
      plan: 'Gratis',
      price: '$0',
      features: ['Funciones esenciales', 'Gestión básica de eventos', ' hasta 3 eventos']
    },
    {
      plan: 'Pro',
      price: '$149/mes',
      features: ['Cotizaciones ilimitadas', 'Inventario avanzado', 'Eventos ilimitados', 'Exportar PDF']
    },
    {
      plan: 'Business',
      price: 'Custom',
      features: ['Equipo multiusuario', 'Reportes avanzados', 'API access', 'Soporte prioritario']
    }
  ],
  storeLinks: {
    apple: 'https://apps.apple.com/mx/app/solennix/id6760874129',
    google: 'https://play.google.com/store/apps/details?id=com.solennix.app',
    web: 'https://solennix.com'
  }
};
---

<Layout
  title={`${solennix.name} — Creapolis`}
  description={solennix.desc}
>
  <!-- Navigation -->
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <div class="nav-logo-mark">C</div>
        <span>Creapolis</span>
      </a>

      <div class="nav-links">
        <a href="/#apps">Apps</a>
        <a href="/#servicios">Servicios</a>
        <a href="#features">Funciones</a>
        <a href="/blog">Blog</a>
        <a href="#contacto">Contacto</a>
      </div>

      <a href="#download" class="nav-cta">Descargar</a>

      <button class="nav-mobile-toggle" aria-label="Menú">
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div class="mobile-menu">
    <a href="/#apps">Apps</a>
    <a href="/#servicios">Servicios</a>
    <a href="#features">Funciones</a>
    <a href="/blog">Blog</a>
    <a href="#contacto">Contacto</a>
    <a href="#download" class="cta">Descargar</a>
  </div>

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-content reveal">
        <span class="hero-label">{solennix.subtitle}</span>
        <h1 class="hero-title">{solennix.name}</h1>
        <p class="hero-tagline">{solennix.tagline}</p>

        <div class="hero-actions">
          <a href={solennix.storeLinks.apple} target="_blank" rel="noopener" class="store-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.3.87.78 0 2.26-1.07 3.81-.91.65.03 2.52.23 3.87.44v3.43c0 .4-.13.88-.57 1.22-.43.33-.86.4-1.18.27-.97-.4-1.96-.78-2.77-.68-.53.08-.71.36-.7.72-.01.36.24.73.72.91 1.15.46 2.16.8 2.56 2.23.4 1.43-.12 2.9-1.05 3.73-.93.83-2.25 1.15-3.53 1.03-1.02-.1-2.26-.59-3.27-.88zm-3.5-14.03c.67-.82 1.13-1.96 1.01-3.08-1 .03-2.2.66-2.91 1.5-.64.76-1.17 1.97-1.02 3.15 1.12.09 2.27-.6 2.92-1.57z"/>
            </svg>
            App Store
          </a>
          <a href={solennix.storeLinks.google} target="_blank" rel="noopener" class="store-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-11.092 6.41a1 1 0 01-.64.109l12.007-6.96a1 1 0 00-.555-.961zm-5.964 6.137l1.928 1.928 8.03-4.643a1 1 0 00.052-1.302l-2.443-2.443 1.29-1.29-7.083 6.086-1.928-1.928-4.372 3.233 2.443 2.443 3.165-3.165v-.02zM5.858 2.065l1.454 1.455 1.11-1.111a.996.996 0 011.41 0l1.886 1.887a.996.996 0 010 1.41l-1.11 1.11 1.454 1.454-1.888 1.887a.996.996 0 01-1.41 0l-1.887-1.887a.996.996 0 010-1.41l1.111-1.11L5.858 5.127a.996.996 0 010-1.41l1.887-1.887a.996.996 0 011.41 0L10.156 3.2l-1.11 1.11-2.443-2.443a.996.996 0 01-.745-.86z"/>
            </svg>
            Google Play
          </a>
        </div>
      </div>

      <div class="hero-visual reveal">
        <div class="app-preview" style={`--accent: ${solennix.color}`}>
          <div class="app-screen">
            <div class="screen-header">
              <span class="screen-title">Dashboard</span>
              <span class="screen-subtitle">3 eventos activos</span>
            </div>
            <div class="screen-stats">
              <div class="stat-card">
                <span class="stat-value">12</span>
                <span class="stat-label">Eventos</span>
              </div>
              <div class="stat-card">
                <span class="stat-value">$45K</span>
                <span class="stat-label">Ingresos</span>
              </div>
              <div class="stat-card">
                <span class="stat-value">8</span>
                <span class="stat-label">Clientes</span>
              </div>
            </div>
            <div class="screen-list">
              <div class="list-item">
                <div class="event-dot"></div>
                <span>Boda García - 15 Feb</span>
              </div>
              <div class="list-item">
                <div class="event-dot"></div>
                <span>XV María - 22 Feb</span>
              </div>
              <div class="list-item">
                <div class="event-dot"></div>
                <span>Corporativo Tech - 1 Mar</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- App Info Banner -->
  <section class="info-banner">
    <div class="container">
      <div class="info-grid">
        <div class="info-item">
          <span class="info-value">📱</span>
          <span class="info-label">iOS & Android</span>
        </div>
        <div class="info-item">
          <span class="info-value">📦</span>
          <span class="info-label">{solennix.size}</span>
        </div>
        <div class="info-item">
          <span class="info-value">⭐</span>
          <span class="info-label">Gratis / Pro / Business</span>
        </div>
        <div class="info-item">
          <span class="info-value">🌎</span>
          <span class="info-label">Español & Inglés</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="label">Funciones</span>
        <h2>Todo lo que necesitás<br />para tu negocio.</h2>
        <p>Unasuite completa para organizar eventos profesionales. Sin complicaciones.</p>
      </div>

      <div class="features-grid">
        {solennix.features.map((feature, i) => (
          <div class="feature-card reveal" style={`--delay: ${i * 0.1}s`}>
            <span class="feature-icon">{feature.icon}</span>
            <h3>{feature.title}</h3>
            <p>{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-header reveal">
        <span class="label">Planes</span>
        <h2>Elige el plan<br />que se adapte a vos.</h2>
        <p>Empezá gratis y escalá cuando tu negocio crezca.</p>
      </div>

      <div class="pricing-grid">
        {solennix.pricing.map((plan, i) => (
          <div class={`pricing-card reveal ${i === 1 ? 'featured' : ''}`}>
            {i === 1 && <span class="pricing-badge">Más Popular</span>}
            <h3>{plan.plan}</h3>
            <div class="pricing-price">
              <span class="price-value">{plan.price}</span>
            </div>
            <ul class="pricing-features">
              {plan.features.map((f) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M3 8L6.5 11.5L13 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
            {i === 0 && (
              <a href={solennix.storeLinks.apple} class="btn btn-secondary">Descargar Gratis</a>
            )}
            {i === 1 && (
              <a href={solennix.storeLinks.apple} class="btn btn-primary">Comenzar Prueba</a>
            )}
            {i === 2 && (
              <a href="mailto:hola@creapolis.dev" class="btn btn-secondary">Contactar</a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Download -->
  <section id="download" class="cta-section">
    <div class="container">
      <div class="cta-content reveal">
        <h2>Empezá hoy mismo.</h2>
        <p>Tu primer evento organizado en minutos. Sin compromiso.</p>

        <div class="cta-stores">
          <a href={solennix.storeLinks.apple} target="_blank" rel="noopener" class="store-btn-large">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.3.87.78 0 2.26-1.07 3.81-.91.65.03 2.52.23 3.87.44v3.43c0 .4-.13.88-.57 1.22-.43.33-.86.4-1.18.27-.97-.4-1.96-.78-2.77-.68-.53.08-.71.36-.7.72-.01.36.24.73.72.91 1.15.46 2.16.8 2.56 2.23.4 1.43-.12 2.9-1.05 3.73-.93.83-2.25 1.15-3.53 1.03-1.02-.1-2.26-.59-3.27-.88zm-3.5-14.03c.67-.82 1.13-1.96 1.01-3.08-1 .03-2.2.66-2.91 1.5-.64.76-1.17 1.97-1.02 3.15 1.12.09 2.27-.6 2.92-1.57z"/>
            </svg>
            <div class="store-btn-text">
              <span class="store-btn-label">Descargar en</span>
              <span class="store-btn-name">App Store</span>
            </div>
          </a>
          <a href={solennix.storeLinks.google} target="_blank" rel="noopener" class="store-btn-large">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-11.092 6.41a1 1 0 01-.64.109l12.007-6.96a1 1 0 00-.555-.961zm-5.964 6.137l1.928 1.928 8.03-4.643a1 1 0 00.052-1.302l-2.443-2.443 1.29-1.29-7.083 6.086-1.928-1.928-4.372 3.233 2.443 2.443 3.165-3.165v-.02zM5.858 2.065l1.454 1.455 1.11-1.111a.996.996 0 011.41 0l1.886 1.887a.996.996 0 010 1.41l-1.11 1.11 1.454 1.454-1.888 1.887a.996.996 0 01-1.41 0l-1.887-1.887a.996.996 0 010-1.41l1.111-1.11L5.858 5.127a.996.996 0 010-1.41l1.887-1.887a.996.996 0 011.41 0L10.156 3.2l-1.11 1.11-2.443-2.443a.996.996 0 01-.745-.86z"/>
            </svg>
            <div class="store-btn-text">
              <span class="store-btn-label">Descargar en</span>
              <span class="store-btn-name">Google Play</span>
            </div>
          </a>
        </div>

        <a href={solennix.storeLinks.web} target="_blank" rel="noopener" class="web-link">
          También disponible en web → {solennix.storeLinks.web}
        </a>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contacto" class="section">
    <div class="container">
      <div class="contact-box reveal">
        <h2>¿Necesitás algo similar?</h2>
        <p>Contáctanos y platícanos de tu idea. Podemos construir algo igual de bueno o mejor.</p>
        <a href="mailto:hola@creapolis.dev" class="btn btn-primary">Iniciar proyecto</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <div class="footer-logo-mark">C</div>
        <span>Creapolis</span>
      </div>
      <div class="footer-links">
        <a href="#apps">Apps</a>
        <a href="#servicios">Servicios</a>
        <a href="#features">Funciones</a>
        <a href="/blog">Blog</a>
        <a href="/privacidad">Privacidad</a>
        <a href="/terminos">Términos</a>
      </div>
      <p class="footer-copy">© {new Date().getFullYear()} Creapolis. Todos los derechos reservados.</p>
    </div>
  </footer>
</Layout>

<style>
  /* Hero */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 24px 80px;
    background: var(--color-bg);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 80%;
    height: 150%;
    background: radial-gradient(ellipse, rgba(88, 86, 214, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero .container {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
  }

  .hero-content {
    text-align: center;
  }

  @media (min-width: 1024px) {
    .hero-content {
      text-align: left;
    }
  }

  .hero-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-text);
    margin-bottom: 12px;
    line-height: 1;
  }

  .hero-tagline {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: var(--color-text-secondary);
    margin-bottom: 32px;
    max-width: 480px;
  }

  @media (min-width: 1024px) {
    .hero-tagline {
      margin-left: 0;
      margin-right: auto;
    }
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (min-width: 1024px) {
    .hero-actions {
      justify-content: flex-start;
    }
  }

  .store-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-text);
    color: white;
    padding: 12px 20px;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s var(--ease-out);
  }

  .store-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .app-preview {
    width: 100%;
    max-width: 360px;
    aspect-ratio: 9/19;
    background: linear-gradient(160deg, var(--accent) 0%, #1a1a2e 100%);
    border-radius: 36px;
    padding: 8px;
    box-shadow: 0 40px 80px rgba(88, 86, 214, 0.3);
  }

  .app-screen {
    width: 100%;
    height: 100%;
    background: #0d0d14;
    border-radius: 28px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow: hidden;
  }

  .screen-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .screen-title {
    color: white;
    font-weight: 600;
    font-size: 1.125rem;
  }

  .screen-subtitle {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.75rem;
  }

  .screen-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .stat-card {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 12px 8px;
    text-align: center;
  }

  .stat-value {
    display: block;
    color: white;
    font-weight: 700;
    font-size: 1.25rem;
  }

  .stat-label {
    display: block;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.625rem;
    margin-top: 4px;
  }

  .screen-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .list-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 10px;
  }

  .event-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .list-item span {
    color: white;
    font-size: 0.8125rem;
  }

  /* Info Banner */
  .info-banner {
    background: var(--color-bg-alt);
    padding: 24px 0;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  @media (min-width: 640px) {
    .info-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .info-item {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .info-value {
    font-size: 1.5rem;
  }

  .info-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  /* Section Defaults */
  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 56px;
  }

  .label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 12px;
  }

  .section-header h2 {
    margin-bottom: 16px;
  }

  .section-header p {
    font-size: 1rem;
    line-height: 1.6;
  }

  /* Features */
  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    padding: 32px;
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    transition: all 0.3s var(--ease-out);
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .feature-icon {
    display: block;
    font-size: 2rem;
    margin-bottom: 16px;
  }

  .feature-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .feature-card p {
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Pricing */
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    max-width: 900px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .pricing-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pricing-card {
    padding: 32px;
    background: var(--color-bg);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    text-align: center;
    position: relative;
  }

  .pricing-card.featured {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .pricing-badge {
