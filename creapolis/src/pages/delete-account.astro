---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Layout from '../layouts/Layout.astro';

const lastUpdated = '22 de abril de 2026';
---

<Layout lang="en" title="Delete Account — Creapolis" description="Delete your account from any Creapolis app and all associated data permanently.">
  <Nav />

  <section class="legal-page">
    <div class="legal-inner">
      <div class="legal-head">
        <p class="eyebrow" style="--accent-color: var(--c-magenta); margin-bottom: 14px;">Legal</p>
        <h1>Delete My <span class="tone">Account</span></h1>
        <p class="last-updated">Last updated: {lastUpdated}</p>
      </div>

      <p class="intro">This page allows you to request deletion of your account in any Creapolis application (Solennix, Pikle, Películas and future apps) and all associated personal data. Deletion is permanent and irreversible.</p>

      <p class="lang-note">También disponible en <a href="/eliminar-cuenta">español</a>.</p>

      <div class="matrix-grid">
        <div class="matrix-col matrix-col-deleted">
          <h2 class="matrix-heading"><span class="matrix-dot" aria-hidden="true"></span>What gets deleted?</h2>
          <ul>
            <li><strong>Profile:</strong> name, email, phone, business name.</li>
            <li><strong>Operational data:</strong> everything you created — events, tasks, contacts, quotes, contracts, inventory, statistics, notes.</li>
            <li><strong>Photos &amp; files:</strong> any images or documents you attached.</li>
            <li><strong>Preferences:</strong> app settings, themes, notifications.</li>
            <li><strong>Authentication:</strong> credentials, active sessions.</li>
          </ul>
        </div>
        <div class="matrix-col matrix-col-retained">
          <h2 class="matrix-heading"><span class="matrix-dot" aria-hidden="true"></span>What does NOT get deleted?</h2>
          <ul>
            <li><strong>Store billing data:</strong> payment and subscription history processed by Google Play or App Store is retained per their policies. Contact Google or Apple directly to delete that data.</li>
            <li><strong>Anonymous aggregated data:</strong> usage statistics that no longer identify you may be retained for service improvement.</li>
            <li><strong>Crash reports:</strong> error reports sent to Firebase Crashlytics do not contain personal data and are retained for up to 90 days.</li>
          </ul>
        </div>
      </div>

      <div class="callout callout-cyan">
        <h2>Deletion timeline</h2>
        <p>Once confirmed, all your data is deleted within <strong class="sla-num">30 calendar days</strong>. During this period your data remains inactive and inaccessible. You will receive a confirmation email once deletion is complete.</p>
      </div>

      <h2>How to delete your account</h2>

      <div class="method-card">
        <div class="method-num">01</div>
        <h3>From the app</h3>
        <p>Open the app → Settings → Account → <strong>Delete account</strong>. Confirm with your password and the request is processed automatically.</p>
      </div>

      <div class="method-card">
        <div class="method-num">02</div>
        <h3>By email</h3>
        <p>Send an email to <a href="mailto:hola@creapolis.dev">hola@creapolis.dev</a> with:</p>
        <ul>
          <li>Subject: <strong>"Delete my account"</strong></li>
          <li>App name (Solennix, Pikle, Películas)</li>
          <li>Email address associated with your account</li>
        </ul>
        <p>The email must be sent from the address linked to your account. We respond within 5 business days.</p>
      </div>

      <div class="method-card">
        <div class="method-num">03</div>
        <h3>Using this form</h3>
        <p>Fill in the details below and we will process your request:</p>
      </div>

      <form class="delete-form" action="mailto:hola@creapolis.dev" method="POST" enctype="text/plain">
        <div class="form-group">
          <label for="app">Application</label>
          <p class="pills-hint">Select the app</p>
          <div class="app-pills">
            <label class="app-pill">
              <input type="radio" name="app" id="app" value="Solennix" required />
              <span class="pill-dot" aria-hidden="true"></span>
              <span>Solennix (Event CRM)</span>
            </label>
            <label class="app-pill">
              <input type="radio" name="app" value="Pepinillo" required />
              <span class="pill-dot" aria-hidden="true"></span>
              <span>Pepinillo (Focus Timer)</span>
            </label>
            <label class="app-pill">
              <input type="radio" name="app" value="Peliculas" required />
              <span class="pill-dot" aria-hidden="true"></span>
              <span>Películas (Movie Catalog)</span>
            </label>
            <label class="app-pill">
              <input type="radio" name="app" value="Subscription Guardian" required />
              <span class="pill-dot" aria-hidden="true"></span>
              <span>Subscription Guardian</span>
            </label>
            <label class="app-pill">
              <input type="radio" name="app" value="otra" required />
              <span class="pill-dot" aria-hidden="true"></span>
              <span>Other Creapolis app or service</span>
            </label>
          </div>
        </div>
        <div class="form-group">
          <label for="email">Account email address</label>
          <input type="email" id="email" name="email" required placeholder="your@email.com" />
        </div>
        <div class="form-group">
          <label for="nombre">Your full name</label>
          <input type="text" id="nombre" name="nombre" required placeholder="Full name" />
        </div>
        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" required />
            <span>I understand this action is permanent and irreversible. All my data will be deleted.</span>
          </label>
        </div>
        <button type="submit" class="btn-delete">Request account deletion</button>
        <p class="form-note">On submit, your email client opens with a pre-filled request. You can also write to us directly at <a href="mailto:hola@creapolis.dev">hola@creapolis.dev</a>.</p>
      </form>

      <div class="callout callout-yellow">
        <h2>Changed your mind?</h2>
        <p>Contact us within <strong class="sla-num">7 days</strong> of your request at <a href="mailto:hola@creapolis.dev">hola@creapolis.dev</a> and we will cancel the process. After that period, deletion continues and cannot be reversed.</p>
      </div>

      <div class="callout callout-magenta">
        <h2>Active subscription?</h2>
        <p>If you have an active paid subscription, <strong>cancel it first</strong> from your store before deleting the account:</p>
        <ul>
          <li><strong>Google Play:</strong> Play Store → Profile → Payments &amp; subscriptions → Subscriptions → [App] → Cancel.</li>
          <li><strong>App Store:</strong> Settings → Your name → Subscriptions → [App] → Cancel subscription.</li>
        </ul>
        <p>Deleting your account does not automatically cancel subscriptions processed by Google or Apple.</p>
      </div>

      <h2>Contact</h2>
      <ul>
        <li><strong>Email:</strong> <a href="mailto:hola@creapolis.dev">hola@creapolis.dev</a></li>
        <li><strong>Responsible:</strong> Tiago David Furtado — Creapolis</li>
        <li><strong>Privacy policy:</strong> <a href="/privacy-policy">creapolis.dev/privacy-policy</a></li>
      </ul>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .legal-page {
    padding: 140px var(--gutter) 100px;
    background: var(--paper);
    min-height: 80vh;
  }
  .legal-inner {
    max-width: min(72ch, 100%);
    margin: 0 auto;
  }
  .legal-head { margin-bottom: 48px; }
  .legal-head h1 {
    font-size: clamp(2.2rem, 4.6vw, 3.4rem);
    line-height: 1.05; letter-spacing: -0.03em;
    font-weight: var(--fw-semibold);
    color: var(--ink); margin: 0 0 14px;
    text-wrap: balance;
  }
  .legal-head h1 .tone {
    color: var(--ink-4);
  }
  .last-updated {
    font-family: var(--font-mono); font-size: 0.78rem;
    color: var(--ink-4); text-transform: uppercase; letter-spacing: var(--ls-mono);
    margin: 0;
  }

  .legal-page p.intro {
    font-size: 1.05rem; line-height: 1.65;
    color: var(--ink-2);
    padding: 20px 24px;
    background: var(--chalk);
    border-left: 3px solid var(--c-magenta);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    margin: 0 0 16px;
  }
  .lang-note {
    font-family: var(--font-mono); font-size: 0.85rem;
    color: var(--ink-3);
    margin: 0 0 40px;
  }
  .lang-note a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal-page h2 {
    font-size: 1.4rem; line-height: 1.25;
    font-weight: var(--fw-semibold); letter-spacing: -0.02em;
    margin: 44px 0 14px;
    color: var(--ink);
    padding-top: 28px; border-top: 1px solid var(--line);
  }
  .legal-page h3 {
    font-size: 1.1rem; line-height: 1.3;
    font-weight: var(--fw-semibold);
    margin: 0 0 10px;
    color: var(--ink);
  }
  .legal-page p, .legal-page li {
    font-size: 1rem; line-height: 1.7;
    color: var(--ink-2);
    margin-bottom: 14px;
  }
  .legal-page ul {
    padding-left: 24px; margin-bottom: 18px;
  }
  .legal-page ul li { margin-bottom: 10px; }
  .legal-page strong { color: var(--ink); font-weight: var(--fw-semibold); }
  .legal-page a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-thickness 0.15s;
  }
  .legal-page a:hover { text-decoration-thickness: 2px; }

  /* ─── Delete vs retain matrix — 2-col hairline grid ─── */
  .matrix-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    overflow: hidden;
    margin: 8px 0 16px;
  }
  .matrix-col {
    background: #ffffff;
    padding: 26px 24px;
    min-width: 0;
  }
  .matrix-heading {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 1.15rem;
    line-height: 1.25;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 10px;
    padding-top: 0;
    border-top: none;
  }
  .matrix-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .matrix-col-deleted .matrix-dot { background: var(--c-magenta); }
  .matrix-col-retained .matrix-dot { background: var(--c-cyan); }
  .matrix-col ul {
    list-style: none;
    padding: 0;
    margin: 6px 0 0;
  }
  .matrix-col li {
    position: relative;
    padding-left: 18px;
    margin-bottom: 12px !important;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-3);
  }
  .matrix-col li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  .matrix-col-deleted li::before { background: var(--c-magenta); }
  .matrix-col-retained li::before { background: var(--c-cyan); }
  .matrix-col strong { color: var(--ink); }
  @media (max-width: 720px) {
    .matrix-grid { grid-template-columns: 1fr; }
  }

  /* ─── Warning callouts — tinted soft bands, ink text ─── */
  .callout {
    border-radius: var(--r-md);
    padding: 24px 26px;
    margin: 36px 0;
  }
  .callout-cyan { background: var(--c-cyan-soft); }
  .callout-yellow { background: var(--c-yellow-soft); }
  .callout-magenta { background: var(--c-magenta-soft); }
  .callout h2 {
    border-top: none;
    padding-top: 0;
    margin: 0 0 10px;
    font-size: 1.2rem;
  }
  .callout p {
    font-size: 0.95rem;
    margin-bottom: 10px;
  }
  .callout ul {
    margin-bottom: 10px;
  }
  .callout li {
    font-size: 0.92rem;
    margin-bottom: 8px;
  }
  .sla-num {
    font-family: var(--font-mono);
    font-size: 0.875em;
    font-weight: var(--fw-semibold);
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  /* ─── Method cards ─── */
  .method-card {
    padding: 24px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    margin: 16px 0;
    position: relative;
  }
  .method-num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: var(--fw-medium);
    color: var(--ink-4);
    position: absolute; top: 22px; right: 24px;
  }
  .method-card h3 {
    font-size: 1.1rem; margin: 0 0 8px;
    color: var(--ink);
  }
  .method-card p { font-size: 0.95rem; margin-bottom: 8px; }
  .method-card ul { margin-bottom: 8px; }

  /* ─── Form ─── */
  .delete-form {
    margin-top: 24px;
    padding: 32px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
  }
  @media (max-width: 480px) {
    .delete-form { padding: 24px 20px; }
  }
  .form-group {
    margin-bottom: 20px;
  }
  .form-group label {
    display: block;
    font-size: 0.88rem;
    font-weight: var(--fw-medium);
    color: var(--ink);
    margin-bottom: 6px;
  }
  .form-group input[type="email"],
  .form-group input[type="text"] {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    background: #ffffff;
    color: var(--ink);
    font-size: 0.95rem;
    font-family: var(--font-sans);
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
  }
  .form-group input:focus {
    outline: 2px solid var(--ink);
    outline-offset: 1px;
    border-color: var(--ink);
    box-shadow: 0 0 0 4px rgba(24, 24, 27, 0.1);
  }
  .pills-hint {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-4);
    margin: 0 0 10px;
  }
  .app-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .app-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: #ffffff;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
    font-size: 0.875rem;
    color: var(--ink-2);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .app-pill:hover {
    border-color: #d4d4d8;
    color: var(--ink);
  }
  .app-pill input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
  .app-pill .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-cyan);
    opacity: 0;
    transition: opacity 0.15s;
    flex-shrink: 0;
  }
  .app-pill:has(input:checked) {
    border-color: var(--ink);
    color: var(--ink);
  }
  .app-pill:has(input:checked) .pill-dot {
    opacity: 1;
  }
  .app-pill input:focus-visible + .pill-dot {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .checkbox-label {
    display: flex !important;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
  }
  .checkbox-label input[type="checkbox"] {
    margin-top: 3px;
    accent-color: var(--ink);
  }
  .checkbox-label span {
    font-size: 0.9rem;
    color: var(--ink-2);
    line-height: 1.5;
  }
  .btn-delete {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 28px;
    background: var(--ink);
    color: #ffffff;
    border: none;
    border-radius: var(--r-pill);
    font-size: 15px;
    font-weight: var(--fw-medium);
    font-family: var(--font-sans);
    cursor: pointer;
    transition: background 0.2s, box-shadow 0.2s var(--ease), transform 0.15s;
  }
  .btn-delete:hover {
    background: var(--ink-2);
    box-shadow: var(--sh-hover);
  }
  .btn-delete:active {
    transform: scale(0.98);
  }
  .form-note {
    font-size: 0.82rem !important;
    color: var(--ink-3) !important;
    margin-top: 14px !important;
  }
</style>
