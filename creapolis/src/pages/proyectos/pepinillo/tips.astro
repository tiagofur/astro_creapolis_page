---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

const pepNav = [
  { label: 'Features', href: '/proyectos/pepinillo#features' },
  { label: 'Guide', href: '/proyectos/pepinillo/guide' },
  { label: 'Tips', href: '/proyectos/pepinillo/tips' },
  { label: 'Support', href: '/proyectos/pepinillo/feedback' },
];

const pepCTA = { text: 'Download', href: 'https://play.google.com/store/apps/details?id=dev.creapolis.pepinillo' };

const tips = [
  {
    icon: '⏰',
    title: 'The 5-Minute Rule',
    desc: 'If a task feels daunting, set a 5-minute timer. Usually, once you start, you\'ll want to keep going. The hardest part is starting.',
  },
  {
    icon: '📦',
    title: 'Batching',
    desc: 'Use Time Blocks to group similar small tasks together. Get things done faster by focusing on one type of work at a time.',
  },
  {
    icon: '🌊',
    title: 'The Flowtime Advantage',
    desc: 'If you find Pomodoro breaks distracting, try Flowtime mode. It lets you work as long as you\'re in "flow" and only suggests a break when your concentration dips.',
  },
  {
    icon: '🧘',
    title: 'Embrace Boredom',
    desc: 'Don\'t reach for your phone during breaks. Sit, stretch, or just breathe. Train your brain to rest without distraction.',
  },
  {
    icon: '🔄',
    title: 'Create Rituals',
    desc: 'Start and end work sessions with a simple ritual. It signals to your brain when to focus and when to rest. Consistency builds habits.',
  },
  {
    icon: '📊',
    title: 'Review Your Week',
    desc: 'Check your focus history at the end of each week. See where your time went and adjust. What gets measured gets managed.',
  },
];
---

<Layout
  title="Focus Tips & Techniques — Pepinillo"
  description="Master deep work with proven focus strategies. Tips for Pomodoro, Flowtime, and Time Blocking in Pepinillo."
>
  <Nav links={pepNav} cta={pepCTA} />

  <section class="tips-page">
    <div class="tips-inner">

      <div class="tips-head reveal">
        <div class="eyebrow" style="margin-bottom:14px"><span>Focus Techniques</span></div>
        <h1>Mastering your <span class="serif">focus</span>.</h1>
        <p class="subtitle">Proven strategies to get more done with less distraction. Pick what works for you.</p>
      </div>

      <div class="tips-grid">
        {tips.map((tip) => (
          <article class="tip-card reveal">
            <div class="tip-icon">{tip.icon}</div>
            <h2>{tip.title}</h2>
            <p>{tip.desc}</p>
          </article>
        ))}
      </div>

      <div class="next-links reveal">
        <h3>Keep going</h3>
        <div class="link-grid">
          <a href="/proyectos/pepinillo/guide" class="next-card">
            <span class="next-icon">📖</span>
            <div>
              <span class="next-title">Quick Start Guide</span>
              <span class="next-desc">Set up your first session in under 2 minutes.</span>
            </div>
          </a>
          <a href="/proyectos/pepinillo/feedback" class="next-card">
            <span class="next-icon">💬</span>
            <div>
              <span class="next-title">Feedback & Support</span>
              <span class="next-desc">Have a question? We're here to help.</span>
            </div>
          </a>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>

<style>
  .tips-page {
    padding: 140px var(--gutter) 100px;
    background:
      radial-gradient(55% 35% at 50% 0%, var(--lime-soft) 0%, transparent 60%),
      var(--paper);
    min-height: 80vh;
  }

  .tips-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .tips-head {
    text-align: center;
    margin-bottom: 64px;
  }

  .tips-head h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0 0 16px;
  }

  .tips-head h1 .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--lime);
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Tips Grid */
  .tips-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 80px;
  }

  .tip-card {
    padding: 32px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    transition: box-shadow 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .tip-card:hover {
    box-shadow: var(--sh-2);
    border-color: oklch(0.84 0.18 128 / 0.4);
  }

  .tip-icon {
    font-size: 1.5rem;
    margin-bottom: 16px;
  }

  .tip-card h2 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 8px;
  }

  .tip-card p {
    font-size: 0.9rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0;
  }

  /* Next Links */
  .next-links {
    border-top: 1px solid var(--line);
    padding-top: 48px;
  }

  .next-links h3 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    margin: 0 0 20px;
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
  }

  .next-card {
    display: flex;
    gap: 16px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s var(--ease);
    align-items: center;
  }

  .next-card:hover {
    border-color: var(--lime);
  }

  .next-icon {
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  .next-title {
    display: block;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 2px;
  }

  .next-desc {
    display: block;
    font-size: 0.82rem;
    color: var(--ink-2);
  }

  /* Eyebrow */
  .eyebrow { display: inline-flex; }

  .eyebrow span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lime);
    background: var(--lime-soft);
    border: 1px solid oklch(0.84 0.18 128 / 0.25);
    border-radius: var(--r-pill);
    padding: 5px 12px;
  }
</style>
