---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const pepinillo = {
  name: 'Pepinillo',
  tagline: 'Master your focus. Own your time.',
  desc: 'The beautiful, native focus timer for iPhone, iPad, Mac & Apple Watch. Built with Pomodoro, Flowtime, and Time Blocking to help you stay in the zone.',
  storeLink: 'https://apps.apple.com/app/pepinillo',
  platforms: ['iPhone', 'iPad', 'Mac', 'Apple Watch'],
  modes: [
    {
      letter: 'P',
      title: 'Pomodoro',
      desc: '25-minute focused sprints with structured breaks. The classic technique — proven, simple, and effective.',
    },
    {
      letter: 'F',
      title: 'Flowtime',
      desc: 'Work as long as you\'re in the zone. Pepinillo tracks your session and suggests a break only when you need one.',
    },
    {
      letter: 'T',
      title: 'Time Blocking',
      desc: 'Reserve dedicated blocks for your most important work. Group similar tasks, protect your calendar.',
    },
    {
      letter: 'S',
      title: 'Stopwatch',
      desc: 'Track open-ended work sessions without pressure. Log time, review patterns, and improve.',
    },
    {
      letter: 'L',
      title: 'Live Activities',
      desc: 'Your timer lives on the Lock Screen and Dynamic Island — no need to open the app.',
    },
    {
      letter: 'W',
      title: 'Apple Watch',
      desc: 'Glance at your focus timer from your wrist. Start, pause, and skip breaks without touching your phone.',
    },
  ],
};

const pepNav = [
  { label: 'Features', href: '#features' },
  { label: 'Guide', href: '/pepinillo/guide' },
  { label: 'Tips', href: '/pepinillo/tips' },
  { label: 'Support', href: '/pepinillo/feedback' },
];

const pepCTA = { text: 'Download', href: pepinillo.storeLink };
---

<Layout
  title="Pepinillo — Deep Work Companion"
  description={pepinillo.desc}
  ogImage="/og-pepinillo.png"
>
  <Nav links={pepNav} cta={pepCTA} />

  <header class="hero">
    <div class="ribbon" aria-hidden="true">
      <svg viewBox="0 0 1400 800" preserveAspectRatio="none">
        <defs>
          <linearGradient id="prib" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="oklch(0.84 0.18 128)" stop-opacity="0.3"/>
            <stop offset="100%" stop-color="oklch(0.72 0.14 235)" stop-opacity="0.2"/>
          </linearGradient>
        </defs>
        <path d="M -100,700 C 200,500 600,650 900,400 C 1100,230 1300,550 1500,350"
              fill="none" stroke="url(#prib)" stroke-width="120" stroke-linecap="round"/>
      </svg>
    </div>

    <div class="wrap">
      <div class="reveal">
        <div class="chips-row">
          <span class="chip live"><span class="chip-dot"></span>Available now</span>
          <span class="chip pep-chip">iOS · iPadOS · macOS · watchOS</span>
        </div>

        <h1>
          <span class="serif">{pepinillo.name}.</span><br/>
          Deep Work<br/>
          <span class="accent">Companion</span>.
        </h1>

        <p class="tagline">{pepinillo.desc}</p>

        <div class="store-wrap">
          <a class="store-btn" href={pepinillo.storeLink} target="_blank" rel="noopener noreferrer">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.05 12.04a4.4 4.4 0 0 1 2.1-3.7 4.5 4.5 0 0 0-3.55-1.92c-1.5-.15-2.94.88-3.7.88-.78 0-1.95-.86-3.22-.84a4.72 4.72 0 0 0-3.98 2.42c-1.7 2.95-.43 7.3 1.22 9.7.8 1.17 1.76 2.48 3.02 2.44 1.22-.05 1.68-.78 3.15-.78 1.46 0 1.88.78 3.17.75 1.31-.02 2.14-1.18 2.94-2.36a10.5 10.5 0 0 0 1.34-2.73 4.25 4.25 0 0 1-2.49-3.86zM14.5 5.25a4.3 4.3 0 0 0 1-3.25 4.47 4.47 0 0 0-2.9 1.5 4.16 4.16 0 0 0-1.02 3.15 3.67 3.67 0 0 0 2.92-1.4z"/>
            </svg>
            <span>
              <span class="small">Download on the</span>
              <span class="big">App Store</span>
            </span>
          </a>
        </div>

        <div class="links-row">
          <a href="/pepinillo/guide">Quick Start Guide →</a>
          <a href="/pepinillo/tips">Focus Tips →</a>
        </div>
      </div>

      <div class="device-wrap reveal reveal-delay-2">
        <div class="device">
          <div class="device-screen">
            <div class="ds-mode">Flowtime</div>
            <div class="ds-timer">42:17</div>
            <div class="ds-label">In the zone</div>
            <div class="ds-bar">
              <div class="ds-bar-fill" style="width:68%"></div>
            </div>
            <div class="ds-task">
              <span class="ds-dot"></span>
              <span>Design review</span>
            </div>
            <div class="ds-actions">
              <button class="ds-btn-secondary" aria-label="Skip">↩</button>
              <button class="ds-btn-primary" aria-label="Pause">⏸</button>
              <button class="ds-btn-secondary" aria-label="End">✓</button>
            </div>
          </div>
        </div>
        <div class="watch">
          <div class="watch-face">
            <div class="wf-time">42:17</div>
            <div class="wf-label">Focus</div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="info-strip">
    <div class="wrap row">
      <div class="info-cell"><div class="v">Pomodoro · Flowtime · Time Block</div><div class="l">Focus Modes</div></div>
      <div class="info-cell"><div class="v">Privacy First</div><div class="l">No tracking, no ads</div></div>
      <div class="info-cell"><div class="v">Free + Pro</div><div class="l">Plans</div></div>
      <div class="info-cell"><div class="v">EN · ES</div><div class="l">Languages</div></div>
    </div>
  </section>

  <section id="features" class="section">
    <div class="wrap">
      <div class="products-header">
        <div class="reveal">
          <div class="eyebrow" style="margin-bottom:18px"><span>Features · What it does</span></div>
          <h2>Everything you need<br/><span class="serif">to stay in the zone.</span></h2>
        </div>
        <p class="reveal reveal-delay-1">Built for deep work. Four focus modes, seamless Apple ecosystem integration, and mindful breaks — so you can protect your most valuable resource: attention.</p>
      </div>

      <div class="features">
        {pepinillo.modes.map((mode, i) => (
          <div class={`feature reveal${i % 3 === 1 ? ' reveal-delay-1' : ''}${i % 3 === 2 ? ' reveal-delay-2' : ''}`}>
            <div class="icon pep-icon">{mode.letter}</div>
            <h3>{mode.title}</h3>
            <p>{mode.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="privacy-section section" style="background: var(--chalk)">
    <div class="wrap reveal">
      <div class="privacy-card">
        <div class="eyebrow" style="margin-bottom:16px"><span>Privacy</span></div>
        <h2>Your data stays<br/><span class="serif">on your device.</span></h2>
        <ul class="privacy-list">
          <li>
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M3 8L7 11.5L13 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Tasks and focus history are stored locally on your device.
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M3 8L7 11.5L13 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            iCloud Sync uses your personal Apple account — we never see your data.
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M3 8L7 11.5L13 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            No third-party analytics, no tracking SDKs.
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M3 8L7 11.5L13 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Mindful Minutes logged to Apple Health stay on-device. Always.
          </li>
        </ul>
        <a href="/privacy-policy" class="btn btn-ghost">Read Privacy Policy →</a>
      </div>
    </div>
  </section>

  <section class="download-section">
    <div class="wrap reveal">
      <h2>Start focusing<br/><span class="serif">today.</span></h2>
      <p>Pick a mode, link a task, hit start. That's it.</p>
      <div class="dl-btns">
        <a class="store-btn large" href={pepinillo.storeLink} target="_blank" rel="noopener noreferrer">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.05 12.04a4.4 4.4 0 0 1 2.1-3.7 4.5 4.5 0 0 0-3.55-1.92c-1.5-.15-2.94.88-3.7.88-.78 0-1.95-.86-3.22-.84a4.72 4.72 0 0 0-3.98 2.42c-1.7 2.95-.43 7.3 1.22 9.7.8 1.17 1.76 2.48 3.02 2.44 1.22-.05 1.68-.78 3.15-.78 1.46 0 1.88.78 3.17.75 1.31-.02 2.14-1.18 2.94-2.36a10.5 10.5 0 0 0 1.34-2.73 4.25 4.25 0 0 1-2.49-3.86zM14.5 5.25a4.3 4.3 0 0 0 1-3.25 4.47 4.47 0 0 0-2.9 1.5 4.16 4.16 0 0 0-1.02 3.15 3.67 3.67 0 0 0 2.92-1.4z"/>
          </svg>
          <span>
            <span class="small">Download on the</span>
            <span class="big">App Store</span>
          </span>
        </a>
      </div>
      <p class="sub-links">
        <a href="/pepinillo/guide">Quick Start Guide</a> ·
        <a href="/pepinillo/feedback">Support</a> ·
        <a href="/privacy-policy">Privacy</a> ·
        <a href="/terms-of-use">Terms</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ─── Hero ─── */
  .hero {
    position: relative;
    padding: 160px var(--gutter) 100px;
    background:
      radial-gradient(55% 60% at 80% 10%, var(--lime-soft) 0%, transparent 60%),
      radial-gradient(35% 40% at 10% 90%, var(--sky-soft) 0%, transparent 70%),
      var(--paper);
    overflow: clip;
  }

  .hero .wrap {
    display: grid;
    gap: clamp(40px, 6vw, 80px);
    grid-template-columns: 1fr;
    align-items: center;
    position: relative;
    z-index: 2;
    max-width: var(--max);
    margin: 0 auto;
  }

  @media (min-width: 980px) {
    .hero .wrap {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .ribbon {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .ribbon svg { width: 100%; height: 100%; }

  .chips-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px;
    border-radius: var(--r-pill);
    font-size: 0.78rem;
    font-weight: 500;
    background: var(--chalk);
    border: 1px solid var(--line);
    color: var(--ink-2);
    letter-spacing: 0.01em;
  }

  .chip.live {
    color: oklch(0.45 0.15 140);
    background: oklch(0.95 0.06 140);
    border-color: oklch(0.85 0.1 140 / 0.4);
  }

  .chip-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .pep-chip {
    color: oklch(0.5 0.15 128);
    background: var(--lime-soft);
    border-color: oklch(0.84 0.18 128 / 0.3);
  }

  .hero h1 {
    font-size: clamp(3.2rem, 8.4vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
    color: var(--ink);
    margin: 0 0 24px;
  }

  .hero h1 .serif { color: var(--pep-accent); }
  .hero h1 .accent { color: var(--pep-accent); }

  .tagline {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: var(--ink-2);
    max-width: 48ch;
    line-height: 1.65;
    margin-bottom: 32px;
  }

  /* ─── Store button ─── */
  .store-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 22px;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--r-md);
    text-decoration: none;
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
    border: none;
    cursor: pointer;
  }

  .store-btn:hover { opacity: 0.85; transform: translateY(-1px); }

  .store-btn span { display: flex; flex-direction: column; }
  .store-btn .small { font-size: 0.7rem; opacity: 0.7; line-height: 1; }
  .store-btn .big { font-size: 1.05rem; font-weight: 600; line-height: 1.3; }

  .store-btn.large { padding: 14px 26px; }
  .store-btn.large .big { font-size: 1.15rem; }

  .store-wrap { margin-bottom: 24px; }

  .links-row {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .links-row a {
    color: var(--ink-3);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.15s;
  }
  .links-row a:hover { color: var(--pep-accent); }

  /* ─── Device mockup ─── */
  .device-wrap {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 16px;
  }

  .device {
    width: clamp(200px, 22vw, 260px);
    background: var(--ink);
    border-radius: 36px;
    padding: 14px;
    box-shadow: var(--sh-3), 0 0 0 1px oklch(1 0 0 / 0.08) inset;
    position: relative;
  }

  .device::before {
    content: '';
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 6px;
    background: oklch(0.25 0 0);
    border-radius: var(--r-pill);
  }

  .device-screen {
    background: oklch(0.13 0.01 265);
    border-radius: 26px;
    padding: 36px 20px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    min-height: 340px;
  }

  .ds-mode {
    font-size: 0.75rem;
    color: var(--pep-accent);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ds-timer {
    font-size: clamp(2.8rem, 5vw, 3.6rem);
    font-weight: 300;
    color: oklch(0.98 0.003 85);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .ds-label {
    font-size: 0.8rem;
    color: oklch(0.65 0.01 265);
  }

  .ds-bar {
    width: 100%;
    height: 4px;
    background: oklch(0.25 0.01 265);
    border-radius: var(--r-pill);
    overflow: hidden;
    margin: 4px 0;
  }

  .ds-bar-fill {
    height: 100%;
    background: var(--pep-accent);
    border-radius: var(--r-pill);
  }

  .ds-task {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: oklch(0.75 0.01 265);
  }

  .ds-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--pep-accent);
    flex-shrink: 0;
  }

  .ds-actions {
    display: flex;
    gap: 12px;
    margin-top: 8px;
  }

  .ds-btn-primary, .ds-btn-secondary {
    border: none;
    cursor: default;
    border-radius: 50%;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .ds-btn-primary {
    width: 52px; height: 52px;
    background: var(--pep-accent);
    color: oklch(0.15 0.02 128);
  }

  .ds-btn-secondary {
    width: 40px; height: 40px;
    background: oklch(0.22 0.01 265);
    color: oklch(0.65 0.01 265);
    font-size: 0.85rem;
  }

  /* Watch */
  .watch {
    width: 80px;
    height: 90px;
    background: var(--ink);
    border-radius: 20px;
    padding: 8px;
    box-shadow: var(--sh-2);
    margin-top: 60px;
    flex-shrink: 0;
  }

  .watch-face {
    background: oklch(0.13 0.01 265);
    border-radius: 14px;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
  }

  .wf-time {
    font-size: 1rem;
    font-weight: 300;
    color: oklch(0.98 0.003 85);
    letter-spacing: -0.02em;
  }

  .wf-label {
    font-size: 0.55rem;
    color: var(--pep-accent);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ─── Info strip ─── */
  .info-strip {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--chalk);
    padding: 32px var(--gutter);
  }

  .info-strip .wrap {
    max-width: var(--max);
    margin: 0 auto;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 48px;
    align-items: center;
  }

  .info-cell .v {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--ink);
  }

  .info-cell .l {
    font-size: 0.78rem;
    color: var(--ink-3);
    margin-top: 2px;
  }

  /* ─── Features ─── */
  .section {
    padding: 100px var(--gutter);
  }

  .section .wrap {
    max-width: var(--max);
    margin: 0 auto;
  }

  .products-header {
    display: grid;
    gap: 20px 60px;
    grid-template-columns: 1fr;
    margin-bottom: 64px;
  }

  @media (min-width: 768px) {
    .products-header {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  .products-header h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0;
  }

  .products-header h2 .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--pep-accent);
  }

  .products-header p {
    font-size: 1.05rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .feature {
    padding: 28px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    transition: box-shadow 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .feature:hover {
    box-shadow: var(--sh-2);
    border-color: var(--line-2);
  }

  .icon {
    width: 44px; height: 44px;
    border-radius: var(--r-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 16px;
    background: var(--chalk-2);
    color: var(--ink-2);
  }

  .pep-icon {
    background: var(--lime-soft);
    color: oklch(0.45 0.15 128);
  }

  .feature h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 8px;
  }

  .feature p {
    font-size: 0.9rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0;
  }

  /* ─── Privacy ─── */
  .privacy-card {
    max-width: 640px;
  }

  .privacy-card h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0 0 28px;
  }

  .privacy-card h2 .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--pep-accent);
  }

  .privacy-list {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .privacy-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.95rem;
    color: var(--ink-2);
    line-height: 1.5;
  }

  .privacy-list li svg {
    flex-shrink: 0;
    color: var(--pep-accent);
    margin-top: 1px;
  }

  /* ─── Download ─── */
  .download-section {
    padding: 120px var(--gutter);
    text-align: center;
    background:
      radial-gradient(50% 60% at 50% 0%, var(--lime-soft) 0%, transparent 70%),
      var(--paper);
  }

  .download-section .wrap {
    max-width: var(--max);
    margin: 0 auto;
  }

  .download-section h2 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
    margin: 0 0 16px;
  }

  .download-section h2 .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--pep-accent);
  }

  .download-section > .wrap > p {
    font-size: 1.1rem;
    color: var(--ink-2);
    margin: 0 0 40px;
  }

  .dl-btns {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .sub-links {
    font-size: 0.85rem;
    color: var(--ink-3);
    margin: 0;
  }

  .sub-links a {
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.15s;
  }

