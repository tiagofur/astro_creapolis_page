---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const title = "Pepinillo — Deep Work Companion";
const tagline = "Master your focus. Own your time.";
const description = "The beautiful, native focus timer for iPhone, iPad, Mac & Apple Watch. Built with Pomodoro, Flowtime, and Time Blocking to help you stay in the zone.";

const pepNav = [
  { label: 'Features', href: '#features' },
  { label: 'Guide', href: '/pepinillo/guide' },
  { label: 'Tips', href: '/pepinillo/tips' },
  { label: 'Support', href: '/pepinillo/feedback' },
];

const pepCTA = { text: 'Download', href: 'https://apps.apple.com/app/pepinillo' };

const modes = [
  {
    icon: '🍅',
    title: 'Pomodoro',
    desc: 'Classic 25-minute intervals with mindful breaks. Simple, proven, effective.',
  },
  {
    icon: '🌊',
    title: 'Flowtime',
    desc: 'Work as long as you\'re in the zone. Breaks only when your concentration dips.',
  },
  {
    icon: '📦',
    title: 'Time Blocks',
    desc: 'Plan your day with dedicated blocks. Group similar tasks and power through.',
  },
  {
    icon: '⏱️',
    title: 'Stopwatch',
    desc: 'No rules, no intervals. Just hit start and track your time freely.',
  },
];

const platforms = [
  { icon: '📱', name: 'iPhone' },
  { icon: '💻', name: 'Mac' },
  { icon: '📲', name: 'iPad' },
  { icon: '⌚', name: 'Apple Watch' },
];

const resources = [
  {
    title: 'Quick Start Guide',
    desc: 'Set up your first session in under 2 minutes.',
    href: '/pepinillo/guide',
    icon: '📖',
  },
  {
    title: 'Focus Tips & Techniques',
    desc: 'Master deep work with proven strategies.',
    href: '/pepinillo/tips',
    icon: '🧠',
  },
  {
    title: 'Feedback & Support',
    desc: 'Bug report? Feature idea? We\'re here.',
    href: '/pepinillo/feedback',
    icon: '💬',
  },
];
---

<Layout title={title} description={description}>
  <Nav links={pepNav} cta={pepCTA} />

  <section class="hero">
    <div class="hero-inner">
      <div class="eyebrow" style="margin-bottom:16px"><span>Focus Timer for Apple</span></div>
      <h1>Master your focus.<br /><span class="serif">Own your time.</span></h1>
      <p class="hero-desc">{description}</p>

      <div class="platforms">
        {platforms.map((p) => (
          <span class="platform-badge">
            <span class="platform-icon">{p.icon}</span> {p.name}
          </span>
        ))}
      </div>

      <a href={pepCTA.href} class="btn-primary" target="_blank" rel="noopener noreferrer">
        Download for Free →
      </a>
    </div>
  </section>

  <section class="features" id="features">
    <div class="features-inner">
      <div class="section-head">
        <div class="eyebrow" style="margin-bottom:12px"><span>Modes</span></div>
        <h2>Four ways to <span class="serif">focus</span>.</h2>
        <p class="section-sub">Whether you love structure or prefer freedom — Pepinillo adapts to your flow.</p>
      </div>

      <div class="mode-grid">
        {modes.map((mode) => (
          <article class="mode-card reveal">
            <div class="mode-icon">{mode.icon}</div>
            <h3>{mode.title}</h3>
            <p>{mode.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="highlights">
    <div class="highlights-inner">
      <div class="highlight-card reveal">
        <div class="hl-icon">🔒</div>
        <h3>Lock Screen & Dynamic Island</h3>
        <p>Your timer lives on your Lock Screen and in the Dynamic Island via Live Activities. No need to keep the app open.</p>
      </div>
      <div class="highlight-card reveal">
        <div class="hl-icon">☁️</div>
        <h3>iCloud Sync</h3>
        <p>Your tasks and focus history sync across all your Apple devices through your personal iCloud account.</p>
      </div>
      <div class="highlight-card reveal">
        <div class="hl-icon">❤️</div>
        <h3>Apple Health</h3>
        <p>Log Mindful Minutes automatically. Your focus data stays between you and Apple Health — we never see it.</p>
      </div>
    </div>
  </section>

  <section class="resources">
    <div class="resources-inner">
      <div class="section-head">
        <div class="eyebrow" style="margin-bottom:12px"><span>Resources</span></div>
        <h2>Get the most out of <span class="serif">Pepinillo</span>.</h2>
      </div>

      <div class="resource-grid">
        {resources.map((r) => (
          <a href={r.href} class="resource-card reveal">
            <div class="res-icon">{r.icon}</div>
            <div>
              <h3>{r.title}</h3>
              <p>{r.desc}</p>
              <span class="res-link">Read more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ── Hero ── */
  .hero {
    padding: 160px var(--gutter) 80px;
    background:
      radial-gradient(55% 40% at 50% 0%, var(--lime-soft) 0%, transparent 60%),
      var(--paper);
    text-align: center;
  }

  .hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0 0 20px;
  }

  .hero h1 .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--pep-accent);
  }

  .hero-desc {
    font-size: 1.15rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0 0 32px;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .platforms {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .platform-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--ink-2);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 6px 14px;
  }

  .platform-icon { font-size: 1rem; }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    background: var(--pep-accent);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: var(--r-pill);
    text-decoration: none;
    transition: transform 0.15s var(--ease), box-shadow 0.2s var(--ease);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--sh-2);
  }

  /* ── Features / Modes ── */
  .features {
    padding: 100px var(--gutter);
    background: var(--paper);
  }

  .features-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .section-head {
    text-align: center;
    margin-bottom: 56px;
  }

  .section-head h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 14px;
  }

  .section-head h2 .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--pep-accent);
  }

  .section-sub {
    font-size: 1.05rem;
    color: var(--ink-2);
    line-height: 1.6;
    max-width: 480px;
    margin: 0 auto;
  }

  .mode-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
  }

  .mode-card {
    padding: 32px 24px;
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    text-align: center;
    transition: box-shadow 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .mode-card:hover {
    box-shadow: var(--sh-2);
    border-color: oklch(0.84 0.18 128 / 0.4);
  }

  .mode-icon {
    font-size: 2rem;
    margin-bottom: 16px;
  }

  .mode-card h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 8px;
  }

  .mode-card p {
    font-size: 0.88rem;
    color: var(--ink-2);
    line-height: 1.55;
    margin: 0;
  }

  /* ── Highlights ── */
  .highlights {
    padding: 80px var(--gutter);
    background: var(--paper-soft);
  }

  .highlights-inner {
    max-width: 960px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }

  .highlight-card {
    padding: 32px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    border-top: 3px solid var(--pep-accent);
  }

  .hl-icon {
    font-size: 1.5rem;
    margin-bottom: 14px;
  }

  .highlight-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 8px;
  }

  .highlight-card p {
    font-size: 0.9rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Resources ── */
  .resources {
    padding: 100px var(--gutter);
    background: var(--paper);
  }

  .resources-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .resource-card {
    display: flex;
    gap: 20px;
    padding: 28px;
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s var(--ease), border-color 0.2s var(--ease);
    align-items: flex-start;
  }

  .resource-card:hover {
    box-shadow: var(--sh-2);
    border-color: oklch(0.84 0.18 128 / 0.4);
  }

  .res-icon {
    font-size: 1.4rem;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--lime-soft);
    border-radius: var(--r-sm);
  }

  .resource-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 4px;
  }

  .resource-card p {
    font-size: 0.85rem;
    color: var(--ink-2);
    line-height: 1.5;
    margin: 0 0 8px;
  }

  .res-link {
    font-size: 0.85rem;
    color: var(--pep-accent);
    font-weight: 500;
  }

  /* ── Eyebrow ── */
  .eyebrow { display: inline-flex; }

  .eyebrow span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pep-accent);
    background: var(--lime-soft);
    border: 1px solid oklch(0.84 0.18 128 / 0.25);
    border-radius: var(--r-pill);
    padding: 5px 12px;
  }
</style>
