---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const pepNav = [
  { label: 'Features', href: '/pepinillo#features' },
  { label: 'Guide', href: '/pepinillo/guide' },
  { label: 'Tips', href: '/pepinillo/tips' },
  { label: 'Support', href: '/pepinillo/feedback' },
];

const pepCTA = { text: 'Download', href: 'https://apps.apple.com/app/pepinillo' };

const tips = [
  {
    tag: 'Getting Started',
    title: 'The 5-Minute Rule',
    desc: 'If a task feels daunting, set a 5-minute Pomodoro and commit to starting — just starting. Once you\'re in motion, momentum takes over. You\'ll almost always keep going past those 5 minutes.',
  },
  {
    tag: 'Productivity',
    title: 'Task Batching',
    desc: 'Use Time Block mode to group similar small tasks together — emails, code reviews, admin work. Switching between different types of tasks burns cognitive energy. Protect it.',
  },
  {
    tag: 'Advanced',
    title: 'The Flowtime Advantage',
    desc: 'If you find Pomodoro breaks pull you out of deep work, try Flowtime. It lets you work as long as you\'re in the zone — no interruptions — and only suggests a break when your concentration naturally dips.',
  },
  {
    tag: 'Environment',
    title: 'Protect Your Context',
    desc: 'Before starting a session, close every unrelated tab and app. Put your phone on Do Not Disturb. The goal is zero-cost resumption: if you\'re interrupted, you want to get back instantly.',
  },
  {
    tag: 'Breaks',
    title: 'Actually Take Breaks',
    desc: 'A break staring at your phone is not a break. Stand up, step outside, look at something more than 20 feet away. 5 real minutes of rest beats 20 minutes of passive scrolling every time.',
  },
  {
    tag: 'Review',
    title: 'End-of-Day Review',
    desc: 'Check your focus history before closing out for the day. How many sessions did you complete? How long were they? Patterns reveal your real productive hours — schedule deep work accordingly.',
  },
];
---

<Layout
  title="Focus Tips & Techniques — Pepinillo"
  description="Master your focus with proven deep work techniques. Tips for Pomodoro, Flowtime, Time Blocking, environment design, and building sustainable focus habits."
>
  <Nav links={pepNav} cta={pepCTA} />

  <section class="tips-page">
    <div class="tips-inner">

      <div class="tips-head reveal">
        <div class="eyebrow" style="margin-bottom:14px"><span>Focus Tips & Techniques</span></div>
        <h1>Master your <span class="serif">focus</span>.</h1>
        <p class="subtitle">Deep work is a skill. Like any skill, it improves with deliberate practice — and the right tools.</p>
      </div>

      <div class="tips-grid">
        {tips.map((tip, i) => (
          <article class={`tip-card reveal${i % 3 === 1 ? ' reveal-delay-1' : ''}${i % 3 === 2 ? ' reveal-delay-2' : ''}`}>
            <span class="tip-tag">{tip.tag}</span>
            <h2>{tip.title}</h2>
            <p>{tip.desc}</p>
          </article>
        ))}
      </div>

      <div class="cta-block reveal">
        <div class="cta-inner">
          <h2>Ready to put this into practice?</h2>
          <p>Download Pepinillo and start your first focused session in under a minute.</p>
          <div class="cta-links">
            <a
              href="https://apps.apple.com/app/pepinillo"
              class="store-btn"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.05 12.04a4.4 4.4 0 0 1 2.1-3.7 4.5 4.5 0 0 0-3.55-1.92c-1.5-.15-2.94.88-3.7.88-.78 0-1.95-.86-3.22-.84a4.72 4.72 0 0 0-3.98 2.42c-1.7 2.95-.43 7.3 1.22 9.7.8 1.17 1.76 2.48 3.02 2.44 1.22-.05 1.68-.78 3.15-.78 1.46 0 1.88.78 3.17.75 1.31-.02 2.14-1.18 2.94-2.36a10.5 10.5 0 0 0 1.34-2.73 4.25 4.25 0 0 1-2.49-3.86zM14.5 5.25a4.3 4.3 0 0 0 1-3.25 4.47 4.47 0 0 0-2.9 1.5 4.16 4.16 0 0 0-1.02 3.15 3.67 3.67 0 0 0 2.92-1.4z"/>
              </svg>
              <span>
                <span class="s">Download on the</span>
                <span class="b">App Store</span>
              </span>
            </a>
            <a href="/pepinillo/guide" class="btn-outline">Quick Start Guide →</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>

<style>
  .tips-page {
    padding: 140px var(--gutter) 100px;
    background:
      radial-gradient(55% 35% at 50% 0%, var(--lime-soft) 0%, transparent 60%),
      var(--paper);
    min-height: 80vh;
  }

  .tips-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .tips-head {
    margin-bottom: 64px;
    max-width: 600px;
  }

  .tips-head h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0 0 16px;
  }

  .tips-head h1 .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--pep-accent);
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0;
  }

  /* Tips grid */
  .tips-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 80px;
  }

  .tip-card {
    padding: 30px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    transition: box-shadow 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .tip-card:hover {
    box-shadow: var(--sh-2);
    border-color: var(--line-2);
  }

  .tip-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: oklch(0.45 0.15 128);
    background: var(--lime-soft);
    border: 1px solid oklch(0.84 0.18 128 / 0.25);
    border-radius: var(--r-pill);
    padding: 3px 10px;
    margin-bottom: 14px;
  }

  .tip-card h2 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .tip-card p {
    font-size: 0.93rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0;
  }

  /* CTA block */
  .cta-block {
    border-top: 1px solid var(--line);
    padding-top: 64px;
  }

  .cta-inner {
    text-align: center;
    max-width: 520px;
    margin: 0 auto;
  }

  .cta-inner h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0 0 12px;
  }

  .cta-inner p {
    font-size: 1rem;
    color: var(--ink-2);
    margin: 0 0 32px;
    line-height: 1.6;
  }

  .cta-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* Store button */
  .store-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--r-md);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .store-btn:hover { opacity: 0.82; }
  .store-btn span { display: flex; flex-direction: column; }
  .store-btn .s { font-size: 0.68rem; opacity: 0.7; line-height: 1; }
  .store-btn .b { font-size: 0.95rem; font-weight: 600; line-height: 1.3; }

  /* Outline button */
  .btn-outline {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-md);
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.9rem;
    transition: border-color 0.15s, color 0.15s;
  }

  .btn-outline:hover {
    border-color: var(--pep-accent);
    color: var(--pep-accent);
  }

  /* Eyebrow */
  .eyebrow { display: inline-flex; }

  .eyebrow span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pep-accent);
    background: var(--lime-soft);
    border: 1px solid oklch(0.84 0.18 128 / 0.25);
    border-radius: var(--r-pill);
    padding: 5px 12px;
  }

  .reveal { opacity: 0; transform: translateY(20px); }
</style>
