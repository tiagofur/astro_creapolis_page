---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const pepNav = [
  { label: 'Features', href: '/pepinillo#features' },
  { label: 'Guide', href: '/pepinillo/guide' },
  { label: 'Tips', href: '/pepinillo/tips' },
  { label: 'Support', href: '/pepinillo/feedback' },
];

const pepCTA = { text: 'Download', href: 'https://apps.apple.com/app/pepinillo' };

const options = [
  {
    icon: '✉️',
    title: 'Email Support',
    desc: 'For bugs, feature requests, or account issues — we read every email.',
    link: 'mailto:hola@creapolis.dev?subject=Pepinillo%20-%20Support',
    linkText: 'hola@creapolis.dev',
  },
  {
    icon: '𝕏',
    title: 'X (Twitter)',
    desc: 'Reach out publicly or via DM. We\'re active and responsive.',
    link: 'https://x.com/creapolisdev',
    linkText: '@creapolisdev',
  },
];
---

<Layout
  title="Feedback & Support — Pepinillo"
  description="Get support for Pepinillo, report a bug, or send us a feature request. We're here to help."
>
  <Nav links={pepNav} cta={pepCTA} />

  <section class="feedback-page">
    <div class="feedback-inner">

      <div class="feedback-head reveal">
        <div class="eyebrow" style="margin-bottom:14px"><span>Feedback & Support</span></div>
        <h1>We're here to <span class="serif">help</span>.</h1>
        <p class="subtitle">Bug? Feature request? Just want to say hi? Reach out — we read everything and reply fast.</p>
      </div>

      <div class="options-grid">
        {options.map((opt) => (
          <a href={opt.link} class="option-card reveal" target={opt.link.startsWith('http') ? '_blank' : undefined} rel={opt.link.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <div class="opt-icon">{opt.icon}</div>
            <div>
              <h2>{opt.title}</h2>
              <p>{opt.desc}</p>
              <span class="opt-link">{opt.linkText} →</span>
            </div>
          </a>
        ))}
      </div>

      <div class="faq reveal">
        <h2>Common Questions</h2>

        <details class="faq-item">
          <summary>How do I cancel my subscription?</summary>
          <p>Subscriptions are managed through the App Store. Go to <strong>Settings → Apple ID → Subscriptions</strong> on your iPhone or iPad, find Pepinillo, and tap Cancel Subscription. You'll keep Pro access until the end of your billing period.</p>
        </details>

        <details class="faq-item">
          <summary>My timer stopped running in the background. What do I do?</summary>
          <p>Make sure Background App Refresh is enabled for Pepinillo: <strong>Settings → Pepinillo → Background App Refresh → On</strong>. Also check that Live Activities are enabled in <strong>Settings → Pepinillo → Live Activities</strong>.</p>
        </details>

        <details class="faq-item">
          <summary>How does iCloud Sync work?</summary>
          <p>If you're signed into iCloud on all your devices, your tasks and focus history sync automatically. We use Apple's CloudKit — your data goes through Apple's servers, not ours. We never see it.</p>
        </details>

        <details class="faq-item">
          <summary>Can I use Pepinillo on Mac?</summary>
          <p>Yes. Pepinillo runs natively on Mac (Apple Silicon and Intel). Download it from the Mac App Store — it's included with your purchase, no extra cost.</p>
        </details>

        <details class="faq-item">
          <summary>How do I request a refund?</summary>
          <p>Refunds are handled directly by Apple. Visit <a href="https://reportaproblem.apple.com" target="_blank" rel="noopener noreferrer">reportaproblem.apple.com</a>, sign in with your Apple ID, find your Pepinillo purchase, and select "Request a Refund".</p>
        </details>
      </div>

    </div>
  </section>

  <Footer />
</Layout>

<style>
  .feedback-page {
    padding: 140px var(--gutter) 100px;
    background:
      radial-gradient(55% 35% at 50% 0%, var(--lime-soft) 0%, transparent 60%),
      var(--paper);
    min-height: 80vh;
  }

  .feedback-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .feedback-head {
    margin-bottom: 56px;
  }

  .feedback-head h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0 0 16px;
  }

  .feedback-head h1 .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--pep-accent);
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0;
  }

  /* Options grid */
  .options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
    margin-bottom: 64px;
  }

  .option-card {
    display: flex;
    gap: 20px;
    padding: 28px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s var(--ease), border-color 0.2s var(--ease);
    align-items: flex-start;
  }

  .option-card:hover {
    box-shadow: var(--sh-2);
    border-color: oklch(0.84 0.18 128 / 0.4);
  }

  .opt-icon {
    font-size: 1.6rem;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--lime-soft);
    border-radius: var(--r-sm);
  }

  .option-card h2 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 6px;
  }

  .option-card p {
    font-size: 0.88rem;
    color: var(--ink-2);
    line-height: 1.55;
    margin: 0 0 10px;
  }

  .opt-link {
    font-size: 0.88rem;
    color: var(--pep-accent);
    font-weight: 500;
  }

  /* FAQ */
  .faq {
    border-top: 1px solid var(--line);
    padding-top: 48px;
  }

  .faq h2 {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 24px;
    letter-spacing: -0.02em;
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-item summary {
    padding: 18px 0;
    font-size: 0.98rem;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    user-select: none;
    transition: color 0.15s;
  }

  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary::after {
    content: '+';
    font-size: 1.2rem;
    font-weight: 300;
    color: var(--ink-3);
    flex-shrink: 0;
    transition: transform 0.2s var(--ease), color 0.15s;
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
    color: var(--pep-accent);
  }

  .faq-item summary:hover { color: var(--pep-accent); }

  .faq-item p {
    font-size: 0.92rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0;
    padding-bottom: 20px;
  }

  .faq-item a {
    color: var(--pep-accent);
    text-decoration: none;
  }

  .faq-item a:hover { text-decoration: underline; }

  /* Eyebrow */
  .eyebrow { display: inline-flex; }

  .eyebrow span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pep-accent);
    background: var(--lime-soft);
    border: 1px solid oklch(0.84 0.18 128 / 0.25);
    border-radius: var(--r-pill);
    padding: 5px 12px;
  }


</style>
