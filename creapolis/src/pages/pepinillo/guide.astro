---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const pepNav = [
  { label: 'Features', href: '/pepinillo#features' },
  { label: 'Guide', href: '/pepinillo/guide' },
  { label: 'Tips', href: '/pepinillo/tips' },
  { label: 'Support', href: '/pepinillo/feedback' },
];

const pepCTA = { text: 'Download', href: 'https://apps.apple.com/app/pepinillo' };

const steps = [
  {
    num: '01',
    title: 'Pick a Mode',
    desc: 'Swipe between Pomodoro, Flowtime, Time Block, or Stopwatch. Each mode is designed for a different style of deep work.',
  },
  {
    num: '02',
    title: 'Link a Task',
    desc: 'Tap "Link Task" to select what you\'re working on. This helps you track where your time goes.',
  },
  {
    num: '03',
    title: 'Start Focusing',
    desc: 'Hit the big Start button and dive in. Pepinillo takes care of the rest — including your breaks.',
  },
  {
    num: '04',
    title: 'Mindful Breaks',
    desc: 'When the timer ends, follow the suggested break activities to recharge. Stretch, breathe, hydrate.',
  },
];
---

<Layout
  title="Quick Start Guide — Pepinillo"
  description="Get started with Pepinillo in under 2 minutes. Learn how to pick a mode, link tasks, and start focusing."
>
  <Nav links={pepNav} cta={pepCTA} />

  <section class="guide-page">
    <div class="guide-inner">

      <div class="guide-head reveal">
        <div class="eyebrow" style="margin-bottom:14px"><span>Quick Start</span></div>
        <h1>Welcome to <span class="serif">Pepinillo</span>.</h1>
        <p class="subtitle">Pepinillo is designed to be simple yet powerful. Here is how to get started:</p>
      </div>

      <ol class="steps">
        {steps.map((step) => (
          <li class="step-card reveal">
            <div class="step-num">{step.num}</div>
            <div>
              <h2>{step.title}</h2>
              <p>{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="pro-tip reveal">
        <div class="tip-icon">💡</div>
        <div>
          <h2>Pro Tip: Live Activities</h2>
          <p>You don't need to keep the app open. Your timer will appear on your <strong>Lock Screen</strong> and in the <strong>Dynamic Island</strong> automatically. Just start a session and put your phone down.</p>
        </div>
      </div>

      <div class="next-links reveal">
        <h3>What's next?</h3>
        <div class="link-grid">
          <a href="/pepinillo/tips" class="next-card">
            <span class="next-icon">🧠</span>
            <div>
              <span class="next-title">Focus Tips & Techniques</span>
              <span class="next-desc">Master deep work with proven strategies.</span>
            </div>
          </a>
          <a href="/pepinillo/feedback" class="next-card">
            <span class="next-icon">💬</span>
            <div>
              <span class="next-title">Feedback & Support</span>
              <span class="next-desc">Questions? We're here to help.</span>
            </div>
          </a>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>

<style>
  .guide-page {
    padding: 140px var(--gutter) 100px;
    background:
      radial-gradient(55% 35% at 50% 0%, var(--lime-soft) 0%, transparent 60%),
      var(--paper);
    min-height: 80vh;
  }

  .guide-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .guide-head {
    margin-bottom: 56px;
  }

  .guide-head h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0 0 16px;
  }

  .guide-head h1 .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--pep-accent);
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0;
  }

  /* Steps */
  .steps {
    list-style: none;
    padding: 0;
    margin: 0 0 48px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .step-card {
    display: flex;
    gap: 24px;
    padding: 28px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    align-items: flex-start;
    transition: box-shadow 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .step-card:hover {
    box-shadow: var(--sh-2);
    border-color: oklch(0.84 0.18 128 / 0.4);
  }

  .step-num {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--pep-accent);
    line-height: 1;
    flex-shrink: 0;
    width: 48px;
  }

  .step-card h2 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 6px;
  }

  .step-card p {
    font-size: 0.92rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0;
  }

  /* Pro Tip */
  .pro-tip {
    display: flex;
    gap: 20px;
    padding: 28px;
    background: var(--lime-soft);
    border: 1px solid oklch(0.84 0.18 128 / 0.3);
    border-radius: var(--r-lg);
    margin-bottom: 64px;
    align-items: flex-start;
  }

  .tip-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .pro-tip h2 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 6px;
  }

  .pro-tip p {
    font-size: 0.92rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0;
  }

  .pro-tip strong {
    color: var(--pep-accent);
  }

  /* Next Links */
  .next-links {
    border-top: 1px solid var(--line);
    padding-top: 48px;
  }

  .next-links h3 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    margin: 0 0 20px;
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
  }

  .next-card {
    display: flex;
    gap: 16px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s var(--ease);
    align-items: center;
  }

  .next-card:hover {
    border-color: var(--pep-accent);
  }

  .next-icon {
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  .next-title {
    display: block;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 2px;
  }

  .next-desc {
    display: block;
    font-size: 0.82rem;
    color: var(--ink-2);
  }

  /* Eyebrow */
  .eyebrow { display: inline-flex; }

  .eyebrow span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pep-accent);
    background: var(--lime-soft);
    border: 1px solid oklch(0.84 0.18 128 / 0.25);
    border-radius: var(--r-pill);
    padding: 5px 12px;
  }
</style>
