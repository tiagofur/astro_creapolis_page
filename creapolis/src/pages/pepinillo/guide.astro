---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const pepNav = [
  { label: 'Features', href: '/pepinillo#features' },
  { label: 'Guide', href: '/pepinillo/guide' },
  { label: 'Tips', href: '/pepinillo/tips' },
  { label: 'Support', href: '/pepinillo/feedback' },
];

const pepCTA = { text: 'Download', href: 'https://apps.apple.com/app/pepinillo' };

const steps = [
  {
    num: '01',
    title: 'Pick a Mode',
    desc: 'Swipe between Pomodoro, Flowtime, Time Block, or Stopwatch. Not sure which? Start with Pomodoro — 25 minutes of focus, 5-minute break, repeat.',
  },
  {
    num: '02',
    title: 'Link a Task',
    desc: 'Tap "Link Task" to select what you\'re working on. Linking a task gives context to your session and helps you review focus history later.',
  },
  {
    num: '03',
    title: 'Start Focusing',
    desc: 'Hit the big Start button. Your timer will appear on the Lock Screen and in the Dynamic Island — so you never need to keep the app open.',
  },
  {
    num: '04',
    title: 'Mindful Breaks',
    desc: 'When the timer ends, follow the suggested break activity. Getting up, stretching, or stepping outside is science — not optional.',
  },
];
---

<Layout
  title="Quick Start Guide — Pepinillo"
  description="Get started with Pepinillo in minutes. Learn how to pick a focus mode, link tasks, and use Live Activities on your iPhone, iPad, Mac, and Apple Watch."
>
  <Nav links={pepNav} cta={pepCTA} />

  <section class="guide-page">
    <div class="guide-inner">

      <div class="guide-head reveal">
        <div class="eyebrow" style="margin-bottom:14px"><span>Quick Start Guide</span></div>
        <h1>Welcome to <span class="serif">Pepinillo</span></h1>
        <p class="subtitle">Pepinillo is designed to be simple yet powerful. You'll be focusing in under a minute.</p>
        <a href="https://apps.apple.com/app/pepinillo" class="store-btn" target="_blank" rel="noopener noreferrer">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.05 12.04a4.4 4.4 0 0 1 2.1-3.7 4.5 4.5 0 0 0-3.55-1.92c-1.5-.15-2.94.88-3.7.88-.78 0-1.95-.86-3.22-.84a4.72 4.72 0 0 0-3.98 2.42c-1.7 2.95-.43 7.3 1.22 9.7.8 1.17 1.76 2.48 3.02 2.44 1.22-.05 1.68-.78 3.15-.78 1.46 0 1.88.78 3.17.75 1.31-.02 2.14-1.18 2.94-2.36a10.5 10.5 0 0 0 1.34-2.73 4.25 4.25 0 0 1-2.49-3.86zM14.5 5.25a4.3 4.3 0 0 0 1-3.25 4.47 4.47 0 0 0-2.9 1.5 4.16 4.16 0 0 0-1.02 3.15 3.67 3.67 0 0 0 2.92-1.4z"/>
          </svg>
          <span>
            <span class="s">Download on the</span>
            <span class="b">App Store</span>
          </span>
        </a>
      </div>

      <div class="steps">
        {steps.map((step, i) => (
          <div class={`step reveal${i % 2 === 1 ? ' reveal-delay-1' : ''}`}>
            <div class="step-num">{step.num}</div>
            <div class="step-body">
              <h2>{step.title}</h2>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="tip-box reveal">
        <div class="tip-icon">💡</div>
        <div>
          <strong>Pro Tip: Live Activities</strong>
          <p>You don't need to keep the app open. Your timer will appear on your Lock Screen and in the Dynamic Island automatically. On Apple Watch, your focus timer is always one wrist-raise away.</p>
        </div>
      </div>

      <div class="modes-overview reveal">
        <h2>Focus Mode Reference</h2>
        <div class="modes-grid">
          <div class="mode-card">
            <h3>Pomodoro</h3>
            <p>25 min focus + 5 min break. After 4 rounds, take a long 15–30 min break. Best for tasks with clear boundaries.</p>
          </div>
          <div class="mode-card">
            <h3>Flowtime</h3>
            <p>No fixed intervals. Work until you feel your concentration dip, then take a break proportional to your focus time. Best for creative or deep analytical work.</p>
          </div>
          <div class="mode-card">
            <h3>Time Block</h3>
            <p>Reserve a fixed block (e.g., 90 minutes) for a category of work. Group similar small tasks together to reduce context switching.</p>
          </div>
          <div class="mode-card">
            <h3>Stopwatch</h3>
            <p>Track open-ended sessions without pressure. Useful for logging real work time and identifying where your hours actually go.</p>
          </div>
        </div>
      </div>

      <div class="guide-footer reveal">
        <p>Still have questions?</p>
        <div class="guide-footer-links">
          <a href="/pepinillo/tips" class="btn-outline">Focus Tips & Techniques →</a>
          <a href="/pepinillo/feedback" class="btn-outline">Contact Support →</a>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>

<style>
  .guide-page {
    padding: 140px var(--gutter) 100px;
    background:
      radial-gradient(55% 35% at 50% 0%, var(--lime-soft) 0%, transparent 60%),
      var(--paper);
    min-height: 80vh;
  }

  .guide-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .guide-head {
    margin-bottom: 60px;
  }

  .guide-head h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0 0 16px;
  }

  .guide-head h1 .serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--pep-accent);
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0 0 28px;
  }

  /* Store button */
  .store-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--r-md);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .store-btn:hover { opacity: 0.82; }
  .store-btn span { display: flex; flex-direction: column; }
  .store-btn .s { font-size: 0.68rem; opacity: 0.7; line-height: 1; }
  .store-btn .b { font-size: 0.95rem; font-weight: 600; line-height: 1.3; }

  /* Steps */
  .steps {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 48px;
  }

  .step {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 24px;
    padding: 28px 32px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    align-items: flex-start;
    transition: box-shadow 0.2s var(--ease);
  }

  .step:hover {
    box-shadow: var(--sh-2);
  }

  .step-num {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--pep-accent);
    background: var(--lime-soft);
    border-radius: var(--r-sm);
    padding: 6px 8px;
    text-align: center;
    align-self: flex-start;
    margin-top: 2px;
  }

  .step-body h2 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 8px;
  }

  .step-body p {
    font-size: 0.95rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0;
  }

  /* Tip box */
  .tip-box {
    display: flex;
    gap: 16px;
    padding: 24px 28px;
    background: var(--lime-soft);
    border: 1px solid oklch(0.84 0.18 128 / 0.25);
    border-radius: var(--r-lg);
    margin-bottom: 56px;
    align-items: flex-start;
  }

  .tip-icon {
    font-size: 1.4rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .tip-box strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 6px;
  }

  .tip-box p {
    font-size: 0.9rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0;
  }

  /* Modes overview */
  .modes-overview {
    margin-bottom: 60px;
  }

  .modes-overview h2 {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 24px;
    letter-spacing: -0.02em;
  }

  .modes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .mode-card {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--chalk);
  }

  .mode-card h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--pep-accent);
    margin: 0 0 8px;
  }

  .mode-card p {
    font-size: 0.88rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0;
  }

  /* Guide footer */
  .guide-footer {
    border-top: 1px solid var(--line);
    padding-top: 40px;
    text-align: center;
  }

  .guide-footer p {
    font-size: 1rem;
    color: var(--ink-2);
    margin-bottom: 20px;
  }

  .guide-footer-links {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-md);
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.9rem;
    transition: border-color 0.15s, color 0.15s;
  }

  .btn-outline:hover {
    border-color: var(--pep-accent);
    color: var(--pep-accent);
  }

  /* Eyebrow */
  .eyebrow {
    display: inline-flex;
  }

  .eyebrow span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pep-accent);
    background: var(--lime-soft);
    border: 1px solid oklch(0.84 0.18 128 / 0.25);
    border-radius: var(--r-pill);
    padding: 5px 12px;
  }

  .reveal { opacity: 0; transform: translateY(20px); }
</style>
