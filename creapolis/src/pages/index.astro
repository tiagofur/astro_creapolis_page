---
import { getCollection } from 'astro:content';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Ribbon from '../components/Ribbon.astro';
import { getPublishedCount, products } from '../i18n/data/products';
import Layout from '../layouts/Layout.astro';
import { getPostDescription } from '../utils/post';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const postTagColors: Record<string, string> = {
  // device / platform
  mobile: 'var(--iris)',
  desktop: 'var(--sky)',
  nativo: 'var(--sky)',
  // tech
  flutter: 'var(--sky)',
  dart: 'var(--sky)',
  react: 'var(--sky)',
  'react-native': 'var(--sky)',
  nextjs: 'var(--sky)',
  astro: 'var(--lime)',
  // web / backend / ops
  web: 'var(--lime)',
  backend: 'var(--amber)',
  devops: 'var(--amber)',
  // topics
  ui: 'var(--iris)',
  estado: 'var(--iris)',
  arquitectura: 'var(--amber)',
  testing: 'var(--lime)',
  performance: 'var(--coral)',
  seguridad: 'var(--coral)',
  datos: 'var(--coral)',
  // AI / automation
  ia: 'var(--coral)',
  automatizacion: 'var(--coral)',
  // meta
  desarrollo: 'var(--iris)',
  tutorial: 'var(--iris)',
  herramientas: 'var(--lime)',
  // business
  pricing: 'var(--amber)',
  mvp: 'var(--amber)',
  startup: 'var(--amber)',
  wordpress: 'var(--lime)',
  jamstack: 'var(--lime)',
};

function postDate(date: Date) {
  return new Intl.DateTimeFormat('es-MX', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(date);
}

const apps = [
  {
    slug: 'solennix',
    name: 'Solennix',
    tagline: 'todo-en-uno para eventos',
    desc: 'CRM, cotizaciones, inventario y dashboard para organizadores profesionales en Latinoamérica.',
    href: '/proyectos/solennix',
    deviceRows: [[3], [2], [1]],
  },
  {
    slug: 'pepinillo',
    name: 'Pepinillo',
    tagline: 'Pomodoro, tareas y timer',
    desc: 'Productividad todo-en-uno: Pomodoro configurable, tareas con prioridades y subtasks, calendario, timer y estadísticas.',
    href: '/proyectos/pepinillo',
    deviceRows: [[2], [3]],
  },
  {
    slug: 'peliculas',
    name: 'Películas',
    tagline: 'tu cine, a tu manera',
    desc: 'Catálogo de películas y series, listas personalizadas, búsqueda avanzada y recomendaciones basadas en tus gustos.',
    href: '/proyectos/peliculas',
    deviceRows: [[3], [2]],
  },
].map((app) => {
  const canonical = products.find((p) => p.slug === app.slug);
  if (!canonical) return { ...app, platform: '', color: '', status: 'live' };
  const platformStr = canonical.platforms
    .filter((pl) => pl.available)
    .map((pl) => pl.id.toUpperCase())
    .join(' · ');
  return {
    ...app,
    platform: platformStr,
    color: canonical.color,
    status: canonical.status,
  };
});

const shelf = [
  {
    ring: 'Sx',
    name: 'Solennix · Mejora continua',
    status: 'active',
    statusLabel: 'En producción',
    desc: 'Iteración constante: nuevas features por feedback de usuarios reales, estabilidad y preparación para escalar.',
    progress: 92,
    color: 'var(--iris)',
    bg: 'var(--iris-soft)',
  },
  {
    ring: 'Se',
    name: 'Serene · Diario de gratitud',
    status: 'dev',
    statusLabel: 'En desarrollo',
    desc: 'Diario de gratitud con IA consciente para ansiedad, burnout y depresión. Feedback terapéutico responsable — sin alucinaciones, sin diagnósticos, sin dañar.',
    progress: 40,
    color: 'var(--coral)',
    bg: 'var(--coral-soft)',
  },
  {
    ring: 'Pe',
    name: 'Pepinillo para iOS',
    status: 'dev',
    statusLabel: 'En desarrollo',
    desc: 'La app de productividad que ya funciona en Android, camino al iPhone. Próximo paso: migrar Android a nativo y construir versión desktop.',
    progress: 28,
    color: 'var(--lime)',
    bg: 'var(--lime-soft)',
  },
  {
    ring: 'SG',
    name: 'Subscription Guardian',
    status: 'pre',
    statusLabel: 'Pre-lanzamiento',
    desc: 'Control de suscripciones para iOS. Alertas antes de cada cobro, dashboard de gastos y privacidad total. Próximamente en App Store.',
    progress: 70,
    color: 'var(--sky)',
    bg: 'var(--sky-soft)',
  },
  {
    ring: '?',
    name: 'En exploración · Asistente conectado',
    status: 'soon',
    statusLabel: 'Concepto',
    desc: 'Idea explorando: un asistente que unifica WhatsApp, correo y CRM en un solo hilo para PyMEs. Todavía sin nombre definido.',
    progress: 10,
    color: 'var(--amber)',
    bg: 'var(--amber-soft)',
  },
];

const services = [
  {
    num: '01 / Móvil',
    mark: 'm',
    title: 'Apps móviles',
    desc: 'iOS y Android, nativas o multiplataforma. Publico, doy soporte y mantengo stores.',
  },
  {
    num: '02 / Web',
    mark: 'w',
    title: 'Apps web',
    desc: 'SPAs, e-commerce y dashboards con Next.js y Astro. Rápidas, seguras y medibles.',
  },
  {
    num: '03 / Desktop',
    mark: 'd',
    title: 'Software de escritorio',
    desc: 'macOS, Windows y Linux. Tauri + Rust para rendimiento nativo y bundles pequeños.',
  },
  {
    num: '04 / IA',
    mark: 'i',
    title: 'Consultoría de IA',
    desc: 'Automatización de procesos, chatbots, análisis. Implementación práctica, no teoría.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Descubrir',
    desc: 'Llamada de 45 min, lectura del mercado, roadmap con fechas realistas y presupuesto.',
  },
  {
    n: '2',
    title: 'Diseñar',
    desc: 'Wireframes, prototipo navegable en Figma y sistema de diseño documentado.',
  },
  {
    n: '3',
    title: 'Construir',
    desc: 'Sprints de 2 semanas. Demo cada viernes. Código en tu repo desde el día uno.',
  },
  {
    n: '4',
    title: 'Lanzar',
    desc: 'QA, publicación en stores, métricas. 30 días de soporte incluidos post-lanzamiento.',
  },
];

const publishedCount = getPublishedCount();
const stats = [
  { n: '5+ años', label: 'Construyendo producto', color: 'c1' },
  { n: `${publishedCount} apps`, label: 'Propias en tiendas', color: 'c2' },
  { n: '1 persona', label: 'Cero intermediarios', color: 'c3' },
  { n: '< 24h', label: 'Respuesta a cada mensaje', color: 'c4' },
];
---

<Layout>
  <Nav />

  <div>
  <!-- ═══════════════════════════════════════════════════════════════
       HERO — full-height with ribbon + showcase cards
       ═══════════════════════════════════════════════════════════════ -->
  <header class="hero">
    <Ribbon />
    <div class="hero-grid">
      <div class="hero-copy reveal">
        <div class="eyebrow" style="margin-bottom:20px">
          <span>Estudio de producto · Monterrey</span>
        </div>
        <h1>Software que<br/><span class="serif">transforma</span> ideas<br/>en productos.</h1>
        <p class="lead">Diseño y desarrollo apps móviles, web y escritorio con el cuidado de quien las va a mantener y la velocidad de quien entrega cada semana. Consultoría de IA incluida.</p>
        <div class="hero-cta">
          <a href="/es/contacto" class="btn btn-primary btn-lg">Iniciar proyecto
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </a>
          <a href="#apps" class="hero-cta-ghost">Ver mi trabajo ↓</a>
        </div>
        <div class="hero-trust">
          <span><strong>5+ años</strong> entregando producto</span>
          <span><strong>{publishedCount} apps propias</strong> en tiendas</span>
          <span><strong>Respuesta &lt;24h</strong> a cada mensaje</span>
        </div>
      </div>

      <div class="showcase reveal reveal-delay-2">
        <img src="/og/solennix.svg" alt="Solennix — CRM y eventos para organizadores profesionales" class="showcase-img" loading="lazy" decoding="async" />
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════════════════════
       MARQUEE — trust strip
       ═══════════════════════════════════════════════════════════════ -->
  <section class="stamps" aria-label="Lo que nos define">
    <div class="stamps-row">
      <span>Código propio, no plantillas</span>
      <span>Diseño en cada pixel</span>
      <span>Sprints de dos semanas</span>
      <span>Cero agencias intermedias</span>
      <span>Producto real, no slides</span>
      <span>Soporte post-lanzamiento</span>
      <span>Código propio, no plantillas</span>
      <span>Diseño en cada pixel</span>
      <span>Sprints de dos semanas</span>
      <span>Cero agencias intermedias</span>
      <span>Producto real, no slides</span>
      <span>Soporte post-lanzamiento</span>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       PRODUCTS — apps in production + in-dev shelf
       ═══════════════════════════════════════════════════════════════ -->
  <section id="apps" class="section">
    <div class="wrap">
      <div class="products-header">
        <div class="reveal">
          <div class="eyebrow" style="margin-bottom:18px"><span>Mis apps · En producción</span></div>
          <h2>Producto propio,<br/><span class="serif">en las tiendas</span>.</h2>
        </div>
        <p class="reveal reveal-delay-1">Antes de hacer el tuyo, hice el mío. Estas son apps creadas, mantenidas y operadas por mí. Usuarios reales, reseñas reales, código propio.</p>
      </div>

      <div class="products">
        {apps.map((app, i) => (
          <a href={app.href} class={`product reveal${i > 0 ? ` reveal-delay-${i}` : ''}`} style={`--product-color: ${app.color}`}>
            <div class="product-vis">
              <div class="glow"></div>
              <div class="device">
                <div class="title"></div>
                {app.deviceRows.map((row) => (
                  <div class="row">
                    {row.map(() => <div class="bit"></div>)}
                  </div>
                ))}
                <div class="big"></div>
              </div>
            </div>
            <div class="product-meta">
              <div class="head">
                <h3>{app.name}</h3>
                <span class={`chip ${app.status === 'live' ? 'live' : 'pre'}`}><span class="chip-dot"></span>{app.status === 'live' ? 'Live' : 'Pre-lanzamiento'}</span>
              </div>
              <span class="tagline">{app.tagline}</span>
              <p>{app.desc}</p>
              <div class="foot">
                <span class="plat">{app.platform}</span>
                <span>Ver detalles →</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- In-development shelf -->
      <div class="shelf reveal">
        <div class="shelf-head">
          <div>
            <div class="eyebrow" style="margin-bottom:10px"><span>En desarrollo · Taller abierto</span></div>
            <h3>Lo que estoy construyendo ahora mismo.</h3>
          </div>
          <a href="#contact" class="btn btn-ghost">Síguelo de cerca →</a>
        </div>
        <div class="shelf-grid">
          {shelf.map((item) => (
            <div class="shelf-card" style={`--ring-color: ${item.color}; --ring-bg: ${item.bg}`}>
              <div class="ring">{item.ring}</div>
              <div class="body">
                <div class="h">
                  <h4>{item.name}</h4>
                  <span class={`chip ${item.status}`}><span class="chip-dot"></span>{item.statusLabel}</span>
                </div>
                <p>{item.desc}</p>
                <div class="bar"><span style={`width: ${item.progress}%`}></span></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SERVICES — what we build
       ═══════════════════════════════════════════════════════════════ -->
  <section id="services" class="section" style="background: var(--chalk)">
    <div class="wrap">
      <div class="products-header">
        <div class="reveal">
          <div class="eyebrow" style="margin-bottom:18px"><span>Servicios</span></div>
          <h2>Hago producto<br/>de cabo a rabo.</h2>
        </div>
        <p class="reveal reveal-delay-1">Descubrimiento, diseño, código y despliegue. Un solo responsable de punta a punta, una sola factura. Sin agencias intermedias ni handoffs rotos.</p>
      </div>

      <div class="svc-grid">
        {services.map((s, i) => (
          <div class={`svc reveal${i > 0 ? ` reveal-delay-${i}` : ''}`}>
            <span class="mark">{s.mark}</span>
            <span class="num">{s.num}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>

      <div class="svc-more reveal">
        <a href="/servicios" class="btn btn-primary">Ver servicios y tarifas
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       PROCESS — how we work
       ═══════════════════════════════════════════════════════════════ -->
  <section id="proceso" class="section">
    <div class="wrap">
      <div class="products-header">
        <div class="reveal">
          <div class="eyebrow" style="margin-bottom:18px"><span>Cómo trabajamos</span></div>
          <h2>Un proceso con<br/><span class="serif">pocas sorpresas</span>.</h2>
        </div>
        <p class="reveal reveal-delay-1">Entregas visibles cada dos semanas. Canal directo con quien escribe el código — nunca un intermediario. Así se construye confianza: mostrando avance real, no promesas.</p>      </div>

      <div class="proc">
        {steps.map((step, i) => (
          <div class={`step reveal${i > 0 ? ` reveal-delay-${i}` : ''}`}>
            <span class="bignum">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       MISSION — who we are + stats
       ═══════════════════════════════════════════════════════════════ -->
  <section class="mission">
    <div class="ribbon" aria-hidden="true">
      <svg viewBox="0 0 1400 400" preserveAspectRatio="none">
        <defs>
          <linearGradient id="rib2" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="oklch(0.84 0.18 128)" stop-opacity="0.3"/>
            <stop offset="100%" stop-color="oklch(0.72 0.18 32)" stop-opacity="0.3"/>
          </linearGradient>
        </defs>
        <path d="M -100,200 C 300,50 600,350 900,150 C 1100,20 1300,250 1500,100"
              fill="none" stroke="url(#rib2)" stroke-width="80" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="wrap">
      <div class="reveal">
        <div class="eyebrow" style="color: oklch(0.75 0.01 265); margin-bottom:18px"><span>Sobre mí</span></div>
        <h2>No es una agencia.<br/>Es un <span class="serif">desarrollador que vive en el producto</span>.</h2>
        <p class="big">Desde 2019 construyo software — al principio como experimento, ahora como trabajo. Hablás conmigo, te contesto yo, escribo el código yo. Sin agencias, sin equipos que cambian a mitad de proyecto, sin nadie que te traduzca lo que ya dijiste bien.</p>
        <a href="/sobre" class="btn btn-ghost" style="margin-top:24px;border-color:oklch(0.5 0.01 265);color:var(--paper)">Conocé más sobre mí
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </a>
      </div>

      <div class="stats reveal reveal-delay-2">
        {stats.map((stat) => (
          <div class="stat">
            <div class={`n ${stat.color}`}>{stat.n}</div>
            <div class="l">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       NOTAS — latest blog posts
       ═══════════════════════════════════════════════════════════════ -->
  <section id="notas" class="section notes-block">
    <div class="wrap">
      <div class="notes-head reveal">
        <div>
          <div class="eyebrow" style="margin-bottom:14px"><span>Notas</span></div>
          <h2>Pensamos en voz alta <span class="serif">sobre producto</span>.</h2>
          <p class="notes-intro">Lo que aprendo construyendo apps reales — decisiones técnicas, errores que pagué, y lo que funciona cuando el hype se apaga.</p>
        </div>
        <a href="/blog" class="btn btn-ghost">Ver todas las notas
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </a>
      </div>

      <div class="notes-grid reveal reveal-delay-2">
        {latestPosts.map((post) => {
          const firstTag = post.data.tags?.[0];
          const accent = firstTag ? (postTagColors[firstTag] ?? 'var(--iris)') : 'var(--iris)';
          return (
            <a href={`/blog/${post.slug}`} class="note-card" style={`--note-accent: ${accent}`}>
              <div class="note-top">
                <span class="note-dot" aria-hidden="true"></span>
                <span class="note-date">{postDate(post.data.pubDate)}</span>
                {firstTag && <span class="note-tag">{firstTag}</span>}
              </div>
              <h3>{post.data.title}</h3>
              <p>{getPostDescription(post)}</p>
              <span class="note-read">Leer nota
                <svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       CONTACT CTA — mini form
       ═══════════════════════════════════════════════════════════════ -->
  <section id="contact" class="contact-cta">
    <div class="contact-card reveal">
      <div class="eyebrow" style="margin-bottom:16px"><span>Hablemos</span></div>
      <h2>Contame tu idea.<br/>Te contesto <span class="serif">el mismo día</span>.</h2>
      <p class="lead">Sin formularios de 20 campos ni disqueros. Escribime en 2 minutos, te respondo en menos de 24 horas con próximos pasos.</p>

      <div class="c-cta-row">
        <a href="/es/contacto" class="btn btn-primary btn-lg">Iniciar conversación
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </a>
        <a href="mailto:hola@creapolis.dev" class="btn btn-ghost btn-lg">hola@creapolis.dev</a>
      </div>
    </div>
  </section>

  </div>

  <Footer />
</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════════
     HERO
     ═══════════════════════════════════════════════════════════════ */
  .hero {
    position: relative;
    min-height: 100vh;
    padding: 140px var(--gutter) 80px;
    display: grid; place-items: center;
    overflow: clip;
    background:
      radial-gradient(60% 50% at 80% 10%, var(--iris-soft) 0%, transparent 60%),
      radial-gradient(50% 45% at 10% 80%, var(--coral-soft) 0%, transparent 70%),
      radial-gradient(70% 60% at 50% 120%, var(--lime-soft) 0%, transparent 70%),
      var(--paper);
  }
  .hero-grid {
    width: 100%; max-width: var(--max);
    display: grid; gap: clamp(40px, 6vw, 80px);
    grid-template-columns: 1fr;
    position: relative; z-index: 2;
  }
  @media (min-width: 980px) {
    .hero-grid { grid-template-columns: 1.25fr 1fr; align-items: center; }
  }
  .hero h1 {
    font-size: clamp(3rem, 8vw, 6.2rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
    margin-bottom: 28px;
  }
  .hero h1 .serif { color: var(--iris); font-size: 1.02em; }
  .hero p.lead {
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    color: var(--ink-2);
    max-width: 52ch; margin-bottom: 36px;
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .hero-cta-ghost {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--ink-3);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }
  .hero-cta-ghost:hover { color: var(--ink); }
  .hero-trust {
    margin-top: 40px; padding-top: 24px;
    border-top: 1px dashed var(--line-2);
    display: flex; flex-wrap: wrap; gap: 18px 32px;
    font-size: 0.85rem; color: var(--ink-3);
  }
  .hero-trust strong { color: var(--ink); font-weight: 500; }

  /* Canvas showpiece */
  .showcase {
    width: 100%; max-width: 520px; margin: 0 auto;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--sh-3);
    border: 1px solid var(--line);
  }
  .showcase-img {
    width: 100%; height: auto; display: block;
  }

  /* ═══════════════════════════════════════════════════════════════
     MARQUEE
     ═══════════════════════════════════════════════════════════════ */
  .stamps {
    background: var(--ink); color: var(--paper);
    padding: 28px 0; overflow: hidden;
  }
  .stamps-row {
    display: flex; gap: 64px; white-space: nowrap;
    animation: marquee 32s linear infinite;
    font-family: var(--font-mono); font-size: 0.82rem; color: oklch(0.75 0.01 265);
  }
  .stamps:hover .stamps-row { animation-play-state: paused; }
  .stamps-row span { display: inline-flex; align-items: center; gap: 10px; }
  .stamps-row span::before { content: "✦"; color: var(--coral); font-size: 0.7rem; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* ═══════════════════════════════════════════════════════════════
     PRODUCTS
