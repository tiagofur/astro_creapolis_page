---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('es-ES', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  }).format(date);
}
---

<Layout title="Blog — Creapolis" description="Artículos sobre desarrollo de software, tecnología y mejores prácticas.">
  <!-- Navigation -->
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <div class="nav-logo-mark">C</div>
        <span>Creapolis</span>
      </a>

      <div class="nav-links">
        <a href="/#apps">Apps</a>
        <a href="/#servicios">Servicios</a>
        <a href="/#proceso">Proceso</a>
        <a href="/blog">Blog</a>
        <a href="/#contacto">Contacto</a>
      </div>

      <a href="/#contacto" class="nav-cta">Iniciar proyecto</a>

      <button class="nav-mobile-toggle" aria-label="Menú">
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div class="mobile-menu">
    <a href="/#apps">Apps</a>
    <a href="/#servicios">Servicios</a>
    <a href="/#proceso">Proceso</a>
    <a href="/blog">Blog</a>
    <a href="/#contacto">Contacto</a>
    <a href="/#contacto" class="cta">Iniciar proyecto</a>
  </div>

  <!-- Header -->
  <section class="page-header">
    <div class="container">
      <span class="page-label">Blog</span>
      <h1>Ideas sobre<br />desarrollo y tecnología.</h1>
      <p>Artículos sobre desarrollo de software, mejores prácticas y casos de uso.</p>
    </div>
  </section>

  <!-- Posts -->
  <section class="section">
    <div class="container">
      <div class="posts-grid">
        {sortedPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="post-card">
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              {post.data.tags.length > 0 && (
                <span class="post-tags">
                  {post.data.tags.slice(0, 2).join(', ')}
                </span>
              )}
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="post-link">Leer más →</span>
          </a>
        ))}
      </div>

      {sortedPosts.length === 0 && (
        <div class="empty-state">
          <p>No hay artículos publicados aún.</p>
        </div>
      )}
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <div class="footer-logo-mark">C</div>
        <span>Creapolis</span>
      </div>
      <div class="footer-links">
        <a href="/#apps">Apps</a>
        <a href="/#servicios">Servicios</a>
        <a href="/#proceso">Proceso</a>
        <a href="/blog">Blog</a>
        <a href="/privacidad">Privacidad</a>
        <a href="/terminos">Términos</a>
      </div>
      <p class="footer-copy">© {new Date().getFullYear()} Creapolis. Todos los derechos reservados.</p>
    </div>
  </footer>
</Layout>

<style>
  .page-header {
    padding: 140px 24px 80px;
    text-align: center;
    background: var(--color-bg-alt);
  }

  .page-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 16px;
  }

  .page-header p {
    max-width: 500px;
    margin: 0 auto;
    font-size: 1.0625rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .post-card {
    display: block;
    padding: 24px;
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: all 0.3s var(--ease-out);
  }

  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    font-size: 0.8125rem;
    color: var(--color-text-tertiary);
  }

  .post-tags {
    color: var(--color-accent);
  }

  .post-card h2 {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 8px;
    color: var(--color-text);
  }

  .post-card p {
    font-size: 0.9375rem;
    line-height: 1.5;
    margin-bottom: 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-link {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .empty-state {
    text-align: center;
    padding: 64px 24px;
    color: var(--color-text-secondary);
  }
</style>