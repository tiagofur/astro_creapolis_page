---
import PepinilloFeedbackContent from '../../../../components/pages/PepinilloFeedbackContent.astro';
import type { Lang } from '../../../../i18n/ui';
import Layout from '../../../../layouts/Layout.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'pt' } }];
}
const lang = Astro.params.lang as Lang;
---

<Layout lang={lang} title="Feedback e suporte — Pepinillo" description="Obtenha suporte para o Pepinillo, reporte um bug ou envie uma sugestão. Estamos para ajudar.">
  <PepinilloFeedbackContent lang={lang} />
</Layout>
