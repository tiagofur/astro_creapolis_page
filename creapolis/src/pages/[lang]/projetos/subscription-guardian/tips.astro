---
import SGTipsContent from '../../../../components/pages/SGTipsContent.astro';
import type { Lang } from '../../../../i18n/ui';
import Layout from '../../../../layouts/Layout.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'pt' } }];
}
const lang = Astro.params.lang as Lang;
---

<Layout lang={lang} title="Dicas de assinaturas — Subscription Guardian" description="Estratégias práticas para reduzir a fadiga de assinaturas sem sacrificar o que importa para você.">
  <SGTipsContent lang={lang} />
</Layout>
