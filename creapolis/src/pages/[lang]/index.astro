    font-size: 11px;
    font-weight: var(--fw-medium);
    color: var(--ink-4);
  }

  .cap-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--row-accent);
  }

  .cap-body {
