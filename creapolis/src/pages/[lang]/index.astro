  }

  .case-row:hover .case-link {
    color: var(--ink);
    border-color: var(--ink);
  }

  .case-row:hover .case-link svg {
    transform: translate(2px, -2px);
  }

  @media (max-width: 720px) {
    .case-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .case-num {
      display: none;
    }
    .case-link {
      width: fit-content;
    }
  }

  /* ═══════════════════════════════════════════════════════════════
     5. MANIFESTO — pull-quote
     ═══════════════════════════════════════════════════════════════ */
  .manifesto {
    padding: clamp(64px, 9vw, 120px) 0;
  }

  .manifesto .wrap {
    max-width: 860px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }

  .manifesto-quote {
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    line-height: 1.18;
    letter-spacing: -0.03em;
    font-weight: var(--fw-semibold);
    color: var(--ink);
    max-width: 26ch;
    margin: 0;
    text-wrap: balance;
  }

  .manifesto .head-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* ═══════════════════════════════════════════════════════════════
     8. COMPARISON — hairline grid
