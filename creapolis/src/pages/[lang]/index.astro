  }

  .head-link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  /* ═══════════════════════════════════════════════════════════════
     3. SERVICES CARDS
     ═══════════════════════════════════════════════════════════════ */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }

