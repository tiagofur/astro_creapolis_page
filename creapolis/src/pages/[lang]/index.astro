    grid-template-columns: 34px 1fr auto 28px;
    gap: 16px;
    align-items: center;
    padding: 20px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }

  .app-row:hover {
