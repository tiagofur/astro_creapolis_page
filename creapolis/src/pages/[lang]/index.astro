    font-weight: var(--fw-medium);
    font-size: 0.95rem;
  }

  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: var(--fw-medium);
    color: var(--ink-2);
