---
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Nav from '../../components/Nav.astro';
import CmyDots from '../../components/brand/CmyDots.astro';
import CubePyramid from '../../components/brand/CubePyramid.astro';
import { getHomeServices, getHomeSteps } from '../../i18n/data/home';
import type { Lang } from '../../i18n/ui';
import {
  formatDate,
  getLocalizedPath,
  useTranslations,
} from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';
import { getPostDescription } from '../../utils/post';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'pt' } },
  ];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const services = getHomeServices(lang);
const steps = getHomeSteps(lang);

/* ─── Capability rows (formerly hero carousel — now calm, scannable) ─── */
const ACCENTS = ['#00AEEF', '#EC008C', '#FFC400', '#00AEEF'] as const;

const capabilities = {
  es: [
    {
      num: '01',
      title: 'Agentes de IA que atienden y agendan citas en automático',
      desc: 'Respuesta en segundos 24/7 por WhatsApp o web, sincronizada con Google Calendar y tu CRM.',
      href: getLocalizedPath(lang, '/servicios#ai-agents'),
    },
    {
      num: '02',
      title: 'IA interna para soporte, cotizaciones y operaciones',
      desc: 'Un asistente conectado a tus documentos, precios e inventario que resuelve hasta el 80% de lo repetitivo.',
      href: getLocalizedPath(lang, '/servicios#ai-agents'),
    },
    {
      num: '03',
      title: 'CRMs y sistemas web a la medida de tu operación',
      desc: 'Deja atrás los Excel desconectados: paneles, cotizadores, contratos e inventario. Código 100% tuyo.',
      href: getLocalizedPath(lang, '/servicios#mvp'),
    },
    {
      num: '04',
      title: 'Apps iOS y Android publicadas en tiendas oficiales',
      desc: 'Diseño, desarrollo y publicación completa, con pagos, notificaciones y modo offline.',
      href: getLocalizedPath(lang, '/servicios#mvp'),
    },
  ],
  en: [
    {
      num: '01',
      title: 'AI agents that answer and book appointments automatically',
      desc: 'Replies in seconds 24/7 over WhatsApp or web chat, synced with Google Calendar and your CRM.',
      href: getLocalizedPath(lang, '/servicios#ai-agents'),
    },
    {
      num: '02',
      title: 'Internal AI for support, quoting, and operations',
      desc: 'An assistant connected to your documents, pricing, and inventory that resolves up to 80% of repetitive work.',
      href: getLocalizedPath(lang, '/servicios#ai-agents'),
    },
    {
      num: '03',
      title: 'Custom CRMs and web systems built around your operation',
      desc: 'Move past disconnected spreadsheets: dashboards, quoting engines, contracts, inventory. 100% your code.',
      href: getLocalizedPath(lang, '/servicios#mvp'),
    },
    {
      num: '04',
      title: 'iOS and Android apps published to official stores',
      desc: 'Design, engineering, and full store publishing, with payments, notifications, and offline mode.',
      href: getLocalizedPath(lang, '/servicios#mvp'),
    },
  ],
  pt: [
    {
      num: '01',
      title: 'Agentes de IA que atendem e agendam reuniões no automático',
      desc: 'Resposta em segundos 24/7 por WhatsApp ou web, sincronizada com Google Calendar e seu CRM.',
      href: getLocalizedPath(lang, '/servicos#ai-agents'),
    },
    {
      num: '02',
      title: 'IA interna para suporte, orçamentos e operações',
      desc: 'Um assistente conectado aos seus documentos, preços e estoque que resolve até 80% do repetitivo.',
      href: getLocalizedPath(lang, '/servicos#ai-agents'),
    },
    {
      num: '03',
      title: 'CRMs e sistemas web sob medida para sua operação',
      desc: 'Chega de planilhas desconectadas: painéis, orçamentos, contratos e estoque. Código 100% seu.',
      href: getLocalizedPath(lang, '/servicos#mvp'),
    },
    {
      num: '04',
      title: 'Apps iOS e Android publicados nas lojas oficiais',
      desc: 'Design, desenvolvimento e publicação completa, com pagamentos, notificações e modo offline.',
      href: getLocalizedPath(lang, '/servicos#mvp'),
    },
  ],
}[lang];

/* ─── Own apps — concise production proof (one CMYK accent each) ─── */
const ownApps = [
  {
    slug: 'solennix',
    num: '01',
    name: 'Solennix',
    category: lang === 'es' ? 'CRM y Operaciones para Eventos' : lang === 'en' ? 'Event CRM & Operations' : 'CRM e Operações para Eventos',
    summary: lang === 'es' ? 'Cotizaciones, contratos, inventario y finanzas en Web, iOS y Android.' : lang === 'en' ? 'Quotes, contracts, inventory, and billing across Web, iOS, and Android.' : 'Orçamentos, contratos, inventário e finanças na Web, iOS e Android.',
    platforms: ['Web', 'iOS', 'Android'],
    status: 'Live',
    accent: 'var(--c-cyan)',
    href: getLocalizedPath(lang, '/proyectos/solennix'),
  },
  {
    slug: 'pepinillo',
    num: '02',
    name: 'Pepinillo',
    category: lang === 'es' ? 'Productividad & Enfoque' : lang === 'en' ? 'Productivity & Focus' : 'Produtividade & Foco',
    summary: lang === 'es' ? 'Timer nativo en Kotlin Compose y SwiftUI publicado en ambas tiendas.' : lang === 'en' ? 'Native Kotlin Compose and SwiftUI timer live on both stores.' : 'Timer nativo em Kotlin Compose e SwiftUI nas duas lojas.',
    platforms: ['iOS', 'Android'],
    status: 'Live',
    accent: 'var(--c-yellow)',
    href: getLocalizedPath(lang, '/proyectos/pepinillo'),
  },
  {
    slug: 'peliculas',
    num: '03',
    name: lang === 'es' ? 'Películas' : 'Movies',
    category: lang === 'es' ? 'Catálogo & Entretenimiento' : lang === 'en' ? 'Entertainment Catalog' : 'Catálogo & Entretenimento',
    summary: lang === 'es' ? 'Cartelera, trailers y listas personalizadas con Flutter.' : lang === 'en' ? 'Showtimes, trailers, and watchlists built with Flutter.' : 'Filmes em cartaz, trailers e listas com Flutter.',
    platforms: ['Android'],
    status: 'Live',
    accent: 'var(--c-magenta)',
    href: getLocalizedPath(lang, '/proyectos/peliculas'),
  },
  {
    slug: 'subscription-guardian',
    num: '04',
    name: 'Subscription Guardian',
    category: lang === 'es' ? 'Finanzas Personales iOS' : lang === 'en' ? 'iOS Personal Finance' : 'Finanças Pessoais iOS',
    summary: lang === 'es' ? 'Control de suscripciones 100% privado con SwiftUI y SwiftData.' : lang === 'en' ? '100% private subscription tracker built with SwiftUI and SwiftData.' : 'Controle de assinaturas 100% privado em SwiftUI.',
    platforms: ['iOS'],
    status: 'Pre-launch',
    accent: 'var(--key)',
    href: getLocalizedPath(lang, '/proyectos/subscription-guardian'),
  },
];

/* ─── Hero micro-stats ─── */
const heroStats = {
  es: [
    { v: '4', l: 'apps en tiendas' },
    { v: String(allPosts.length), l: 'notas técnicas publicadas' },
    { v: '< 24h', l: 'de respuesta' },
    { v: '100%', l: 'código tuyo' },
  ],
  en: [
    { v: '4', l: 'apps on the stores' },
    { v: String(allPosts.length), l: 'technical notes published' },
    { v: '< 24h', l: 'response time' },
    { v: '100%', l: 'your code' },
  ],
  pt: [
    { v: '4', l: 'apps nas lojas' },
    { v: String(allPosts.length), l: 'notas técnicas publicadas' },
    { v: '< 24h', l: 'de resposta' },
    { v: '100%', l: 'código seu' },
  ],
}[lang];

const lblBefore = lang === 'en' ? 'Before' : 'Antes';
const lblAfter = lang === 'en' ? 'Now' : lang === 'pt' ? 'Agora' : 'Ahora';

/* ─── Mini cases: problem → result ─── */
const cases = {
  es: [
    {
      before: 'Excel, WhatsApp y contratos en papel para organizar eventos',
      after: 'Solennix: cotizaciones, contratos, inventario y finanzas en un sistema propio',
      cta: 'Ver el caso',
      href: getLocalizedPath(lang, '/proyectos/solennix'),
    },
    {
      before: 'Una idea de app de enfoque sin presencia en tiendas',
      after: 'Pepinillo: timer nativo en Kotlin & SwiftUI, publicado en App Store y Google Play',
      cta: 'Ver la app',
      href: getLocalizedPath(lang, '/proyectos/pepinillo'),
    },
    {
      before: 'Prospectos esperando horas una respuesta por WhatsApp',
      after: 'Un agente de IA que responde en segundos y agenda citas solo — pruébalo aquí mismo',
      cta: 'Ver cómo funciona',
      href: getLocalizedPath(lang, '/servicios#ai-agents'),
    },
  ],
  en: [
    {
      before: 'Spreadsheets, WhatsApp, and paper contracts to run events',
      after: 'Solennix: quotes, contracts, inventory, and billing in one owned system',
      cta: 'See the case',
      href: getLocalizedPath(lang, '/proyectos/solennix'),
    },
    {
      before: 'A focus-app idea with no store presence',
      after: 'Pepinillo: a native Kotlin & SwiftUI timer live on the App Store and Google Play',
      cta: 'See the app',
      href: getLocalizedPath(lang, '/proyectos/pepinillo'),
    },
    {
      before: 'Leads waiting hours for a WhatsApp reply',
      after: 'An AI agent that answers in seconds and books meetings on its own — try it right here',
      cta: 'See how it works',
      href: getLocalizedPath(lang, '/servicios#ai-agents'),
    },
  ],
  pt: [
    {
      before: 'Planilhas, WhatsApp e contratos no papel para organizar eventos',
      after: 'Solennix: orçamentos, contratos, inventário e finanças em um sistema próprio',
      cta: 'Ver o caso',
      href: getLocalizedPath(lang, '/projetos/solennix'),
    },
    {
      before: 'Uma ideia de app de foco sem presença nas lojas',
      after: 'Pepinillo: timer nativo em Kotlin & SwiftUI publicado na App Store e Google Play',
      cta: 'Ver o app',
      href: getLocalizedPath(lang, '/projetos/pepinillo'),
    },
    {
      before: 'Prospectos esperando horas por uma resposta no WhatsApp',
      after: 'Um agente de IA que responde em segundos e agenda reuniões sozinho — teste aqui mesmo',
      cta: 'Ver como funciona',
      href: getLocalizedPath(lang, '/servicos#ai-agents'),
    },
  ],
}[lang];

/* ─── Manifesto pull-quote ─── */
const manifesto = {
  es: {
    ink: 'No vendo horas. Entrego sistemas que funcionan —',
    muted: 'y el código es tuyo desde el día uno.',
    cta: 'Así trabajo',
  },
  en: {
    ink: "I don't sell hours. I deliver systems that work —",
    muted: 'and the code is yours from day one.',
    cta: 'How I work',
  },
  pt: {
    ink: 'Não vendo horas. Entrego sistemas que funcionam —',
    muted: 'e o código é seu desde o dia um.',
    cta: 'Como trabalho',
  },
}[lang];

/* ─── Comparison: solo studio vs agency vs no-code ─── */
const comparison = {
  es: {
    eyebrow: 'Por qué un taller',
    title: '¿Por qué un taller',
    titleTone: 'y no una agencia?',
    lead: 'La diferencia no es el precio — es quién controla el producto.',
    usLabel: 'Creapolis · Taller',
    agencyLabel: 'Agencia tradicional',
    nocodeLabel: 'No-code / plantilla',
    rows: [
      { crit: 'El código y los datos son 100% tuyos', agency: false, nocode: false },
      { crit: 'Hablas directo con quien programa', agency: false, nocode: false },
      { crit: 'Precio cerrado por fase, sin sorpresas', agency: false, nocode: true },
      { crit: 'Se adapta a tu flujo real de trabajo', agency: true, nocode: false },
      { crit: 'Crece e integra tus otros sistemas', agency: true, nocode: false },
    ],
  },
  en: {
    eyebrow: 'Why a solo studio',
    title: 'Why a solo studio',
    titleTone: 'instead of an agency?',
    lead: "The difference isn't price — it's who controls the product.",
    usLabel: 'Creapolis · Studio',
    agencyLabel: 'Traditional agency',
    nocodeLabel: 'No-code template',
    rows: [
      { crit: 'The code and data are 100% yours', agency: false, nocode: false },
      { crit: 'You talk directly to the person building it', agency: false, nocode: false },
      { crit: 'Fixed price per phase, no surprises', agency: false, nocode: true },
      { crit: 'Fits your real workflow', agency: true, nocode: false },
      { crit: 'Grows and integrates your other systems', agency: true, nocode: false },
    ],
  },
  pt: {
    eyebrow: 'Por que um estúdio',
    title: 'Por que um estúdio',
    titleTone: 'e não uma agência?',
    lead: 'A diferença não é o preço — é quem controla o produto.',
    usLabel: 'Creapolis · Estúdio',
    agencyLabel: 'Agência tradicional',
    nocodeLabel: 'No-code / template',
    rows: [
      { crit: 'O código e os dados são 100% seus', agency: false, nocode: false },
      { crit: 'Você fala direto com quem programa', agency: false, nocode: false },
      { crit: 'Preço fechado por fase, sem surpresas', agency: false, nocode: true },
      { crit: 'Se adapta ao seu fluxo real', agency: true, nocode: false },
      { crit: 'Cresce e integra seus outros sistemas', agency: true, nocode: false },
    ],
  },
}[lang];

const heroCta = lang === 'es' ? 'Cotizar proyecto' : lang === 'en' ? 'Get a quote' : 'Orçar projeto';
const heroCta2 = lang === 'es' ? 'Ver servicios' : lang === 'en' ? 'View services' : 'Ver serviços';
---

<Layout lang={lang} ogImage="/og/home.svg">
  <Nav lang={lang} />

  <div class="page-container">
    <!-- ═══════════════════════════════════════════════════════════════
         1. HERO — quiet, typographic, one ambient CMYK halo
         ═══════════════════════════════════════════════════════════════ -->
    <header class="hero">
      <div class="hero-halo" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <div class="hero-mark reveal" aria-hidden="true">
          <CubePyramid size={72} variant="cmyk" class="hero-pyramid" />
        </div>
        <div class="hero-eyebrow reveal reveal-delay-1">
          <CmyDots size={5} />
          <span class="hero-eyebrow-label">
            {lang === 'es' ? 'Agentes de IA · Automatización · Software a Medida' : lang === 'en' ? 'AI Agents · Automation · Custom Software' : 'Agentes de IA · Automação · Software sob Medida'}
          </span>
        </div>
        <h1 class="hero-title reveal reveal-delay-2">
          {lang === 'es' && <>Soluciones claras para automatizar <span class="tone">y escalar tu negocio.</span></>}
          {lang === 'en' && <>Clear solutions to automate <span class="tone">and scale your business.</span></>}
          {lang === 'pt' && <>Soluções claras para automatizar <span class="tone">e escalar seu negócio.</span></>}
        </h1>
        <p class="hero-lead reveal reveal-delay-3">
          {lang === 'es'
            ? 'Estudio de software en Monterrey. Construyo agentes de IA, automatización de procesos y plataformas a la medida — con entregas cada dos semanas y código 100% tuyo desde el día uno.'
            : lang === 'en'
              ? 'A software studio in Monterrey. I build AI agents, process automation, and custom platforms — delivered in two-week sprints with 100% your code from day one.'
              : 'Estúdio de software em Monterrey. Construo agentes de IA, automação de processos e plataformas sob medida — com entregas a cada duas semanas e código 100% seu desde o dia um.'}
        </p>
        <div class="hero-actions reveal reveal-delay-4">
          <a href={getLocalizedPath(lang, '/contacto')} class="btn btn-primary" data-track-event="start_project_click">
            {heroCta}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </a>
          <a href={getLocalizedPath(lang, '/servicios')} class="btn btn-secondary">{heroCta2}</a>
        </div>

        <div class="hero-stats reveal">
          {heroStats.map((s) => (
            <div class="hero-stat">
              <span class="hero-stat-v">{s.v}</span>
              <span class="hero-stat-l">{s.l}</span>
            </div>
          ))}
        </div>
      </div>
    </header>

    <!-- ═══════════════════════════════════════════════════════════════
         2. CAPABILITIES — discrete hairline rows (what we build)
         ═══════════════════════════════════════════════════════════════ -->
    <section class="section-tight" aria-label={lang === 'es' ? 'Qué construimos' : 'What we build'}>
      <div class="wrap">
        <div class="cap-rows reveal">
          {capabilities.map((cap, i) => (
            <a href={cap.href} class="cap-row" style={`--row-accent: ${ACCENTS[i]}`}>
              <span class="cap-num">{cap.num}</span>
              <span class="cap-dot" aria-hidden="true"></span>
              <span class="cap-body">
                <strong>{cap.title}</strong>
                <small>{cap.desc}</small>
              </span>
              <svg class="cap-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         3. MINI CASES — problem → result proof rows
         ═══════════════════════════════════════════════════════════════ -->
    <section id="casos" class="section-tight section-alt">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow" style="--accent-color: var(--c-magenta);">
            {lang === 'es' ? 'Casos reales' : lang === 'en' ? 'Real cases' : 'Casos reais'}
          </p>
          <h2 class="section-title">
            {lang === 'es' && <>De problema a producto, <span class="tone">publicado y funcionando.</span></>}
            {lang === 'en' && <>From problem to product, <span class="tone">shipped and running.</span></>}
            {lang === 'pt' && <>Do problema ao produto, <span class="tone">publicado e funcionando.</span></>}
          </h2>
        </div>

        <div class="case-rows reveal">
          {cases.map((c, i) => (
            <a href={c.href} class="case-row" style={`--row-accent: ${ACCENTS[i % 3]}`}>
              <span class="case-num"><i aria-hidden="true"></i>0{i + 1}</span>
              <span class="case-body">
                <span class="case-line"><small>{lblBefore}</small>{c.before}</span>
                <span class="case-line case-after"><small>{lblAfter}</small>{c.after}</span>
              </span>
              <span class="case-link">
                {c.cta}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         4. SERVICES — cards with 3px accent bar + price pill
         ═══════════════════════════════════════════════════════════════ -->
    <section id="servicios" class="section">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow" style="--accent-color: var(--c-cyan);">
            {lang === 'es' ? 'Servicios' : 'Services'}
          </p>
          <h2 class="section-title">
            {lang === 'es' && <>Cómo podemos trabajar <span class="tone">juntos.</span></>}
            {lang === 'en' && <>How we can work <span class="tone">together.</span></>}
            {lang === 'pt' && <>Como podemos trabalhar <span class="tone">juntos.</span></>}
          </h2>
          <a href={getLocalizedPath(lang, '/servicios')} class="head-link">
            {lang === 'es' ? 'Servicios completos y precios →' : 'Full services & pricing →'}
          </a>
        </div>

        <div class="services-grid reveal-stagger reveal">
          {services.map((s, i) => (
            <a
              href={getLocalizedPath(lang, `/servicios#${s.id}`)}
              class="service-card"
              style={`--accent-color: ${ACCENTS[i % 3]};`}
            >
              <span class="card-bar" aria-hidden="true"></span>
              <div class="service-top">
                <span class="service-num">{s.num}</span>
                {s.price && <span class="service-price">{s.price}</span>}
              </div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <span class="service-more">
                {lang === 'es' ? 'Entregables y alcance →' : 'Deliverables & scope →'}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         5. MANIFESTO — pull-quote breathing point
         ═══════════════════════════════════════════════════════════════ -->
    <section class="manifesto">
      <div class="wrap reveal">
        <CmyDots size={5} />
        <p class="manifesto-quote">
          {manifesto.ink} <span class="tone">{manifesto.muted}</span>
        </p>
        <a href={getLocalizedPath(lang, '/sobre')} class="head-link">
          {manifesto.cta}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
        </a>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         6. OWN APPS — concise production proof rows
         ═══════════════════════════════════════════════════════════════ -->
    <section id="apps" class="section">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow" style="--accent-color: var(--c-magenta);">
            {lang === 'es' ? 'Proyectos propios' : 'Our own products'}
          </p>
          <h2 class="section-title">
            {lang === 'es' && <>Software real, publicado <span class="tone">y en producción.</span></>}
            {lang === 'en' && <>Real software, published <span class="tone">and in production.</span></>}
            {lang === 'pt' && <>Software real, publicado <span class="tone">e em produção.</span></>}
          </h2>
          <a href={getLocalizedPath(lang, '/proyectos')} class="head-link">
            {lang === 'es' ? 'Ver portafolio →' : 'View portfolio →'}
          </a>
        </div>

        <div class="apps-rows reveal">
          {ownApps.map((app) => (
            <a href={app.href} class="app-row" style={`--row-accent: ${app.accent}`}>
              <span class="app-num">{app.num}</span>
              <span class="app-main">
                <span class="app-title-line">
                  <strong>{app.name}</strong>
                  <span class="app-status">
                    <span class="status-dot" aria-hidden="true"></span>
                    {app.status}
                  </span>
                </span>
                <small class="app-summary">{app.summary}</small>
              </span>
              <span class="app-platforms">
                {app.platforms.map((p) => (
                  <span class="platform-pill">{p}</span>
                ))}
              </span>
              <svg class="app-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         5. PROCESS — hairline grid
         ═══════════════════════════════════════════════════════════════ -->
    <section id="proceso" class="section section-alt">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow" style="--accent-color: var(--c-yellow);">
            {lang === 'es' ? 'Proceso' : 'Process'}
          </p>
          <h2 class="section-title">
            {lang === 'es' && <>Un proceso simple, <span class="tone">de principio a fin.</span></>}
            {lang === 'en' && <>A simple process, <span class="tone">start to finish.</span></>}
            {lang === 'pt' && <>Um processo simples, <span class="tone">do início ao fim.</span></>}
          </h2>
        </div>

        <div class="hairline-grid reveal">
          {steps.map((step) => (
            <div class="hairline-cell">
              <span class="step-number">0{step.n}</span>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         8. COMPARISON — solo studio vs agency vs no-code
         ═══════════════════════════════════════════════════════════════ -->
    <section id="porque" class="section">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow" style="--accent-color: var(--c-cyan);">{comparison.eyebrow}</p>
          <h2 class="section-title">
            {comparison.title} <span class="tone">{comparison.titleTone}</span>
          </h2>
          <p>{comparison.lead}</p>
        </div>

        <div class="compare-scroll reveal">
          <div class="compare-grid">
            <div class="cmp-cell cmp-head" aria-hidden="true"></div>
            <div class="cmp-cell cmp-head cmp-us">
              <span class="cmp-us-dot" aria-hidden="true"></span>
              {comparison.usLabel}
            </div>
            <div class="cmp-cell cmp-head">{comparison.agencyLabel}</div>
            <div class="cmp-cell cmp-head">{comparison.nocodeLabel}</div>

            {comparison.rows.map((row) => (
              <>
                <div class="cmp-cell cmp-crit">{row.crit}</div>
                <div class="cmp-cell cmp-val cmp-us">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-label="✓"><path d="M3 8.5L6.5 12L13 4.5" stroke="var(--c-cyan)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <div class="cmp-cell cmp-val">
                  {row.agency ? (
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-label="✓"><path d="M3 8.5L6.5 12L13 4.5" stroke="#a1a1aa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  ) : (
                    <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-label="✕"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7" stroke="#d4d4d8" stroke-width="2" stroke-linecap="round"/></svg>
                  )}
                </div>
                <div class="cmp-cell cmp-val">
                  {row.nocode ? (
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-label="✓"><path d="M3 8.5L6.5 12L13 4.5" stroke="#a1a1aa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  ) : (
                    <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-label="✕"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7" stroke="#d4d4d8" stroke-width="2" stroke-linecap="round"/></svg>
                  )}
                </div>
              </>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         7. BLOG NOTES
         ═══════════════════════════════════════════════════════════════ -->
    <section id="notas" class="section">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow" style="--accent-color: var(--c-cyan);">Blog</p>
          <h2 class="section-title">
            {t('notes.title')} <span class="tone">{t('notes.title.serif')}.</span>
          </h2>
          <a href={getLocalizedPath(lang, '/blog')} class="head-link">{t('notes.cta')} →</a>
        </div>

        <div class="notes-grid reveal">
          {latestPosts.map((post) => (
            <a href={getLocalizedPath(lang, `/blog/${post.slug}`)} class="note-card">
              <div class="note-meta">
                <span class="note-date">{formatDate(post.data.pubDate, lang)}</span>
                {post.data.tags?.[0] && <span class="note-tag">{post.data.tags[0]}</span>}
              </div>
              <h3>{post.data.title}</h3>
              <p>{getPostDescription(post)}</p>
              <span class="note-read">{t('notes.read')} →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         8. FINAL CTA — the one dark card, with CMYK ambient glows
         ═══════════════════════════════════════════════════════════════ -->
    <section id="contacto" class="final-cta-section">
      <div class="wrap">
        <div class="cta-card reveal">
          <div class="cta-glow cta-glow-magenta" aria-hidden="true"></div>
          <div class="cta-glow cta-glow-cyan" aria-hidden="true"></div>
          <h2>
            {lang === 'es'
              ? '¿Platicamos sobre tu proyecto o agente de IA?'
              : lang === 'en'
                ? 'Ready to discuss your project or AI agent?'
                : 'Vamos conversar sobre seu projeto ou agente de IA?'}
          </h2>
          <p>
            {lang === 'es'
              ? 'Escríbeme o prueba el agente aquí mismo para agendar una llamada de 30 minutos sin costo.'
              : lang === 'en'
                ? 'Send a message or use our live AI concierge to book a free 30-minute discovery call.'
                : 'Escreva ou teste o agente aqui mesmo para agendar uma chamada de 30 minutos sem custo.'}
          </p>
          <div class="cta-actions">
            <a href={getLocalizedPath(lang, '/contacto')} class="cta-btn-primary" data-track-event="start_project_click">
              {lang === 'es' ? 'Ir a Contacto' : 'Contact us'}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 11L11 3M11 3H4.5M11 3V9.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </a>
            <a href="mailto:hola@creapolis.dev" class="cta-btn-email">hola@creapolis.dev</a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <Footer lang={lang} hideCta={true} />
</Layout>

<style>
  .page-container {
    overflow-x: clip;
  }

  .tone {
    color: var(--ink-4);
  }

  /* ═══════════════════════════════════════════════════════════════
     1. HERO
     ═══════════════════════════════════════════════════════════════ */
  .hero {
    position: relative;
    padding: 168px var(--gutter) 72px;
    text-align: center;
    overflow: hidden;
  }

  .hero-halo {
    position: absolute;
    top: -180px;
    left: 50%;
    width: 560px;
    height: 560px;
    transform: translateX(-50%);
    background: var(--halo-conic);
    filter: blur(90px);
    opacity: 0.16;
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    max-width: 780px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .hero-mark {
    margin-bottom: 4px;
  }

  .hero-pyramid {
    animation: pyramid-float 4.6s var(--ease) infinite;
  }

  @keyframes pyramid-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .hero-eyebrow-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: var(--ls-mono);
    color: var(--ink-3);
  }

  .hero-title {
    font-size: clamp(2.6rem, 6.4vw, 4.6rem);
    line-height: 1.04;
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-display);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
    max-width: 16ch;
  }

  .hero-lead {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.6;
    color: var(--ink-3);
    margin: 0;
    max-width: 56ch;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }

  .hero-stats {
    width: 100%;
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 20px 10px;
    align-items: center;
    text-align: center;
  }

  .hero-stat + .hero-stat {
    border-left: 1px solid var(--line);
  }

  .hero-stat-v {
    font-size: 1.35rem;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hero-stat-l {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-4);
  }

  @media (max-width: 640px) {
    .hero-stats {
      grid-template-columns: 1fr 1fr;
    }
    .hero-stat:nth-child(odd) {
      border-left: 0;
    }
    .hero-stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  /* ═══════════════════════════════════════════════════════════════
     2. CAPABILITY ROWS
     ═══════════════════════════════════════════════════════════════ */
  .cap-rows {
    border-top: 1px solid var(--line);
  }

  .cap-row {
    display: grid;
    grid-template-columns: 34px 14px 1fr 28px;
    gap: 14px;
    align-items: center;
    padding: 22px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }

  .cap-row:hover {
    background: var(--chalk);
  }

  .cap-num {
