  }

  /* ═══════════════════════════════════════════════════════════════
     SECTION HEADS
     ═══════════════════════════════════════════════════════════════ */
  .section {
    padding: clamp(72px, 9vw, 120px) 0;
  }

  .section-tight {
    padding: clamp(40px, 5vw, 64px) 0;
  }

  .section-alt {
    background: var(--chalk);
  }

  .section-head {
    display: flex;
    flex-direction: column;
