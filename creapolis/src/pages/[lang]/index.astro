    color: var(--ink-2);
    transition: color 0.2s;
  }

  .service-card:hover .service-more {
    color: var(--ink);
  }

  /* ═══════════════════════════════════════════════════════════════
     4. APPS ROWS
     ═══════════════════════════════════════════════════════════════ */
  .apps-rows {
    border-top: 1px solid var(--line);
  }

  .app-row {
