---
import type { Lang } from '../../../../i18n/ui';
import Layout from '../../../../layouts/Layout.astro';
import PepinilloGuideContent from '../../../../components/pages/PepinilloGuideContent.astro';

export function getStaticPaths() { return [{ params: { lang: 'en' } }]; }
const lang = Astro.params.lang as Lang;
---

<Layout lang={lang} title="Quick Start Guide — Pepinillo" description="Get started with Pepinillo in under 2 minutes. Learn how to pick a mode, link tasks, and start focusing.">
  <PepinilloGuideContent lang={lang} />
</Layout>
