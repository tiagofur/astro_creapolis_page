---
import type { Lang } from '../../i18n/ui';
import { getLocalizedPath } from '../../i18n/utils';
export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'pt' } },
  ];
}

const lang = Astro.params.lang as Lang;

import Footer from '../../components/Footer.astro';
import Nav from '../../components/Nav.astro';
import Layout from '../../layouts/Layout.astro';
---

<Layout lang={lang}
  title="Página no encontrada — Creapolis"
  description="La página que buscás no existe. Te llevamos de vuelta al camino."
>
  <Nav lang={lang} />

  <section class="nf-page">
    <div class="wrap">
      <div class="nf-content reveal">
        <p class="nf-eyebrow">Error 404</p>

        <div class="nf-bignum" aria-hidden="true">
          <span class="digit">4</span>
          <span class="digit middle">0</span>
          <span class="digit">4</span>
        </div>

        <h1>Acá no hay nada. <span class="tone">Todavía.</span></h1>
        <p class="lead">La URL que pediste no existe, o movimos algo de lugar y se nos olvidó dejar señal. Lo que es seguro es que no querés quedarte mirando este 404 — te dejo tres caminos.</p>

        <div class="nf-options">
          <a href={`/${lang}/`} class="nf-opt reveal reveal-delay-1" style="--accent-color: var(--c-cyan);">
            <span class="card-bar" aria-hidden="true"></span>
            <div class="opt-num">01</div>
            <h3>Al inicio</h3>
            <p>Ver apps, servicios, blog y todo lo demás.</p>
            <span class="opt-link">Ir al home
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </span>
          </a>

          <a href={`/${lang}/blog`} class="nf-opt reveal reveal-delay-2" style="--accent-color: var(--c-magenta);">
            <span class="card-bar" aria-hidden="true"></span>
            <div class="opt-num">02</div>
            <h3>Notas de taller</h3>
            <p>Lo que aprendo construyendo apps reales.</p>
            <span class="opt-link">Ver el blog
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </span>
          </a>

          <a href={getLocalizedPath(lang, '/contacto')} class="nf-opt reveal reveal-delay-3" style="--accent-color: var(--c-yellow);">
            <span class="card-bar" aria-hidden="true"></span>
            <div class="opt-num">03</div>
            <h3>Contame qué pasó</h3>
            <p>Si llegaste acá por un link roto, avisame y lo arreglo.</p>
            <span class="opt-link">Escribir
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
  <div data-track-pageview="404_viewed" hidden></div>
</Layout>

<style>
  .nf-page {
    padding: 168px var(--gutter) 120px;
    min-height: 80vh;
    background: var(--paper);
  }
  .nf-page .wrap {
    max-width: 1000px;
    margin: 0 auto;
  }
  .nf-content { text-align: center; }

  .nf-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: var(--ls-mono);
    color: var(--ink-4);
    margin: 0 0 24px;
  }

  .nf-bignum {
    display: flex; justify-content: center; align-items: center;
    gap: clamp(6px, 1.6vw, 18px);
    margin-bottom: 16px;
    user-select: none;
  }
  .nf-bignum .digit {
    font-family: var(--font-mono);
    font-weight: var(--fw-medium);
    font-size: clamp(6rem, 20vw, 13rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .nf-bignum .digit.middle {
    color: var(--c-magenta);
    animation: nf-wobble 3.5s var(--ease) infinite;
    display: inline-block;
  }
  @keyframes nf-wobble {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(-6deg); }
  }

  h1 {
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: var(--ls-display);
    font-weight: var(--fw-semibold);
    color: var(--ink); margin: 0 0 20px;
    text-wrap: balance;
  }
  h1 .tone { color: var(--ink-4); }
  p.lead {
    font-size: 1.04rem; line-height: 1.6;
    color: var(--ink-3); max-width: 52ch;
    margin: 0 auto 48px;
    text-wrap: pretty;
  }

  .nf-options {
    display: grid; gap: 16px;
    grid-template-columns: 1fr;
    max-width: 760px; margin: 0 auto;
    text-align: left;
  }
  @media (min-width: 780px) {
    .nf-options { grid-template-columns: repeat(3, 1fr); }
  }

  .nf-opt {
    position: relative;
    display: flex; flex-direction: column; gap: 8px;
    padding: 28px 24px 24px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    overflow: hidden;
    text-decoration: none; color: inherit;
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .nf-opt:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-hover);
  }

  .opt-num {
    font-family: var(--font-mono); font-size: 11px;
    color: var(--ink-4);
    text-transform: uppercase; letter-spacing: 0.08em;
    margin-bottom: 4px;
  }
  .nf-opt h3 { font-size: 1.1rem; font-weight: var(--fw-semibold); letter-spacing: -0.015em; margin: 0; color: var(--ink); }
  .nf-opt p {
    font-size: 0.9rem; line-height: 1.55;
    color: var(--ink-3); margin: 0; flex: 1;
  }
  .opt-link {
    display: inline-flex; align-items: center; gap: 6px;
    margin-top: 12px;
    font-family: var(--font-mono); font-size: 0.75rem;
    text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--ink-2);
    transition: gap 0.2s var(--ease), color 0.2s;
  }
  .nf-opt:hover .opt-link { gap: 10px; color: var(--ink); }

  @media (prefers-reduced-motion: reduce) {
    .nf-bignum .digit.middle { animation: none; }
  }
</style>
