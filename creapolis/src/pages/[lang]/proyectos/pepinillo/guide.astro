---
import PepinilloGuideContent from '../../../../components/pages/PepinilloGuideContent.astro';
import ProductHubLayout from '../../../../components/pages/ProductHubLayout.astro';
import type { Lang } from '../../../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}
const lang = Astro.params.lang as Lang;
---

<ProductHubLayout lang={lang} slug="pepinillo" currentPage="guide">
