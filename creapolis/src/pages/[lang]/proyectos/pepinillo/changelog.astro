---
import ChangelogContent from '../../../../components/pages/ChangelogContent.astro';
import ProductHubLayout from '../../../../components/pages/ProductHubLayout.astro';
import type { Lang } from '../../../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}
const lang = Astro.params.lang as Lang;
---

<ProductHubLayout lang={lang} slug="pepinillo" currentPage="changelog">
  <ChangelogContent lang={lang} slug="pepinillo" />
</ProductHubLayout>
