---
import PepinilloFeedbackContent from '../../../../components/pages/PepinilloFeedbackContent.astro';
import type { Lang } from '../../../../i18n/ui';
import Layout from '../../../../layouts/Layout.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}
const lang = Astro.params.lang as Lang;
---

<Layout lang={lang} title="Feedback y soporte — Pepinillo" description="Obtené soporte para Pepinillo, reportá un bug o mandá una sugerencia. Estamos para ayudarte.">
  <PepinilloFeedbackContent lang={lang} />
</Layout>
