---
import { getSolennixData } from '../../../i18n/data/solennix';
import { type Lang, ui } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'pt' } },
  ];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { features, pricing, phone } = getSolennixData(lang);

import Footer from '../../../components/Footer.astro';
import Nav from '../../../components/Nav.astro';
import Layout from '../../../layouts/Layout.astro';

const storeLinks = {
  apple: 'https://apps.apple.com/mx/app/solennix/id6760874129',
  google: 'https://play.google.com/store/apps/details?id=com.solennix.app',
  web: 'https://solennix.com',
};
const size = '24.6 MB';
---

<Layout lang={lang}
  title="Solennix — Creapolis"
  description={t('solennix.hero.desc')}
  ogImage="/og/solennix.svg"
>
  <Nav lang={lang} />

  <header class="s-hero" id="main-content">
    <div class="ribbon" aria-hidden="true">
      <svg viewBox="0 0 1400 800" preserveAspectRatio="none">
        <defs>
          <linearGradient id="srib" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="oklch(0.62 0.2 285)" stop-opacity="0.35"/>
            <stop offset="100%" stop-color="oklch(0.72 0.18 32)" stop-opacity="0.3"/>
          </linearGradient>
        </defs>
        <path d="M -100,600 C 300,400 500,750 800,500 C 1100,250 1300,650 1500,400"
              fill="none" stroke="url(#srib)" stroke-width="100" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="wrap">
      <div class="reveal">
        <div class="chips-row">
          <span class="chip live"><span class="chip-dot"></span>{t('solennix.hero.chip.prod')}</span>
          <span class="chip" style="color:var(--iris);background:var(--iris-soft);border-color:color-mix(in oklch, var(--iris) 25%, var(--line))">{t('solennix.hero.chip.by')}</span>
        </div>
        <h1><span class="serif">{t('solennix.hero.title.serif')}</span><br/>{t('solennix.hero.title.p1')}<br/>{t('solennix.hero.title.p2')}</h1>
        <p class="tag">{t('solennix.hero.desc')}</p>

        <div class="stores">
          <a class="store" href={storeLinks.apple} target="_blank" rel="noopener">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.05 12.04a4.4 4.4 0 0 1 2.1-3.7 4.5 4.5 0 0 0-3.55-1.92c-1.5-.15-2.94.88-3.7.88-.78 0-1.95-.86-3.22-.84a4.72 4.72 0 0 0-3.98 2.42c-1.7 2.95-.43 7.3 1.22 9.7.8 1.17 1.76 2.48 3.02 2.44 1.22-.05 1.68-.78 3.15-.78 1.46 0 1.88.78 3.17.75 1.31-.02 2.14-1.18 2.94-2.36a10.5 10.5 0 0 0 1.34-2.73 4.25 4.25 0 0 1-2.49-3.86zM14.5 5.25a4.3 4.3 0 0 0 1-3.25 4.47 4.47 0 0 0-2.9 1.5 4.16 4.16 0 0 0-1.02 3.15 3.67 3.67 0 0 0 2.92-1.4z"/></svg>
            <span><span class="small">{t('solennix.download')}</span><span class="big">App Store</span></span>
          </a>
          <a class="store" href={storeLinks.google} target="_blank" rel="noopener">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 1.9C3.2 2.1 3 2.5 3 3v18c0 .5.2.9.6 1.1l10.5-10.2L3.6 1.9zm12 10.6l2.7 2.6-3.8 2.2-2-1.9 3.1-2.9zm0-1.9l-3-2.9 2.4-1.4 3.4 2-2.8 2.3zM4.7 2.4l10.2 10-10.2 10v-20z"/></svg>
            <span><span class="small">{t('solennix.download')}</span><span class="big">Google Play</span></span>
          </a>
        </div>

      </div>

      <div class="phone-wrap reveal reveal-delay-2">
        <div class="phone">
          <div class="phone-screen">
            <div class="ps-head">
              <div>
                <h4>{phone.headTitle}</h4>
                <div class="sub">{phone.headSub}</div>
              </div>
              <div class="ps-avatar"></div>
            </div>
            <div class="ps-stats">
              {phone.stats.map((s) => (
                <div class="ps-stat"><div class="v">{s.v}</div><div class="l">{s.l}</div></div>
              ))}
            </div>
            <div class="ps-label">{phone.label}</div>
            <div class="ps-list">
              {phone.items.map((it) => (
                <div class="ps-item"><span class="dot" style={`background:${it.color}`}></span><span class="name">{it.name}</span><span class="date">{it.date}</span></div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="info-strip">
    <div class="row wrap">
      <div class="info-cell"><div class="v">{t('solennix.info.platforms.value')}</div><div class="l">{t('solennix.info.platforms.label')}</div></div>
      <div class="info-cell"><div class="v">{size}</div><div class="l">{t('solennix.info.size.label')}</div></div>
      <div class="info-cell"><div class="v">{t('solennix.info.plans.value')}</div><div class="l">{t('solennix.info.plans.label')}</div></div>
      <div class="info-cell"><div class="v">{t('solennix.info.langs.value')}</div><div class="l">{t('solennix.info.langs.label')}</div></div>
    </div>
  </section>

  <section id="features" class="section">
    <div class="wrap">
      <div class="products-header">
        <div class="reveal">
          <div class="eyebrow" style="margin-bottom:18px"><span>{t('solennix.features.eyebrow')}</span></div>
          <h2>{t('solennix.features.title.p1')}<br/><span class="serif">{t('solennix.features.title.serif')}</span></h2>
        </div>
        <p class="reveal reveal-delay-1">{t('solennix.features.desc')}</p>
      </div>

      <div class="features">
        {features.map((feature, i) => (
          <div class={`feature reveal${i === 1 ? ' reveal-delay-1' : ''}${i === 2 ? ' reveal-delay-2' : ''}`}>
            <div class="icon">{feature.letter}</div>
            <h3>{feature.title}</h3>
            <p>{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Case Study -->
  <section id="case-study" class="section case-study" style="background: var(--chalk)">
    <div class="wrap">
      <div class="case-head reveal">
        <div class="eyebrow" style="margin-bottom:16px"><span>{t('solennix.case.eyebrow')}</span></div>
        <h2>{t('solennix.case.title.p1')}<br/><span class="serif">{t('solennix.case.title.serif')}</span></h2>
      </div>

      <div class="case-grid">
        {(ui[lang] as any)['solennix.case.chapters'].map((chapter: { title: string; text: string }, i: number) => (
          <div class={`case-block reveal${i === 1 ? ' reveal-delay-1' : ''}${i === 2 ? ' reveal-delay-2' : ''}`}>
            <div class="case-num" style="color: var(--iris)">{String(i + 1).padStart(2, '0')}</div>
            <h3>{chapter.title}</h3>
            <p>{chapter.text}</p>
          </div>
        ))}
      </div>

      <div class="tech-block reveal">
        <div class="eyebrow" style="margin-bottom:14px"><span>{t('solennix.case.stack')}</span></div>
        <div class="tech-chips">
          {(ui[lang] as any)['solennix.case.tech'].map((tech: string) => (
            <span class="tech-chip" style="--accent-color: var(--iris)">{tech}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="pricing" class="section" style="background: var(--chalk)">
    <div class="wrap">
      <div class="products-header">
        <div class="reveal">
          <div class="eyebrow" style="margin-bottom:18px"><span>{t('solennix.pricing.eyebrow')}</span></div>
          <h2>{t('solennix.pricing.title.p1')}<br/><span class="serif">{t('solennix.pricing.title.serif')}</span></h2>
        </div>
        <p class="reveal reveal-delay-1">{t('solennix.pricing.desc')}</p>
      </div>

      <div class="pricing">
        {pricing.map((plan, i) => (
          <div class={`price reveal${i === 1 ? ' feat reveal-delay-1' : ''}${i === 2 ? ' reveal-delay-2' : ''}`}>
            {i === 1 && <span class="price-badge">{t('solennix.pricing.popular')}</span>}
            <span class="tag">{plan.tag}</span>
            <h3>{plan.plan}</h3>
            <div class="n">{plan.price}{i === 1 && !plan.priceNoSuffix && <small>{t('solennix.pricing.pro.suffix')}</small>}</div>
            <ul>
              {plan.features.map((f) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8L7 11.5L13 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            <div class="btn-wrap">
              {i === 0 && <a href={storeLinks.apple} class="btn btn-ghost">{plan.btn}</a>}
              {i === 1 && <a href={storeLinks.apple} class="btn" style="background:var(--lime);color:var(--ink)">{plan.btn}</a>}
              {i === 2 && <a href="mailto:hola@creapolis.dev" class="btn btn-ghost">{plan.btn}</a>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="download" class="download">
    <div class="wrap reveal">
      <h2>{t('solennix.download.title.p1')} <span class="serif">{t('solennix.download.title.serif')}</span>.</h2>
      <p>{t('solennix.download.desc')}</p>
      <div class="download-btns">
        <a class="store" href={storeLinks.apple} target="_blank" rel="noopener">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 12.04a4.4 4.4 0 0 1 2.1-3.7 4.5 4.5 0 0 0-3.55-1.92c-1.5-.15-2.94.88-3.7.88-.78 0-1.95-.86-3.22-.84a4.72 4.72 0 0 0-3.98 2.42c-1.7 2.95-.43 7.3 1.22 9.7.8 1.17 1.76 2.48 3.02 2.44 1.22-.05 1.68-.78 3.15-.78 1.46 0 1.88.78 3.17.75 1.31-.02 2.14-1.18 2.94-2.36a10.5 10.5 0 0 0 1.34-2.73 4.25 4.25 0 0 1-2.49-3.86zM14.5 5.25a4.3 4.3 0 0 0 1-3.25 4.47 4.47 0 0 0-2.9 1.5 4.16 4.16 0 0 0-1.02 3.15 3.67 3.67 0 0 0 2.92-1.4z"/></svg>
          <span><span class="small">{t('solennix.download')}</span><span class="big">App Store</span></span>
        </a>
        <a class="store" href={storeLinks.google} target="_blank" rel="noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M3.6 1.9C3.2 2.1 3 2.5 3 3v18c0 .5.2.9.6 1.1l10.5-10.2L3.6 1.9z"/></svg>
          <span><span class="small">{t('solennix.download')}</span><span class="big">Google Play</span></span>
        </a>
        <a class="btn btn-ghost btn-lg" href={storeLinks.web} target="_blank" rel="noopener">{storeLinks.web} →</a>
      </div>
    </div>
  </section>

  <section id="contacto" class="contact-cta">
    <div class="wrap">
      <div class="contact-card reveal">
        <div class="eyebrow" style="margin-bottom:16px"><span>{t('solennix.cta.eyebrow')}</span></div>
        <h2>{t('solennix.cta.title.p1')} <span class="serif">{t('solennix.cta.title.serif')}</span>?</h2>
        <p class="lead">{t('solennix.cta.lead')}</p>
        <a href="mailto:hola@creapolis.dev" class="btn btn-primary btn-lg">{t('solennix.cta.btn')}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Layout>

<style>
  .s-hero {
    position: relative;
    padding: 160px var(--gutter) 100px;
    background:
      radial-gradient(55% 60% at 85% 20%, var(--iris-soft) 0%, transparent 60%),
      radial-gradient(40% 45% at 15% 90%, var(--coral-soft) 0%, transparent 70%),
      var(--paper);
    overflow: clip;
  }

  .s-hero .wrap {
    display: grid;
    gap: clamp(40px, 6vw, 80px);
    grid-template-columns: 1fr;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 980px) {
    .s-hero .wrap {
      grid-template-columns: 1.05fr 1fr;
    }
  }

  .chips-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .s-hero h1 {
    font-size: clamp(3.2rem, 8.4vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .s-hero h1 .serif {
    color: var(--iris);
  }

  .s-hero .tag {
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    color: var(--ink-2);
    max-width: 50ch;
    margin: 24px 0 32px;
    line-height: 1.6;
  }

  .s-hero .stores {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .store {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--paper);
    font-size: 0.9rem;
    font-weight: 500;
    transition: transform 0.2s var(--ease), box-shadow 0.2s;
    text-decoration: none;
  }

  .store:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px oklch(0.2 0.02 265 / 0.2);
  }

  .store .small {
    font-size: 0.65rem;
    opacity: 0.7;
    display: block;
    margin-bottom: 2px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-family: var(--font-mono);
  }

  .store .big {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .rating {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    font-size: 0.85rem;
  }

  .stars {
    color: var(--amber);
    letter-spacing: 2px;
  }

  /* Phone mockup */
  .phone-wrap {
    position: relative;
    display: grid;
    place-items: center;
  }

  .phone-wrap::before {
    content: "";
    position: absolute;
    inset: -10% -15%;
    background: radial-gradient(circle at 50% 50%, var(--iris-soft), transparent 65%);
    z-index: 0;
    filter: blur(20px);
  }

  .phone {
    position: relative;
    width: 100%;
    max-width: 320px;
    aspect-ratio: 9/19;
    padding: 10px;
    background: linear-gradient(175deg, var(--iris), oklch(0.3 0.08 285));
    border-radius: 44px;
    box-shadow: 0 40px 80px oklch(0.3 0.1 285 / 0.35), 0 0 0 2px oklch(0.2 0.04 285 / 0.3);
    z-index: 1;
  }

  .phone-screen {
    width: 100%;
    height: 100%;
    background: oklch(0.12 0.015 285);
    border-radius: 34px;
    padding: 22px 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: hidden;
    position: relative;
  }

  .phone-screen::before {
    content: "";
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 70px;
    height: 20px;
    border-radius: 12px;
    background: oklch(0.08 0 0);
  }

  .ps-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    padding-top: 18px;
  }

  .ps-head h4 {
    color: var(--paper);
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .ps-head .sub {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: oklch(0.7 0.02 285);
  }

  .ps-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--iris);
  }

  .ps-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .ps-stat {
    background: oklch(0.18 0.015 285);
    border-radius: 12px;
    padding: 12px 8px;
    text-align: center;
    border: 1px solid oklch(0.25 0.03 285);
  }

  .ps-stat .v {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--paper);
    font-size: 1.35rem;
    line-height: 1;
  }

  .ps-stat .l {
    color: oklch(0.6 0.02 285);
    font-size: 0.6rem;
    margin-top: 4px;
    font-family: var(--font-mono);
  }

  .ps-stat:nth-child(1) .v { color: var(--lime); }
  .ps-stat:nth-child(2) .v { color: var(--coral); }
  .ps-stat:nth-child(3) .v { color: var(--sky); }

  .ps-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: oklch(0.55 0.02 285);
    margin-top: 8px;
  }

  .ps-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ps-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    background: oklch(0.16 0.015 285);
    border-radius: 10px;
    border: 1px solid oklch(0.22 0.02 285);
  }

  .ps-item .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .ps-item .name {
    color: var(--paper);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .ps-item .date {
    margin-left: auto;
    color: oklch(0.55 0.02 285);
    font-size: 0.65rem;
    font-family: var(--font-mono);
  }

  /* Info strip */
  .info-strip {
    background: var(--ink);
    color: var(--paper);
    padding: 32px var(--gutter);
  }

  .info-strip .row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media (min-width: 720px) {
    .info-strip .row {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .info-cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .info-cell .v {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--paper);
  }

  .info-cell .l {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: oklch(0.7 0.01 265);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Products header */
  .products-header {
    display: grid;
    gap: 28px;
    grid-template-columns: 1fr;
    margin-bottom: 56px;
    align-items: end;
  }

  @media (min-width: 720px) {
    .products-header {
      grid-template-columns: 1.1fr 1fr;
      gap: 48px;
    }
  }

  /* Features */
  .features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 720px) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .features {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature {
    padding: 32px 28px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.3s var(--ease), border-color 0.3s, box-shadow 0.3s;
    position: relative;
    overflow: hidden;
  }

  .feature:hover {
    transform: translateY(-3px);
    border-color: var(--iris);
    box-shadow: var(--sh-2);
  }

  .feature .icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--feat-soft, var(--iris-soft));
    color: var(--feat-color, var(--iris));
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.5rem;
    border: 1px solid color-mix(in oklch, var(--feat-color, var(--iris)) 30%, transparent);
  }

  .feature h3 {
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .feature p {
    font-size: 0.92rem;
    color: var(--ink-2);
    margin: 0;
  }

  .feature:nth-child(1) { --feat-color: var(--iris); --feat-soft: var(--iris-soft); }
  .feature:nth-child(2) { --feat-color: var(--coral); --feat-soft: var(--coral-soft); }
  .feature:nth-child(3) { --feat-color: var(--lime); --feat-soft: var(--lime-soft); }
  .feature:nth-child(4) { --feat-color: var(--sky); --feat-soft: var(--sky-soft); }
  .feature:nth-child(5) { --feat-color: var(--amber); --feat-soft: var(--amber-soft); }
  .feature:nth-child(6) { --feat-color: var(--iris); --feat-soft: var(--iris-soft); }

  /* Pricing */
  .pricing {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    max-width: 1000px;
    margin: 0 auto;
  }

  @media (min-width: 820px) {
    .pricing {
      grid-template-columns: repeat(3, 1fr);
