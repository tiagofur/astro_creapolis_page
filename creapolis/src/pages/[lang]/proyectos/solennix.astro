---
import { getSolennixData } from '../../../i18n/data/solennix';
import { type Lang, ui } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'pt' } },
  ];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { features, pricing, phone } = getSolennixData(lang);

import Footer from '../../../components/Footer.astro';
import Nav from '../../../components/Nav.astro';
import Layout from '../../../layouts/Layout.astro';

const storeLinks = {
  apple: 'https://apps.apple.com/mx/app/solennix/id6760874129',
  google: 'https://play.google.com/store/apps/details?id=com.solennix.app',
  web: 'https://solennix.com',
};
const size = '24.6 MB';
---

<Layout lang={lang}
  title="Solennix — Creapolis"
  description={t('solennix.hero.desc')}
  ogImage="/og/solennix.svg"
  extraJsonLd={{
    '@type': 'SoftwareApplication',
    name: 'Solennix',
    description: t('solennix.hero.desc'),
    applicationCategory: 'MobileApplication',
    operatingSystem: 'iOS · Android · Web',
    offers: {
      '@type': 'Offer',
      price: '149',
      priceCurrency: 'MXN',
    },
    author: {
      '@type': 'Organization',
      name: 'Creapolis',
      url: 'https://creapolis.dev',
    },
  }}
>
  <Nav lang={lang} />

  <header class="s-hero">
    <div class="wrap">
      <div class="reveal">
        <div class="chips-row">
          <span class="chip live"><span class="chip-dot"></span>{t('solennix.hero.chip.prod')}</span>
          <span class="chip">{t('solennix.hero.chip.by')}</span>
        </div>
        <h1>{t('solennix.hero.title.p1')}<br/>{t('solennix.hero.title.p2')} <span class="tone">{t('solennix.hero.title.serif')}</span></h1>
        <p class="tag">{t('solennix.hero.desc')}</p>

        <div class="stores">
          <a class="store" href={storeLinks.apple} target="_blank" rel="noopener" data-track-event="store_click" data-track-label="apple">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.05 12.04a4.4 4.4 0 0 1 2.1-3.7 4.5 4.5 0 0 0-3.55-1.92c-1.5-.15-2.94.88-3.7.88-.78 0-1.95-.86-3.22-.84a4.72 4.72 0 0 0-3.98 2.42c-1.7 2.95-.43 7.3 1.22 9.7.8 1.17 1.76 2.48 3.02 2.44 1.22-.05 1.68-.78 3.15-.78 1.46 0 1.88.78 3.17.75 1.31-.02 2.14-1.18 2.94-2.36a10.5 10.5 0 0 0 1.34-2.73 4.25 4.25 0 0 1-2.49-3.86zM14.5 5.25a4.3 4.3 0 0 0 1-3.25 4.47 4.47 0 0 0-2.9 1.5 4.16 4.16 0 0 0-1.02 3.15 3.67 3.67 0 0 0 2.92-1.4z"/></svg>
            <span><span class="small">{t('solennix.download')}</span><span class="big">App Store</span></span>
          </a>
          <a class="store" href={storeLinks.google} target="_blank" rel="noopener" data-track-event="store_click" data-track-label="google">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 1.9C3.2 2.1 3 2.5 3 3v18c0 .5.2.9.6 1.1l10.5-10.2L3.6 1.9zm12 10.6l2.7 2.6-3.8 2.2-2-1.9 3.1-2.9zm0-1.9l-3-2.9 2.4-1.4 3.4 2-2.8 2.3zM4.7 2.4l10.2 10-10.2 10v-20z"/></svg>
            <span><span class="small">{t('solennix.download')}</span><span class="big">Google Play</span></span>
          </a>
        </div>

      </div>

      <div class="phone-wrap reveal reveal-delay-2">
        <div class="phone">
          <div class="phone-screen">
            <div class="ps-head">
              <div>
                <h4>{phone.headTitle}</h4>
                <div class="sub">{phone.headSub}</div>
              </div>
              <div class="ps-avatar"></div>
            </div>
            <div class="ps-stats">
              {phone.stats.map((s) => (
                <div class="ps-stat"><div class="v">{s.v}</div><div class="l">{s.l}</div></div>
              ))}
            </div>
            <div class="ps-label">{phone.label}</div>
            <div class="ps-list">
              {phone.items.map((it) => (
                <div class="ps-item"><span class="dot" style={`background:${it.color}`}></span><span class="name">{it.name}</span><span class="date">{it.date}</span></div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="info-strip">
    <div class="row wrap">
      <div class="info-cell"><div class="v">{t('solennix.info.platforms.value')}</div><div class="l">{t('solennix.info.platforms.label')}</div></div>
      <div class="info-cell"><div class="v">{size}</div><div class="l">{t('solennix.info.size.label')}</div></div>
      <div class="info-cell"><div class="v">{t('solennix.info.plans.value')}</div><div class="l">{t('solennix.info.plans.label')}</div></div>
      <div class="info-cell"><div class="v">{t('solennix.info.langs.value')}</div><div class="l">{t('solennix.info.langs.label')}</div></div>
    </div>
  </section>

  <section id="features" class="section">
    <div class="wrap">
      <div class="section-head reveal">
          <p class="eyebrow" style="margin:0"><span>{t('solennix.features.eyebrow')}</span></p>
          <h2>{t('solennix.features.title.p1')} <span class="tone">{t('solennix.features.title.serif')}</span></h2>
          <p>{t('solennix.features.desc')}</p>
        </div>

      <div class="features">
        {features.map((feature, i) => (
          <div class={`feature reveal${i === 1 ? ' reveal-delay-1' : ''}${i === 2 ? ' reveal-delay-2' : ''}`}>
            <div class="icon">{feature.letter}</div>
            <h3>{feature.title}</h3>
            <p>{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Case Study -->
  <section id="case-study" class="section case-study" style="background: var(--chalk)">
    <div class="wrap">
      <div class="case-head reveal">
        <p class="eyebrow" style="margin:0 0 14px"><span>{t('solennix.case.eyebrow')}</span></p>
        <h2>{t('solennix.case.title.p1')} <span class="tone">{t('solennix.case.title.serif')}</span></h2>
      </div>

      <div class="case-grid">
        {(ui[lang] as any)['solennix.case.chapters'].map((chapter: { title: string; text: string }, i: number) => (
          <div class={`case-block reveal${i === 1 ? ' reveal-delay-1' : ''}${i === 2 ? ' reveal-delay-2' : ''}`}>
            <div class="case-num"><span class="case-dot" aria-hidden="true"></span>{String(i + 1).padStart(2, '0')}</div>
            <h3>{chapter.title}</h3>
            <p>{chapter.text}</p>
          </div>
        ))}
      </div>

      <div class="tech-block reveal">
        <p class="eyebrow" style="margin:0 0 14px"><span>{t('solennix.case.stack')}</span></p>
        <div class="tech-chips">
          {(ui[lang] as any)['solennix.case.tech'].map((tech: string) => (
            <span class="tech-chip">{tech}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="pricing" class="section" style="background: var(--chalk)">
    <div class="wrap">
      <div class="section-head reveal">
          <p class="eyebrow" style="margin:0"><span>{t('solennix.pricing.eyebrow')}</span></p>
          <h2>{t('solennix.pricing.title.p1')} <span class="tone">{t('solennix.pricing.title.serif')}</span></h2>
          <p>{t('solennix.pricing.desc')}</p>
        </div>

      <div class="pricing">
        {pricing.map((plan, i) => (
          <div class={`price reveal${i === 1 ? ' feat reveal-delay-1' : ''}${i === 2 ? ' reveal-delay-2' : ''}`}>
            {i === 1 && <span class="price-badge">{t('solennix.pricing.popular')}</span>}
            <span class="tag">{plan.tag}</span>
            <h3>{plan.plan}</h3>
            <div class="n">{plan.price}{i === 1 && !plan.priceNoSuffix && <small>{t('solennix.pricing.pro.suffix')}</small>}</div>
            <ul>
              {plan.features.map((f) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8L7 11.5L13 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            <div class="btn-wrap">
              {i === 0 && <a href={storeLinks.apple} class="btn btn-ghost">{plan.btn}</a>}
              {i === 1 && <a href={storeLinks.apple} class="btn btn-invert">{plan.btn}</a>}
              {i === 2 && <a href="mailto:hola@creapolis.dev" class="btn btn-ghost">{plan.btn}</a>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="download" class="download-wrap">
    <div class="download reveal">
      <div class="cta-glow" aria-hidden="true"></div>
      <h2>{t('solennix.download.title.p1')} <span class="tone">{t('solennix.download.title.serif')}</span>.</h2>
      <p>{t('solennix.download.desc')}</p>
      <div class="download-btns">
        <a class="store" href={storeLinks.apple} target="_blank" rel="noopener" data-track-event="store_click" data-track-label="apple">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 12.04a4.4 4.4 0 0 1 2.1-3.7 4.5 4.5 0 0 0-3.55-1.92c-1.5-.15-2.94.88-3.7.88-.78 0-1.95-.86-3.22-.84a4.72 4.72 0 0 0-3.98 2.42c-1.7 2.95-.43 7.3 1.22 9.7.8 1.17 1.76 2.48 3.02 2.44 1.22-.05 1.68-.78 3.15-.78 1.46 0 1.88.78 3.17.75 1.31-.02 2.14-1.18 2.94-2.36a10.5 10.5 0 0 0 1.34-2.73 4.25 4.25 0 0 1-2.49-3.86zM14.5 5.25a4.3 4.3 0 0 0 1-3.25 4.47 4.47 0 0 0-2.9 1.5 4.16 4.16 0 0 0-1.02 3.15 3.67 3.67 0 0 0 2.92-1.4z"/></svg>
          <span><span class="small">{t('solennix.download')}</span><span class="big">App Store</span></span>
        </a>
        <a class="store" href={storeLinks.google} target="_blank" rel="noopener" data-track-event="store_click" data-track-label="google">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M3.6 1.9C3.2 2.1 3 2.5 3 3v18c0 .5.2.9.6 1.1l10.5-10.2L3.6 1.9z"/></svg>
          <span><span class="small">{t('solennix.download')}</span><span class="big">Google Play</span></span>
        </a>
        <a class="btn btn-ghost btn-lg" href={storeLinks.web} target="_blank" rel="noopener">{storeLinks.web} →</a>
      </div>
    </div>
  </section>

  <section id="contacto" class="contact-cta">
    <div class="wrap reveal">
      <p class="eyebrow" style="margin:0 auto 14px; justify-content:center"><span>{t('solennix.cta.eyebrow')}</span></p>
      <h2>{t('solennix.cta.title.p1')} <span class="tone">{t('solennix.cta.title.serif')}</span>?</h2>
      <p class="lead">{t('solennix.cta.lead')}</p>
      <a href="mailto:hola@creapolis.dev" class="btn btn-primary">{t('solennix.cta.btn')}
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </a>
    </div>
  </section>

  <Footer lang={lang} />
  <div data-track-pageview="project_viewed" data-track-slug="solennix" hidden></div>
</Layout>

<style>
  .tone { color: var(--ink-4); }
  .p-color { color: var(--c-cyan); }

  /* ─── Hero ─────────────────────────────────────────────────────────── */
  .s-hero {
    padding: 152px var(--gutter) clamp(48px, 6vw, 80px);
    background: var(--paper);
  }

  .s-hero .wrap {
    display: grid;
    gap: clamp(40px, 6vw, 72px);
    grid-template-columns: 1fr;
    align-items: center;
    max-width: var(--max);
    margin: 0 auto;
  }

  @media (min-width: 980px) {
    .s-hero .wrap { grid-template-columns: 1.05fr 1fr; }
  }

  .chips-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }

  .s-hero h1 {
    font-size: clamp(2.7rem, 6.8vw, 5rem);
    line-height: 1.02;
    letter-spacing: var(--ls-display);
    font-weight: var(--fw-semibold);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }

  .s-hero .tag {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: var(--ink-3);
    max-width: 50ch;
    margin: 20px 0 28px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .s-hero .stores {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }

  .store {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 18px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: var(--fw-medium);
    transition: box-shadow 0.2s var(--ease), transform 0.15s;
    text-decoration: none;
  }

  .store:hover { box-shadow: 0 12px 32px rgba(9, 9, 11, 0.15); }
  .store:active { transform: scale(0.98); }

  .store .small {
    font-size: 0.6rem;
    opacity: 0.7;
    display: block;
    margin-bottom: 2px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-family: var(--font-mono);
  }

  .store .big {
    font-size: 0.95rem;
    font-weight: var(--fw-medium);
  }

  /* Phone mockup — ink device, white screen */
  .phone-wrap {
    display: grid;
    place-items: center;
  }

  .phone {
    position: relative;
    width: 100%;
    max-width: 300px;
    aspect-ratio: 9/19;
    padding: 10px;
    background: #09090b;
    border-radius: 40px;
    box-shadow: var(--sh-3);
  }

  .phone-screen {
    width: 100%;
    height: 100%;
    background: #ffffff;
    border-radius: 31px;
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    gap: 13px;
    overflow: hidden;
    position: relative;
  }

  .phone-screen::before {
    content: "";
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 64px;
    height: 18px;
    border-radius: 10px;
    background: #09090b;
  }

  .ps-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    padding-top: 16px;
  }

  .ps-head h4 {
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
  }

  .ps-head .sub {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--ink-4);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 3px;
  }

  .ps-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--c-cyan);
  }

  .ps-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 7px;
  }

  .ps-stat {
    background: var(--chalk);
    border-radius: var(--r-sm);
    padding: 11px 7px;
    text-align: center;
  }

  .ps-stat .v {
    color: var(--ink);
    font-size: 1.15rem;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .ps-stat .l {
    color: var(--ink-4);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 5px;
  }

  .ps-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--ink-4);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .ps-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ps-item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 11px;
    background: var(--chalk);
    border-radius: var(--r-sm);
  }

  .ps-item .dot { width: 7px; height: 7px; border-radius: 999px; flex-shrink: 0; }
  .ps-item .name { flex: 1; font-size: 0.76rem; color: var(--ink); }
  .ps-item .date { font-family: var(--font-mono); font-size: 0.62rem; color: var(--ink-4); }

  /* ─── Info strip — hairline grid ───────────────────────────────────── */
  .info-strip { padding: 0 var(--gutter); }
  .info-strip .row {
    max-width: var(--max); margin: 0 auto;
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 1px; background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    overflow: hidden;
  }
  @media (min-width: 720px) { .info-strip .row { grid-template-columns: repeat(4, 1fr); } }
  .info-cell { background: #ffffff; padding: 20px 22px; }
  .info-cell .v { font-size: clamp(1.05rem, 1.8vw, 1.3rem); font-weight: var(--fw-semibold); letter-spacing: -0.02em; line-height: 1.15; color: var(--ink); }
  .info-cell .l { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-4); margin-top: 6px; }

  /* ─── Sections ─────────────────────────────────────────────────────── */
  .section { padding: clamp(64px, 9vw, 120px) var(--gutter); }
  .section .wrap { max-width: var(--max); margin: 0 auto; }
  .section[style*="chalk"], .case-study { background: var(--chalk); }

  .section-head { max-width: 640px; display: flex; flex-direction: column; gap: 14px; margin-bottom: 44px; }
  .section-head h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
    line-height: 1.08; letter-spacing: -0.03em;
    font-weight: var(--fw-semibold);
    color: var(--ink); margin: 0; text-wrap: balance;
  }
  .section-head p { color: var(--ink-3); font-size: 1rem; line-height: 1.6; }

  /* ─── Features — tinted cyan icon tiles ────────────────────────────── */
  .features { display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .features { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .features { grid-template-columns: repeat(3, 1fr); } }

  .feature {
    padding: 26px 24px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .feature:hover { transform: translateY(-4px); box-shadow: var(--sh-hover); }
  .feature .icon {
    width: 44px; height: 44px;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 1.15rem; font-weight: var(--fw-medium);
    color: var(--c-cyan-3);
    background: var(--c-cyan-soft);
    border-radius: var(--r-lg);
    margin-bottom: 16px;
  }
  .feature h3 { font-size: 1.05rem; font-weight: var(--fw-semibold); letter-spacing: -0.01em; line-height: 1.3; margin: 0 0 8px; color: var(--ink); }
  .feature p { font-size: 0.9rem; line-height: 1.55; color: var(--ink-3); margin: 0; }

  /* ─── Case study ───────────────────────────────────────────────────── */
  .case-head { max-width: 640px; margin-bottom: 44px; }
  .case-head h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
    line-height: 1.08; letter-spacing: -0.03em;
    font-weight: var(--fw-semibold);
    color: var(--ink); margin: 0; text-wrap: balance;
  }
  .case-grid { display: grid; gap: 16px; grid-template-columns: 1fr; margin-bottom: 48px; }
  @media (min-width: 800px) { .case-grid { grid-template-columns: repeat(3, 1fr); } }

  .case-block {
    padding: 22px 24px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    border-top: var(--accent-bar) solid var(--c-cyan);
  }
  .case-num {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: 11px; font-weight: var(--fw-medium);
    color: var(--ink-4);
    margin-bottom: 12px;
  }
  .case-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--c-cyan); }
  .case-block h3 { font-size: 1.06rem; font-weight: var(--fw-semibold); letter-spacing: -0.01em; margin: 0 0 8px; color: var(--ink); }
  .case-block p { font-size: 0.92rem; line-height: 1.6; color: var(--ink-3); margin: 0; }

  .tech-block { padding-top: 24px; border-top: 1px solid var(--line); }
  .tech-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .tech-chip {
    display: inline-flex; align-items: center;
    padding: 5px 12px;
    font-family: var(--font-mono); font-size: 0.76rem;
    color: var(--ink-2);
    background: #ffffff;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
  }

  /* ─── Pricing — Pro is the single dark card ────────────────────────── */
  .pricing { display: grid; gap: 16px; grid-template-columns: 1fr; align-items: stretch; }
  @media (min-width: 900px) { .pricing { grid-template-columns: repeat(3, 1fr); } }

  .price {
    position: relative;
