---
import ProductHubLayout from '../../../../components/pages/ProductHubLayout.astro';
import PrivacyAppendixContent from '../../../../components/pages/PrivacyAppendixContent.astro';
import type { Lang } from '../../../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}
const lang = Astro.params.lang as Lang;
---

