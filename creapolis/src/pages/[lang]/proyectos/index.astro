---
import type { Lang } from "../../../i18n/ui";
export function getStaticPaths() {
  return [{ params: { lang: "es" } }];
}
const lang = Astro.params.lang as Lang;

import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

const apps = [
  {
    name: 'Solennix',
    tagline: 'todo-en-uno para eventos',
    desc: 'CRM, cotizaciones, inventario y dashboard para organizadores profesionales en Latinoamérica.',
    href: `/${lang}/solennix`,
    platform: 'iOS · Android · Web',
    color: 'var(--iris)',
    status: 'live',
    deviceRows: [[3], [2], [1]],
  },
  {
    name: 'Pepinillo',
    tagline: 'Pomodoro, tareas y timer',
    desc: 'Productividad todo-en-uno: Pomodoro configurable, tareas con prioridades y subtasks, calendario, timer y estadísticas.',
    href: `/${lang}/proyectos/pepinillo`,
    platform: 'Android',
    color: 'var(--lime)',
    status: 'live',
    deviceRows: [[2], [3]],
  },
  {
    name: 'Películas',
    tagline: 'tu cine, a tu manera',
    desc: 'Catálogo de películas y series, listas personalizadas, búsqueda avanzada y recomendaciones basadas en tus gustos.',
    href: `/${lang}/proyectos/peliculas`,
    platform: 'Android',
    color: 'var(--coral)',
    status: 'live',
    deviceRows: [[3], [2]],
  },
];
---

<Layout lang={lang} title="Proyectos — Creapolis" description="Nuestros proyectos y aplicaciones desarrolladas.">
  <Nav lang={lang} />

  <header class="page-hero" id="main-content">
    <div class="wrap">
      <div class="page-copy reveal">
        <div class="eyebrow" style="margin-bottom:20px">
          <span>Proyectos · En producción</span>
        </div>
        <h1>Apps que demuestran<br/><span class="serif">mi capacidad</span>.</h1>
        <p class="lead">Proyectos propios en producción, disponibles en las tiendas. Tecnología real, usuarios reales.</p>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <div class="products">
        {apps.map((app, i) => (
          <a href={app.href} class={`product reveal${i > 0 ? ` reveal-delay-${i}` : ''}`} style={`--product-color: ${app.color}`}>
            <div class="product-vis">
              <div class="glow"></div>
              <div class="device">
                <div class="title"></div>
                {app.deviceRows.map((row) => (
                  <div class="row">
                    {row.map(() => <div class="bit"></div>)}
                  </div>
                ))}
                <div class="big"></div>
              </div>
            </div>
            <div class="product-meta">
              <div class="head">
                <h3>{app.name}</h3>
                <span class="chip live"><span class="chip-dot"></span>Live</span>
              </div>
              <span class="tagline serif">{app.tagline}</span>
              <p>{app.desc}</p>
              <div class="foot">
                <span class="plat">{app.platform}</span>
                <span>Ver detalles →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Layout>

<style>
  .page-hero {
    position: relative;
    padding: 160px var(--gutter) 80px;
    overflow: clip;
    background:
      radial-gradient(60% 50% at 80% 10%, var(--iris-soft) 0%, transparent 60%),
      radial-gradient(50% 45% at 10% 80%, var(--coral-soft) 0%, transparent 70%),
      radial-gradient(70% 60% at 50% 120%, var(--lime-soft) 0%, transparent 70%),
      var(--paper);
  }

  .page-copy {
    max-width: 680px;
  }

  .page-copy h1 {
    margin-bottom: 20px;
  }

  .page-copy h1 .serif {
    color: var(--iris);
    font-size: 1.02em;
  }

  .page-copy .lead {
    max-width: 48ch;
  }

  .products {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .products { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1080px) {
    .products { grid-template-columns: repeat(3, 1fr); }
  }

  .product {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.35s;
    text-decoration: none;
    color: inherit;
  }

  .product:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-3);
    border-color: var(--line-2);
  }

  .product-vis {
    aspect-ratio: 4/3;
    position: relative;
    overflow: hidden;
    background: var(--chalk);
  }

  .product-vis .glow {
    position: absolute;
    inset: -20%;
    background: radial-gradient(circle at 50% 40%, var(--product-color), transparent 60%);
    opacity: 0.28;
  }

  .product-vis .device {
    position: absolute;
    inset: 12% 18% 0 18%;
    background: var(--ink);
    border-radius: 22px 22px 0 0;
    padding: 14px 12px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .product-vis .device::before {
    content: "";
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 44px;
    height: 5px;
    background: oklch(0.3 0.01 265);
    border-radius: 4px;
  }

  .product-vis .device .title {
    height: 10px;
    width: 60%;
    background: var(--paper);
    border-radius: 3px;
    margin-top: 10px;
  }

  .product-vis .device .row {
    display: flex;
    gap: 6px;
  }

  .product-vis .device .row .bit {
    flex: 1;
    height: 26px;
    background: color-mix(in oklch, var(--product-color) 40%, var(--ink));
    border-radius: 6px;
  }

  .product-vis .device .row .bit:nth-child(2) {
    background: color-mix(in oklch, var(--product-color) 70%, var(--ink));
  }

  .product-vis .device .big {
    flex: 1;
    background: color-mix(in oklch, var(--product-color) 80%, var(--ink));
    border-radius: 10px 10px 0 0;
    margin-top: 2px;
  }

  .product-meta {
    padding: 22px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .product-meta .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .product-meta h3 {
    font-size: 1.35rem;
  }

  .product-meta .tagline {
    color: var(--product-color);
    font-size: 1.05rem;
  }

  .product-meta p {
    font-size: 0.92rem;
    color: var(--ink-2);
  }

  .product-meta .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
  }

  .product-meta .foot .plat {
    font-family: var(--font-mono);
    color: var(--ink-3);
    font-size: 0.78rem;
  }
</style>
