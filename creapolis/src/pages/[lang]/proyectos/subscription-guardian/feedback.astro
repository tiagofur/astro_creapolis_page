---
import ProductHubLayout from '../../../../components/pages/ProductHubLayout.astro';
import SGFeedbackContent from '../../../../components/pages/SGFeedbackContent.astro';
import type { Lang } from '../../../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}
const lang = Astro.params.lang as Lang;
---

<ProductHubLayout lang={lang} slug="subscription-guardian" currentPage="support">
  <SGFeedbackContent lang={lang} />
</ProductHubLayout>
