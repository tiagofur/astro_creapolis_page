---
import SGFeedbackContent from '../../../../components/pages/SGFeedbackContent.astro';
import type { Lang } from '../../../../i18n/ui';
import Layout from '../../../../layouts/Layout.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}
const lang = Astro.params.lang as Lang;
---

<Layout lang={lang} title="Feedback y soporte — Subscription Guardian" description="¿Bug? ¿Sugerencia? ¿Preguntas? Acá estamos para ayudarte. Preguntas frecuentes y canales de contacto.">
  <SGFeedbackContent lang={lang} />
</Layout>
