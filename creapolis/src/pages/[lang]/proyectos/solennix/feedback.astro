---
import ProductHubLayout from '../../../../components/pages/ProductHubLayout.astro';
import SolennixFeedbackContent from '../../../../components/pages/SolennixFeedbackContent.astro';
import type { Lang } from '../../../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}
const lang = Astro.params.lang as Lang;
---

<ProductHubLayout lang={lang} slug="solennix" currentPage="support">
  <SolennixFeedbackContent lang={lang} />
</ProductHubLayout>
