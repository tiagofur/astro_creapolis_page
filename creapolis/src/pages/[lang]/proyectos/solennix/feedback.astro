---
import SolennixFeedbackContent from '../../../../components/pages/SolennixFeedbackContent.astro';
import type { Lang } from '../../../../i18n/ui';
import Layout from '../../../../layouts/Layout.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'pt' } },
  ];
}
const lang = Astro.params.lang as Lang;
---

<Layout lang={lang} title="Feedback y soporte — Solennix" description="¿Bug? ¿Sugerencia? ¿Preguntas? Acá estamos para ayudarte. Preguntas frecuentes y canales de contacto.">
  <SolennixFeedbackContent lang={lang} />
</Layout>
