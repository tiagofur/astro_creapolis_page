---
import ProductHubLayout from '../../../../components/pages/ProductHubLayout.astro';
import SolennixGuideContent from '../../../../components/pages/SolennixGuideContent.astro';
import type { Lang } from '../../../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}
const lang = Astro.params.lang as Lang;
---

<ProductHubLayout lang={lang} slug="solennix" currentPage="guide">
  <SolennixGuideContent lang={lang} />
</ProductHubLayout>
