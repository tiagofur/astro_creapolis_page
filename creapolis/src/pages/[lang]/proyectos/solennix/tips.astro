---
import SolennixTipsContent from '../../../../components/pages/SolennixTipsContent.astro';
import type { Lang } from '../../../../i18n/ui';
import Layout from '../../../../layouts/Layout.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'pt' } },
  ];
}
const lang = Astro.params.lang as Lang;
---

<Layout lang={lang} title="Tips para organizadores — Solennix" description="Estrategias prácticas para cobrar más, organizar mejor y no quemarte en temporada alta.">
  <SolennixTipsContent lang={lang} />
</Layout>
