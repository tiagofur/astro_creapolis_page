---
import type { Lang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/utils';
export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'pt' } },
  ];
}
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

import { getCollection } from 'astro:content';
import BlogSpanishNotice from '../../../components/BlogSpanishNotice.astro';
import Footer from '../../../components/Footer.astro';
import Nav from '../../../components/Nav.astro';
import Layout from '../../../layouts/Layout.astro';
import { getPostDescription } from '../../../utils/post';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('es-MX', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(date);
}

// ─── Editorial categories ───────────────────────────────────
type EditorialCat =
  | 'Engineering'
  | 'Mobile'
  | 'AI/ML'
  | 'Product'
  | 'Building Creapolis';

const EDITORIAL_CATEGORIES: {
  key: EditorialCat;
  color: string;
  icon: string;
}[] = [
  { key: 'Engineering', color: '--lime', icon: '⚙️' },
  { key: 'Mobile', color: '--sky', icon: '📱' },
  { key: 'AI/ML', color: '--coral', icon: '🤖' },
  { key: 'Product', color: '--amber', icon: '📦' },
  { key: 'Building Creapolis', color: '--iris', icon: '🏗️' },
];

// Map editorial category → color token for accent bars
const catColorMap: Record<string, string> = {
  Engineering: '--lime',
  Mobile: '--sky',
  'AI/ML': '--coral',
  Product: '--amber',
  'Building Creapolis': '--iris',
};

// Featured post: explicit — most recent with longest description (or first)
const featured = sortedPosts[0];
const rest = sortedPosts.filter((p) => p.slug !== featured?.slug);

// Count posts per editorial category
const catCounts = new Map<string, number>();
for (const post of sortedPosts) {
  const cats = (post.data as any).categories as string[] | undefined;
  if (cats) {
    for (const c of cats) {
      catCounts.set(c, (catCounts.get(c) || 0) + 1);
    }
  }
}

const totalPosts = sortedPosts.length;
---

<Layout lang={lang} title="Notas — Creapolis" description="Notas de producto, tecnología y aprendizajes construyendo software. Escritas desde Creapolis." ogImage="/og/blog.svg">
  <Nav lang={lang} />
  <BlogSpanishNotice lang={lang} currentPath={Astro.url.pathname} />

  <!-- ═══════════════════════════════════════════════════════════════
       HEADER — gradient bg + decorative accents
       ═══════════════════════════════════════════════════════════════ -->
  <section class="blog-header">
    <div class="header-decor" aria-hidden="true"></div>
    <div class="wrap">
      <div class="reveal header-copy">
        <div class="eyebrow" style="margin-bottom:14px"><span>Notas de taller · {totalPosts} artículos</span></div>
        <h1>Ideas sobre desarrollo<br/>y <span class="serif">tecnología</span>.</h1>
        <p class="lead">Notas de producto, mejores prácticas, IA y casos de uso. Lo que aprendo construyendo apps reales — sin hype ni humo.</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       FILTER BAR — sticky, editorial categories with counts
       ═══════════════════════════════════════════════════════════════ -->
  <nav class="filter-bar" aria-label="Filtrar por categoría">
    <div class="filter-inner">
      <button
        type="button"
        class="filter-chip is-active"
        data-cat-filter="all"
      >
        {t('blog.cat.all')} <span class="filter-count">{totalPosts}</span>
      </button>
      {EDITORIAL_CATEGORIES.map(({ key, color, icon }) => {
        const count = catCounts.get(key) || 0;
        if (count === 0) return null;
        return (
          <button
            type="button"
            class={`filter-chip filter-chip--${color.replace('--', '')}`}
            data-cat-filter={key}
          >
            {icon} {key} <span class="filter-count">{count}</span>
          </button>
        );
      })}
    </div>
  </nav>

  <!-- ═══════════════════════════════════════════════════════════════
       FEATURED POST — large hero card
       ═══════════════════════════════════════════════════════════════ -->
  {featured && (
    <section class="section featured-section" style="padding-top: clamp(32px, 4vw, 48px)">
      <div class="wrap">
        <a
          href={`/${lang}/blog/${featured.slug}`}
          class="featured-card reveal"
          data-post-cats={((featured.data as any).categories || []).join(',')}
          data-post-tags={featured.data.tags.join(',')}
        >
          <div class="featured-vis">
            <div class="featured-glow"></div>
            <div class="featured-device">
              <div class="fd-bar"></div>
              <div class="fd-bar" style="width:70%"></div>
              <div class="fd-block"></div>
              <div class="fd-bar" style="width:50%"></div>
              <div class="fd-bar"></div>
            </div>
          </div>
          <div class="featured-meta">
            <div class="featured-top">
              <span class="chip live"><span class="chip-dot"></span>{t('blog.featured.badge')}</span>
              <time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time>
            </div>
            <h2>{featured.data.title}</h2>
            <p class="featured-desc">{getPostDescription(featured)}</p>
            <div class="featured-foot">
              <div class="featured-tags">
                {((featured.data as any).categories || []).map((cat: string) => (
                  <span class={`tag-chip tag-chip--${catColorMap[cat]?.replace('--', '') || 'default'}`}>{cat}</span>
                ))}
                {featured.data.tags.slice(0, 3).map((tag) => (
                  <span class="tag-chip-sm tag-chip-sm--default">{tag}</span>
                ))}
              </div>
              <span class="featured-link">Leer artículo
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M2 8L8 2M8 2H3M8 2V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════════════════════
       ALL POSTS — grid with colored accents
       ═══════════════════════════════════════════════════════════════ -->
  <section class="section" style="padding-top: 0">
    <div class="wrap">
      <div class="grid-header reveal">
        <div class="eyebrow"><span>Todos los artículos</span></div>
      </div>

      <div id="filter-empty" class="filter-empty">
        Nada por acá con ese tag. Probá con otro de arriba.
      </div>

      <div class="posts-grid">
        {rest.map((post, i) => {
          const cats = (post.data as any).categories as string[] | undefined;
          const primaryCat = cats?.[0] || 'Engineering';
          const colorVar = catColorMap[primaryCat]?.replace('--', '') || 'default';
          return (
            <a
              href={`/${lang}/blog/${post.slug}`}
              class={`post-card reveal${i > 0 && i <= 3 ? ` reveal-delay-${i}` : ''}`}
              data-post-cats={cats?.join(',') || ''}
              data-post-tags={post.data.tags.join(',')}
            >
              <div class={`post-accent post-accent--${colorVar}`}></div>
              <div class="post-body">
                <div class="post-meta">
                  <span class={`cat-badge cat-badge--${colorVar}`}>{primaryCat}</span>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                </div>
                <h3>{post.data.title}</h3>
                <p>{getPostDescription(post)}</p>
                <div class="post-foot">
                  <div class="post-tags">
                    {post.data.tags.slice(0, 2).map((tag) => (
                      <span class="tag-chip-sm tag-chip-sm--default">{tag}</span>
                    ))}
                  </div>
                  <span class="post-link">
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M2 8L8 2M8 2H3M8 2V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      {sortedPosts.length === 0 && (
        <div class="empty-state">
          <div class="eyebrow" style="margin-bottom:12px"><span>Sin artículos</span></div>
          <p>Todavía no hay artículos publicados. Vuelve pronto.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       NEWSLETTER CTA
       ═══════════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="newsletter-card reveal">
        <div class="newsletter-glow" aria-hidden="true"></div>
        <div class="newsletter-content">
          <div class="eyebrow" style="margin-bottom:14px"><span>Hablemos</span></div>
          <h3>¿Te gustó lo que leíste <span class="serif">y tenés un proyecto</span>?</h3>
          <p>Si algo de lo que escribió te resonó y tenés una idea que querés llevar a cabo, conversemos. Te respondo el mismo día.</p>
          <div class="newsletter-form">
            <a href={`/${lang}/contacto`} class="btn btn-primary btn-lg">Iniciar conversación
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════════
     HEADER
     ═══════════════════════════════════════════════════════════════ */
  .blog-header {
    padding: 120px var(--gutter) 32px;
    background: var(--chalk);
    position: relative;
    overflow: clip;
  }
  .blog-header .header-copy { max-width: 620px; }
  .blog-header h1 { margin-bottom: 14px !important; }
  .blog-header p.lead { margin-bottom: 0 !important; }
  .header-decor {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(50% 50% at 85% 10%, var(--iris-soft) 0%, transparent 60%),
      radial-gradient(45% 40% at 5% 90%, var(--lime-soft) 0%, transparent 70%),
      radial-gradient(40% 35% at 60% 110%, var(--coral-soft) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .blog-header .wrap {
    max-width: var(--max);
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .blog-header h1 {
    font-size: clamp(2rem, 5vw, 3.6rem);
    margin-bottom: 20px;
  }
  .blog-header p.lead {
    max-width: 52ch;
    margin-bottom: 28px;
  }

  /* ═══════════════════════════════════════════════════════════════
     FILTER BAR — sticky con chips canónicos
     ═══════════════════════════════════════════════════════════════ */
  .filter-bar {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in oklch, var(--paper) 92%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .filter-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 14px var(--gutter);
    display: flex;
    flex-wrap: nowrap;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .filter-inner::-webkit-scrollbar { display: none; }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    padding: 7px 14px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink-2);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    cursor: pointer;
    transition: transform 0.2s var(--ease), border-color 0.2s var(--ease), background 0.2s var(--ease), color 0.2s var(--ease);
    white-space: nowrap;
  }
  .filter-chip:hover { transform: translateY(-1px); border-color: var(--line-2); }
  .filter-chip.is-active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .filter-chip.is-active .filter-count {
    background: oklch(0.35 0.02 265);
    color: var(--paper);
  }
  .filter-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    padding: 1px 7px;
    font-size: 0.68rem;
    color: var(--ink-3);
    background: var(--chalk);
    border-radius: var(--r-pill);
    transition: background 0.2s, color 0.2s;
  }

  /* Accent variants — solo el texto y el contador, el fondo sigue neutro hasta activo */
  .filter-chip--iris { color: var(--iris); }
  .filter-chip--iris:hover { border-color: color-mix(in oklch, var(--iris) 35%, var(--line)); }
  .filter-chip--iris.is-active { background: var(--iris); border-color: var(--iris); color: var(--paper); }
  .filter-chip--coral { color: var(--coral); }
  .filter-chip--coral:hover { border-color: color-mix(in oklch, var(--coral) 35%, var(--line)); }
  .filter-chip--coral.is-active { background: var(--coral); border-color: var(--coral); color: var(--paper); }
  .filter-chip--lime { color: oklch(0.55 0.18 128); }
  .filter-chip--lime:hover { border-color: color-mix(in oklch, var(--lime) 45%, var(--line)); }
  .filter-chip--lime.is-active { background: var(--lime); border-color: var(--lime); color: var(--ink); }
  .filter-chip--sky { color: var(--sky); }
  .filter-chip--sky:hover { border-color: color-mix(in oklch, var(--sky) 35%, var(--line)); }
  .filter-chip--sky.is-active { background: var(--sky); border-color: var(--sky); color: var(--ink); }
  .filter-chip--amber { color: oklch(0.5 0.14 70); }
  .filter-chip--amber:hover { border-color: color-mix(in oklch, var(--amber) 40%, var(--line)); }
  .filter-chip--amber.is-active { background: var(--amber); border-color: var(--amber); color: var(--ink); }

  /* Estado oculto por filtro */
  .post-card[data-hidden="true"],
  .featured-card[data-hidden="true"] { display: none; }

  /* Category section headers */
  .cat-header {
    margin: 40px 0 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .cat-header h2 {
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cat-header .cat-count {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--ink-4);
    font-weight: 400;
  }

  .filter-empty {
    display: none;
    padding: 48px 20px;
    text-align: center;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }
  .filter-empty.is-visible { display: block; }

  /* Cuando el filtro esconde featured */
  .featured-section.is-hidden { display: none; }

  /* Tag chips — color coded */
  .tag-chip {
    padding: 4px 12px;
    border-radius: var(--r-pill);
    font-size: 0.78rem;
    font-weight: 500;
    font-family: var(--font-mono);
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink-2);
  }
  .tag-chip--iris { background: var(--iris-soft); color: var(--iris); border-color: color-mix(in oklch, var(--iris) 25%, var(--line)); }
  .tag-chip--coral { background: var(--coral-soft); color: var(--coral); border-color: color-mix(in oklch, var(--coral) 25%, var(--line)); }
  .tag-chip--lime { background: var(--lime-soft); color: var(--lime); border-color: color-mix(in oklch, var(--lime) 25%, var(--line)); }
  .tag-chip--sky { background: var(--sky-soft); color: var(--sky); border-color: color-mix(in oklch, var(--sky) 25%, var(--line)); }
  .tag-chip--amber { background: var(--amber-soft); color: var(--amber); border-color: color-mix(in oklch, var(--amber) 25%, var(--line)); }

  .tag-chip-sm {
    padding: 2px 8px;
    border-radius: var(--r-pill);
    font-size: 0.68rem;
    font-family: var(--font-mono);
    font-weight: 500;
    border: 1px solid var(--line);
    background: var(--chalk);
    color: var(--ink-3);
  }
  .tag-chip-sm--iris { background: var(--iris-soft); color: var(--iris); border-color: color-mix(in oklch, var(--iris) 20%, var(--line)); }
  .tag-chip-sm--coral { background: var(--coral-soft); color: var(--coral); border-color: color-mix(in oklch, var(--coral) 20%, var(--line)); }
  .tag-chip-sm--lime { background: var(--lime-soft); color: var(--lime); border-color: color-mix(in oklch, var(--lime) 20%, var(--line)); }
  .tag-chip-sm--sky { background: var(--sky-soft); color: var(--sky); border-color: color-mix(in oklch, var(--sky) 20%, var(--line)); }
  .tag-chip-sm--amber { background: var(--amber-soft); color: var(--amber); border-color: color-mix(in oklch, var(--amber) 20%, var(--line)); }

  /* ═══════════════════════════════════════════════════════════════
     FEATURED POST
     ═══════════════════════════════════════════════════════════════ */
  .featured-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.35s;
  }
  .featured-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-3);
    border-color: var(--line-2);
  }
  @media (min-width: 880px) {
    .featured-card { grid-template-columns: 1fr 1.2fr; }
  }

  .featured-vis {
    position: relative;
    background: var(--chalk);
    min-height: 280px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .featured-glow {
    position: absolute;
    inset: -30%;
    background: radial-gradient(circle at 50% 50%, var(--iris) 0%, transparent 55%);
    opacity: 0.12;
  }
  .featured-device {
    position: relative;
    width: 55%;
    background: var(--ink);
    border-radius: 16px 16px 0 0;
    padding: 20px 14px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .featured-device::before {
    content: "";
    position: absolute;
    top: 7px;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 4px;
    background: oklch(0.3 0.01 265);
    border-radius: 4px;
  }
  .fd-bar {
    height: 12px;
    background: color-mix(in oklch, var(--iris) 35%, var(--ink));
    border-radius: 4px;
    margin-top: 8px;
  }
  .fd-bar:nth-child(2) { background: color-mix(in oklch, var(--lime) 30%, var(--ink)); }
  .fd-block {
    flex: 1;
    min-height: 60px;
    background: color-mix(in oklch, var(--iris) 50%, var(--ink));
    border-radius: 8px 8px 0 0;
    margin-top: 4px;
  }

  .featured-meta {
    padding: clamp(24px, 4vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .featured-top {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .featured-top time {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--ink-3);
  }
  .featured-meta h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
  .featured-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .featured-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .featured-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .featured-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--iris);
    white-space: nowrap;
  }
  .featured-link svg {
    transition: transform 0.2s var(--ease);
  }
  .featured-card:hover .featured-link svg {
    transform: translate(2px, -2px);
  }

  /* ═══════════════════════════════════════════════════════════════
     POSTS GRID
     ═══════════════════════════════════════════════════════════════ */
  .grid-header {
    margin-bottom: 32px;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 720px) { .posts-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .posts-grid { grid-template-columns: repeat(3, 1fr); } }

  .post-card {
    display: flex;
    flex-direction: row;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s;
  }
  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--sh-2);
    border-color: var(--line-2);
  }

  /* Colored left accent bar */
  .post-accent {
    width: 4px;
    flex-shrink: 0;
    background: var(--ink-4);
  }
  .post-accent--iris { background: var(--iris); }
  .post-accent--coral { background: var(--coral); }
  .post-accent--lime { background: var(--lime); }
  .post-accent--sky { background: var(--sky); }
  .post-accent--amber { background: var(--amber); }

  .post-body {
    flex: 1;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .post-meta {
