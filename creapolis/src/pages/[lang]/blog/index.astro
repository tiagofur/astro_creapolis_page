<script>
  // ─── Filter bar: hide posts that don't match the selected editorial category ───
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-cat-filter]');
  const allCards = document.querySelectorAll<HTMLElement>('[data-post-cats]');
  const featuredSection = document.querySelector<HTMLElement>('.featured-section');
  const emptyState = document.getElementById('filter-empty');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.catFilter ?? 'all';

      // Update active state on chips
      filterButtons.forEach((b) => b.classList.toggle('is-active', b === btn));

      // Hide/show featured section: only visible when filter is "all"
      if (featuredSection) {
        featuredSection.classList.toggle('is-hidden', selected !== 'all');
      }

      // Filter grid cards
      let visibleCount = 0;
      allCards.forEach((card) => {
        const cats = (card.dataset.postCats ?? '').split(',').map((c) => c.trim());
        const match = selected === 'all' || cats.includes(selected);
        if (match) {
          card.removeAttribute('data-hidden');
          visibleCount++;
        } else {
          card.setAttribute('data-hidden', 'true');
        }
      });

      // Toggle empty state
      if (emptyState) {
        emptyState.classList.toggle('is-visible', visibleCount === 0);
      }

      // Scroll filter bar so active chip stays visible on mobile
      btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    });
  });
</script>
