  /* ═══════════════════════════════════════════════════════════════
     RESPONSIVE CONTENT — prevent overflow
     ═══════════════════════════════════════════════════════════════ */
  .article-content :global(pre) {
    max-width: 100%;
    overflow-x: auto;
  }
  .article-content :global(table) {
