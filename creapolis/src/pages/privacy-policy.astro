---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Layout from '../layouts/Layout.astro';

const email = 'hola@creapolis.dev';
const twitter = '@creapolisdev';
const lastUpdated = 'April 23, 2026';
---

<Layout
  lang="en"
  title="Privacy Policy — Pepinillo"
  description="Pepinillo Privacy Policy: We value your privacy. Your tasks and focus history are stored locally on your device."
>
  <Nav />

  <section class="legal-page">
    <div class="legal-inner">
      <div class="legal-head">
        <p class="eyebrow" style="--accent-color: var(--c-yellow); margin-bottom: 14px;">Legal</p>
        <h1>Privacy <span class="tone">Policy</span></h1>
        <p class="last-updated">Last updated: {lastUpdated}</p>
      </div>

      <p class="intro">At Pepinillo, we believe focus should be simple and private. Here is how we protect your data:</p>

      <div class="privacy-grid">
        <article class="privacy-card" style="--accent-color: var(--c-cyan);">
          <span class="card-bar" aria-hidden="true"></span>
          <h2>📱 Local Data</h2>
          <p>Your tasks and focus history are stored on your device. Nothing leaves your phone or computer without permission.</p>
        </article>

        <article class="privacy-card" style="--accent-color: var(--c-magenta);">
          <h2>☁️ iCloud Sync (Optional)</h2>
          <p>If you enable sync, data goes only to your personal Apple iCloud account. We never see your data.</p>
        </article>

        <article class="privacy-card" style="--accent-color: var(--c-yellow);">
          <h2>🚫 No Tracking</h2>
          <p>We do not use third-party analytics or tracking SDKs. Your privacy is built-in, not added later.</p>
        </article>

        <article class="privacy-card" style="--accent-color: var(--c-cyan);">
          <h2>❤️ Apple Health Integration</h2>
          <p>If you grant permission, we log "Mindful Minutes" to Apple Health. This data lives in your device and Apple Health only. You can revoke access anytime.</p>
        </article>

        <article class="privacy-card" style="--accent-color: var(--c-magenta);">
          <h2>🔒 Encryption</h2>
          <p>Your iCloud data is encrypted in transit using Apple's secure protocols. We don't add our own trackers or keyloggers.</p>
        </article>

        <article class="privacy-card" style="--accent-color: var(--c-yellow);">
          <h2>⚠️ No Cloud Backups (Yet)</h2>
          <p>All your focus data lives on your device. If you lose it, it's gone — unless you have iCloud sync enabled.</p>
        </article>
      </div>

      <section class="contact">
        <h3>Contact</h3>
        <p>Questions about our privacy? Email <a href={`mailto:${email}`}>{email}</a> or DM <a href={`https://x.com/${twitter.replace('@', '')}`} target="_blank" rel="noopener noreferrer">{twitter}</a>.</p>
      </section>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .legal-page {
    padding: 140px var(--gutter) 100px;
    background: var(--paper);
    min-height: 80vh;
  }
  .legal-inner {
    max-width: min(72ch, 100%);
    margin: 0 auto;
  }
  .legal-head { margin-bottom: 48px; }
  .legal-head h1 {
    font-size: clamp(2.2rem, 4.6vw, 3.4rem);
    line-height: 1.05; letter-spacing: -0.03em;
    font-weight: var(--fw-semibold);
    color: var(--ink); margin: 0 0 14px;
    text-wrap: balance;
  }
  .legal-head h1 .tone {
    color: var(--ink-4);
  }
  .last-updated {
    font-family: var(--font-mono); font-size: 0.78rem;
    color: var(--ink-4); text-transform: uppercase; letter-spacing: var(--ls-mono);
    margin: 0;
  }
  .intro {
    font-size: 1.15rem; line-height: 1.6;
    color: var(--ink-2); margin-bottom: 40px;
  }
  .privacy-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }
  .privacy-card {
    position: relative;
    background: #ffffff;
    padding: 26px 24px 24px;
    border-radius: var(--r-xl);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .privacy-card .card-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: var(--accent-bar);
    background: var(--accent-color, var(--c-cyan));
  }
  .privacy-card h2 {
    font-size: 1.1rem; margin: 0 0 10px;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .privacy-card p {
    font-size: 0.95rem; line-height: 1.6;
    color: var(--ink-3); margin: 0;
  }
  .contact {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .contact h3 {
    font-family: var(--font-mono);
    font-size: 0.78rem; text-transform: uppercase;
    letter-spacing: var(--ls-mono);
    color: var(--ink-4); margin-bottom: 10px;
  }
  .contact p {
    font-size: 1rem; line-height: 1.7;
    color: var(--ink-2);
  }
  .contact a {
    color: var(--ink); text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .contact a:hover { text-decoration-thickness: 2px; }
</style>
