---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 glass border-b border-white/20">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-br from-violet to-cyan rounded-lg blur opacity-75 group-hover:opacity-100 transition"></div>
          <div class="relative w-8 h-8 bg-gradient-to-br from-violet to-cyan rounded-lg flex items-center justify-center">
            <span class="text-white font-display font-bold text-sm">C</span>
          </div>
        </div>
        <span class="font-display font-semibold text-text text-lg">Creapolis</span>
      </a>

      <div class="hidden md:flex items-center gap-8">
        <a href="#services" class="text-sm font-medium text-text-secondary hover:text-text transition">Servicios</a>
        <a href="#work" class="text-sm font-medium text-text-secondary hover:text-text transition">Proyectos</a>
        <a href="#contact" class="text-sm font-medium text-text-secondary hover:text-text transition">Contacto</a>
      </div>

      <a href="#contact" class="hidden md:inline-flex items-center gap-2 px-5 py-2 bg-text text-white rounded-lg text-sm font-medium hover:bg-text/90 transition">
        Hablemos
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>

      <button class="md:hidden p-2" id="mobile-menu-btn">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="relative pt-32 pb-20 px-6 overflow-hidden">
    <!-- Gradient background -->
    <div class="absolute inset-0 -z-10">
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-violet/20 rounded-full blur-3xl"></div>
      <div class="absolute top-20 right-1/4 w-96 h-96 bg-cyan/20 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-6xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-surface border border-border rounded-full mb-8 fade-up">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald"></span>
        </span>
        <span class="text-xs font-medium text-text-secondary">Disponibles para nuevos proyectos</span>
      </div>

      <h1 class="font-display font-bold text-5xl md:text-7xl lg:text-8xl text-text mb-6 tracking-tight fade-up delay-100">
        Construimos software<br/>
        <span class="gradient-text">sin límites</span>
      </h1>

      <p class="text-lg md:text-xl text-text-secondary max-w-2xl mx-auto mb-10 fade-up delay-200">
        Desarrollamos aplicaciones web, móviles y de escritorio que transforman ideas en productos reales.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 fade-up delay-300">
        <a href="#contact" class="inline-flex items-center gap-2 px-8 py-4 bg-text text-white rounded-xl text-base font-semibold hover:bg-text/90 transition shadow-lg shadow-text/20 hover:shadow-xl hover:shadow-text/30 hover:-translate-y-0.5">
          Iniciar proyecto
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>
        <a href="#work" class="inline-flex items-center gap-2 px-8 py-4 bg-surface border border-border text-text rounded-xl text-base font-semibold hover:border-text/20 transition">
          Ver proyectos
        </a>
      </div>

      <!-- Platform badges -->
      <div class="flex flex-wrap items-center justify-center gap-3 mt-16 fade-up delay-400">
        {['Web', 'iOS', 'Android', 'macOS', 'Windows', 'Linux'].map((platform) => (
          <span class="px-4 py-2 bg-surface border border-border rounded-lg text-sm font-medium text-text-secondary">
            {platform}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Bento Grid -->
  <section id="services" class="py-20 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="font-display font-bold text-4xl md:text-5xl text-text mb-4">
          Lo que creamos
        </h2>
        <p class="text-lg text-text-secondary max-w-2xl mx-auto">
          Desde MVPs hasta productos enterprise. Tecnología moderna, código limpio, resultados reales.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Web Apps -->
        <div class="group relative bg-surface border border-border rounded-2xl p-8 hover:border-violet/30 transition-all hover:shadow-lg hover:shadow-violet/10">
          <div class="absolute top-8 right-8 w-12 h-12 bg-gradient-to-br from-violet/10 to-violet/5 rounded-xl flex items-center justify-center group-hover:scale-110 transition">
            <svg class="w-6 h-6 text-violet" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
            </svg>
          </div>
          <h3 class="font-display font-semibold text-2xl text-text mb-3">Aplicaciones Web</h3>
          <p class="text-text-secondary mb-6 leading-relaxed">
            Dashboards, SaaS platforms, e-commerce. Construidas con React, Next.js, Astro y las tecnologías más modernas.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-violet/10 text-violet rounded-full text-xs font-medium">Next.js</span>
            <span class="px-3 py-1 bg-violet/10 text-violet rounded-full text-xs font-medium">React</span>
            <span class="px-3 py-1 bg-violet/10 text-violet rounded-full text-xs font-medium">Astro</span>
          </div>
        </div>

        <!-- Mobile Apps -->
        <div class="group relative bg-surface border border-border rounded-2xl p-8 hover:border-cyan/30 transition-all hover:shadow-lg hover:shadow-cyan/10">
          <div class="absolute top-8 right-8 w-12 h-12 bg-gradient-to-br from-cyan/10 to-cyan/5 rounded-xl flex items-center justify-center group-hover:scale-110 transition">
            <svg class="w-6 h-6 text-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="font-display font-semibold text-2xl text-text mb-3">Apps Móviles</h3>
          <p class="text-text-secondary mb-6 leading-relaxed">
            iOS y Android. Nativas para máxima performance o cross-platform con Flutter y React Native.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-cyan/10 text-cyan rounded-full text-xs font-medium">Flutter</span>
            <span class="px-3 py-1 bg-cyan/10 text-cyan rounded-full text-xs font-medium">React Native</span>
            <span class="px-3 py-1 bg-cyan/10 text-cyan rounded-full text-xs font-medium">Swift</span>
          </div>
        </div>

        <!-- Desktop Apps -->
        <div class="group relative bg-surface border border-border rounded-2xl p-8 hover:border-emerald/30 transition-all hover:shadow-lg hover:shadow-emerald/10">
          <div class="absolute top-8 right-8 w-12 h-12 bg-gradient-to-br from-emerald/10 to-emerald/5 rounded-xl flex items-center justify-center group-hover:scale-110 transition">
            <svg class="w-6 h-6 text-emerald" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="font-display font-semibold text-2xl text-text mb-3">Software Desktop</h3>
          <p class="text-text-secondary mb-6 leading-relaxed">
            macOS, Windows, Linux. Performance nativo con la flexibilidad de tecnologías web modernas.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-emerald/10 text-emerald rounded-full text-xs font-medium">Tauri</span>
            <span class="px-3 py-1 bg-emerald/10 text-emerald rounded-full text-xs font-medium">Electron</span>
            <span class="px-3 py-1 bg-emerald/10 text-emerald rounded-full text-xs font-medium">Swift</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="work" class="py-20 px-6 bg-gradient-to-b from-bg to-surface">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="font-display font-bold text-4xl md:text-5xl text-text mb-4">
          Proyectos destacados
        </h2>
        <p class="text-lg text-text-secondary max-w-2xl mx-auto">
          Apps que usamos nosotros mismos. Cada proyecto es un laboratorio de innovación.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Pepinillo -->
        <div class="group relative bg-surface border border-border rounded-2xl overflow-hidden hover:border-emerald/30 transition-all hover:shadow-xl hover:shadow-emerald/10">
          <div class="aspect-video bg-gradient-to-br from-emerald/10 to-emerald/5 p-8 flex items-center justify-center">
            <div class="relative w-32 h-56 bg-white rounded-3xl shadow-2xl border border-gray-200 flex flex-col items-center justify-center p-4">
              <div class="w-20 h-20 rounded-full border-4 border-emerald mb-4 flex items-center justify-center">
                <span class="font-display font-bold text-emerald text-xl">25:00</span>
              </div>
              <div class="w-full space-y-2">
                <div class="h-2 bg-emerald/30 rounded-full"></div>
                <div class="h-2 bg-emerald/20 rounded-full w-3/4"></div>
                <div class="h-2 bg-emerald/10 rounded-full w-1/2"></div>
              </div>
            </div>
          </div>
          <div class="p-8">
            <div class="flex items-center gap-2 mb-4">
              <span class="px-3 py-1 bg-emerald/10 text-emerald rounded-full text-xs font-medium">Android</span>
              <span class="px-3 py-1 bg-border text-text-secondary rounded-full text-xs font-medium">iOS próximamente</span>
            </div>
            <h3 class="font-display font-semibold text-2xl text-text mb-3">Pepinillo</h3>
            <p class="text-text-secondary leading-relaxed mb-4">
              App de productividad todo-en-uno. Pomodoro, tareas, timer y estadísticas en una interfaz minimalista.
            </p>
            <a href="/proyectos/pepinillo" class="inline-flex items-center gap-2 text-emerald font-medium group-hover:gap-3 transition-all">
              Ver más
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Peliculas -->
        <div class="group relative bg-surface border border-border rounded-2xl overflow-hidden hover:border-amber/30 transition-all hover:shadow-xl hover:shadow-amber/10">
          <div class="aspect-video bg-gradient-to-br from-amber/10 to-amber/5 p-8 flex items-center justify-center">
            <div class="relative w-32 h-56 bg-white rounded-3xl shadow-2xl border border-gray-200 p-3 space-y-2">
              <div class="h-3 bg-amber/20 rounded-full"></div>
              <div class="grid grid-cols-3 gap-2 flex-1">
                <div class="bg-gradient-to-br from-amber/30 to-rose/30 rounded-lg"></div>
                <div class="bg-gradient-to-br from-rose/30 to-violet/30 rounded-lg"></div>
                <div class="bg-gradient-to-br from-violet/30 to-cyan/30 rounded-lg"></div>
              </div>
            </div>
          </div>
          <div class="p-8">
            <div class="flex items-center gap-2 mb-4">
              <span class="px-3 py-1 bg-amber/10 text-amber rounded-full text-xs font-medium">Android</span>
              <span class="px-3 py-1 bg-border text-text-secondary rounded-full text-xs font-medium">iOS próximamente</span>
            </div>
            <h3 class="font-display font-semibold text-2xl text-text mb-3">Peliculas</h3>
            <p class="text-text-secondary leading-relaxed mb-4">
              Descubre películas y series. Catálogo completo, búsqueda avanzada, listas personalizadas y recomendaciones.
            </p>
            <a href="/proyectos/peliculas" class="inline-flex items-center gap-2 text-amber font-medium group-hover:gap-3 transition-all">
              Ver más
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Solennix -->
        <div class="group relative bg-surface border border-border rounded-2xl overflow-hidden hover:border-violet/30 transition-all hover:shadow-xl hover:shadow-violet/10 lg:col-span-2">
          <div class="grid lg:grid-cols-2">
            <div class="aspect-video lg:aspect-auto bg-gradient-to-br from-violet/10 to-violet/5 p-8 flex items-center justify-center">
              <div class="relative w-64 h-40 bg-white rounded-2xl shadow-2xl border border-gray-200 flex">
                <div class="w-12 bg-violet/10 border-r border-gray-200"></div>
                <div class="flex-1 p-3 space-y-2">
                  <div class="flex gap-2">
                    <div class="flex-1 h-8 bg-violet/20 rounded"></div>
                    <div class="flex-1 h-8 bg-violet/10 rounded"></div>
                    <div class="flex-1 h-8 bg-violet/10 rounded"></div>
                  </div>
                  <div class="h-16 bg-violet/10 rounded"></div>
                  <div class="space-y-1">
                    <div class="h-2 bg-violet/10 rounded-full"></div>
                    <div class="h-2 bg-violet/10 rounded-full w-2/3"></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="p-8">
              <div class="flex items-center gap-2 mb-4">
                <span class="px-3 py-1 bg-violet/10 text-violet rounded-full text-xs font-medium">SaaS Web</span>
                <span class="px-3 py-1 bg-border text-text-secondary rounded-full text-xs font-medium">App móvil próx.</span>
              </div>
              <h3 class="font-display font-semibold text-2xl text-text mb-3">Solennix</h3>
              <p class="text-text-secondary leading-relaxed mb-4">
                Plataforma all-in-one para organizadores de eventos. CRM, inventario, cotizaciones y reportes en tiempo real.
              </p>
              <a href="/proyectos/solennix" class="inline-flex items-center gap-2 text-violet font-medium group-hover:gap-3 transition-all">
                Ver más
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="font-display font-bold text-4xl md:text-5xl text-text mb-6">
        ¿Listo para construir<br/>algo increíble?
      </h2>
      <p class="text-lg text-text-secondary mb-10 max-w-2xl mx-auto">
        Cuéntanos tu idea. Conversemos sin compromiso y veamos cómo podemos ayudarte a hacerla realidad.
      </p>
      <a href="mailto:hola@creapolis.dev" class="inline-flex items-center gap-3 px-10 py-5 bg-text text-white rounded-xl text-lg font-semibold hover:bg-text/90 transition shadow-xl shadow-text/20 hover:shadow-2xl hover:shadow-text/30 hover:-translate-y-1">
        hola@creapolis.dev
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-border py-12 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-8">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 bg-gradient-to-br from-violet to-cyan rounded-lg flex items-center justify-center">
            <span class="text-white font-display font-bold text-sm">C</span>
          </div>
          <span class="font-display font-semibold text-text text-lg">Creapolis</span>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-6">
          <a href="#services" class="text-sm font-medium text-text-secondary hover:text-text transition">Servicios</a>
          <a href="#work" class="text-sm font-medium text-text-secondary hover:text-text transition">Proyectos</a>
          <a href="/privacidad" class="text-sm font-medium text-text-secondary hover:text-text transition">Privacidad</a>
          <a href="/terminos" class="text-sm font-medium text-text-secondary hover:text-text transition">Términos</a>
        </div>
      </div>

      <div class="text-center text-sm text-text-secondary">
        © {new Date().getFullYear()} Creapolis. Construyendo el futuro del software.
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Scroll animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.fade-up, .fade-in').forEach(el => observer.observe(el));

  // Mobile menu
  const menuBtn = document.getElementById('mobile-menu-btn');
  if (menuBtn) {
    menuBtn.addEventListener('click', () => {
      // Add mobile menu functionality here
      alert('Mobile menu - to be implemented');
    });
  }
</script>
